  "required": [
    "kind",
    "version",
    "subscriptionId",
    "revision",
    "owner",
    "shardHandle",
    "selector",
    "start",
    "expiresAt",
    "sink",
    "requestedState"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpe:design:local-subscription-intent:v1",
  "title": "Proposed local SubscriptionIntent; no wire or authority grant",
  "description": "Closed local control-plane configuration. Resolve handles and authorize whole-shard intake locally; never serialize selectors as relay topics."
}
