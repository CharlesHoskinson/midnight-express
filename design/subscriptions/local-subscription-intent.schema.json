    "start": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "after",
            "earliest",
            "latest"
          ]
        },
        "cursor": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "mode",
        "cursor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "after"
              }
            }
          },
          "then": {
            "properties": {
              "cursor": {
                "type": "string",
                "pattern": "^cursor:[a-z0-9][a-z0-9._/-]*(?![\\s\\S])",
                "maxLength": 80
              }
            }
          },
          "else": {
            "properties": {
              "cursor": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z(?![\\s\\S])"
    },
    "sink": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^sink:[a-z0-9][a-z0-9._/-]*(?![\\s\\S])",
          "maxLength": 80
        },
        "maxInFlight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxQueuedEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maxQueuedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      },
      "required": [
        "handle",
        "maxInFlight",
        "maxQueuedEvents",
        "maxQueuedBytes"
      ],
      "additionalProperties": false
    },
    "requestedState": {
      "enum": [
        "active",
        "paused",
        "unsubscribed"
      ]
    }
