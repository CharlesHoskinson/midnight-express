        "digest": "sha256:44261b1ec8271036a5c1c4577eaf39a0a0d2644f61b9bba8c51e0998a3b7d934",
        "download_count": 2,
        "created_at": "2026-08-04T11:20:09Z",
        "updated_at": "2026-08-04T11:20:19Z",
