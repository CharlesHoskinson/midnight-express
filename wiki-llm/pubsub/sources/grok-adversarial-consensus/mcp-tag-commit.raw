      "changes": 25,
      "blob_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/blob/5f5440bb26a62e2cf3440b92da5a667efa03b267/schema%2F2026-07-28%2Fschema.json",
      "raw_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/raw/5f5440bb26a62e2cf3440b92da5a667efa03b267/schema%2F2026-07-28%2Fschema.json",
