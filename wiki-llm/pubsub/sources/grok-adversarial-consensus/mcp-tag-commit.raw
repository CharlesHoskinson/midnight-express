      "patch": "@@ -0,0 +1,10 @@\n+{\n+  \"jsonrpc\": \"2.0\",\n+  \"id\": \"listen-1\",\n+  \"result\": {\n+    \"resultType\": \"complete\",\n+    \"_meta\": {\n+      \"io.modelcontextprotocol/subscriptionId\": \"listen-1\"\n+    }\n+  }\n+}"
