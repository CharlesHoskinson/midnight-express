      "raw_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/raw/5f5440bb26a62e2cf3440b92da5a667efa03b267/schema%2F2026-07-28%2Fexamples%2FSubscriptionsListenResultResponse%2Flisten-closed-response.json",
