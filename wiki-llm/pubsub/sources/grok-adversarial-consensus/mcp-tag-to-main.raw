  "files": [
    {
      "sha": "a5d696f67127cfaf10f3f48317fea295fdfd94ea",
      "filename": ".github/workflows/cut-release.yml",
      "status": "modified",
      "additions": 35,
      "deletions": 13,
      "changes": 48,
      "blob_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/blob/75db1e987cbbba6d170315dc99d0dfc440754aef/.github%2Fworkflows%2Fcut-release.yml",
      "raw_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/raw/75db1e987cbbba6d170315dc99d0dfc440754aef/.github%2Fworkflows%2Fcut-release.yml",
      "contents_url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/contents/.github%2Fworkflows%2Fcut-release.yml?ref=75db1e987cbbba6d170315dc99d0dfc440754aef",
      "patch": "@@ -82,7 +82,7 @@ jobs:\n       - uses: actions/checkout@v7\n       - uses: actions/setup-node@v7\n         with:\n-          node-version: '20'\n+          node-version: '24'\n           cache: npm\n \n       - name: Validate version\n@@ -98,21 +98,37 @@ jobs:\n           cp -r schema/draft \"schema/$VERSION\"\n           # Stamp the protocolVersion constant the generators read.\n           sed -i \"s|^export const LATEST_PROTOCOL_VERSION = .*|export const LATEST_PROTOCOL_VERSION = \\\"$VERSION\\\";|\" \"schema/$VERSION/schema.ts\"\n-          # Promote the draft docs the same way, keeping internal links\n-          # within the new version.\n+          # Promote the draft docs the same way.\n           cp -r docs/docs/draft \"docs/docs/$VERSION\"\n-          grep -rl \"/docs/draft/\" \"docs/docs/$VERSION\" \\\n-            | xargs -r sed -i \"s|/docs/draft/|/docs/$VERSION/|g\"\n-          # Keep intra-tree spec links inside the new version too: the copied\n-          # spec pages, docs pages, and schema.ts doc comments all link to\n-          # /specification/draft/... — mirror what rewrite() in the docs.json\n-          # step already does for nav paths (and what the hand-cut 2025-11-25\n-          # snapshot did). schema.json/schema.mdx are regenerated from\n-          # schema.ts by `npm run generate` below, so stamping schema.ts is\n-          # sufficient for the schema artifacts.\n+          # Keep intra-tree links inside the new version. The copied spec\n+          # pages, docs pages, and schema.ts doc comments link to the draft\n+          # tiers as /specification/draft/..., /docs/draft/..., and\n+          # schema/draft/.... All three rewrites run over all three promoted\n+          # trees, mirroring what rewrite() in the docs.json step already\n+          # does for nav paths and what the hand-cut 2025-11-25 snapshot\n+          # did. schema.json/schema.mdx are regenerated from schema.ts by\n+          # `npm run generate` below, so stamping schema.ts covers the\n+          # schema artifacts.\n           grep -rl \"/specification/draft/\" \\\n               \"docs/specification/$VERSION\" \"docs/docs/$VERSION\" \"schema/$VERSION\" \\\n             | xargs -r sed -i \"s|/specification/draft/|/specification/$VERSION/|g\"\n+          grep -rl \"/docs/draft/\" \\\n+              \"docs/specification/$VERSION\" \"docs/docs/$VERSION\" \"schema/$VERSION\" \\\n+            | xargs -r sed -i \"s|/docs/draft/|/docs/$VERSION/|g\"\n+          grep -rl \"schema/draft/\" \\\n+              \"docs/specification/$VERSION\" \"docs/docs/$VERSION\" \"schema/$VERSION\" \\\n+            | xargs -r sed -i \"s|schema/draft/|schema/$VERSION/|g\"\n+          # The draft changelog's full-changelog link compares the previous\n+          # release tag against the draft branch. Pin the released copy to\n+          # the new tag, matching the 2025-11-25 changelog.\n+          sed -i -E \"s|(/specification/compare/[0-9]{4}-[0-9]{2}-[0-9]{2})\\.\\.\\.draft|\\1...$VERSION|g\" \\\n+            \"docs/specification/$VERSION/changelog.mdx\"\n+          # The learn/versioning page hardcodes the previous release as the\n+          # current protocol version, and the link rewrites above only cover\n+          # draft-tier paths. Stamp the new version into the promoted copy\n+          # and into the draft source for the next cycle.\n+          sed -i -E \"s|(\\*\\*current\\*\\* protocol version is \\[\\*\\*)[0-9]{4}-[0-9]{2}-[0-9]{2}(\\*\\*\\]\\(/specification/)[0-9]{4}-[0-9]{2}-[0-9]{2}(/\\))|\\1$VERSION\\2$VERSION\\3|\" \\\n+            \"docs/docs/$VERSION/learn/versioning.mdx\" docs/docs/draft/learn/versioning.mdx\n \n       - name: Regenerate schema artifacts\n         run: |\n@@ -164,13 +180,19 @@ jobs:\n           }\n           // Draft-source redirects (pages that moved out of the draft tree)\n           // get a dated sibling so the promoted version's URLs resolve too.\n+          // Skip any dated source already present: main may carry pre-cut\n+          // <version>/ redirects, and Mintlify rejects duplicate sources.\n           const draftRedirects = (j.redirects ?? []).filter((r) =>\n             r.source.startsWith('/specification/draft/'),\n           );\n+          const sources = new Set((j.redirects ?? []).map((r) => r.source));\n           for (const r of draftRedirects) {\n+            const source = r.source.replace('/specification/draft/', `/specification/${V}/`);\n+            if (sources.has(source)) continue;\n+            sources.add(source);\n             j.redirects.push({\n               ...r,\n-              source: r.source.replace('/specification/draft/', `/specification/${V}/`),\n+              source,\n               destination: r.destination\n                 .replaceAll('/specification/draft', `/specification/${V}`)\n                 .replaceAll('/docs/draft', `/docs/${V}`),"
    },
    {
      "sha": "ec5b8bedb1c3d38e8bdb7d3324952afa2e73c744",
      "filename": ".github/workflows/sep-lifecycle-manual.yml",
      "status": "modified",
      "additions": 11,
      "deletions": 5,
      "changes": 16,
      "blob_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/blob/75db1e987cbbba6d170315dc99d0dfc440754aef/.github%2Fworkflows%2Fsep-lifecycle-manual.yml",
      "raw_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/raw/75db1e987cbbba6d170315dc99d0dfc440754aef/.github%2Fworkflows%2Fsep-lifecycle-manual.yml",
      "contents_url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/contents/.github%2Fworkflows%2Fsep-lifecycle-manual.yml?ref=75db1e987cbbba6d170315dc99d0dfc440754aef",
      "patch": "@@ -13,7 +13,7 @@ on:\n         default: true\n \n env:\n-  NODE_VERSION: '20'\n+  NODE_VERSION: '24'\n \n jobs:\n   run-automation:\n@@ -47,15 +47,20 @@ jobs:\n         id: automation\n         working-directory: tools/sep-automation\n         run: |\n-          if [[ \"${{ github.event.inputs.dry_run }}\" == \"true\" ]]; then\n+          if [[ \"$DRY_RUN\" == \"true\" ]]; then\n             echo \"::notice::Running in DRY RUN mode - no changes will be made\"\n           else\n             echo \"::warning::Running in PRODUCTION mode - changes will be applied!\"\n           fi\n \n-          if [[ -n \"${{ github.event.inputs.issue_number }}\" ]]; then\n-            echo \"Processing single issue #${{ github.event.inputs.issue_number }}\"\n-            npm start -- --issue ${{ github.event.inputs.issue_number }} 2>&1 | tee automation.log\n+          if [[ -n \"$ISSUE_NUMBER\" ]]; then\n+            if ! [[ \"$ISSUE_NUMBER\" =~ ^[1-9][0-9]*$ ]]; then\n+              echo \"::error::Issue/PR number must be a positive integer\"\n+              exit 1\n+            fi\n+\n+            echo \"Processing single issue #$ISSUE_NUMBER\"\n+            npm start -- --issue \"$ISSUE_NUMBER\" 2>&1 | tee automation.log\n           else\n             echo \"Running full sweep\"\n             npm start 2>&1 | tee automation.log\n@@ -68,6 +73,7 @@ jobs:\n           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n           MAINTAINERS_TEAM: core-maintainers\n           DRY_RUN: ${{ github.event.inputs.dry_run }}\n+          ISSUE_NUMBER: ${{ github.event.inputs.issue_number }}\n           DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}\n           LOG_LEVEL: info\n "
    },
