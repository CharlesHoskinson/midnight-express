      "node_id": "C_kwDOM2nIG9oAKDJiNTJlZGNkZmI3YjcxYmM3NjEwNDYyMzk0N2QyN2NlOGZlZmJiMDU",
      "commit": {
        "author": {
          "name": "Den Delimarsky",
          "email": "den@anthropic.com",
