    {
      "sha": "413d21d5041dc614ba2439b7975e7b3156455123",
      "node_id": "C_kwDOM2nIG9oAKDQxM2QyMWQ1MDQxZGM2MTRiYTI0MzliNzk3NWU3YjMxNTY0NTUxMjM",
      "commit": {
        "author": {
          "name": "Claude",
          "email": "noreply@anthropic.com",
          "date": "2026-07-29T21:14:46Z"
        },
        "committer": {
          "name": "Claude",
          "email": "noreply@anthropic.com",
          "date": "2026-07-29T21:14:46Z"
        },
        "message": "ci: stamp the current protocol version into learn/versioning.mdx at cut\n\nThe promote step rewrites draft-tier links but not the hardcoded dated\nversion in the Revisions section, which is how the 2026-07-28 copy\nshipped naming 2025-11-25 as current. Stamp the new version into the\npromoted copy and the draft source, mirroring the existing changelog\nrewrite.",
        "tree": {
          "sha": "71362ff6aaf19ca904a184bea538d032705b4e63",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/71362ff6aaf19ca904a184bea538d032705b4e63"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/413d21d5041dc614ba2439b7975e7b3156455123",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgrLzsfFISF4by8Q+FKz27YpkK1USsBB+m\namu1QkJnbDsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5AAAAQCWrLEZU\nZFDWXDbcnaySl6OYGiRYoiXKxSwdAHQLysa9aJRd4hrCTgL3bvwuu0Zkkynnp4Z4JCwY293yHAEc\nEA8=\n-----END SSH SIGNATURE-----",
          "payload": "tree 71362ff6aaf19ca904a184bea538d032705b4e63\nparent 7f86f0e67c7bfcac7b1268d4dca77e928d74f923\nauthor Claude <noreply@anthropic.com> 1785359686 +0000\ncommitter Claude <noreply@anthropic.com> 1785359686 +0000\n\nci: stamp the current protocol version into learn/versioning.mdx at cut\n\nThe promote step rewrites draft-tier links but not the hardcoded dated\nversion in the Revisions section, which is how the 2026-07-28 copy\nshipped naming 2025-11-25 as current. Stamp the new version into the\npromoted copy and the draft source, mirroring the existing changelog\nrewrite.\n",
          "verified_at": "2026-07-29T21:14:58Z"
        }
      },
