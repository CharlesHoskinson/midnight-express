      "parents": [
        {
          "sha": "4df2d6b6e3588efb46e7542d98498e5c630a0a86",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/commits/4df2d6b6e3588efb46e7542d98498e5c630a0a86",
