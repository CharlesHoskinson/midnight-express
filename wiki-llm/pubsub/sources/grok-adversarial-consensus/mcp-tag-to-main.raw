    {
      "sha": "100c5a40011fe4591a38a3eb3f4ac6d5d424d4c2",
      "node_id": "C_kwDOM2nIG9oAKDEwMGM1YTQwMDExZmU0NTkxYTM4YTNlYjNmNGFjNmQ1ZDQyNGQ0YzI",
      "commit": {
        "author": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-07-08T14:29:55Z"
        },
        "committer": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-07-08T14:29:55Z"
        },
        "message": "Allow nested skills, gated on fresh activation consent\n\nReplace the ban on a SKILL.md appearing in a descendant directory of a\nskill with defined nesting semantics, per review discussion:\n\n- Nested content is supporting content: read through the enclosing\n  skill, a nested SKILL.md is ordinary markdown and hosts MUST NOT act\n  on its frontmatter.\n- Activation requires fresh consent: approval is per skill, and\n  activating a nested skill - through the host's skill-loading\n  machinery or by giving effect to its frontmatter - requires explicit\n  user consent; approval of the enclosing skill does not substitute.\n- Publication is flat: a nested skill is published through its own\n  index entry or explicit reference, and nothing in the index marks\n  nesting.\n\nClarifications that follow: relative references in any SKILL.md resolve\nagainst its own directory regardless of how the file was reached, and\nthe digest-verification requirement is scoped to content retrieved via\nits index entry. Security Implications gains a nested-skill-consent\nbullet, and the no-implicit-permission-grants bullet states that a\nnested skill's allowed-tools has no effect unless that skill is\nactivated under its own approval.\n\nNo-Verification-Needed: doc-only change with no runtime surface",
        "tree": {
          "sha": "04ec8bb74188ebf0a6038afe7f8b29397c2e3da7",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/04ec8bb74188ebf0a6038afe7f8b29397c2e3da7"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/100c5a40011fe4591a38a3eb3f4ac6d5d424d4c2",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEEUpM1t3/M4chist5yabmE5eCp/yCpA8owiBOXI5b/Fjk1+uXNERWt02uSP7hzRv8v5fM5\nZaEd48lf5fhyKLXtrAAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAhAL+aJlEJsiFDPPrhVUT9jeTnaqR4ikgsU12H3MCNrhXEAAAA\nIHY9GOikDqXgRgPFrpftIpy1HwzJHaciAEL5KtfoeTUD\n-----END SSH SIGNATURE-----",
          "payload": "tree 04ec8bb74188ebf0a6038afe7f8b29397c2e3da7\nparent 2971db76fe113d486a1dff4ae0b068ab53e89d94\nauthor Peter Alexander <pja@anthropic.com> 1783520995 +0100\ncommitter Peter Alexander <pja@anthropic.com> 1783520995 +0100\n\nAllow nested skills, gated on fresh activation consent\n\nReplace the ban on a SKILL.md appearing in a descendant directory of a\nskill with defined nesting semantics, per review discussion:\n\n- Nested content is supporting content: read through the enclosing\n  skill, a nested SKILL.md is ordinary markdown and hosts MUST NOT act\n  on its frontmatter.\n- Activation requires fresh consent: approval is per skill, and\n  activating a nested skill - through the host's skill-loading\n  machinery or by giving effect to its frontmatter - requires explicit\n  user consent; approval of the enclosing skill does not substitute.\n- Publication is flat: a nested skill is published through its own\n  index entry or explicit reference, and nothing in the index marks\n  nesting.\n\nClarifications that follow: relative references in any SKILL.md resolve\nagainst its own directory regardless of how the file was reached, and\nthe digest-verification requirement is scoped to content retrieved via\nits index entry. Security Implications gains a nested-skill-consent\nbullet, and the no-implicit-permission-grants bullet states that a\nnested skill's allowed-tools has no effect unless that skill is\nactivated under its own approval.\n\nNo-Verification-Needed: doc-only change with no runtime surface\n",
          "verified_at": "2026-07-08T14:30:18Z"
        }
      },
