      "patch": "@@ -394,10 +394,17 @@ body:has(#schema-reference) {\n \n /*** LF Projects copyright footer ***/\n \n+/* footer.js appends #lf-copyright into Mintlify's #footer flex row, which\n+   already draws the top border. Let the row wrap so the notice sits beside\n+   the social icons when there is room and drops to its own line otherwise. */\n+#footer {\n+  flex-wrap: wrap;\n+  row-gap: 1.5rem;\n+}\n+\n #lf-copyright {\n-  margin-top: 2rem;\n-  padding-top: 1.5rem;\n-  border-top: 1px solid light-dark(rgb(var(--gray-950)/.1), rgba(255 255 255/0.1));\n+  flex: 1 1 32rem;\n+  min-width: 0;\n   text-align: center;\n   font-size: 0.875rem;\n   color: rgb(var(--gray-500));"
    },
