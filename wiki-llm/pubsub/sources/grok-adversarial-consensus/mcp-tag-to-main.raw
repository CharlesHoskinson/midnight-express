    },
    {
      "sha": "9408347ed8900b527dba55c5953f36f2282b6b21",
      "node_id": "C_kwDOM2nIG9oAKDk0MDgzNDdlZDg5MDBiNTI3ZGJhNTVjNTk1M2YzNmYyMjgyYjZiMjE",
      "commit": {
        "author": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T21:37:13Z"
        },
        "committer": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T21:37:13Z"
        },
        "message": "SEP-2640: add per-skill limits and a size field on resource entries\n\nEach resources entry now carries size, the byte length of the file's\nraw content, the same bytes the digest covers. A host can budget a\nskill from the entry alone before fetching anything, and a read whose\nlength differs from size is a verification failure equivalent to a\ndigest mismatch.\n\nFix two per-skill limits: 512 resources per skill and 16 MiB\n(16,777,216 bytes) total file size, the sum of size over resources.\nHosts must support skills up to these limits and may support larger\nones; servers should not serve skills that exceed them. Both are\ncheckable from the entry before any file is retrieved. The limits\nbound exposure to one skill and say nothing about catalog size.\n\nUpdate the examples and the SDK guidance accordingly. Regenerate the\nrendered SEP docs.\n\nNo-Verification-Needed: documentation-only change",
        "tree": {
          "sha": "20136851046efb589f7f5672e4c9f29f66f37e55",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/20136851046efb589f7f5672e4c9f29f66f37e55"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/9408347ed8900b527dba55c5953f36f2282b6b21",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAg3TEOWZgs8wFZnafNMjeE03DAzR\nEZQ3QjwTbkVfb2zV8AAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQL7CgA7IqLYnBkkaxRWczk8Ph9AMDA0qtWM4O79X/KN3d/pzfTF42SuRPoCMoPGt83\niZZ0ea8XLozSlLvT02FAk=\n-----END SSH SIGNATURE-----",
          "payload": "tree 20136851046efb589f7f5672e4c9f29f66f37e55\nparent 641d1eb400e7f479f4dac3da177d8bc8fa9b4736\nauthor Peter Alexander <pja@anthropic.com> 1787261833 +0000\ncommitter Peter Alexander <pja@anthropic.com> 1787261833 +0000\n\nSEP-2640: add per-skill limits and a size field on resource entries\n\nEach resources entry now carries size, the byte length of the file's\nraw content, the same bytes the digest covers. A host can budget a\nskill from the entry alone before fetching anything, and a read whose\nlength differs from size is a verification failure equivalent to a\ndigest mismatch.\n\nFix two per-skill limits: 512 resources per skill and 16 MiB\n(16,777,216 bytes) total file size, the sum of size over resources.\nHosts must support skills up to these limits and may support larger\nones; servers should not serve skills that exceed them. Both are\ncheckable from the entry before any file is retrieved. The limits\nbound exposure to one skill and say nothing about catalog size.\n\nUpdate the examples and the SDK guidance accordingly. Regenerate the\nrendered SEP docs.\n\nNo-Verification-Needed: documentation-only change\n",
          "verified_at": "2026-08-21T12:32:44Z"
        }
      },
