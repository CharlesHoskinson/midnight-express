    },
    {
      "sha": "ccb6c3e31537bfedc5245c7aa9ce045bee573fb7",
      "node_id": "C_kwDOM2nIG9oAKGNjYjZjM2UzMTUzN2JmZWRjNTI0NWM3YWE5Y2UwNDViZWU1NzNmYjc",
      "commit": {
        "author": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T13:47:17Z"
        },
        "committer": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T13:47:17Z"
        },
        "message": "SEP-2640: a resources/read of SKILL.md does not load the skill\n\nresources/read is transport: it returns bytes to whoever asked, via a\ngeneric resource tool, a resource browser, or a user inspecting the\nserver. Nothing said that such a read is not a skill load, which left\nthe verification, approval, and acting-on window bypassable by reading\nthe URI directly.\n\nState in Reading that a skill is loaded only through the host's own\nskill-loading path, that a SKILL.md read arriving by any other route\ngrants no approval, opens no window, and confers no standing on the\nskill's supporting files, and that such content is ordinary resource\ncontent. Note in the host integration sketch that read_skill is that\npath and read_resource on the same URI is not.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change",
        "tree": {
          "sha": "28659bbac09c33a569cfe7c184bc1dd94a7b220c",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/28659bbac09c33a569cfe7c184bc1dd94a7b220c"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/ccb6c3e31537bfedc5245c7aa9ce045bee573fb7",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAg3TEOWZgs8wFZnafNMjeE03DAzR\nEZQ3QjwTbkVfb2zV8AAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQFmkKSaAbwimKNhOa4byMKUlpzNZ5hrIk1WHxU5CpKJIgiXAAGRT1g3Xla+G4151uQ\nsAB4ZcyXARe9QprN9MxQ4=\n-----END SSH SIGNATURE-----",
          "payload": "tree 28659bbac09c33a569cfe7c184bc1dd94a7b220c\nparent 4b0368a25d4767dba8842e918aacb407b11e0a8c\nauthor Peter Alexander <pja@anthropic.com> 1787233637 +0000\ncommitter Peter Alexander <pja@anthropic.com> 1787233637 +0000\n\nSEP-2640: a resources/read of SKILL.md does not load the skill\n\nresources/read is transport: it returns bytes to whoever asked, via a\ngeneric resource tool, a resource browser, or a user inspecting the\nserver. Nothing said that such a read is not a skill load, which left\nthe verification, approval, and acting-on window bypassable by reading\nthe URI directly.\n\nState in Reading that a skill is loaded only through the host's own\nskill-loading path, that a SKILL.md read arriving by any other route\ngrants no approval, opens no window, and confers no standing on the\nskill's supporting files, and that such content is ordinary resource\ncontent. Note in the host integration sketch that read_skill is that\npath and read_resource on the same URI is not.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change\n",
          "verified_at": "2026-08-20T13:55:45Z"
        }
      },
