        {
          "sha": "8b97c28d25c09a0f5acb585d607243ec26d36c37",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/commits/8b97c28d25c09a0f5acb585d607243ec26d36c37",
