    {
      "sha": "8d25c11f4f1f7ff313f73e916555672dbf54fda7",
      "node_id": "C_kwDOM2nIG9oAKDhkMjVjMTFmNGYxZjdmZjMxM2Y3M2U5MTY1NTU2NzJkYmY1NGZkYTc",
      "commit": {
        "author": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-07-08T11:23:27Z"
