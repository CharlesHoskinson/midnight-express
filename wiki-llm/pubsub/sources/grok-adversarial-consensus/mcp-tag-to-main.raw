    {
      "sha": "db4bfcff3d60f5df01a21bdf6b78f7012cac4634",
      "node_id": "C_kwDOM2nIG9oAKGRiNGJmY2ZmM2Q2MGY1ZGYwMWEyMWJkZjZiNzhmNzAxMmNhYzQ2MzQ",
      "commit": {
        "author": {
          "name": "Claude",
          "email": "noreply@anthropic.com",
          "date": "2026-07-28T20:04:27Z"
        },
        "committer": {
          "name": "Claude",
          "email": "noreply@anthropic.com",
          "date": "2026-07-28T20:04:27Z"
        },
        "message": "Date remaining draft links in the 2026-07-28 spec tree\n\nThe cut-release promote step rewrote /specification/draft/ links but\nleft /docs/draft/ and schema/draft/ links untouched in the promoted\nspec tree, so 13 links in docs/specification/2026-07-28/ still pointed\nat the living draft tiers. Date all 13 to 2026-07-28, matching the\nhand-cut 2025-11-25 snapshot, and extend the workflow so future cuts\nrewrite both patterns plus the changelog compare link.\n\nFixes #3160\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01DrwuUqBvFfzvqAFmefi7pU",
        "tree": {
          "sha": "3b2cd09578760fd8f2e5367c8b49ccaf772191df",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/3b2cd09578760fd8f2e5367c8b49ccaf772191df"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/db4bfcff3d60f5df01a21bdf6b78f7012cac4634",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgrLzsfFISF4by8Q+FKz27YpkK1USsBB+m\namu1QkJnbDsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5AAAAQHGWqLLA\n8tFli0WIuSyXpYsrSqnr2frn5JaS/a6EXCq+pp8WrFHFs25NoNWmONXZz+eH7jlydqjyQ9bSXywC\niAs=\n-----END SSH SIGNATURE-----",
          "payload": "tree 3b2cd09578760fd8f2e5367c8b49ccaf772191df\nparent db8a7478ebef7e201eed19114e7b10352ccb1d06\nauthor Claude <noreply@anthropic.com> 1785269067 +0000\ncommitter Claude <noreply@anthropic.com> 1785269067 +0000\n\nDate remaining draft links in the 2026-07-28 spec tree\n\nThe cut-release promote step rewrote /specification/draft/ links but\nleft /docs/draft/ and schema/draft/ links untouched in the promoted\nspec tree, so 13 links in docs/specification/2026-07-28/ still pointed\nat the living draft tiers. Date all 13 to 2026-07-28, matching the\nhand-cut 2025-11-25 snapshot, and extend the workflow so future cuts\nrewrite both patterns plus the changelog compare link.\n\nFixes #3160\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01DrwuUqBvFfzvqAFmefi7pU\n",
          "verified_at": "2026-07-28T20:04:40Z"
        }
      },
