      "parents": [
        {
          "sha": "72cc599d9319d044f70f8d88df5c5c1a0728e44c",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/commits/72cc599d9319d044f70f8d88df5c5c1a0728e44c",
          "html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/commit/72cc599d9319d044f70f8d88df5c5c1a0728e44c"
        }
      ]
    },
    {
      "sha": "a9834326e77fe7c79bc8a1dc7f8871ae8ff85bf2",
      "node_id": "C_kwDOM2nIG9oAKGE5ODM0MzI2ZTc3ZmU3Yzc5YmM4YTFkYzdmODg3MWFlOGZmODViZjI",
      "commit": {
        "author": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T12:58:26Z"
        },
        "committer": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T12:58:26Z"
        },
        "message": "SEP-2640: require disk caches to be write-isolated or re-verified on access\n\nThe SEP encourages hosts to cache skill content on disk but said\nnothing about keeping that cache honest. Verification at fetch time\ndoes not carry over to bytes that may have changed since, so a cache\nwritable by the model, by scripts it runs, or by other users would\nbypass digest verification entirely.\n\nRequire hosts that cache on disk to either keep the cache where only\nthe host can write and never modify cached files in place, or\nrecompute the SHA-256 digest from the cached bytes on every access.\nState explicitly that a stored digest label or modification time is\nnot verification.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change",
        "tree": {
          "sha": "514d765c7d87fe4e34b0abf9d69187228e7ddbaf",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/514d765c7d87fe4e34b0abf9d69187228e7ddbaf"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/a9834326e77fe7c79bc8a1dc7f8871ae8ff85bf2",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAg3TEOWZgs8wFZnafNMjeE03DAzR\nEZQ3QjwTbkVfb2zV8AAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQDG2bhEmlLdz4Kx62o5zr2B+ZbW42vK0ulPQPqe2X9rFCCkml9TH0jyyckcbboaG/x\nVndZdEz3N+6a8BolTXswM=\n-----END SSH SIGNATURE-----",
          "payload": "tree 514d765c7d87fe4e34b0abf9d69187228e7ddbaf\nparent 17b94128a4f83c48e26c0eac170cf1eed5d0a449\nauthor Peter Alexander <pja@anthropic.com> 1787230706 +0000\ncommitter Peter Alexander <pja@anthropic.com> 1787230706 +0000\n\nSEP-2640: require disk caches to be write-isolated or re-verified on access\n\nThe SEP encourages hosts to cache skill content on disk but said\nnothing about keeping that cache honest. Verification at fetch time\ndoes not carry over to bytes that may have changed since, so a cache\nwritable by the model, by scripts it runs, or by other users would\nbypass digest verification entirely.\n\nRequire hosts that cache on disk to either keep the cache where only\nthe host can write and never modify cached files in place, or\nrecompute the SHA-256 digest from the cached bytes on every access.\nState explicitly that a stored digest label or modification time is\nnot verification.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change\n",
          "verified_at": "2026-08-20T13:55:45Z"
        }
      },
