    {
      "sha": "ad13588b2b9dfed6da6e9795e5f270422f538df1",
      "node_id": "C_kwDOM2nIG9oAKGFkMTM1ODhiMmI5ZGZlZDZkYTZlOTc5NWU1ZjI3MDQyMmY1MzhkZjE",
      "commit": {
        "author": {
          "name": "Paul Carleton",
          "email": "paulc@anthropic.com",
          "date": "2026-08-17T15:47:01Z"
        },
        "committer": {
          "name": "Paul Carleton",
          "email": "paulc@anthropic.com",
          "date": "2026-08-17T15:47:01Z"
        },
        "message": "Re-charter the Authorization IG as a single venue\n\nFold the auth-wg-* sub-group channels and the Enterprise-Managed\nAuthorization IG into #auth-ig with one thread per topic, make the\nbiweekly call agenda-driven (slots requested and handed out each time,\nthin agenda cancels), bring SEP/draft/demo feedback explicitly into\nscope, and record the two standing questions asked of every problem\npitch before a SEP is drafted.",
        "tree": {
          "sha": "b90759ab35cded3adc244f73738524c3ca8c5623",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/b90759ab35cded3adc244f73738524c3ca8c5623"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/ad13588b2b9dfed6da6e9795e5f270422f538df1",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEEdcr+Fw37uqsnhZOgyyiQcfH17wAHnXvmGKzi+km/rTfIzVNyhK6kTXbv5eNg3M5bdxf8\nIHgYGyIpR5Vd51IYxQAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAhAIozd1Xb5nhafkIks0elZ+1uFpAoZyfYwzBAApBtdn/zAAAA\nICeTsvVYyaESnasbA+G6U2dvIQs67EJaJtlYOzyb2ukT\n-----END SSH SIGNATURE-----",
          "payload": "tree b90759ab35cded3adc244f73738524c3ca8c5623\nparent 31eefec6b979b09ab2092490e2271c0eb38ccd38\nauthor Paul Carleton <paulc@anthropic.com> 1786981621 +0100\ncommitter Paul Carleton <paulc@anthropic.com> 1786981621 +0100\n\nRe-charter the Authorization IG as a single venue\n\nFold the auth-wg-* sub-group channels and the Enterprise-Managed\nAuthorization IG into #auth-ig with one thread per topic, make the\nbiweekly call agenda-driven (slots requested and handed out each time,\nthin agenda cancels), bring SEP/draft/demo feedback explicitly into\nscope, and record the two standing questions asked of every problem\npitch before a SEP is drafted.\n",
          "verified_at": "2026-08-17T15:48:46Z"
        }
      },
