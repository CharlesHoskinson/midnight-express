      "blob_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/blob/75db1e987cbbba6d170315dc99d0dfc440754aef/blog%2Fcontent%2Fposts%2F2026-07-28-spec-ga%2Fmicrosoft.svg",
