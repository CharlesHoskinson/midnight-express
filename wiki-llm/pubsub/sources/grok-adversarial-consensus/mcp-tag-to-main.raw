      "parents": [
        {
          "sha": "2971db76fe113d486a1dff4ae0b068ab53e89d94",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/commits/2971db76fe113d486a1dff4ae0b068ab53e89d94",
          "html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/commit/2971db76fe113d486a1dff4ae0b068ab53e89d94"
        }
