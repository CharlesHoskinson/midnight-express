    },
    {
      "sha": "01b12e056b64f81bd3cec44fcde806a611535c73",
      "node_id": "C_kwDOM2nIG9oAKDAxYjEyZTA1NmI2NGY4MWJkM2NlYzQ0ZmNkZTgwNmE2MTE1MzVjNzM",
      "commit": {
        "author": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T13:50:23Z"
        },
        "committer": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T13:50:23Z"
        },
        "message": "SEP-2640: explain why a listing entry is a complete manifest\n\nAdd a paragraph to Rationale stating that a skills/list entry is\nintentionally the complete manifest of a skill, verbatim frontmatter\nplus the full resources set with digests, rather than a summary to be\ncompleted by a follow-up call. One pass over the listing gives a host\neverything it needs to build its registry, present the skill for\napproval, bind the approval to content, and verify later reads, with\nno second round-trip per skill.\n\nskills/get exists only for what the listing does not serve: refreshing\none skill's entry without re-enumerating the catalog, and obtaining an\nentry for a skill a partial listing omitted. It is never a step needed\nto complete a listed entry.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change",
        "tree": {
          "sha": "7ded0f4b160b7baabd2f403d86bed358015ffc83",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/7ded0f4b160b7baabd2f403d86bed358015ffc83"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/01b12e056b64f81bd3cec44fcde806a611535c73",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAg3TEOWZgs8wFZnafNMjeE03DAzR\nEZQ3QjwTbkVfb2zV8AAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQOkGkW/PjF4omOKK9Ebhg93OH8kpgtiR1gHqqYZ3feJhM6Yb1wa6VDilpEncXUF+NR\nBjXkH+JuuMpZLoE2CLvgo=\n-----END SSH SIGNATURE-----",
          "payload": "tree 7ded0f4b160b7baabd2f403d86bed358015ffc83\nparent ccb6c3e31537bfedc5245c7aa9ce045bee573fb7\nauthor Peter Alexander <pja@anthropic.com> 1787233823 +0000\ncommitter Peter Alexander <pja@anthropic.com> 1787233823 +0000\n\nSEP-2640: explain why a listing entry is a complete manifest\n\nAdd a paragraph to Rationale stating that a skills/list entry is\nintentionally the complete manifest of a skill, verbatim frontmatter\nplus the full resources set with digests, rather than a summary to be\ncompleted by a follow-up call. One pass over the listing gives a host\neverything it needs to build its registry, present the skill for\napproval, bind the approval to content, and verify later reads, with\nno second round-trip per skill.\n\nskills/get exists only for what the listing does not serve: refreshing\none skill's entry without re-enumerating the catalog, and obtaining an\nentry for a skill a partial listing omitted. It is never a step needed\nto complete a listed entry.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change\n",
          "verified_at": "2026-08-20T13:55:45Z"
        }
      },
