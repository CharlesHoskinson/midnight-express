    {
      "sha": "d6e62d8dddc5d5c22e23d41ab64b1b90bb44f59f",
      "node_id": "C_kwDOM2nIG9oAKGQ2ZTYyZDhkZGRjNWQ1YzIyZTIzZDQxYWI2NGIxYjkwYmI0NGY1OWY",
      "commit": {
        "author": {
          "name": "Claude",
          "email": "noreply@anthropic.com",
          "date": "2026-07-29T02:05:41Z"
        },
        "committer": {
          "name": "Claude",
          "email": "noreply@anthropic.com",
          "date": "2026-07-29T02:05:41Z"
        },
        "message": "Mark Final SEP pages as historical records\n\nFinal SEPs are point-in-time records of the design as accepted. The\nprotocol can change after a SEP is finalized, so a Final SEP page can\ndrift from the current specification. SEP-2322 still documents\ntasks/result and tasks/input_response even though SEP-2663 removed\nthem (#3142).\n\nThe SEP generator now injects a notice at the top of every Final SEP\npage pointing readers to the current specification. The SEP guidelines\nnow state that Final SEPs are not updated after finalization and that\nthe current specification is authoritative.\n\nCloses #3142\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01XY2THv6f61qBZdC8j7uPZP",
        "tree": {
          "sha": "f0d01f18262afb7c2b0bdc0ccfb1c47481d89d35",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/f0d01f18262afb7c2b0bdc0ccfb1c47481d89d35"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/d6e62d8dddc5d5c22e23d41ab64b1b90bb44f59f",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgrLzsfFISF4by8Q+FKz27YpkK1USsBB+m\namu1QkJnbDsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5AAAAQO6SULpv\n3Uh7u9zFVMuRbVlzxHKItVjkKNqUmO6ubxLi0BkLHXrtBAJP+jsHhWtmjeW4EXSwPM7bj5/kc6ao\n7gc=\n-----END SSH SIGNATURE-----",
          "payload": "tree f0d01f18262afb7c2b0bdc0ccfb1c47481d89d35\nparent aa7306efa4dcc03a2a9f2f223e3b2d7a0c5f3ded\nauthor Claude <noreply@anthropic.com> 1785290741 +0000\ncommitter Claude <noreply@anthropic.com> 1785290741 +0000\n\nMark Final SEP pages as historical records\n\nFinal SEPs are point-in-time records of the design as accepted. The\nprotocol can change after a SEP is finalized, so a Final SEP page can\ndrift from the current specification. SEP-2322 still documents\ntasks/result and tasks/input_response even though SEP-2663 removed\nthem (#3142).\n\nThe SEP generator now injects a notice at the top of every Final SEP\npage pointing readers to the current specification. The SEP guidelines\nnow state that Final SEPs are not updated after finalization and that\nthe current specification is authoritative.\n\nCloses #3142\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01XY2THv6f61qBZdC8j7uPZP\n",
          "verified_at": "2026-07-29T02:05:53Z"
        }
      },
