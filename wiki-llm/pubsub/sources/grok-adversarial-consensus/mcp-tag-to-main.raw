      "patch": "@@ -17,6 +17,10 @@\n       {\n         \"label\": \"GitHub\",\n         \"href\": \"https://github.com/modelcontextprotocol\"\n+      },\n+      {\n+        \"label\": \"Discord\",\n+        \"href\": \"https://discord.gg/6CSzBmMkjX\"\n       }\n     ]\n   },\n@@ -70,7 +74,19 @@\n               {\n                 \"group\": \"Developer tools\",\n                 \"pages\": [\n-                  \"docs/2026-07-28/tools/inspector\",\n+                  {\n+                    \"group\": \"Inspector\",\n+                    \"pages\": [\n+                      \"docs/2026-07-28/tools/inspector\",\n+                      \"docs/2026-07-28/tools/inspector/web\",\n+                      \"docs/2026-07-28/tools/inspector/cli\",\n+                      \"docs/2026-07-28/tools/inspector/tui\",\n+                      \"docs/2026-07-28/tools/inspector/configuration\",\n+                      \"docs/2026-07-28/tools/inspector/authorization\",\n+                      \"docs/2026-07-28/tools/inspector/protocol-eras\",\n+                      \"docs/2026-07-28/tools/inspector/recipes\"\n+                    ]\n+                  },\n                   \"docs/2026-07-28/tools/debugging\"\n                 ]\n               },\n@@ -356,7 +372,19 @@\n               {\n                 \"group\": \"Developer tools\",\n                 \"pages\": [\n-                  \"docs/draft/tools/inspector\",\n+                  {\n+                    \"group\": \"Inspector\",\n+                    \"pages\": [\n+                      \"docs/draft/tools/inspector\",\n+                      \"docs/draft/tools/inspector/web\",\n+                      \"docs/draft/tools/inspector/cli\",\n+                      \"docs/draft/tools/inspector/tui\",\n+                      \"docs/draft/tools/inspector/configuration\",\n+                      \"docs/draft/tools/inspector/authorization\",\n+                      \"docs/draft/tools/inspector/protocol-eras\",\n+                      \"docs/draft/tools/inspector/recipes\"\n+                    ]\n+                  },\n                   \"docs/draft/tools/debugging\"\n                 ]\n               },\n@@ -743,6 +771,12 @@\n             \"pages\": [\n               \"extensions/tasks/overview\"\n             ]\n+          },\n+          {\n+            \"group\": \"Skills\",\n+            \"pages\": [\n+              \"extensions/skills/overview\"\n+            ]\n           }\n         ]\n       },\n@@ -819,6 +853,7 @@\n               \"seps/2575-stateless-mcp\",\n               \"seps/2577-deprecate-roots-sampling-and-logging\",\n               \"seps/2596-spec-feature-lifecycle-and-deprecation\",\n+              \"seps/2640-skills-extension\",\n               \"seps/2663-tasks-extension\"\n             ]\n           }\n@@ -837,8 +872,9 @@\n             ]\n           },\n           {\n-            \"group\": \"Propose Changes\",\n+            \"group\": \"Shaping the Protocol\",\n             \"pages\": [\n+              \"development/roadmap\",\n               \"community/design-principles\",\n               \"community/sep-guidelines\"\n             ]\n@@ -857,32 +893,32 @@\n           {\n             \"group\": \"Working Group Charters\",\n             \"pages\": [\n+              \"community/working-groups/agents\",\n               \"community/working-groups/file-uploads\",\n+              \"community/working-groups/filesystems\",\n+              \"community/working-groups/infrastructure\",\n               \"community/working-groups/inspector-v2\",\n               \"community/working-groups/interceptors\",\n               \"community/working-groups/registry\",\n               \"community/working-groups/sdk\",\n               \"community/working-groups/server-card\",\n               \"community/working-groups/skills-over-mcp\",\n+              \"community/working-groups/transports\",\n               \"community/working-groups/triggers-events\"\n             ]\n           },\n           {\n             \"group\": \"Interest Group Charters\",\n             \"pages\": [\n               \"community/interest-groups/auth\",\n+              \"community/interest-groups/enterprise\",\n               \"community/interest-groups/enterprise-managed-authorization\",\n               \"community/interest-groups/financial-services\",\n               \"community/interest-groups/primitive-grouping\",\n+              \"community/interest-groups/scientific-computing\",\n               \"community/interest-groups/security\",\n               \"community/interest-groups/tool-annotations\"\n             ]\n-          },\n-          {\n-            \"group\": \"Roadmap\",\n-            \"pages\": [\n-              \"development/roadmap\"\n-            ]\n           }\n         ]\n       }\n@@ -900,7 +936,8 @@\n   },\n   \"footer\": {\n     \"socials\": {\n-      \"github\": \"https://github.com/modelcontextprotocol\"\n+      \"github\": \"https://github.com/modelcontextprotocol\",\n+      \"discord\": \"https://discord.gg/6CSzBmMkjX\"\n     }\n   },\n   \"redirects\": [\n@@ -916,6 +953,10 @@\n       \"source\": \"/community/tool-annotations/charter\",\n       \"destination\": \"/community/interest-groups/tool-annotations\"\n     },\n+    {\n+      \"source\": \"/community/agents/charter\",\n+      \"destination\": \"/community/working-groups/agents\"\n+    },\n     {\n       \"source\": \"/community/file-uploads/charter\",\n       \"destination\": \"/community/working-groups/file-uploads\"\n@@ -944,6 +985,10 @@\n       \"source\": \"/community/skills-over-mcp/charter\",\n       \"destination\": \"/community/working-groups/skills-over-mcp\"\n     },\n+    {\n+      \"source\": \"/community/transports/charter\",\n+      \"destination\": \"/community/working-groups/transports\"\n+    },\n     {\n       \"source\": \"/community/triggers-events/charter\",\n       \"destination\": \"/community/working-groups/triggers-events\"\n@@ -1205,6 +1250,174 @@\n     {\n       \"source\": \"