    {
      "sha": "72cc599d9319d044f70f8d88df5c5c1a0728e44c",
      "node_id": "C_kwDOM2nIG9oAKDcyY2M1OTlkOTMxOWQwNDRmNzBmOGQ4OGRmNWM1YzFhMDcyOGU0NGM",
      "commit": {
        "author": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-19T15:03:44Z"
        },
        "committer": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-19T15:03:44Z"
        },
        "message": "SEP-2640: require on-demand retrieval of skill files, with local caching\n\nRemove the suggestion that hosts may fetch, verify, and cache a skill's\nentire file set at approval time. Hosts MUST NOT retrieve skill files\nahead of need (on connect, on listing, or at approval): SKILL.md is\nfetched when a skill is loaded and supporting files when they are read.\nA server with many skills and files would otherwise see load\nproportional to its catalog from every connecting host.\n\nHosts SHOULD cache what they retrieve, validated against entry digests\non reuse. Note that lazy retrieval is compatible with content-bound\napproval, which binds to the resources set rather than to bytes.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change",
        "tree": {
          "sha": "29cff4720c18abfabf53a69292273c3f59142d1e",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/29cff4720c18abfabf53a69292273c3f59142d1e"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/72cc599d9319d044f70f8d88df5c5c1a0728e44c",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAg3TEOWZgs8wFZnafNMjeE03DAzR\nEZQ3QjwTbkVfb2zV8AAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQEh1pkipvCYqNhrsyy9tQJPard9+c9qtY2jAJoK8cj3IosfUmzEGmx3XopqfDqb0CU\ngL2y/vr/opGQjfCVclPAU=\n-----END SSH SIGNATURE-----",
          "payload": "tree 29cff4720c18abfabf53a69292273c3f59142d1e\nparent d29bd05222b4732d7b665b552abee532a8c200fa\nauthor Peter Alexander <pja@anthropic.com> 1787151824 +0000\ncommitter Peter Alexander <pja@anthropic.com> 1787151824 +0000\n\nSEP-2640: require on-demand retrieval of skill files, with local caching\n\nRemove the suggestion that hosts may fetch, verify, and cache a skill's\nentire file set at approval time. Hosts MUST NOT retrieve skill files\nahead of need (on connect, on listing, or at approval): SKILL.md is\nfetched when a skill is loaded and supporting files when they are read.\nA server with many skills and files would otherwise see load\nproportional to its catalog from every connecting host.\n\nHosts SHOULD cache what they retrieve, validated against entry digests\non reuse. Note that lazy retrieval is compatible with content-bound\napproval, which binds to the resources set rather than to bytes.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change\n",
          "verified_at": "2026-08-20T13:55:45Z"
        }
      },
