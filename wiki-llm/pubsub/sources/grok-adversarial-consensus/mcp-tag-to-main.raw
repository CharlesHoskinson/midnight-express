    {
      "sha": "b25c0874bf0ba699a58e21ef06f659d839659de3",
      "node_id": "C_kwDOM2nIG9oAKGIyNWMwODc0YmYwYmE2OTlhNThlMjFlZjA2ZjY1OWQ4Mzk2NTlkZTM",
      "commit": {
        "author": {
          "name": "Koichi ITO",
          "email": "koic.ito@gmail.com",
          "date": "2026-08-10T02:40:08Z"
        },
        "committer": {
          "name": "GitHub",
          "email": "noreply@github.com",
          "date": "2026-08-10T02:40:08Z"
        },
        "message": "Update Ruby MCP client example (#3212)\n\nFollow-up to https://github.com/modelcontextprotocol/quickstart-resources/pull/177.\n\nThis PR removes the `base64` dependency from the `bundle add` arguments,\nas it became a runtime dependency of Claude SDK for Ruby v1.60.0+.\nhttps://github.com/anthropics/anthropic-sdk-ruby/pull/161#issuecomment-5221400980\n\nAt least when this draft of `build-client.mdx` was written, `bundle add ...` was expected to install\na recent version of the Claude SDK for Ruby that already includes `base64` as a runtime dependency.",
        "tree": {
          "sha": "30ccc290d51d94373a87250f25f10bc49f307f53",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/30ccc290d51d94373a87250f25f10bc49f307f53"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/b25c0874bf0ba699a58e21ef06f659d839659de3",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
