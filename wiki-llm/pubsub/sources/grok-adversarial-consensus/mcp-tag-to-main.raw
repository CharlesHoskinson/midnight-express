      "blob_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/blob/75db1e987cbbba6d170315dc99d0dfc440754aef/seps%2F2260-Require-Server-requests-to-be-associated-with-Client-requests.md",
      "raw_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/raw/75db1e987cbbba6d170315dc99d0dfc440754aef/seps%2F2260-Require-Server-requests-to-be-associated-with-Client-requests.md",
