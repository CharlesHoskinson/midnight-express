      "blob_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/blob/75db1e987cbbba6d170315dc99d0dfc440754aef/docs%2Fspecification%2Fdraft%2Fbasic%2Fauthorization%2Fclient-registration.mdx",
