        "committer": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-07-08T11:23:27Z"
        },
        "message": "Fix grammar and paragraph break in skills extension SEP\n\nAdd the missing conjunction in the host-side surfaces bullet, and\nrestore the blank line before the skill://index.json paragraph so it\nno longer renders joined to the preceding archive-read paragraph.\n\nAlso regenerate docs/seps/2640-skills-extension.mdx, which had gone\nstale against the source markdown.\n\nNo-Verification-Needed: doc-only change with no runtime surface",
        "tree": {
          "sha": "a4809f5d0f69a2890ad8c5f786dc3283c3d36964",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/a4809f5d0f69a2890ad8c5f786dc3283c3d36964"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/8d25c11f4f1f7ff313f73e916555672dbf54fda7",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEEUpM1t3/M4chist5yabmE5eCp/yCpA8owiBOXI5b/Fjk1+uXNERWt02uSP7hzRv8v5fM5\nZaEd48lf5fhyKLXtrAAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGMAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEgAAAAgcGiucKZaJf8gzQNYJJtwB0u0vgQEaCNvcJiRYiL858gAAAAg\nLzj6E0cgp75lQ29nTO2baJY6E0+Vp6aPxob6s1i6rkU=\n-----END SSH SIGNATURE-----",
          "payload": "tree a4809f5d0f69a2890ad8c5f786dc3283c3d36964\nparent 82609b1924fbd475e62da5af8a4e447e348d8072\nauthor Peter Alexander <pja@anthropic.com> 1783509807 +0100\ncommitter Peter Alexander <pja@anthropic.com> 1783509807 +0100\n\nFix grammar and paragraph break in skills extension SEP\n\nAdd the missing conjunction in the host-side surfaces bullet, and\nrestore the blank line before the skill://index.json paragraph so it\nno longer renders joined to the preceding archive-read paragraph.\n\nAlso regenerate docs/seps/2640-skills-extension.mdx, which had gone\nstale against the source markdown.\n\nNo-Verification-Needed: doc-only change with no runtime surface\n",
          "verified_at": "2026-07-08T11:23:39Z"
        }
