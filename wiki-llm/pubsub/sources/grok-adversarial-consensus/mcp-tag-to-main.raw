    {
      "sha": "7c046ffbbce305afb84842439f5694f46da797c6",
      "node_id": "C_kwDOM2nIG9oAKDdjMDQ2ZmZiYmNlMzA1YWZiODQ4NDI0MzlmNTY5NGY0NmRhNzk3YzY",
      "commit": {
        "author": {
          "name": "Claude",
          "email": "noreply@anthropic.com",
          "date": "2026-07-28T21:13:29Z"
        },
        "committer": {
          "name": "Claude",
          "email": "noreply@anthropic.com",
          "date": "2026-07-28T21:13:29Z"
        },
        "message": "Update PostHog logo in GA post with light and dark variants\n\nPostHog provided refreshed brand SVGs with fixed colors, so the single\ncurrentColor file no longer fits. The quote shortcode gains an optional\nlogo-dark param that inlines a second SVG, and quotes.css shows one\nvariant per theme via PaperMod's body.dark toggle. The GA post now uses\nposthog.svg in light mode and posthog-white.svg in dark mode.\n\nCo-Authored-By: Claude <noreply@anthropic.com>",
        "tree": {
          "sha": "9a9bf5cbfb2d7eeb39fc596d68e807503fd5dbe8",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/9a9bf5cbfb2d7eeb39fc596d68e807503fd5dbe8"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/7c046ffbbce305afb84842439f5694f46da797c6",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgrLzsfFISF4by8Q+FKz27YpkK1USsBB+m\namu1QkJnbDsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5AAAAQGl5k7Qo\nvkrVT68NVC3I7BlONbUzwnAe74oB8HKHIwdkwWj5gpsAn1bpSBwfwQqGrjw+dbL48fIeiOIyv2t2\njgY=\n-----END SSH SIGNATURE-----",
          "payload": "tree 9a9bf5cbfb2d7eeb39fc596d68e807503fd5dbe8\nparent fc28315bb1eb362129ab27e85f2b65ca63f2fa30\nauthor Claude <noreply@anthropic.com> 1785273209 +0000\ncommitter Claude <noreply@anthropic.com> 1785273209 +0000\n\nUpdate PostHog logo in GA post with light and dark variants\n\nPostHog provided refreshed brand SVGs with fixed colors, so the single\ncurrentColor file no longer fits. The quote shortcode gains an optional\nlogo-dark param that inlines a second SVG, and quotes.css shows one\nvariant per theme via PaperMod's body.dark toggle. The GA post now uses\nposthog.svg in light mode and posthog-white.svg in dark mode.\n\nCo-Authored-By: Claude <noreply@anthropic.com>\n",
          "verified_at": "2026-07-28T21:13:43Z"
        }
      },
