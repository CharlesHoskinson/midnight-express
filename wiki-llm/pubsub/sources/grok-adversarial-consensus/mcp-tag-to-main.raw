      "raw_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/raw/75db1e987cbbba6d170315dc99d0dfc440754aef/docs%2Fdocs%2F2025-11-25%2Fdevelop%2Fconnect-remote-servers.mdx",
