    {
      "sha": "17b94128a4f83c48e26c0eac170cf1eed5d0a449",
      "node_id": "C_kwDOM2nIG9oAKDE3Yjk0MTI4YTRmODNjNDhlMjZjMGVhYzE3MGNmMWVlZDVkMGE0NDk",
      "commit": {
        "author": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T12:55:54Z"
        },
        "committer": {
          "name": "Peter Alexander",
          "email": "pja@anthropic.com",
          "date": "2026-08-20T12:55:54Z"
        },
        "message": "SEP-2640: define the window in which a host is acting on a skill\n\nThe file-allowlist rule in Integrity and verification applied \"while\nacting on a skill\", but the SEP never said what that meant. Define it\nas the span from loading the skill's SKILL.md into the model's context\nuntil, at the earliest, that SKILL.md leaves context; hosts may keep\nthe window open longer, never shorter, and hold the entry they loaded\nfrom for the whole of it.\n\nUse the same term in the content-bound approval rule in Security\nImplications, which previously said \"while it holds the approved\nentry\" for the same window.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change",
        "tree": {
          "sha": "43ee0c05af93a1dc67b6587feb34cc0aab5d353a",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/trees/43ee0c05af93a1dc67b6587feb34cc0aab5d353a"
        },
        "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/git/commits/17b94128a4f83c48e26c0eac170cf1eed5d0a449",
        "comment_count": 0,
        "verification": {
          "verified": true,
          "reason": "valid",
          "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAg3TEOWZgs8wFZnafNMjeE03DAzR\nEZQ3QjwTbkVfb2zV8AAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQHjqCphz+ILmPHRjDUn7j0E2qjqGt//2uQxa3LYVgmRW8UnP/Q4jwpUC9TbqqpFtxR\nrSJTOzTa20MdJd13KpRwc=\n-----END SSH SIGNATURE-----",
          "payload": "tree 43ee0c05af93a1dc67b6587feb34cc0aab5d353a\nparent 72cc599d9319d044f70f8d88df5c5c1a0728e44c\nauthor Peter Alexander <pja@anthropic.com> 1787230554 +0000\ncommitter Peter Alexander <pja@anthropic.com> 1787230554 +0000\n\nSEP-2640: define the window in which a host is acting on a skill\n\nThe file-allowlist rule in Integrity and verification applied \"while\nacting on a skill\", but the SEP never said what that meant. Define it\nas the span from loading the skill's SKILL.md into the model's context\nuntil, at the earliest, that SKILL.md leaves context; hosts may keep\nthe window open longer, never shorter, and hold the entry they loaded\nfrom for the whole of it.\n\nUse the same term in the content-bound approval rule in Security\nImplications, which previously said \"while it holds the approved\nentry\" for the same window.\n\nRegenerate the rendered SEP docs.\n\nNo-Verification-Needed: documentation-only change\n",
          "verified_at": "2026-08-20T13:55:45Z"
        }
      },
