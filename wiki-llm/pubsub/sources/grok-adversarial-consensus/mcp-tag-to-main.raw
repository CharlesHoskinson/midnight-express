          "sha": "4eb82eb70b0ad4fe9586b391d270e47a7ca8896d",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/commits/4eb82eb70b0ad4fe9586b391d270e47a7ca8896d",
