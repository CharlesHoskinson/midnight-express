        {
          "sha": "af08f6fe16675351433e7803a5fee3cdd1eb1d9a",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/commits/af08f6fe16675351433e7803a5fee3cdd1eb1d9a",
