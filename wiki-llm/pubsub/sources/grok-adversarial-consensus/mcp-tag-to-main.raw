      "parents": [
        {
          "sha": "d29bd05222b4732d7b665b552abee532a8c200fa",
          "url": "https://api.github.com/repos/modelcontextprotocol/modelcontextprotocol/commits/d29bd05222b4732d7b665b552abee532a8c200fa",
