ersions":["enterprise-server@3.22","enterprise-server@3.21","enterprise-server@3.20","enterprise-server@3.19","enterprise-server@3.18"],"error":"","featureFlags":{},"fullUrl":"https://docs-internal.github.com/en/subscriptions-and-notifications/get-started/configuring-notifications","isHomepageVersion":false,"nonEnterpriseDefaultVersion":"free-pro-team@latest","page":{"documentType":"article","contentType":"get-started","title":"Configuring notifications","fullTitle":"Configuring notifications - GitHub Docs","introPlainText":"Choose the type of activity on GitHub that you want to receive notifications for and how you want these updates delivered.","applicableVersions":["free-pro-team@latest","enterprise-cloud@latest","enterprise-server@3.22","enterprise-server@3.21","enterprise-server@3.20","enterprise-server@3.19","enterprise-server@3.18"],"hidden":false,"noEarlyAccessBanner":false,"docsTeamMetrics":null},"relativePath":"subscriptions-and-notifications/get-started/configuring-notifications.md","sidebarTree":{"href":"/en/subscriptions-and-notifications","title":"Subscriptions \u0026 notifications","childPages":[{"href":"/en/subscriptions-and-notifications/get-started","title":"Get started","childPages":[{"href":"/en/subscriptions-and-notifications/get-started/configuring-notifications","title":"Configuring notifications","childPages":[]}]},{"href":"/en/subscriptions-and-notifications/concepts","title":"Concepts","childPages":[{"href":"/en/subscriptions-and-notifications/concepts/about-notifications","title":"About notifications","childPages":[]},{"href":"/en/subscriptions-and-notifications/concepts/scheduled-reminders","title":"Scheduled reminders","childPages":[]}]},{"href":"/en/subscriptions-and-notifications/how-tos","title":"How-tos","childPages":[{"href":"/en/subscriptions-and-notifications/how-tos/managing-subscriptions-for-activity-on-github","title":"Manage subscriptions","childPages":[{"href":"/en/subscriptions-and-notifications/how-tos/managing-subscriptions-for-activity-on-github/viewing-your-subscriptions","title":"View subscriptions","childPages":[]},{"href":"/en/subscriptions-and-notifications/how-tos/managing-subscriptions-for-activity-on-github/managing-your-subscriptions","title":"Manage your subscriptions","childPages":[]}]},{"href":"/en/subscriptions-and-notifications/how-tos/viewing-and-triaging-notifications","title":"Customize a workflow","childPages":[{"href":"/en/subscriptions-and-notifications/how-tos/viewing-and-triaging-notifications/managing-notifications-from-your-inbox","title":"Manage from your inbox","childPages":[]},{"href":"/en/subscriptions-and-notifications/how-tos/viewing-and-triaging-notifications/triaging-a-single-notification","title":"Triage a notification","childPages":[]}]},{"href":"/en/subscriptions-and-notifications/how-tos/managing-organization-notifications","title":"Manage organization notifications","childPages":[]},{"href":"/en/subscriptions-and-notifications/how-tos/managing-github-actions-notifications","title":"Manage Actions notifications","childPages":[]},{"href":"/en/subscriptions-and-notifications/how-tos/managing-your-scheduled-reminders","title":"Manage scheduled reminders","childPages":[]},{"href":"/en/subscriptions-and-notifications/how-tos/managing-security-notifications","title":"Manage security notifications","childPages":[]},{"href":"/en/subscriptions-and-notifications/how-tos/managing-marketing-emails-from-github","title":"Manage marketing emails","childPages":[]}]},{"href":"/en/subscriptions-and-notifications/tutorials","title":"Tutorials","childPages":[{"href":"/en/subscriptions-and-notifications/tutorials/customizing-a-workflow-for-triaging-your-notifications","title":"Triage your notifications","childPages":[]}]},{"href":"/en/subscriptions-and-notifications/reference","title":"Reference","childPages":[{"href":"/en/subscriptions-and-notifications/reference/inbox-filters","title":"Inbox filters","childPages":[]},{"href":"/en/subscriptions-and-notifications/reference/email-notification-headers","title":"Email notification headers","childPages":[]},{"href":"/en/subscriptions-and-notifications/reference/types-of-emails-github-sends","title":"Emails from GitHub","childPages":[]}]}],"layout":"discovery-landing"},"sidebarExpanded":{},"sidebarCollapsed":false,"status":200,"xHost":"docs.github.com"},"articleContext":{"title":"Configuring notifications","intro":"\u003cp\u003eChoose the type of activity on GitHub that you want to receive notifications for and how you want these updates delivered.\u003c/p\u003e","effectiveDate":"","renderedPage":"\u003ch2 id=\"notification-delivery-options\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#notification-delivery-options\"\u003eNotification delivery options\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eYou can receive notifications for activity on GitHub in the following locations.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThe notifications inbox in the GitHub web interface\u003c/li\u003e\n\u003cli\u003eThe notifications inbox on GitHub Mobile, which syncs with the inbox in the web interface\u003c/li\u003e\n\u003cli\u003eAn email client that uses a verified email address, which can also sync with the notifications inbox in the web interface and GitHub Mobile\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eTo use the notifications inbox on GitHub and GitHub Mobile, you must enable notifications for both \u003cstrong\u003eEmail\u003c/strong\u003e and \u003cstrong\u003eOn GitHub\u003c/strong\u003e in your notification settings. For more information, see \u003ca href=\"#choosing-your-notification-settings\"\u003eChoosing your notification settings\u003c/a\u003e.\u003c/p\u003e\n\u003cdiv class=\"ghd-alert ghd-alert-success\" data-container=\"alert\"\u003e\u003cp class=\"ghd-alert-title\"\u003e\u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon mr-2\" aria-hidden\u003e\u003cpath d=\"M8 1.5c-2.363 0-4 1.69-4 3.75 0 .984.424 1.625.984 2.304l.214.253c.223.264.47.556.673.848.284.411.537.896.621 1.49a.75.75 0 0 1-1.484.211c-.04-.282-.163-.547-.37-.847a8.456 8.456 0 0 0-.542-.68c-.084-.1-.173-.205-.268-.32C3.201 7.75 2.5 6.766 2.5 5.25 2.5 2.31 4.863 0 8 0s5.5 2.31 5.5 5.25c0 1.516-.701 2.5-1.328 3.259-.095.115-.184.22-.268.319-.207.245-.383.453-.541.681-.208.3-.33.565-.37.847a.751.751 0 0 1-1.485-.212c.084-.593.337-1.078.621-1.489.203-.292.45-.584.673-.848.075-.088.147-.173.213-.253.561-.679.985-1.32.985-2.304 0-2.06-1.637-3.75-4-3.75ZM5.75 12h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5ZM6 15.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z\"\u003e\u003c/path\u003e\u003c/svg\u003eTip\u003c/p\u003e\n\u003cp\u003e\nIf you receive notifications both via email and on GitHub, you can automatically sync the read or unread status of the notification so that notifications on GitHub are automatically marked as read once you've read the corresponding email notification. To enable this sync, your email client must be able to view images from \u003ccode\u003enotifications@github.com\u003c/code\u003e.\u003c/p\u003e\n\u003c/div\u003e\n\u003ch3 id=\"benefits-of-the-notifications-inbox\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#benefits-of-the-notifications-inbox\"\u003eBenefits of the notifications inbox\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eThe notifications inbox includes triaging options designed specifically for your GitHub notifications flow, including options to:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTriage multiple notifications at once.\u003c/li\u003e\n\u003cli\u003eMark completed notifications as \u003cstrong\u003eDone\u003c/strong\u003e and remove them from your inbox. To view all of your notifications marked as \u003cstrong\u003eDone\u003c/strong\u003e, use the \u003ccode\u003eis:done\u003c/code\u003e query.\u003c/li\u003e\n\u003cli\u003eSave a notification to review later. Saved notifications are flagged in your inbox and kept indefinitely. To view all of your saved notifications, use the \u003ccode\u003eis:saved\u003c/code\u003e query.\u003c/li\u003e\n\u003cli\u003eUnsubscribe and remove a notification from your inbox.\u003c/li\u003e\n\u003cli\u003ePreview the issue or pull request where the notification originates on GitHub from within the notifications inbox.\u003c/li\u003e\n\u003cli\u003eSee one of the latest reasons you're receiving a notification from your inbox with a \u003ccode\u003ereasons\u003c/code\u003e label.\u003c/li\u003e\n\u003cli\u003eCreate custom filters to focus on different notifications when you want.\u003c/li\u003e\n\u003cli\u003eGroup notifications in your inbox by repository or date to get a quick overview with less context switching.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eIn addition, you can receive and triage notifications on your mobile device with GitHub Mobile. For more information, see \u003ca href=\"#managing-your-notification-settings-with-github-mobile\"\u003eManaging your notification settings with GitHub Mobile\u003c/a\u003e or \u003ca href=\"/en/get-started/using-github/github-mobile\"\u003eGitHub Mobile\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"benefits-of-using-an-email-client-for-notifications\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#benefits-of-using-an-email-client-for-notifications\"\u003eBenefits of using an email client for notifications\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eOne benefit of using an email client is that all of your notifications can be kept indefinitely depending on your email client's storage capacity. Your inbox notifications are only kept for 3 months on GitHub unless you've marked them as \u003cstrong\u003eSaved\u003c/strong\u003e. \u003cstrong\u003eSaved\u003c/strong\u003e notifications are kept indefinitely. For more information about your inbox's retention policy, see \u003ca href=\"/en/subscriptions-and-notifications/concepts/about-notifications#notification-retention-policy\"\u003eAbout notifications\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eSending notifications to your email client also allows you to customize your inbox according to your email client's settings, which can include custom or color-coded labels.\u003c/p\u003e\n\u003cp\u003eEmail notifications also allow flexibility with the types of notifications you receive and allow you to choose different email addresses for updates. For example, you can send certain notifications for a repository to a verified personal email address. For more information, about your email customization options, see \u003ca href=\"#customizing-your-email-notifications\"\u003eCustomizing your email notifications\u003c/a\u003e.\u003c/p\u003e\n\u003ch2 id=\"about-participating-and-watching-notifications\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#about-participating-and-watching-notifications\"\u003eAbout participating and watching notifications\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eWhen you watch a repository, you're subscribing to updates for activity in that repository.\u003c/p\u003e\n\u003cp\u003eTo see repositories that you're watching, go to your \u003ca href=\"https://github.com/watching\"\u003ewatching page\u003c/a\u003e. For more information, see \u003ca href=\"/en/subscriptions-and-notifications/how-tos/managing-subscriptions-for-activity-on-github\"\u003eManaging subscriptions for activity on GitHub\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eYou can configure notifications for a repository on the repository page, or on your watching page.\u003c/p\u003e\n\u003cdiv class=\"ghd-alert ghd-alert-accent\" data-container=\"alert\"\u003e\u003cp class=\"ghd-alert-title\"\u003e\u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon mr-2\" aria-hidden\u003e\u003cpath d=\"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z\"\u003e\u003c/path\u003e\u003c/svg\u003eNote\u003c/p\u003e\n\u003cp\u003e\nYou can watch a maximum of 10,000 repositories.\u003c/p\u003e\n\u003c/div\u003e\n\u003ch3 id=\"about-custom-notifications\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#about-custom-notifications\"\u003eAbout custom notifications\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eYou can customize notifications for a repository. For example, you can choose to only be notified when updates to one or more types of events (issues, pull requests, releases, security alerts, or discussions) happen within a repository, or ignore all notifications for a repository. For more information, see \u003ca href=\"#configuring-your-watch-settings-for-an-individual-repository\"\u003eConfiguring your watch settings for an individual repository\u003c/a\u003e below.\u003c/p\u003e\n\u003ch3 id=\"participating-in-conversations\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#participating-in-conversations\"\u003eParticipating in conversations\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eAnytime you comment in a conversation or when someone @mentions your username, you are participating in a conversation. By default, you are automatically subscribed to a conversation when you participate in it. You can unsubscribe from a conversation you've participated in manually by clicking \u003cstrong\u003eUnsubscribe\u003c/strong\u003e on the issue or pull request or through the \u003cstrong\u003eUnsubscribe\u003c/strong\u003e option in the notifications inbox.\u003c/p\u003e\n\u003cp\u003eFor conversations you're watching or participating in, you can choose whether you want to receive notifications on GitHub or by email in your notification settings. For more information, see \u003ca href=\"/en/subscriptions-and-notifications/get-started/configuring-notifications#choosing-your-notification-settings\"\u003eChoosing your notification settings\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eFor example, on your \"Notification settings\" page:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eIf you don't want notifications to be sent to your email, deselect \u003cstrong\u003eemail\u003c/strong\u003e for participating and watching notifications.\u003c/li\u003e\n\u003cli\u003eIf you want to receive notifications by email when you've participated in a conversation, then select \u003cstrong\u003eemail\u003c/strong\u003e under \"Participating\".\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eIf you do not enable \"Notify me: On GitHub\" for watching or participating notifications, then your notifications inbox will not have any updates.\u003c/p\u003e\n\u003ch2 id=\"customizing-your-email-notifications\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#customizing-your-email-notifications\"\u003eCustomizing your email notifications\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eAfter enabling email notifications, GitHub will send notifications to you as multipart emails that contain both HTML and plain text copies of the content. Email notification content includes any Markdown, @mentions, emojis, hash-links, and more, that appear in the original content on GitHub. If you only want to see the text in the email, you can configure your email client to display the plain text copy only.\u003c/p\u003e\n\u003cdiv class=\"ghd-alert ghd-alert-success\" data-container=\"alert\"\u003e\u003cp class=\"ghd-alert-title\"\u003e\u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon mr-2\" aria-hidden\u003e\u003cpath d=\"M8 1.5c-2.363 0-4 1.69-4 3.75 0 .984.424 1.625.984 2.304l.214.253c.223.264.47.556.673.848.284.411.537.896.621 1.49a.75.75 0 0 1-1.484.211c-.04-.282-.163-.547-.37-.847a8.456 8.456 0 0 0-.542-.68c-.084-.1-.173-.205-.268-.32C3.201 7.75 2.5 6.766 2.5 5.25 2.5 2.31 4.863 0 8 0s5.5 2.31 5.5 5.25c0 1.516-.701 2.5-1.328 3.259-.095.115-.184.22-.268.319-.207.245-.383.453-.541.681-.208.3-.33.565-.37.847a.751.751 0 0 1-1.485-.212c.084-.593.337-1.078.621-1.489.203-.292.45-.584.673-.848.075-.088.147-.173.213-.253.561-.679.985-1.32.985-2.304 0-2.06-1.637-3.75-4-3.75ZM5.75 12h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5ZM6 15.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z\"\u003e\u003c/path\u003e\u003c/svg\u003eTip\u003c/p\u003e\n\u003cp\u003e\nIf you receive notifications both via email and on GitHub, you can automatically sync the read or unread status of the notification so that notifications on GitHub are automatically marked as read once you've read the corresponding email notification. To enable this sync, your email client must be able to view images from \u003ccode\u003enotifications@github.com\u003c/code\u003e.\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003eIf you're using Gmail, you can click a button beside the notification email to visit the original issue or pull request that generated the notification.\u003c/p\u003e\n\u003cp\u003eChoose a default email address where you want to send updates for conversations you're participating in or watching. You can also specify which activity on GitHub you want to receive updates for using your default email address. For example, choose whether you want updates sent to your default email from:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eComments on issues and pull requests\u003c/li\u003e\n\u003cli\u003ePull request reviews\u003c/li\u003e\n\u003cli\u003ePull request pushes\u003c/li\u003e\n\u003cli\u003eYour own updates, such as when you open, comment on, or close an issue or pull request\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eDepending on the organization that owns the repository, you can also send notifications to different email addresses. Your organization may require the email address to be verified for a specific domain. For more information, see \u003ca href=\"/en/subscriptions-and-notifications/how-tos/managing-organization-notifications#choosing-where-your-organizations-email-notifications-are-sent\"\u003eManaging organization notifications\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eYou can also send notifications for a specific repository to an email address. For more information, see \u003ca href=\"/en/repositories/managing-your-repositorys-settings-and-features/managing-repository-settings/about-email-notifications-for-pushes-to-your-repository\"\u003eAbout email notifications for pushes to your repository\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eYou'll only receive notification emails if you've chosen to receive email notifications in your notification settings.\u003c/p\u003e\n\u003cp\u003eIf an organization you're a member of restricts email notifications to an approved email domain, you'll need to verify an email address in that domain to receive email notifications about activity in the organization. For more information, see \u003ca href=\"/en/organizations/keeping-your-organization-secure/managing-security-settings-for-your-organization/restricting-email-notifications-for-your-organization\"\u003eRestricting email notifications for your organization\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eEach email notification that GitHub sends contains header information that you can use to filter notifications in your email client. For information about the headers included, see \u003ca href=\"/en/subscriptions-and-notifications/reference/email-notification-headers\"\u003eEmail notification headers\u003c/a\u003e.\u003c/p\u003e\n\u003ch2 id=\"replying-to-email-notifications\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#replying-to-email-notifications\"\u003eReplying to email notifications\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eYou can reply to email notifications from GitHub and your reply will be posted to the issue, pull request, or discussion.\u003c/p\u003e\n\u003cp\u003eThe \u003ccode\u003ereply-to\u003c/code\u003e address on each email notification identifies the thread and the account that the comment will be posted from. This email address remains valid until you reset your password.\u003c/p\u003e\n\u003cp\u003eGitHub will not always include the full email contents and will attempt to strip some personally identifiable information from comments created via an email reply:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eEmail addresses in a standard format, such as \u003ccode\u003eoctocat@github.com\u003c/code\u003e, are transformed to \u003ccode\u003e***@***.***\u003c/code\u003e.\u003c/li\u003e\n\u003cli\u003eSignatures and quoted reply chains, when the email client has used a \u003ccode\u003e\u003e\u003c/code\u003e to mark those sections, are stripped.\u003c/li\u003e\n\u003cli\u003eWhile the unsubscribe link from your email notification is sometimes quoted, the link will only work when signed in to your account.\u003c/li\u003e\n\u003cli\u003eEmail attachments are not included in the resulting comment.\u003c/li\u003e\n\u003cli\u003eThe maximum length of a comment created via an email reply is 65530 characters.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 id=\"choosing-your-notification-settings\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#choosing-your-notification-settings\"\u003eChoosing your notification settings\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003col\u003e\n\u003cli\u003e\n\u003cp\u003eIn the upper-right corner of any page, click \u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon octicon-inbox\" aria-label=\"You have \" role=\"img\"\u003e\u003cpath d=\"M2.8 2.06A1.75 1.75 0 0 1 4.41 1h7.18c.7 0 1.333.417 1.61 1.06l2.74 6.395c.04.093.06.194.06.295v4.5A1.75 1.75 0 0 1 14.25 15H1.75A1.75 1.75 0 0 1 0 13.25v-4.5c0-.101.02-.202.06-.295Zm1.61.44a.25.25 0 0 0-.23.152L1.887 8H4.75a.75.75 0 0 1 .6.3L6.625 10h2.75l1.275-1.7a.75.75 0 0 1 .6-.3h2.863L11.82 2.652a.25.25 0 0 0-.23-.152Zm10.09 7h-2.875l-1.275 1.7a.75.75 0 0 1-.6.3h-3.5a.75.75 0 0 1-.6-.3L4.375 9.5H1.5v3.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Z\"\u003e\u003c/path\u003e\u003c/svg\u003e. If the icon is not displayed, go directly to the \u003ca href=\"https://github.com/notifications\"\u003enotifications page\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003e\u003cpicture\u003e\u003csource srcset=\"/assets/cb-13619/mw-1440/images/help/notifications/notifications-general-existence-indicator.webp 2x\" type=\"image/webp\"\u003e\u003cimg src=\"/assets/cb-13619/images/help/notifications/notifications-general-existence-indicator.png\" alt=\"Screenshot of the right corner of the header of GitHub. An inbox icon has a blue dot, indicating that there are unread notifications.\"\u003e\u003c/picture\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eIn the left sidebar, under the list of repositories, use the \"Manage notifications\" drop-down to click \u003cstrong\u003eNotification settings\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003e\u003cpicture\u003e\u003csource srcset=\"/assets/cb-27558/mw-1440/images/help/notifications-v2/manage-notifications-options.webp 2x\" type=\"image/webp\"\u003e\u003cimg src=\"/assets/cb-27558/images/help/notifications-v2/manage-notifications-options.png\" alt=\"Screenshot of the \u0026#x22;Notifications\u0026#x22; page. A dropdown menu, titled \u0026#x22;Manage notifications\u0026#x22;, is highlighted with an orange outline.\"\u003e\u003c/picture\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eOn the notifications settings page, choose how you receive notifications when:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThere are updates in repositories you're watching or in a conversation you're participating in. For more information, see \u003ca href=\"#about-participating-and-watching-notifications\"\u003eAbout participating and watching notifications\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003eThere are new Dependabot alerts in your repository. For more information, see \u003ca href=\"/en/subscriptions-and-notifications/how-tos/managing-security-notifications\"\u003eManaging security notifications\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003eThere are workflow runs updates on repositories set up with GitHub Actions. For more information, see \u003ca href=\"/en/subscriptions-and-notifications/how-tos/managing-github-actions-notifications\"\u003eManaging GitHub Actions notifications\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003eThere are new deploy keys added to repositories that belong to organizations that you're an owner of. For more information, see \u003ca href=\"/en/subscriptions-and-notifications/how-tos/managing-organization-notifications\"\u003eManaging organization notifications\u003c/a\u003e.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch2 id=\"configuring-your-watch-settings-for-an-individual-repository\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#configuring-your-watch-settings-for-an-individual-repository\"\u003eConfiguring your watch settings for an individual repository\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eYou can choose whether to watch or unwatch an individual repository. You can also choose to only be notified of certain event types such as issues, pull requests, releases, security alerts, or discussions (if enabled for the repository), or completely ignore an individual repository.\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e\n\u003cp\u003eOn GitHub, navigate to the main page of the repository.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eIn the upper-right corner, select the \"Watch\" drop-down menu, then click a watch option.\u003c/p\u003e\n\u003cp\u003eIf you want to further customize notifications, click \u003cstrong\u003eCustom\u003c/strong\u003e, then select specific events that you want to be notified of, such as Issues or Pull Requests, in addition to participating and @mentions.\u003c/p\u003e\n\u003cp\u003eFor example, if you select \"Issues\", you will be notified about, and subscribed to, updates on every issue (including those that existed prior to you selecting this option) in the repository. If you're @mentioned in a pull request in this repository, you'll receive notifications for that too, and you'll be subscribed to updates on that specific pull request, in addition to being notified about issues.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch2 id=\"managing-your-notification-settings-with-github-mobile\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#managing-your-notification-settings-with-github-mobile\"\u003eManaging your notification settings with GitHub Mobile\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eWhen you install GitHub Mobile, you will automatically be opted into web notifications. Within the app, you can enable push notifications for the following events.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eDirect mentions\u003c/li\u003e\n\u003cli\u003eAssignments to issues or pull requests\u003c/li\u003e\n\u003cli\u003eRequests to review a pull request\u003c/li\u003e\n\u003cli\u003eRequests to approve a deployment\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eYou can also schedule when GitHub Mobile will send push notifications to your mobile device.\u003c/p\u003e\n\u003cp\u003eGitHub Enterprise Server uses background fetch to support push notifications, so you may experience a delay in receiving push notifications.\u003c/p\u003e\n\u003ch3 id=\"managing-your-notification-settings-with-github-for-ios\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#managing-your-notification-settings-with-github-for-ios\"\u003eManaging your notification settings with GitHub for iOS\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003col\u003e\n\u003cli\u003eIn the bottom menu, tap \u003cstrong\u003eProfile\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eTo view your settings, tap \u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon octicon-gear\" aria-label=\"The Gear icon\" role=\"img\"\u003e\u003cpath d=\"M8 0a8.2 8.2 0 0 1 .701.031C9.444.095 9.99.645 10.16 1.29l.288 1.107c.018.066.079.158.212.224.231.114.454.243.668.386.123.082.233.09.299.071l1.103-.303c.644-.176 1.392.021 1.82.63.27.385.506.792.704 1.218.315.675.111 1.422-.364 1.891l-.814.806c-.049.048-.098.147-.088.294.016.257.016.515 0 .772-.01.147.038.246.088.294l.814.806c.475.469.679 1.216.364 1.891a7.977 7.977 0 0 1-.704 1.217c-.428.61-1.176.807-1.82.63l-1.102-.302c-.067-.019-.177-.011-.3.071a5.909 5.909 0 0 1-.668.386c-.133.066-.194.158-.211.224l-.29 1.106c-.168.646-.715 1.196-1.458 1.26a8.006 8.006 0 0 1-1.402 0c-.743-.064-1.289-.614-1.458-1.26l-.289-1.106c-.018-.066-.079-.158-.212-.224a5.738 5.738 0 0 1-.668-.386c-.123-.082-.233-.09-.299-.071l-1.103.303c-.644.176-1.392-.021-1.82-.63a8.12 8.12 0 0 1-.704-1.218c-.315-.675-.111-1.422.363-1.891l.815-.806c.05-.048.098-.147.088-.294a6.214 6.214 0 0 1 0-.772c.01-.147-.038-.246-.088-.294l-.815-.806C.635 6.045.431 5.298.746 4.623a7.92 7.92 0 0 1 .704-1.217c.428-.61 1.176-.807 1.82-.63l1.102.302c.067.019.177.011.3-.071.214-.143.437-.272.668-.386.133-.066.194-.158.211-.224l.29-1.106C6.009.645 6.556.095 7.299.03 7.53.01 7.764 0 8 0Zm-.571 1.525c-.036.003-.108.036-.137.146l-.289 1.105c-.147.561-.549.967-.998 1.189-.173.086-.34.183-.5.29-.417.278-.97.423-1.529.27l-1.103-.303c-.109-.03-.175.016-.195.045-.22.312-.412.644-.573.99-.014.031-.021.11.059.19l.815.806c.411.406.562.957.53 1.456a4.709 4.709 0 0 0 0 .582c.032.499-.119 1.05-.53 1.456l-.815.806c-.081.08-.073.159-.059.19.162.346.353.677.573.989.02.03.085.076.195.046l1.102-.303c.56-.153 1.113-.008 1.53.27.161.107.328.204.501.29.447.222.85.629.997 1.189l.289 1.105c.029.109.101.143.137.146a6.6 6.6 0 0 0 1.142 0c.036-.003.108-.036.137-.146l.289-1.105c.147-.561.549-.967.998-1.189.173-.086.34-.183.5-.29.417-.278.97-.423 1.529-.27l1.103.303c.109.029.175-.016.195-.045.22-.313.411-.644.573-.99.014-.031.021-.11-.059-.19l-.815-.806c-.411-.406-.562-.957-.53-1.456a4.709 4.709 0 0 0 0-.582c-.032-.499.119-1.05.53-1.456l.815-.806c.081-.08.073-.159.059-.19a6.464 6.464 0 0 0-.573-.989c-.02-.03-.085-.076-.195-.046l-1.102.303c-.56.153-1.113.008-1.53-.27a4.44 4.44 0 0 0-.501-.29c-.447-.222-.85-.629-.997-1.189l-.289-1.105c-.029-.11-.101-.143-.137-.146a6.6 6.6 0 0 0-1.142 0ZM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM9.5 8a1.5 1.5 0 1 0-3.001.001A1.5 1.5 0 0 0 9.5 8Z\"\u003e\u003c/path\u003e\u003c/svg\u003e.\u003c/li\u003e\n\u003cli\u003eTo update your notification settings, tap \u003cstrong\u003eNotifications\u003c/strong\u003e and then use the toggles to enable or disable your preferred types of push notifications.\u003c/li\u003e\n\u003cli\u003eOptionally, to schedule when GitHub Mobile will send push notifications to your mobile device, tap \u003cstrong\u003eWorking Hours\u003c/strong\u003e, use the \u003cstrong\u003eCustom working hours\u003c/strong\u003e toggle, and then choose when you would like to receive push notifications.\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch3 id=\"managing-your-notification-settings-with-github-for-android\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#managing-your-notification-settings-with-github-for-android\"\u003eManaging your notification settings with GitHub for Android\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003col\u003e\n\u003cli\u003eIn the bottom menu, tap \u003cstrong\u003eProfile\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eTo view your settings, tap \u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon octicon-gear\" aria-label=\"The Gear icon\" role=\"img\"\u003e\u003cpath d=\"M8 0a8.2 8.2 0 0 1 .701.031C9.444.095 9.99.645 10.16 1.29l.288 1.107c.018.066.079.158.212.224.231.114.454.243.668.386.123.082.233.09.299.071l1.103-.303c.644-.176 1.392.021 1.82.63.27.385.506.792.704 1.218.315.675.111 1.422-.364 1.891l-.814.806c-.049.048-.098.147-.088.294.016.257.016.515 0 .772-.01.147.038.246.088.294l.814.806c.475.469.679 1.216.364 1.891a7.977 7.977 0 0 1-.704 1.217c-.428.61-1.176.807-1.82.63l-1.102-.302c-.067-.019-.177-.011-.3.071a5.909 5.909 0 0 1-.668.386c-.133.066-.194.158-.211.224l-.29 1.106c-.168.646-.715 1.196-1.458 1.26a8.006 8.006 0 0 1-1.402 0c-.743-.064-1.289-.614-1.458-1.26l-.289-1.106c-.018-.066-.079-.158-.212-.224a5.738 5.738 0 0 1-.668-.386c-.123-.082-.233-.09-.299-.071l-1.103.303c-.644.176-1.392-.021-1.82-.63a8.12 8.12 0 0 1-.704-1.218c-.315-.675-.111-1.422.363-1.891l.815-.806c.05-.048.098-.147.088-.294a6.214 6.214 0 0 1 0-.772c.01-.147-.038-.246-.088-.294l-.815-.806C.635 6.045.431 5.298.746 4.623a7.92 7.92 0 0 1 .704-1.217c.428-.61 1.176-.807 1.82-.63l1.102.302c.067.019.177.011.3-.071.214-.143.437-.272.668-.386.133-.066.194-.158.211-.224l.29-1.106C6.009.645 6.556.095 7.299.03 7.53.01 7.764 0 8 0Zm-.571 1.525c-.036.003-.108.036-.137.146l-.289 1.105c-.147.561-.549.967-.998 1.189-.173.086-.34.183-.5.29-.417.278-.97.423-1.529.27l-1.103-.303c-.109-.03-.175.016-.195.045-.22.312-.412.644-.573.99-.014.031-.021.11.059.19l.815.806c.411.406.562.957.53 1.456a4.709 4.709 0 0 0 0 .582c.032.499-.119 1.05-.53 1.456l-.815.806c-.081.08-.073.159-.059.19.162.346.353.677.573.989.02.03.085.076.195.046l1.102-.303c.56-.153 1.113-.008 1.53.27.161.107.328.204.501.29.447.222.85.629.997 1.189l.289 1.105c.029.109.101.143.137.146a6.6 6.6 0 0 0 1.142 0c.036-.003.108-.036.137-.146l.289-1.105c.147-.561.549-.967.998-1.189.173-.086.34-.183.5-.29.417-.278.97-.423 1.529-.27l1.103.303c.109.029.175-.016.195-.045.22-.313.411-.644.573-.99.014-.031.021-.11-.059-.19l-.815-.806c-.411-.406-.562-.957-.53-1.456a4.709 4.709 0 0 0 0-.582c-.032-.499.119-1.05.53-1.456l.815-.806c.081-.08.073-.159.059-.19a6.464 6.464 0 0 0-.573-.989c-.02-.03-.085-.076-.195-.046l-1.102.303c-.56.153-1.113.008-1.53-.27a4.44 4.44 0 0 0-.501-.29c-.447-.222-.85-.629-.997-1.189l-.289-1.105c-.029-.11-.101-.143-.137-.146a6.6 6.6 0 0 0-1.142 0ZM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM9.5 8a1.5 1.5 0 1 0-3.001.001A1.5 1.5 0 0 0 9.5 8Z\"\u003e\u003c/path\u003e\u003c/svg\u003e.\u003c/li\u003e\n\u003cli\u003eTo update your notification settings, tap \u003cstrong\u003eConfigure Notifications\u003c/strong\u003e and then use the toggles to enable or disable your preferred types of push notifications.\u003c/li\u003e\n\u003cli\u003eOptionally, to schedule when GitHub Mobile will send push notifications to your mobile device, tap \u003cstrong\u003eWorking Hours\u003c/strong\u003e, use the \u003cstrong\u003eCustom working hours\u003c/strong\u003e toggle, and then choose when you would like to receive push notifications.\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch2 id=\"configuring-your-watch-settings-for-an-individual-repository-with-github-mobile\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#configuring-your-watch-settings-for-an-individual-repository-with-github-mobile\"\u003eConfiguring your watch settings for an individual repository with GitHub Mobile\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eYou can choose whether to watch or unwatch an individual repository. You can also choose to only be notified of certain event types such as issues, pull requests, discussions (if enabled for the repository) and new releases, or completely ignore an individual repository.\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eOn GitHub Mobile, navigate to the main page of the repository.\u003c/li\u003e\n\u003cli\u003eTap \u003cstrong\u003eWatch\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eTo choose what activities you receive notifications for, tap your preferred watch settings. For example, choose to only be notified when you are participating or @mentioned, or use the \"Custom\" option to select specific events that you want to be notified of.\u003c/li\u003e\n\u003c/ol\u003e","renderedPageHast":{"type":"root","children":[{"type":"element","tagName":"h2","properties":{"id":"notification-delivery-options","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#notification-delivery-options"},"children":[{"type":"text","value":"Notification delivery options"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can receive notifications for activity on GitHub in the following locations."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"The notifications inbox in the GitHub web interface"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"The notifications inbox on GitHub Mobile, which syncs with the inbox in the web interface"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"An email client that uses a verified email address, which can also sync with the notifications inbox in the web interface and GitHub Mobile"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To use the notifications inbox on GitHub and GitHub Mobile, you must enable notifications for both "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Email"}]},{"type":"text","value":" and "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"On GitHub"}]},{"type":"text","value":" in your notification settings. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"#choosing-your-notification-settings"},"children":[{"type":"text","value":"Choosing your notification settings"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-success","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M8 1.5c-2.363 0-4 1.69-4 3.75 0 .984.424 1.625.984 2.304l.214.253c.223.264.47.556.673.848.284.411.537.896.621 1.49a.75.75 0 0 1-1.484.211c-.04-.282-.163-.547-.37-.847a8.456 8.456 0 0 0-.542-.68c-.084-.1-.173-.205-.268-.32C3.201 7.75 2.5 6.766 2.5 5.25 2.5 2.31 4.863 0 8 0s5.5 2.31 5.5 5.25c0 1.516-.701 2.5-1.328 3.259-.095.115-.184.22-.268.319-.207.245-.383.453-.541.681-.208.3-.33.565-.37.847a.751.751 0 0 1-1.485-.212c.084-.593.337-1.078.621-1.489.203-.292.45-.584.673-.848.075-.088.147-.173.213-.253.561-.679.985-1.32.985-2.304 0-2.06-1.637-3.75-4-3.75ZM5.75 12h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5ZM6 15.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z"},"children":[]}]},{"type":"text","value":"Tip"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"\nIf you receive notifications both via email and on GitHub, you can automatically sync the read or unread status of the notification so that notifications on GitHub are automatically marked as read once you've read the corresponding email notification. To enable this sync, your email client must be able to view images from "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"notifications@github.com"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"benefits-of-the-notifications-inbox","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#benefits-of-the-notifications-inbox"},"children":[{"type":"text","value":"Benefits of the notifications inbox"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"The notifications inbox includes triaging options designed specifically for your GitHub notifications flow, including options to:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Triage multiple notifications at once."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Mark completed notifications as "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Done"}]},{"type":"text","value":" and remove them from your inbox. To view all of your notifications marked as "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Done"}]},{"type":"text","value":", use the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"is:done"}]},{"type":"text","value":" query."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Save a notification to review later. Saved notifications are flagged in your inbox and kept indefinitely. To view all of your saved notifications, use the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"is:saved"}]},{"type":"text","value":" query."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Unsubscribe and remove a notification from your inbox."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Preview the issue or pull request where the notification originates on GitHub from within the notifications inbox."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"See one of the latest reasons you're receiving a notification from your inbox with a "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"reasons"}]},{"type":"text","value":" label."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Create custom filters to focus on different notifications when you want."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Group notifications in your inbox by repository or date to get a quick overview with less context switching."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"In addition, you can receive and triage notifications on your mobile device with GitHub Mobile. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"#managing-your-notification-settings-with-github-mobile"},"children":[{"type":"text","value":"Managing your notification settings with GitHub Mobile"}]},{"type":"text","value":" or "},{"type":"element","tagName":"a","properties":{"href":"/en/get-started/using-github/github-mobile"},"children":[{"type":"text","value":"GitHub Mobile"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"benefits-of-using-an-email-client-for-notifications","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#benefits-of-using-an-email-client-for-notifications"},"children":[{"type":"text","value":"Benefits of using an email client for notifications"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"One benefit of using an email client is that all of your notifications can be kept indefinitely depending on your email client's storage capacity. Your inbox notifications are only kept for 3 months on GitHub unless you've marked them as "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Saved"}]},{"type":"text","value":". "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Saved"}]},{"type":"text","value":" notifications are kept indefinitely. For more information about your inbox's retention policy, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/concepts/about-notifications#notification-retention-policy"},"children":[{"type":"text","value":"About notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Sending notifications to your email client also allows you to customize your inbox according to your email client's settings, which can include custom or color-coded labels."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Email notifications also allow flexibility with the types of notifications you receive and allow you to choose different email addresses for updates. For example, you can send certain notifications for a repository to a verified personal email address. For more information, about your email customization options, see "},{"type":"element","tagName":"a","properties":{"href":"#customizing-your-email-notifications"},"children":[{"type":"text","value":"Customizing your email notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"about-participating-and-watching-notifications","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#about-participating-and-watching-notifications"},"children":[{"type":"text","value":"About participating and watching notifications"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"When you watch a repository, you're subscribing to updates for activity in that repository."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To see repositories that you're watching, go to your "},{"type":"element","tagName":"a","properties":{"href":"https://github.com/watching"},"children":[{"type":"text","value":"watching page"}]},{"type":"text","value":". For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/managing-subscriptions-for-activity-on-github"},"children":[{"type":"text","value":"Managing subscriptions for activity on GitHub"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can configure notifications for a repository on the repository page, or on your watching page."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-accent","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"},"children":[]}]},{"type":"text","value":"Note"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"\nYou can watch a maximum of 10,000 repositories."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"about-custom-notifications","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#about-custom-notifications"},"children":[{"type":"text","value":"About custom notifications"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can customize notifications for a repository. For example, you can choose to only be notified when updates to one or more types of events (issues, pull requests, releases, security alerts, or discussions) happen within a repository, or ignore all notifications for a repository. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"#configuring-your-watch-settings-for-an-individual-repository"},"children":[{"type":"text","value":"Configuring your watch settings for an individual repository"}]},{"type":"text","value":" below."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"participating-in-conversations","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#participating-in-conversations"},"children":[{"type":"text","value":"Participating in conversations"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Anytime you comment in a conversation or when someone @mentions your username, you are participating in a conversation. By default, you are automatically subscribed to a conversation when you participate in it. You can unsubscribe from a conversation you've participated in manually by clicking "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Unsubscribe"}]},{"type":"text","value":" on the issue or pull request or through the "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Unsubscribe"}]},{"type":"text","value":" option in the notifications inbox."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For conversations you're watching or participating in, you can choose whether you want to receive notifications on GitHub or by email in your notification settings. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/get-started/configuring-notifications#choosing-your-notification-settings"},"children":[{"type":"text","value":"Choosing your notification settings"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For example, on your \"Notification settings\" page:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"If you don't want notifications to be sent to your email, deselect "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"email"}]},{"type":"text","value":" for participating and watching notifications."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"If you want to receive notifications by email when you've participated in a conversation, then select "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"email"}]},{"type":"text","value":" under \"Participating\"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"If you do not enable \"Notify me: On GitHub\" for watching or participating notifications, then your notifications inbox will not have any updates."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"customizing-your-email-notifications","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#customizing-your-email-notifications"},"children":[{"type":"text","value":"Customizing your email notifications"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"After enabling email notifications, GitHub will send notifications to you as multipart emails that contain both HTML and plain text copies of the content. Email notification content includes any Markdown, @mentions, emojis, hash-links, and more, that appear in the original content on GitHub. If you only want to see the text in the email, you can configure your email client to display the plain text copy only."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-success","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M8 1.5c-2.363 0-4 1.69-4 3.75 0 .984.424 1.625.984 2.304l.214.253c.223.264.47.556.673.848.284.411.537.896.621 1.49a.75.75 0 0 1-1.484.211c-.04-.282-.163-.547-.37-.847a8.456 8.456 0 0 0-.542-.68c-.084-.1-.173-.205-.268-.32C3.201 7.75 2.5 6.766 2.5 5.25 2.5 2.31 4.863 0 8 0s5.5 2.31 5.5 5.25c0 1.516-.701 2.5-1.328 3.259-.095.115-.184.22-.268.319-.207.245-.383.453-.541.681-.208.3-.33.565-.37.847a.751.751 0 0 1-1.485-.212c.084-.593.337-1.078.621-1.489.203-.292.45-.584.673-.848.075-.088.147-.173.213-.253.561-.679.985-1.32.985-2.304 0-2.06-1.637-3.75-4-3.75ZM5.75 12h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5ZM6 15.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z"},"children":[]}]},{"type":"text","value":"Tip"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"\nIf you receive notifications both via email and on GitHub, you can automatically sync the read or unread status of the notification so that notifications on GitHub are automatically marked as read once you've read the corresponding email notification. To enable this sync, your email client must be able to view images from "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"notifications@github.com"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"If you're using Gmail, you can click a button beside the notification email to visit the original issue or pull request that generated the notification."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Choose a default email address where you want to send updates for conversations you're participating in or watching. You can also specify which activity on GitHub you want to receive updates for using your default email address. For example, choose whether you want updates sent to your default email from:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Comments on issues and pull requests"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Pull request reviews"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Pull request pushes"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Your own updates, such as when you open, comment on, or close an issue or pull request"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Depending on the organization that owns the repository, you can also send notifications to different email addresses. Your organization may require the email address to be verified for a specific domain. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/managing-organization-notifications#choosing-where-your-organizations-email-notifications-are-sent"},"children":[{"type":"text","value":"Managing organization notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can also send notifications for a specific repository to an email address. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/repositories/managing-your-repositorys-settings-and-features/managing-repository-settings/about-email-notifications-for-pushes-to-your-repository"},"children":[{"type":"text","value":"About email notifications for pushes to your repository"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You'll only receive notification emails if you've chosen to receive email notifications in your notification settings."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"If an organization you're a member of restricts email notifications to an approved email domain, you'll need to verify an email address in that domain to receive email notifications about activity in the organization. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/organizations/keeping-your-organization-secure/managing-security-settings-for-your-organization/restricting-email-notifications-for-your-organization"},"children":[{"type":"text","value":"Restricting email notifications for your organization"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Each email notification that GitHub sends contains header information that you can use to filter notifications in your email client. For information about the headers included, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/reference/email-notification-headers"},"children":[{"type":"text","value":"Email notification headers"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"replying-to-email-notifications","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#replying-to-email-notifications"},"children":[{"type":"text","value":"Replying to email notifications"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can reply to email notifications from GitHub and your reply will be posted to the issue, pull request, or discussion."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"The "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"reply-to"}]},{"type":"text","value":" address on each email notification identifies the thread and the account that the comment will be posted from. This email address remains valid until you reset your password."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"GitHub will not always include the full email contents and will attempt to strip some personally identifiable information from comments created via an email reply:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Email addresses in a standard format, such as "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"octocat@github.com"}]},{"type":"text","value":", are transformed to "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"***@***.***"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Signatures and quoted reply chains, when the email client has used a "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"\u003e"}]},{"type":"text","value":" to mark those sections, are stripped."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"While the unsubscribe link from your email notification is sometimes quoted, the link will only work when signed in to your account."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Email attachments are not included in the resulting comment."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"The maximum length of a comment created via an email reply is 65530 characters."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"choosing-your-notification-settings","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#choosing-your-notification-settings"},"children":[{"type":"text","value":"Choosing your notification settings"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"In the upper-right corner of any page, click "},{"type":"element","tagName":"svg","properties":{"version":"1.1","width":"16","height":"16","viewBox":"0 0 16 16","className":["octicon","octicon-inbox"],"ariaLabel":"You have ","role":"img"},"children":[{"type":"element","tagName":"path","properties":{"d":"M2.8 2.06A1.75 1.75 0 0 1 4.41 1h7.18c.7 0 1.333.417 1.61 1.06l2.74 6.395c.04.093.06.194.06.295v4.5A1.75 1.75 0 0 1 14.25 15H1.75A1.75 1.75 0 0 1 0 13.25v-4.5c0-.101.02-.202.06-.295Zm1.61.44a.25.25 0 0 0-.23.152L1.887 8H4.75a.75.75 0 0 1 .6.3L6.625 10h2.75l1.275-1.7a.75.75 0 0 1 .6-.3h2.863L11.82 2.652a.25.25 0 0 0-.23-.152Zm10.09 7h-2.875l-1.275 1.7a.75.75 0 0 1-.6.3h-3.5a.75.75 0 0 1-.6-.3L4.375 9.5H1.5v3.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Z"},"children":[]}]},{"type":"text","value":". If the icon is not displayed, go directly to the "},{"type":"element","tagName":"a","properties":{"href":"https://github.com/notifications"},"children":[{"type":"text","value":"notifications page"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"element","tagName":"picture","properties":{},"children":[{"type":"element","tagName":"source","properties":{"srcset":"/assets/cb-13619/mw-1440/images/help/notifications/notifications-general-existence-indicator.webp 2x","type":"image/webp"},"children":[]},{"type":"element","tagName":"img","properties":{"src":"/assets/cb-13619/images/help/notifications/notifications-general-existence-indicator.png","alt":"Screenshot of the right corner of the header of GitHub. An inbox icon has a blue dot, indicating that there are unread notifications."},"children":[]}]}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"In the left sidebar, under the list of repositories, use the \"Manage notifications\" drop-down to click "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Notification settings"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"element","tagName":"picture","properties":{},"children":[{"type":"element","tagName":"source","properties":{"srcset":"/assets/cb-27558/mw-1440/images/help/notifications-v2/manage-notifications-options.webp 2x","type":"image/webp"},"children":[]},{"type":"element","tagName":"img","properties":{"src":"/assets/cb-27558/images/help/notifications-v2/manage-notifications-options.png","alt":"Screenshot of the \"Notifications\" page. A dropdown menu, titled \"Manage notifications\", is highlighted with an orange outline."},"children":[]}]}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"On the notifications settings page, choose how you receive notifications when:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"There are updates in repositories you're watching or in a conversation you're participating in. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"#about-participating-and-watching-notifications"},"children":[{"type":"text","value":"About participating and watching notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"There are new Dependabot alerts in your repository. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/managing-security-notifications"},"children":[{"type":"text","value":"Managing security notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"There are workflow runs updates on repositories set up with GitHub Actions. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/managing-github-actions-notifications"},"children":[{"type":"text","value":"Managing GitHub Actions notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"There are new deploy keys added to repositories that belong to organizations that you're an owner of. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/managing-organization-notifications"},"children":[{"type":"text","value":"Managing organization notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"configuring-your-watch-settings-for-an-individual-repository","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#configuring-your-watch-settings-for-an-individual-repository"},"children":[{"type":"text","value":"Configuring your watch settings for an individual repository"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can choose whether to watch or unwatch an individual repository. You can also choose to only be notified of certain event types such as issues, pull requests, releases, security alerts, or discussions (if enabled for the repository), or completely ignore an individual repository."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"On GitHub, navigate to the main page of the repository."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"In the upper-right corner, select the \"Watch\" drop-down menu, then click a watch option."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"If you want to further customize notifications, click "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Custom"}]},{"type":"text","value":", then select specific events that you want to be notified of, such as Issues or Pull Requests, in addition to participating and @mentions."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For example, if you select \"Issues\", you will be notified about, and subscribed to, updates on every issue (including those that existed prior to you selecting this option) in the repository. If you're @mentioned in a pull request in this repository, you'll receive notifications for that too, and you'll be subscribed to updates on that specific pull request, in addition to being notified about issues."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"managing-your-notification-settings-with-github-mobile","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#managing-your-notification-settings-with-github-mobile"},"children":[{"type":"text","value":"Managing your notification settings with GitHub Mobile"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"When you install GitHub Mobile, you will automatically be opted into web notifications. Within the app, you can enable push notifications for the following events."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Direct mentions"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Assignments to issues or pull requests"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Requests to review a pull request"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Requests to approve a deployment"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can also schedule when GitHub Mobile will send push notifications to your mobile device."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"GitHub Enterprise Server uses background fetch to support push notifications, so you may experience a delay in receiving push notifications."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"managing-your-notification-settings-with-github-for-ios","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#managing-your-notification-settings-with-github-for-ios"},"children":[{"type":"text","value":"Managing your notification settings with GitHub for iOS"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"In the bottom menu, tap "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Profile"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"To view your settings, tap "},{"type":"element","tagName":"svg","properties":{"version":"1.1","width":"16","height":"16","viewBox":"0 0 16 16","className":["octicon","octicon-gear"],"ariaLabel":"The Gear icon","role":"img"},"children":[{"type":"element","tagName":"path","properties":{"d":"M8 0a8.2 8.2 0 0 1 .701.031C9.444.095 9.99.645 10.16 1.29l.288 1.107c.018.066.079.158.212.224.231.114.454.243.668.386.123.082.233.09.299.071l1.103-.303c.644-.176 1.392.021 1.82.63.27.385.506.792.704 1.218.315.675.111 1.422-.364 1.891l-.814.806c-.049.048-.098.147-.088.294.016.257.016.515 0 .772-.01.147.038.246.088.294l.814.806c.475.469.679 1.216.364 1.891a7.977 7.977 0 0 1-.704 1.217c-.428.61-1.176.807-1.82.63l-1.102-.302c-.067-.019-.177-.011-.3.071a5.909 5.909 0 0 1-.668.386c-.133.066-.194.158-.211.224l-.29 1.106c-.168.646-.715 1.196-1.458 