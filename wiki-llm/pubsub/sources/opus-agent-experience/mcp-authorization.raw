xs(_components.p,{children:[`MCP clients `,_jsx(_components.strong,{children:`MUST NOT`}),` send tokens to the MCP server other than ones issued by the MCP server’s authorization server.`]}),`\n`,_jsxs(_components.p,{children:[`MCP servers `,_jsx(_components.strong,{children:`MUST`}),` only accept tokens that are valid for use with their\nown resources.`]}),`\n`,_jsxs(_components.p,{children:[`MCP servers `,_jsx(_components.strong,{children:`MUST NOT`}),` accept or transit any other tokens.`]}),`\n`,_jsx(Heading,{level:`2`,id:`refresh-tokens`,children:`Refresh Tokens`}),`\n`,_jsx(_components.p,{children:`This section provides guidance for MCP Clients and MCP Servers when handling or issuing\nrefresh tokens for both OAuth and OpenID Connect.`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`MCP Clients`}),` that desire refresh tokens:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`MUST`}),` keep refresh tokens confidential in transit and storage as specified in `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-14#section-4.3`,children:`OAuth 2.1 Section 4.3`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`SHOULD`}),` include `,_jsx(_components.code,{children:`refresh_token`}),` in their `,_jsx(_components.code,{children:`grant_types`}),` client metadata`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`MAY`}),` add `,_jsx(_components.code,{children:`offline_access`}),` to the `,_jsx(_components.code,{children:`scope`}),` parameter of the authorization and token requests when the Authorization Server metadata contains it in `,_jsx(_components.code,{children:`scopes_supported`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`MUST NOT`}),` assume refresh tokens will be issued; the AS retains discretion`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`MCP Servers`}),` (Protected Resources) `,_jsx(_components.strong,{children:`SHOULD NOT`}),` include `,_jsx(_components.code,{children:`offline_access`}),` in\n`,_jsx(_components.code,{children:`WWW-Authenticate`}),` scope or Protected Resource Metadata `,_jsx(_components.code,{children:`scopes_supported`}),`, as refresh\ntokens are not a resource requirement.`]}),`\n`,_jsx(Heading,{level:`2`,id:`error-handling`,children:`Error Handling`}),`\n`,_jsxs(_components.p,{children:[`Servers `,_jsx(_components.strong,{children:`MUST`}),` return appropriate HTTP status codes for authorization errors:`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Status Code`}),_jsx(_components.th,{children:`Description`}),_jsx(_components.th,{children:`Usage`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{\"data-numeric\":`true`,children:`401`}),_jsx(_components.td,{children:`Unauthorized`}),_jsx(_components.td,{children:`Authorization required or token invalid`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{\"data-numeric\":`true`,children:`403`}),_jsx(_components.td,{children:`Forbidden`}),_jsx(_components.td,{children:`Invalid scopes or insufficient permissions`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{\"data-numeric\":`true`,children:`400`}),_jsx(_components.td,{children:`Bad Request`}),_jsx(_components.td,{children:`Malformed authorization request`})]})]})]}),`\n`,_jsx(Heading,{level:`3`,id:`scope-challenge-handling`,children:`Scope Challenge Handling`}),`\n`,_jsxs(_components.p,{children:[`This section covers handling insufficient scope errors during runtime operations when\na client already has a token but needs additional permissions. This follows the error\nhandling patterns defined in `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13#section-5`,children:`OAuth 2.1 Section 5`}),`\nand leverages the metadata fields from `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9728`,children:`RFC 9728 (OAuth 2.0 Protected Resource Metadata)`}),`.`]}),`\n`,_jsx(Heading,{level:`4`,id:`runtime-insufficient-scope-errors`,children:`Runtime Insufficient Scope Errors`}),`\n`,_jsxs(_components.p,{children:[`When a client makes a request with an access token with insufficient\nscope during runtime operations, the server `,_jsx(_components.strong,{children:`SHOULD`}),` respond with:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`HTTP 403 Forbidden`}),` status code (per `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc6750#section-3.1`,children:`RFC 6750 Section 3.1`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`WWW-Authenticate`}),` header with the `,_jsx(_components.code,{children:`Bearer`}),` scheme and additional parameters:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`error=\"insufficient_scope\"`}),` - indicating the specific type of authorization failure`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`scope=\"required_scope1 required_scope2\"`}),` - specifying the minimum scopes needed for the operation`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`resource_metadata`}),` - the URI of the Protected Resource Metadata document (for consistency with 401 responses)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`error_description`}),` (optional) - human-readable description of the error`]}),`\n`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Server Scope Management`}),`: When responding with insufficient scope errors, servers\n`,_jsx(_components.strong,{children:`SHOULD`}),` include the scopes needed to satisfy the current operation in the `,_jsx(_components.code,{children:`scope`}),`\nparameter, consistent with\n`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc6750#section-3.1`,children:`RFC 6750 Section 3.1`}),`.\nThe `,_jsx(_components.code,{children:`scope`}),` attribute describes the scopes necessary to access\nthe requested resource — servers are not required to include\nthe client’s previously granted scopes.`]}),`\n`,_jsxs(_components.p,{children:[`Whatever scope-inclusion strategy a server adopts, servers `,_jsx(_components.strong,{children:`SHOULD`}),` include all\nscopes required for the current operation in a single challenge.\nChallenging incrementally (returning one missing scope, then another\non the subsequent retry) forces multiple authorization round-trips\nfor a single operation and degrades user experience. The required\nscopes may be determined dynamically based on the specific request\narguments and context, but once determined, they should be emitted\ntogether.`]}),`\n`,_jsxs(_components.p,{children:[`Servers `,_jsx(_components.strong,{children:`SHOULD`}),` be consistent in their scope inclusion strategy to provide predictable behavior for clients.`]}),`\n`,_jsxs(_components.p,{children:[`Servers `,_jsx(_components.strong,{children:`SHOULD`}),` consider the user experience impact when determining which scopes to include in the\nresponse, as misconfigured scopes may require frequent user interaction.`]}),`\n`,_jsxs(_components.p,{children:[`Scope accumulation across operations is a client-side responsibility. See the\n`,_jsx(_components.a,{href:`#step-up-authorization-flow`,children:`Step-Up Authorization Flow`}),` for the scope-union requirement.`]}),`\n`,_jsx(_components.p,{children:`Example insufficient scope response:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`5`,language:`http`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`http`,children:_jsxs(_components.code,{language:`http`,numberOfLines:`5`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`HTTP`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`/`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`1.1`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:` 403`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` Forbidden`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`WWW-Authenticate`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` Bearer error=\"insufficient_scope\",`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`                         scope=\"files:write\",`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`                         resource_metadata=\"https://mcp.example.com/.well-known/oauth-protected-resource\",`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`                         error_description=\"File write permission required for this operation\"`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`4`,id:`step-up-authorization-flow`,children:`Step-Up Authorization Flow`}),`\n`,_jsxs(_components.p,{children:[`Clients will receive scope-related errors during initial authorization or at runtime (`,_jsx(_components.code,{children:`insufficient_scope`}),`).\nClients `,_jsx(_components.strong,{children:`SHOULD`}),` respond to these errors by requesting a new access token with an increased set of scopes via a step-up authorization flow or handle the errors in other, appropriate ways.\nClients acting on behalf of a user `,_jsx(_components.strong,{children:`SHOULD`}),` attempt the step-up authorization flow. Clients acting on their own behalf (`,_jsx(_components.code,{children:`client_credentials`}),` clients)\n`,_jsx(_components.strong,{children:`MAY`}),` attempt the step-up authorization flow or abort the request immediately.`]}),`\n`,_jsx(_components.p,{children:`The flow is as follows:`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Parse error information`}),` from the authorization server response or `,_jsx(_components.code,{children:`WWW-Authenticate`}),` header`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Determine required scopes`}),` by computing the union of the\nclient’s previously requested scope set and the scopes from\nthe current challenge. This ensures previously granted\npermissions are preserved when servers emit per-operation\nscope challenges per\n`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc6750#section-3.1`,children:`RFC 6750 Section 3.1`}),`.\nClients `,_jsx(_components.strong,{children:`MAY`}),` also consult the\n`,_jsx(_components.a,{href:`#scope-selection-strategy`,children:`Scope Selection Strategy`}),` for\ninitial scope selection guidance.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Initiate (re-)authorization`}),` with the determined scope set`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Retry the original request`}),` with the new authorization no more than a few times and treat this as a permanent authorization failure`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Clients `,_jsx(_components.strong,{children:`SHOULD`}),` implement retry limits and `,_jsx(_components.strong,{children:`SHOULD`}),` track scope upgrade attempts to avoid\nrepeated failures for the same resource and operation combination.`]}),`\n`,_jsxs(_components.p,{children:[`Servers `,_jsx(_components.strong,{children:`MUST`}),` account for scope hierarchies, where a broader scope implies narrower ones, when\ndeciding whether a token is sufficient for an operation.`]}),`\n`,_jsx(Heading,{level:`2`,id:`security-considerations`,children:`Security Considerations`}),`\n`,_jsxs(_components.p,{children:[`Implementations of this specification `,_jsx(_components.strong,{children:`MUST`}),` follow the normative security\nrequirements in `,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/security-considerations`,children:`Security Considerations`}),`,\ncovering token audience binding and validation, token theft, communication security,\nauthorization code protection, mix-up and confused deputy attacks, open redirection,\nand Client ID Metadata Document security.`]}),`\n`,_jsx(Heading,{level:`2`,id:`mcp-authorization-extensions`,children:`MCP Authorization Extensions`}),`\n`,_jsx(_components.p,{children:`There are several authorization extensions to the core protocol that define additional authorization mechanisms. These extensions are:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Optional`}),` - Implementations can choose to adopt these extensions`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Additive`}),` - Extensions do not modify or break core protocol functionality; they add new capabilities while preserving core protocol behavior`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Composable`}),` - Extensions are modular and designed to work together without conflicts, allowing implementations to adopt multiple extensions simultaneously`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Versioned independently`}),` - Extensions follow the core MCP versioning cycle but may adopt independent versioning as needed`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`A list of supported extensions can be found in the `,_jsx(_components.a,{href:`https://github.com/modelcontextprotocol/ext-auth`,children:`MCP Authorization Extensions`}),` repository.`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"59:Tb157,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,blockquote:`blockquote`,code:`code`,em:`em`,li:`li`,ol:`ol`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,..._provideComponents(),...props.components},{CodeBlock,Heading,Mermaid,Table}=_components;if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!Mermaid)_missingMdxReference(`Mermaid`,true);if(!Table)_missingMdxReference(`Table`,true);return _jsxs(_Fragment,{children:[_jsx(`div`,{id:`enable-section-numbers`}),`\n`,_jsx(Heading,{level:`2`,id:`introduction`,children:`Introduction`}),`\n`,_jsx(Heading,{level:`3`,id:`purpose-and-scope`,children:`Purpose and Scope`}),`\n`,_jsx(_components.p,{children:`The Model Context Protocol provides authorization capabilities at the transport level,\nenabling MCP clients to make requests to restricted MCP servers on behalf of resource\nowners. This specification defines the authorization flow for HTTP-based transports.`}),`\n`,_jsx(Heading,{level:`3`,id:`protocol-requirements`,children:`Protocol Requirements`}),`\n`,_jsxs(_components.p,{children:[`Authorization is `,_jsx(_components.strong,{children:`OPTIONAL`}),` for MCP implementations. When supported:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Implementations using an HTTP-based transport `,_jsx(_components.strong,{children:`SHOULD`}),` conform to this specification.`]}),`\n`,_jsxs(_components.li,{children:[`Implementations using an STDIO transport `,_jsx(_components.strong,{children:`SHOULD NOT`}),` follow this specification, and\ninstead retrieve credentials from the environment.`]}),`\n`,_jsxs(_components.li,{children:[`Implementations using alternative transports `,_jsx(_components.strong,{children:`MUST`}),` follow established security best\npractices for their protocol.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`standards-compliance`,children:`Standards Compliance`}),`\n`,_jsx(_components.p,{children:`This authorization mechanism is based on established specifications listed below, but\nimplements a selected subset of their features to ensure security and interoperability\nwhile maintaining simplicity:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`OAuth 2.1 IETF DRAFT (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13`,children:`draft-ietf-oauth-v2-1-13`}),`)`]}),`\n`,_jsxs(_components.li,{children:[`OAuth 2.0 Bearer Token Usage\n(`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc6750`,children:`RFC6750`}),`)`]}),`\n`,_jsxs(_components.li,{children:[`OAuth 2.0 Authorization Server Metadata\n(`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc8414`,children:`RFC8414`}),`)`]}),`\n`,_jsxs(_components.li,{children:[`OAuth 2.0 Dynamic Client Registration Protocol\n(`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc7591`,children:`RFC7591`}),`)`]}),`\n`,_jsxs(_components.li,{children:[`Resource Indicators for OAuth 2.0\n(`,_jsx(_components.a,{href:`https://www.rfc-editor.org/rfc/rfc8707.html`,children:`RFC8707`}),`)`]}),`\n`,_jsxs(_components.li,{children:[`OAuth 2.0 Protected Resource Metadata (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9728`,children:`RFC9728`}),`)`]}),`\n`,_jsxs(_components.li,{children:[`OAuth 2.0 Authorization Server Issuer Identification (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9207`,children:`RFC9207`}),`)`]}),`\n`,_jsxs(_components.li,{children:[`OAuth Client ID Metadata Documents (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00`,children:`draft-ietf-oauth-client-id-metadata-document-00`}),`)`]}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://openid.net/specs/openid-connect-discovery-1_0.html`,children:`OpenID Connect Discovery 1.0`})}),`\n`,_jsxs(_components.li,{children:[`OpenID Connect Dynamic Client Registration 1.0 (`,_jsx(_components.a,{href:`https://openid.net/specs/openid-connect-registration-1_0.html`,children:`OpenID Connect Registration`}),`)`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`roles`,children:`Roles`}),`\n`,_jsxs(_components.p,{children:[`A protected `,_jsx(_components.em,{children:`MCP server`}),` acts as an `,_jsx(_components.a,{href:`https://www.ietf.org/archive/id/draft-ietf-oauth-v2-1-13.html#name-roles`,children:`OAuth 2.1 resource server`}),`,\ncapable of accepting and responding to protected resource requests using access tokens.`]}),`\n`,_jsxs(_components.p,{children:[`An `,_jsx(_components.em,{children:`MCP client`}),` acts as an `,_jsx(_components.a,{href:`https://www.ietf.org/archive/id/draft-ietf-oauth-v2-1-13.html#name-roles`,children:`OAuth 2.1 client`}),`,\nmaking protected resource requests on behalf of a resource owner.`]}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.em,{children:`authorization server`}),` is responsible for interacting with the user (if necessary) and issuing access tokens for use at the MCP server.\nThe implementation details of the authorization server are beyond the scope of this specification. It may be hosted with the\nresource server or a separate entity. `,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/authorization-server-discovery`,children:`Authorization Server Discovery`}),`\nspecifies how an MCP server indicates the location of its corresponding authorization server to a client.`]}),`\n`,_jsx(Heading,{level:`2`,id:`overview`,children:`Overview`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`Authorization servers `,_jsx(_components.strong,{children:`MUST`}),` implement OAuth 2.1 with appropriate security\nmeasures for both confidential and public clients.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`Authorization servers and MCP clients `,_jsx(_components.strong,{children:`SHOULD`}),` support `,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/client-registration#client-id-metadata-documents`,children:`OAuth Client ID Metadata Documents`}),`\n(`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00`,children:`draft-ietf-oauth-client-id-metadata-document-00`}),`).`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`Authorization servers and MCP clients `,_jsx(_components.strong,{children:`MAY`}),` support the OAuth 2.0 Dynamic Client Registration\nProtocol (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc7591`,children:`RFC7591`}),`). Note that\n`,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/client-registration#dynamic-client-registration`,children:`Dynamic Client Registration`}),`\nis deprecated and retained for backwards compatibility with authorization servers that do not support Client ID Metadata Documents.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`MCP servers `,_jsx(_components.strong,{children:`MUST`}),` implement OAuth 2.0 Protected Resource Metadata (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9728`,children:`RFC9728`}),`).\nMCP clients `,_jsx(_components.strong,{children:`MUST`}),` use OAuth 2.0 Protected Resource Metadata for `,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/authorization-server-discovery`,children:`authorization server discovery`}),`.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`MCP authorization servers `,_jsx(_components.strong,{children:`MUST`}),` provide at least one of the following discovery mechanisms:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`OAuth 2.0 Authorization Server Metadata (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc8414`,children:`RFC8414`}),`)`]}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://openid.net/specs/openid-connect-discovery-1_0.html`,children:`OpenID Connect Discovery 1.0`})}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`MCP clients `,_jsx(_components.strong,{children:`MUST`}),` support both `,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/authorization-server-discovery#authorization-server-metadata-discovery`,children:`discovery mechanisms`}),` to obtain the information required to interact with the authorization server.`]}),`\n`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`authorization-server-discovery`,children:`Authorization Server Discovery`}),`\n`,_jsxs(_components.p,{children:[`MCP servers advertise their associated authorization servers through OAuth 2.0 Protected\nResource Metadata, and MCP clients determine authorization server endpoints and supported\ncapabilities through authorization server metadata discovery. Implementations `,_jsx(_components.strong,{children:`MUST`}),`\nfollow the normative discovery requirements defined in\n`,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/authorization-server-discovery`,children:`Authorization Server Discovery`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`client-registration`,children:`Client Registration`}),`\n`,_jsxs(_components.p,{children:[`Before initiating the authorization flow, MCP clients `,_jsx(_components.strong,{children:`MUST`}),` obtain a client ID through\none of three registration mechanisms: Client ID Metadata Documents, pre-registration, or\nDynamic Client Registration, following the requirements and selection priority defined in\n`,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/client-registration`,children:`Client Registration`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`scope-selection-strategy`,children:`Scope Selection Strategy`}),`\n`,_jsxs(_components.p,{children:[`MCP servers `,_jsx(_components.strong,{children:`SHOULD`}),` include a `,_jsx(_components.code,{children:`scope`}),` parameter in the `,_jsx(_components.code,{children:`WWW-Authenticate`}),` header as defined in\n`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc6750#section-3`,children:`RFC 6750 Section 3`}),`\nto indicate the scopes required for accessing the resource. This provides clients with immediate\nguidance on the appropriate scopes to request during authorization,\nfollowing the principle of least privilege and preventing clients from requesting excessive permissions.`]}),`\n`,_jsxs(_components.p,{children:[`The scopes included in the `,_jsx(_components.code,{children:`WWW-Authenticate`}),` challenge `,_jsx(_components.strong,{children:`MAY`}),` match `,_jsx(_components.code,{children:`scopes_supported`}),`, be a subset\nor superset of it, or an alternative collection that is neither a strict subset nor\nsuperset. Clients `,_jsx(_components.strong,{children:`MUST NOT`}),` assume any particular set relationship between the challenged\nscope set and `,_jsx(_components.code,{children:`scopes_supported`}),`. Clients `,_jsx(_components.strong,{children:`MUST`}),` treat the scopes provided in the\nchallenge as authoritative for the current operation. These scopes are required to\nsatisfy the current request. When re-authorizing, clients `,_jsx(_components.strong,{children:`SHOULD`}),` include these scopes\nalongside any previously granted scopes to avoid losing permissions needed for other operations\n(see `,_jsx(_components.a,{href:`#step-up-authorization-flow`,children:`Step-Up Authorization Flow`}),`). Servers `,_jsx(_components.strong,{children:`SHOULD`}),` strive for\nconsistency in how they construct scope sets but they are not required to surface every dynamically\nissued scope through `,_jsx(_components.code,{children:`scopes_supported`}),`.`]}),`\n`,_jsx(_components.p,{children:`Example 401 response with scope guidance:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`3`,language:`http`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`http`,children:_jsxs(_components.code,{language:`http`,numberOfLines:`3`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`HTTP`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`/`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`1.1`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:` 401`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` Unauthorized`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`WWW-Authenticate`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` Bearer resource_metadata=\"https://mcp.example.com/.well-known/oauth-protected-resource\",`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`                         scope=\"files:read\"`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`When implementing authorization flows, MCP clients `,_jsx(_components.strong,{children:`SHOULD`}),` follow the principle of least privilege by requesting\nonly the scopes necessary for their intended operations. During the initial authorization handshake, MCP clients\n`,_jsx(_components.strong,{children:`SHOULD`}),` follow this priority order for scope selection:`]}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[_jsxs(_components.strong,{children:[`Use `,_jsx(_components.code,{children:`scope`}),` parameter`]}),` from the initial `,_jsx(_components.code,{children:`WWW-Authenticate`}),` header in the 401 response, if provided`]}),`\n`,_jsxs(_components.li,{children:[_jsxs(_components.strong,{children:[`If `,_jsx(_components.code,{children:`scope`}),` is not available`]}),`, use all scopes defined in `,_jsx(_components.code,{children:`scopes_supported`}),` from the Protected Resource Metadata document, omitting the `,_jsx(_components.code,{children:`scope`}),` parameter if `,_jsx(_components.code,{children:`scopes_supported`}),` is undefined.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`scopes_supported`}),` field is intended to represent the minimal set of scopes necessary\nfor basic functionality (see `,_jsx(_components.a,{href:`/docs/2026-07-28/tutorials/security/security_best_practices#scope-minimization`,children:`Scope Minimization`}),`),\nwith additional scopes requested incrementally through the step-up authorization flow steps\ndescribed in the `,_jsx(_components.a,{href:`#scope-challenge-handling`,children:`Scope Challenge Handling`}),` section.`]}),`\n`,_jsx(Heading,{level:`2`,id:`authorization-flow-steps`,children:`Authorization Flow Steps`}),`\n`,_jsxs(_components.p,{children:[`The registration step shown in the flow uses one of the mechanisms defined in\n`,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/client-registration`,children:`Client Registration`}),`.`]}),`\n`,_jsx(_components.p,{children:`The complete Authorization flow proceeds as follows:`}),`\n`,_jsx(Mermaid,{}),`\n`,_jsx(Heading,{level:`3`,id:`authorization-response-validation`,children:`Authorization Response Validation`}),`\n`,_jsxs(_components.p,{children:[`Before redirecting the user-agent, the client `,_jsx(_components.strong,{children:`MUST`}),` record the `,_jsx(_components.code,{children:`issuer`}),` value from the selected authorization server’s validated metadata document (see `,_jsx(_components.a,{href:`/specification/2026-07-28/basic/authorization/authorization-server-discovery#authorization-server-metadata-discovery`,children:`Authorization Server Metadata Discovery`}),`) and associate it with the same per-request record used to store the PKCE code verifier (and the `,_jsx(_components.code,{children:`state`}),` value, if used). The validation in this section depends on that recorded value being authentic; it provides no protection if the expected issuer was obtained from an unvalidated source.`]}),`\n`,_jsxs(_components.p,{children:[`MCP authorization servers `,_jsx(_components.strong,{children:`SHOULD`}),` include the `,_jsx(_components.code,{children:`iss`}),` parameter in authorization responses, including error responses, as defined in `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9207#section-2`,children:`RFC9207 Section 2`}),`. Authorization servers that include the `,_jsx(_components.code,{children:`iss`}),` parameter `,_jsx(_components.strong,{children:`MUST`}),` advertise this by setting `,_jsx(_components.code,{children:`authorization_response_iss_parameter_supported`}),` to `,_jsx(_components.code,{children:`true`}),` in their metadata (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9207#section-2.3`,children:`RFC9207 Section 2.3`}),`).`]}),`\n`,_jsxs(_components.p,{children:[`On receiving the authorization response, MCP clients `,_jsx(_components.strong,{children:`MUST`}),` apply the validation in `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9207#section-2.4`,children:`RFC9207 Section 2.4`}),` before transmitting the authorization code to any token endpoint:`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:_jsx(_components.code,{children:`authorization_response_iss_parameter_supported`})}),_jsxs(_components.th,{children:[_jsx(_components.code,{children:`iss`}),` in response`]}),_jsx(_components.th,{children:`Client action`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`true`})}),_jsx(_components.td,{children:`present`}),_jsxs(_components.td,{children:[`Compare to the recorded issuer using simple string comparison (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc3986#section-6.2.1`,children:`RFC3986 Section 6.2.1`}),`)`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`true`})}),_jsx(_components.td,{children:`absent`}),_jsx(_components.td,{children:`Reject the response`})]}),_jsxs(_components.tr,{children:[_jsxs(_components.td,{children:[_jsx(_components.code,{children:`false`}),` or absent`]}),_jsx(_components.td,{children:`present`}),_jsxs(_components.td,{children:[`Compare to the recorded issuer using simple string comparison (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc3986#section-6.2.1`,children:`RFC3986 Section 6.2.1`}),`)`]})]}),_jsxs(_components.tr,{children:[_jsxs(_components.td,{children:[_jsx(_components.code,{children:`false`}),` or absent`]}),_jsx(_components.td,{children:`absent`}),_jsx(_components.td,{children:`Proceed`})]})]})]}),`\n`,_jsxs(_components.p,{children:[`The third row applies the local-policy provision in `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9207#section-2.4`,children:`RFC9207 Section 2.4`}),`: this specification compares a present `,_jsx(_components.code,{children:`iss`}),` against the recorded issuer regardless of metadata advertisement, to accommodate authorization servers that emit `,_jsx(_components.code,{children:`iss`}),` before updating their metadata.`]}),`\n`,_jsxs(_components.p,{children:[`A future revision of this specification is expected to upgrade authorization server inclusion of `,_jsx(_components.code,{children:`iss`}),` from `,_jsx(_components.strong,{children:`SHOULD`}),` to `,_jsx(_components.strong,{children:`MUST`}),`. Implementers are encouraged to emit and validate `,_jsx(_components.code,{children:`iss`}),` now to ease that transition; client rejection behavior on `,_jsx(_components.code,{children:`iss`}),` absence will continue to be keyed on `,_jsx(_components.code,{children:`authorization_response_iss_parameter_supported`}),` until that revision defines the upgrade path.`]}),`\n`,_jsxs(_components.p,{children:[`After decoding the `,_jsx(_components.code,{children:`iss`}),` value from the `,_jsx(_components.code,{children:`application/x-www-form-urlencoded`}),` response per `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9207#section-2.4`,children:`RFC 9207 Section 2.4`}),`, clients `,_jsx(_components.strong,{children:`MUST NOT`}),` apply scheme or host case folding, default-port elision, trailing-slash, or percent-encoding normalization (`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc3986#section-6.2.2`,children:`RFC 3986 Sections 6.2.2-6.2.3`}),`) before comparison.`]}),`\n`,_jsxs(_components.p,{children:[`This validation applies equally to error responses - on mismatch the client `,_jsx(_components.strong,{children:`MUST NOT`}),` act on or display `,_jsx(_components.code,{children:`error`}),`, `,_jsx(_components.code,{children:`error_description`}),`, or `,_jsx(_components.code,{children:`error_uri`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`resource-parameter-implementation`,children:`Resource Parameter Implementation`}),`\n`,_jsxs(_components.p,{children:[`MCP clients `,_jsx(_components.strong,{children:`MUST`}),` implement Resource Indicators for OAuth 2.0 as defined in `,_jsx(_components.a,{href:`https://www.rfc-editor.org/rfc/rfc8707.html`,children:`RFC 8707`}),`\nto explicitly specify the target resource for which the token is being requested. The `,_jsx(_components.code,{children:`resource`}),` parameter:`]}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`MUST`}),` be included in both authorization requests and token requests.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`MUST`}),` identify the MCP server that the client intends to use the token with.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`MUST`}),` use the canonical URI of the MCP server as defined in `,_jsx(_components.a,{href:`https://www.rfc-editor.org/rfc/rfc8707.html#name-access-token-request`,children:`RFC 8707 Section 2`}),`.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`canonical-server-uri`,children:`Canonical Server URI`}),`\n`,_jsxs(_components.p,{children:[`For the purposes of this specification, the canonical URI of an MCP server is defined as the resource identifier as specified in\n`,_jsx(_components.a,{href:`https://www.rfc-editor.org/rfc/rfc8707.html#section-2`,children:`RFC 8707 Section 2`}),` and aligns with the `,_jsx(_components.code,{children:`resource`}),` parameter in\n`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc9728`,children:`RFC 9728`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`MCP clients `,_jsx(_components.strong,{children:`SHOULD`}),` provide the most specific URI that they can for the MCP server they intend to access, following the guidance in `,_jsx(_components.a,{href:`https://www.rfc-editor.org/rfc/rfc8707`,children:`RFC 8707`}),`. While the canonical form uses lowercase scheme and host components, implementations `,_jsx(_components.strong,{children:`SHOULD`}),` accept uppercase scheme and host components for robustness and interoperability.`]}),`\n`,_jsx(_components.p,{children:`Examples of valid canonical URIs:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:_jsx(_components.code,{children:`https://mcp.example.com/mcp`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.code,{children:`https://mcp.example.com`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.code,{children:`https://mcp.example.com:8443`})}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`https://mcp.example.com/server/mcp`}),` (when path component is necessary to identify individual MCP server)`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`Examples of invalid canonical URIs:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`mcp.example.com`}),` (missing scheme)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`https://mcp.example.com#fragment`}),` (contains fragment)`]}),`\n`]}),`\n`,_jsxs(_components.blockquote,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Note:`}),` While both `,_jsx(_components.code,{children:`https://mcp.example.com/`}),` (with trailing slash) and `,_jsx(_components.code,{children:`https://mcp.example.com`}),` (without trailing slash) are technically valid absolute URIs according to `,_jsx(_components.a,{href:`https://www.rfc-editor.org/rfc/rfc3986`,children:`RFC 3986`}),`, implementations `,_jsx(_components.strong,{children:`SHOULD`}),` consistently use the form without the trailing slash for better interoperability unless the trailing slash is semantically significant for the specific resource.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`For example, if accessing an MCP server at `,_jsx(_components.code,{children:`https://mcp.example.com`}),`, the authorization request would include:`]}),`\n`,_jsx(CodeBlock,{numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`\u0026resource=https%3A%2F%2Fmcp.example.com`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.p,{children:[`MCP clients `,_jsx(_components.strong,{children:`MUST`}),` send this parameter regardless of whether authorization servers support it.`]}),`\n`,_jsx(Heading,{level:`2`,id:`access-token-usage`,children:`Access Token Usage`}),`\n`,_jsx(Heading,{level:`3`,id:`token-requirements`,children:`Token Requirements`}),`\n`,_jsxs(_components.p,{children:[`Access token handling when making requests to MCP servers `,_jsx(_components.strong,{children:`MUST`}),` conform to the requirements defined in\n`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13#section-5`,children:`OAuth 2.1 Section 5 “Resource Requests”`}),`.\nSpecifically:`]}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`MCP client `,_jsx(_components.stro