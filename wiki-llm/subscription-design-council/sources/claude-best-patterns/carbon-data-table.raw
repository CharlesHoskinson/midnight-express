th\":288,\"height\":315,\"mimeType\":\"image/png\",\"filesize\":17669,\"filename\":\"data-table-usage-size-pairings-batchactionbar-288x315.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/data-table-usage-size-pairings-batchactionbar-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":28828,\"filename\":\"data-table-usage-size-pairings-batchactionbar-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/data-table-usage-size-pairings-batchactionbar-288x315.png\",\"width\":288,\"height\":315,\"mimeType\":\"image/png\",\"filesize\":17669,\"filename\":\"data-table-usage-size-pairings-batchactionbar-288x315.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/data-table-usage-size-pairings-batchactionbar-608x666.png\",\"width\":608,\"height\":666,\"mimeType\":\"image/png\",\"filesize\":45683,\"filename\":\"data-table-usage-size-pairings-batchactionbar-608x666.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/data-table-usage-size-pairings-batchactionbar-928x1016.png\",\"width\":928,\"height\":1016,\"mimeType\":\"image/png\",\"filesize\":80014,\"filename\":\"data-table-usage-size-pairings-batchactionbar-928x1016.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/data-table-usage-size-pairings-batchactionbar-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":57045,\"filename\":\"data-table-usage-size-pairings-batchactionbar-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/data-table-usage-size-pairings-batchactionbar-288x315.png\",\"id\":\"6a704902ee842528a1f9a2af\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"6a7048d3575b72003c60ff9a\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"6a7048d231bc080db4c98b92\"}],\"id\":\"6a7048ba31bc080db4c98b91\"},{\"isPrivate\":false,\"heading\":\"Pagination height\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The pagination height should always match the row height of the data table to maintain visual alignment and consistency. The only exception is when using the extra large data table, use the large pagination height.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-02T17:35:19.354Z\",\"updatedAt\":\"2026-07-27T12:08:40.348Z\",\"alt\":\"Size pairings of the pagination and data table components\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/pagination-usage-size-pairings-1.png\",\"filename\":\"pagination-usage-size-pairings-1.png\",\"mimeType\":\"image/png\",\"filesize\":112165,\"width\":1856,\"height\":2016,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/pagination-usage-size-pairings-1-288x313.png\",\"width\":288,\"height\":313,\"mimeType\":\"image/png\",\"filesize\":18618,\"filename\":\"pagination-usage-size-pairings-1-288x313.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/pagination-usage-size-pairings-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":30737,\"filename\":\"pagination-usage-size-pairings-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/pagination-usage-size-pairings-1-288x313.png\",\"width\":288,\"height\":313,\"mimeType\":\"image/png\",\"filesize\":18618,\"filename\":\"pagination-usage-size-pairings-1-288x313.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/pagination-usage-size-pairings-1-608x660.png\",\"width\":608,\"height\":660,\"mimeType\":\"image/png\",\"filesize\":53827,\"filename\":\"pagination-usage-size-pairings-1-608x660.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/pagination-usage-size-pairings-1-928x1008.png\",\"width\":928,\"height\":1008,\"mimeType\":\"image/png\",\"filesize\":93032,\"filename\":\"pagination-usage-size-pairings-1-928x1008.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/pagination-usage-size-pairings-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":72638,\"filename\":\"pagination-usage-size-pairings-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/pagination-usage-size-pairings-1-288x313.png\",\"checksum\":\"4e1a3e9737e09a880cb21d4f930ebaf5f8d2ad5ceb46e0201123d01fa4978197\",\"id\":\"69cea8d71eed46688fdf4c44\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Size pairings of the pagination and data table components\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"6a7049381bedf2003db8c986\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"6a70493731bc080db4c98b94\"}],\"id\":\"6a70491831bc080db4c98b93\"}],\"id\":\"6a70471431bc080db4c98b83\"},{\"isPrivate\":false,\"heading\":\"Placement\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Data tables should be placed in a page’s main content area and given plenty of space to display data without truncation. Avoid placing data tables inside data tables or smaller containers where the information can feel cramped or needs truncation.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The data table can be placed on the grid following the three different \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"gutter modes\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"2x Grid\",\"relationTo\":\"foundations\",\"value\":{\"name\":\"2x Grid\",\"slug\":\"2x-grid\",\"meta\":{\"description\":\"The IBM Design 2x Grid provides the geometric foundation for typography, layouts, icons, and illustrations, ensuring structure and consistency.\"},\"id\":\"69a0c49d72a67d27f35d2ab3\"}},\"tab\":\"usage\",\"linkType\":\"internal\",\"fragment\":\"gutter-modes\"},\"id\":\"6a2c227b5a6d054d1e6678b0\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" outlined in the 2x grid guidelines. Although, the data table can share horizontal space with other components and content, consider giving your data table the most width on the page to help your user view dense data.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"These three examples show the data table on the wide (default), narrow, and condensed gutter modes. Note the different type alignments and gutter sizes.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[{\"isPrivate\":false,\"heading\":\"Wide gutter mode\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The wide gutter mode is the default and gives the most breathing room between the data table and the other components or content.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:07:47.046Z\",\"updatedAt\":\"2026-04-20T11:32:59.849Z\",\"alt\":\"Data table wide \",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-wide-1.png\",\"filename\":\"datatable-alignment-wide-1.png\",\"mimeType\":\"image/png\",\"filesize\":47673,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-wide-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":18725,\"filename\":\"datatable-alignment-wide-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-wide-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":46301,\"filename\":\"datatable-alignment-wide-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-wide-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":18725,\"filename\":\"datatable-alignment-wide-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-wide-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":52520,\"filename\":\"datatable-alignment-wide-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-wide-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":97488,\"filename\":\"datatable-alignment-wide-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-wide-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":147385,\"filename\":\"datatable-alignment-wide-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-wide-1-288x162.png\",\"checksum\":\"8625d08f2491ba051f97649dcda020cffb16e1f7ac59850b530037d6001f5b7e\",\"id\":\"69c8b3a33b51f9704b6a8078\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Data table on a wide (default) grid\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69c8b38bf19d3390de619ac1\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b388f19d3390de619ac0\"}],\"id\":\"69c8b372f19d3390de619abf\"},{\"isPrivate\":false,\"heading\":\"Narrow gutter mode\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Using the data table on a narrow grid will hang the component into the gutter and create a desirable type alignment between the the data table’s title and other type on the page.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:08:44.789Z\",\"updatedAt\":\"2026-04-20T11:32:59.833Z\",\"alt\":\"Data table narrow \",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-narrow-1.png\",\"filename\":\"datatable-alignment-narrow-1.png\",\"mimeType\":\"image/png\",\"filesize\":77705,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-narrow-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":24392,\"filename\":\"datatable-alignment-narrow-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-narrow-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":75506,\"filename\":\"datatable-alignment-narrow-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-narrow-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":24392,\"filename\":\"datatable-alignment-narrow-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-narrow-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":76837,\"filename\":\"datatable-alignment-narrow-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-narrow-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":159768,\"filename\":\"datatable-alignment-narrow-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-narrow-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":247690,\"filename\":\"datatable-alignment-narrow-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-narrow-1-288x162.png\",\"checksum\":\"0e537f0874337265499f36f0d1beea3bba29e7e970538afdfa47506761c24bb9\",\"id\":\"69c8b3dce90c0d1a042f27b9\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Data table on a narrow grid\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69c8b3cbf19d3390de619ac4\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b3c8f19d3390de619ac3\"}],\"id\":\"69c8b3b4f19d3390de619ac2\"},{\"isPrivate\":false,\"heading\":\"Condensed gutter mode\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The data table can be used on a condensed grid, but care should be taken to avoid any unintentional relationships with other UI elements. Use a hybrid grid or a dissimilar background color to avoid the components blending in to each other.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:09:32.867Z\",\"updatedAt\":\"2026-04-20T11:32:59.857Z\",\"alt\":\"Data table condensed \",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-condensed-1.png\",\"filename\":\"datatable-alignment-condensed-1.png\",\"mimeType\":\"image/png\",\"filesize\":49822,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-condensed-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":19917,\"filename\":\"datatable-alignment-condensed-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-condensed-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":51268,\"filename\":\"datatable-alignment-condensed-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-condensed-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":19917,\"filename\":\"datatable-alignment-condensed-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-condensed-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":56712,\"filename\":\"datatable-alignment-condensed-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-condensed-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":105578,\"filename\":\"datatable-alignment-condensed-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-condensed-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":157678,\"filename\":\"datatable-alignment-condensed-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-alignment-condensed-1-288x162.png\",\"checksum\":\"32bd5eb6927e7ba627e3322734dfada83a807234a8d46a9f3851f5c83beab102\",\"id\":\"69c8b40c630abed3708bd761\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Data table on a condensed grid\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69c8b3fdf19d3390de619ac7\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b3f9f19d3390de619ac6\"}],\"id\":\"69c8b3e4f19d3390de619ac5\"}],\"id\":\"69c8b362f19d3390de619abe\"}],\"id\":\"69c8b17af19d3390de619ab0\",\"blockName\":\"Formatting\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Content\",\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"Main elements\",\"blocks\":[],\"contentFlow\":[],\"subsections\":[{\"isPrivate\":false,\"heading\":\"Data table title and description\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The table title should make it clear to the user what this the data has in common and what purpose it serves in the UI.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"A description can be added under the title to provide more information about the data or its source.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"A data table’s title and description should use \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"sentence-case capitalization.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Content\",\"relationTo\":\"foundations\",\"value\":{\"meta\":{\"description\":\"Explore Carbon's content guidelines for product interfaces, including content foundations, accessibility writing tips, and IBM style resources.\"},\"name\":\"Content\",\"slug\":\"content\",\"id\":\"6a19de8183e83858ce4cf731\"}},\"tab\":\"writing-style\",\"linkType\":\"internal\",\"fragment\":\"use-sentence-case-capitalization\"},\"id\":\"69c8be3cfd647529eb58fb73\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"id\":\"69c8be3346589dbf9eeaffaa\"},{\"isPrivate\":false,\"heading\":\"Column titles\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Column titles should stick to one or two words that describe the data in that column.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"In cases where a column title is too long, wrap the text to two lines and then truncate the rest of the text. The full text should be shown in a tooltip on hover.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Column titles should use \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"sentence-case capitalization.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Content\",\"relationTo\":\"foundations\",\"value\":\"$6:0:props:layout:4:sections:0:subsections:0:intro:root:children:0:children:2:children:1:fields:doc:value\"},\"tab\":\"writing-style\",\"linkType\":\"internal\",\"fragment\":\"use-sentence-case-capitalization\"},\"id\":\"6a2c24955a6d054d1e6678d8\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"id\":\"69c8be3d46589dbf9eeaffab\"},{\"isPrivate\":false,\"heading\":\"Primary button\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"A data table using a primary action should follow the guidance for \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"primary button\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Button\",\"relationTo\":\"components-core\",\"value\":{\"name\":\"Button\",\"slug\":\"button\",\"pageHeader\":{\"releaseStatus\":\"stable\",\"resources\":{\"githubUrl\":\"https://github.com/carbon-design-system/carbon/tree/main/packages/react/src/components/Button\",\"storybookUrl\":\"https://react.carbondesignsystem.com/?path=/docs/components-button--overview\"}},\"meta\":{\"image\":{\"createdAt\":\"2026-06-22T15:19:01.508Z\",\"updatedAt\":\"2026-06-22T15:19:01.694Z\",\"alt\":\"Button\",\"visibility\":\"public\",\"checksum\":\"e6e5080c785870e75634d7516702bb56274dd948c908e73dd057555e245fb047\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/Button.svg\",\"filename\":\"Button.svg\",\"mimeType\":\"image/svg+xml\",\"filesize\":9576,\"width\":320,\"height\":320,\"sizes\":{\"thumbnail\":{\"url\":null},\"square\":{\"url\":null},\"small\":{\"url\":null},\"medium\":{\"url\":null},\"large\":{\"url\":null},\"og\":{\"url\":null}},\"thumbnailURL\":null,\"id\":\"6a395265aab5216c3d3ab673\"},\"description\":\"Buttons are used to initialize an action. Button labels express what action will occur when the user interacts with it.\"},\"tabs\":[{\"slug\":\"guidelines\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"b3f8177f813007f056643e2b\"},{\"slug\":\"specifications\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"5750fe27f00497e2452998e4\"},{\"slug\":\"code\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"2f3ea3894f244b76e05b9c41\"},{\"slug\":\"accessibility\",\"a11y\":{\"showStatusTable\":true,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"8efeb4d7ae8d133f21693abc\"}],\"breadcrumbs\":[{\"url\":\"/button\",\"id\":\"6a3e95e3adcf55003c1f1c28\"}],\"id\":\"692f00f2637db19284b0963e\"}},\"tab\":\"guidelines\",\"linkType\":\"internal\"},\"id\":\"69c8be52fd647529eb58fb75\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" usage and \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"action labels.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Content\",\"relationTo\":\"foundations\",\"value\":\"$6:0:props:layout:4:sections:0:subsections:0:intro:root:children:0:children:2:children:1:fields:doc:value\"},\"tab\":\"action-labels\",\"linkType\":\"internal\"},\"id\":\"69c8be52fd647529eb58fb76\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"For further content guidance, see Carbon’s \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"content guidelines\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Content\",\"relationTo\":\"foundations\",\"value\":\"$6:0:props:layout:4:sections:0:subsections:0:intro:root:children:0:children:2:children:1:fields:doc:value\"},\"tab\":\"overview\",\"linkType\":\"internal\"},\"id\":\"69c8be52fd647529eb58fb77\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\".\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"id\":\"69c8be4a46589dbf9eeaffac\"}],\"id\":\"69c8b45df19d3390de619ac9\"}],\"id\":\"69c8b455f19d3390de619ac8\",\"blockName\":\"Content\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Variants\",\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"Expandable\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The expandable data table helps present large amounts of data in a small space. Use the expanded section for supplementary information or data that needs additional query time. When the content in the expanded area feels cramped, consider taking the user to a dedicated page, side panel, or data table to view the information and complete tasks.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:14:47.456Z\",\"updatedAt\":\"2026-04-20T11:32:59.829Z\",\"alt\":\"Example of data table with row expansion\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-1.png\",\"filename\":\"datatable-expand-1.png\",\"mimeType\":\"image/png\",\"filesize\":56219,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":16389,\"filename\":\"datatable-expand-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":47214,\"filename\":\"datatable-expand-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":16389,\"filename\":\"datatable-expand-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":52654,\"filename\":\"datatable-expand-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":100210,\"filename\":\"datatable-expand-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":140607,\"filename\":\"datatable-expand-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-1-288x162.png\",\"checksum\":\"6c58d83a6bceef8343a722629fd66f9daed2086c29e8dfb8a5dc1fdbda58b2fb\",\"id\":\"69c8b547630abed3708bd863\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8b53a61e5f877775fadef\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b53461e5f877775fadee\"}],\"subsections\":[{\"isPrivate\":false,\"heading\":\"Batch expansion\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"When appropriate, a batch expansion feature can be added to the table column header to allow the user to open all collapsed sections simultaneously. However, the expand-all chevron is not shown by default in the expandable data table variant. Keeping detailed information in the expanded section saves user loading time by postponing some data queries until needed. Expanding all rows at once will typically negate this advantage of the expandable table.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:15:51.591Z\",\"updatedAt\":\"2026-04-20T11:32:59.852Z\",\"alt\":\"Example of data table with batch expansion\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-all-1.png\",\"filename\":\"datatable-expand-all-1.png\",\"mimeType\":\"image/png\",\"filesize\":44111,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-all-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":11972,\"filename\":\"datatable-expand-all-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-all-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":36631,\"filename\":\"datatable-expand-all-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-all-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":11972,\"filename\":\"datatable-expand-all-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-all-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":38883,\"filename\":\"datatable-expand-all-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-all-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":72377,\"filename\":\"datatable-expand-all-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-all-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":102340,\"filename\":\"datatable-expand-all-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expand-all-1-288x162.png\",\"checksum\":\"16faef57e78261b08284c40de7be523e9ccd40550706ea229c5f474624475e7a\",\"id\":\"69c8b587dff79175467a2d05\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8bec246589dbf9eeaffaf\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8bebf46589dbf9eeaffae\"}],\"id\":\"69c8beaa46589dbf9eeaffad\"}],\"id\":\"69c8b51361e5f877775faded\"},{\"isPrivate\":false,\"heading\":\"Selectable\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"By default, the selectable variant allows users to select more than one row in a data table simultaneously. To select a row, the user must select the checkbox associated with the row. The user can select all rows at once by selecting the checkbox in the column header. Checkboxes in the rows have only two states, checked and unchecked. However, the check all checkbox in the column header has three states, check, unchecked, and indeterminate.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Actions applied to the chosen selected items are found in the default \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"table toolbar\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"url\":\"https://carbondesignsystem.com/components/data-table/guidelines/#table-toolbar\",\"linkType\":\"fragment\",\"fragment\":\"table-toolbar\"},\"id\":\"69c8b5b0dac39f9b36311e9a\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" or \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"batch action mode\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"url\":\"https://carbondesignsystem.com/components/data-table/guidelines/#batch-actions\",\"linkType\":\"fragment\",\"fragment\":\"batch-actions\"},\"id\":\"69c8b5b0dac39f9b36311e9b\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\".\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:17:05.932Z\",\"updatedAt\":\"2026-04-20T11:32:59.939Z\",\"alt\":\"Example of a data table with selection\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-multi-select-1.png\",\"filename\":\"datatable-multi-select-1.png\",\"mimeType\":\"image/png\",\"filesize\":70121,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-multi-select-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":18112,\"filename\":\"datatable-multi-select-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-multi-select-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":52647,\"filename\":\"datatable-multi-select-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-multi-select-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":18112,\"filename\":\"datatable-multi-select-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-multi-select-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":58547,\"filename\":\"datatable-multi-select-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-multi-select-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":109692,\"filename\":\"datatable-multi-select-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-multi-select-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":152737,\"filename\":\"datatable-multi-select-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-multi-select-1-288x162.png\",\"checksum\":\"18fff051a0f039c911a49e5fd8e6ad9373c22d47f26527e6ac627a10bdbf1ada\",\"id\":\"69c8b5d1dff79175467a2d5d\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8b5c661e5f877775fadf5\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b5c261e5f877775fadf4\"}],\"subsections\":[{\"isPrivate\":false,\"heading\":\"Radio selection\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The data table also supports a single-select radio button control, limiting the user to selecting only one row at a time. The radio button is placed in the first column on the left side. Single actions applied to the chosen radio item are often placed on the right side of the table toolbar area. They can manifest as primary, ghost, or icon-only buttons.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-01-07T00:09:22.084Z\",\"updatedAt\":\"2026-04-20T11:32:43.116Z\",\"alt\":\"Example of a data table with radio select\",\"visibility\":\"public\",\"filename\":\"datatable-radio-select.png\",\"mimeType\":\"image/png\",\"filesize\":58232,\"width\":1152,\"height\":648,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-radio-select-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":18405,\"filename\":\"datatable-radio-select-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-radio-select-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":69569,\"filename\":\"datatable-radio-select-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-radio-select-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":18405,\"filename\":\"datatable-radio-select-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-radio-select-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":68203,\"filename\":\"datatable-radio-select-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-radio-select-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":132644,\"filename\":\"datatable-radio-select-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-radio-select-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":171624,\"filename\":\"datatable-radio-select-1200x630.png\"}},\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-radio-select.png\",\"checksum\":\"f1dc28524b8119ae4c9252d14545dfc6b9bdba66552fc7b7c14b3920e820611a\",\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-radio-select-288x162.png\",\"id\":\"695da4325f7f826be33b6aa9\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8bf6146589dbf9eeaffb2\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8bf4346589dbf9eeaffb1\"}],\"id\":\"69c8bf3546589dbf9eeaffb0\"}],\"id\":\"69c8b5a761e5f877775fadf3\"},{\"isPrivate\":false,\"heading\":\"Expandable + selectable\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Data tables can be configured to have both expandable and selectable features. The expandable icon always appears first and to the left of the selection icon.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:19:10.525Z\",\"updatedAt\":\"2026-04-20T11:32:59.931Z\",\"alt\":\"Example of a data table with expansion and selection\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expandable%2Bselectable-1.png\",\"filename\":\"datatable-expandable+selectable-1.png\",\"mimeType\":\"image/png\",\"filesize\":42018,\"width\":1728,\"height\":1151,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expandable%2Bselectable-1-288x192.png\",\"width\":288,\"height\":192,\"mimeType\":\"image/png\",\"filesize\":15297,\"filename\":\"datatable-expandable+selectable-1-288x192.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expandable%2Bselectable-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":43575,\"filename\":\"datatable-expandable+selectable-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expandable%2Bselectable-1-288x192.png\",\"width\":288,\"height\":192,\"mimeType\":\"image/png\",\"filesize\":15297,\"filename\":\"datatable-expandable+selectable-1-288x192.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expandable%2Bselectable-1-608x405.png\",\"width\":608,\"height\":405,\"mimeType\":\"image/png\",\"filesize\":47599,\"filename\":\"datatable-expandable+selectable-1-608x405.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expandable%2Bselectable-1-928x618.png\",\"width\":928,\"height\":618,\"mimeType\":\"image/png\",\"filesize\":86249,\"filename\":\"datatable-expandable+selectable-1-928x618.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expandable%2Bselectable-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":124980,\"filename\":\"datatable-expandable+selectable-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-expandable%2Bselectable-1-288x192.png\",\"checksum\":\"ca25802744625c1603fe156a8aecf0de230c623659919ea5c5326d93ea49f9b9\",\"id\":\"69c8b64e7dba4123416f7d63\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8b64461e5f877775fadfb\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b64161e5f877775fadfa\"}],\"subsections\":[],\"id\":\"69c8b62761e5f877775fadf9\"}],\"id\":\"69c8b50761e5f877775fadec\",\"blockName\":\"Variants\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Universal behaviors\",\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"Interactions\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The data table’s toolbar and rows follow interaction conventions that are found in other Carbon components. Buttons, checkboxes, radio buttons, overflow menus, search, and expanding elements are used in the data table, and all behave according to their guidelines.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[{\"isPrivate\":false,\"heading\":\"Mouse\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Users can trigger an action or function in the table by clicking the associated button or component. Each action or function has its own distinct click target. See the \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Accessibility\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Data table\",\"relationTo\":\"components-core\",\"value\":{\"name\":\"Data table\",\"pageHeader\":{\"releaseStatus\":\"stable\",\"resources\":{\"githubUrl\":\"https://github.com/carbon-design-system/carbon/tree/main/packages/react/src/components/DataTable\",\"storybookUrl\":\"https://react.carbondesignsystem.com/?path=/docs/components-datatable-basic--overview\"}},\"slug\":\"data-table\",\"meta\":{\"image\":{\"createdAt\":\"2026-06-24T12:24:42.012Z\",\"updatedAt\":\"2026-06-24T12:24:42.182Z\",\"alt\":\"Data table\",\"visibility\":\"public\",\"checksum\":\"2dc6ffdb6e6bdf4f2ca4ef43e76f3f5c796e89cbf2f021ea274a27e9fe93e846\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/Data%20table.svg\",\"filename\":\"Data table.svg\",\"mimeType\":\"image/svg+xml\",\"filesize\":5099,\"width\":320,\"height\":320,\"sizes\":{\"thumbnail\":{\"url\":null},\"square\":{\"url\":null},\"small\":{\"url\":null},\"medium\":{\"url\":null},\"large\":{\"url\":null},\"og\":{\"url\":null}},\"thumbnailURL\":null,\"id\":\"6a3bcc8af01d4e06871f252e\"},\"description\":\"Data tables organize and display data efficie