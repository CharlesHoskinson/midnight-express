edia/file/data-table-usage-search-1-928x618.png\",\"width\":928,\"height\":618,\"mimeType\":\"image/png\",\"filesize\":15698,\"filename\":\"data-table-usage-search-1-928x618.png\"},\"og\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}},\"url\":\"https://origin.carbondesignsystem.com/api/media/file/data-table-usage-search-1.png\",\"checksum\":\"edf5b624d0383615fc96a0a81d12a68926434bf2f1bfe33c663de03abd602bd8\",\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/data-table-usage-search-1-288x192.png\",\"id\":\"69600fcd5f7f826be33bf3a9\"},\"iconColor\":\"dark\",\"hideCaption\":false,\"id\":\"69c8b83d61e5f877775fae11\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b83a61e5f877775fae10\"}],\"id\":\"69c8b82561e5f877775fae0f\"},{\"isPrivate\":false,\"heading\":\"Open search\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The search field can appear always open on a data table. The field is placed on the left side of the table under the table title and stretches until it meets the actions on the right.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:29:58.742Z\",\"updatedAt\":\"2026-04-20T11:33:00.038Z\",\"alt\":\"Data table search\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-search-2-b-1.png\",\"filename\":\"datatable-search-2-b-1.png\",\"mimeType\":\"image/png\",\"filesize\":26532,\"width\":1216,\"height\":1216,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-search-2-b-1-288x288.png\",\"width\":288,\"height\":288,\"mimeType\":\"image/png\",\"filesize\":26392,\"filename\":\"datatable-search-2-b-1-288x288.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-search-2-b-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":51604,\"filename\":\"datatable-search-2-b-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-search-2-b-1-288x288.png\",\"width\":288,\"height\":288,\"mimeType\":\"image/png\",\"filesize\":26392,\"filename\":\"datatable-search-2-b-1-288x288.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-search-2-b-1-608x608.png\",\"width\":608,\"height\":608,\"mimeType\":\"image/png\",\"filesize\":77291,\"filename\":\"datatable-search-2-b-1-608x608.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-search-2-b-1-928x928.png\",\"width\":928,\"height\":928,\"mimeType\":\"image/png\",\"filesize\":152811,\"filename\":\"datatable-search-2-b-1-928x928.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-search-2-b-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":134432,\"filename\":\"datatable-search-2-b-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-search-2-b-1-288x288.png\",\"checksum\":\"d81e39a3a78b766d0cbd541db0e8bf2fa60f90064751492eb56f57cf93da9698\",\"id\":\"69c8b8d6cab2a5d5b3979f8d\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8b8c434e1302ea7760334\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b8c034e1302ea7760333\"}],\"id\":\"69c8b8a834e1302ea7760332\"}],\"id\":\"69c8b81b61e5f877775fae0e\"},{\"isPrivate\":false,\"heading\":\"Sorting\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Columns can be sorted in ascending or descending order. Sorting controls are located in the column headers and indicated with an arrow icon on hover and when a column is sorted.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"A sorted data table has three states: unsorted (\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"arrows\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"), sorted-up (\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"arrow--up\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\") or sorted-down (\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"arrow--down\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"). The icon indicates the current sorted state and is shown only when the sorting is activated. Only the sorted column displays an icon, and unsorted icons are only visible on hover. You can see a demo of sorting in Carbon’s \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"React Storybook\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"linkType\":\"custom\",\"newTab\":false,\"url\":\"https://react.carbondesignsystem.com/?path=/story/components-datatable-sorting--default\"},\"id\":\"69c8b90c7a36c1dc510b285b\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\".\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:31:24.295Z\",\"updatedAt\":\"2026-04-20T11:33:00.020Z\",\"alt\":\"Data table unsorted\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-sorting-1.png\",\"filename\":\"datatable-sorting-1.png\",\"mimeType\":\"image/png\",\"filesize\":32222,\"width\":1728,\"height\":583,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-sorting-1-288x97.png\",\"width\":288,\"height\":97,\"mimeType\":\"image/png\",\"filesize\":10900,\"filename\":\"datatable-sorting-1-288x97.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-sorting-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":36778,\"filename\":\"datatable-sorting-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-sorting-1-288x97.png\",\"width\":288,\"height\":97,\"mimeType\":\"image/png\",\"filesize\":10900,\"filename\":\"datatable-sorting-1-288x97.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-sorting-1-608x205.png\",\"width\":608,\"height\":205,\"mimeType\":\"image/png\",\"filesize\":32995,\"filename\":\"datatable-sorting-1-608x205.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-sorting-1-928x313.png\",\"width\":928,\"height\":313,\"mimeType\":\"image/png\",\"filesize\":59169,\"filename\":\"datatable-sorting-1-928x313.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-sorting-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":112171,\"filename\":\"datatable-sorting-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-sorting-1-288x97.png\",\"checksum\":\"c7b5998dea9170bb69e3fffcb2e850f76f01376bb01ab7e105aac74f29ae47d8\",\"id\":\"69c8b92c7dba4123416f7f5c\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8b91c34e1302ea7760337\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b91934e1302ea7760336\"}],\"subsections\":[],\"id\":\"69c8b8f334e1302ea7760335\"},{\"isPrivate\":false,\"heading\":\"Batch actions\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Users can perform batch actions on one or more items within a table. Once an item from the table is selected, the batch action bar appears at the top of the table, presenting a set of possible actions to apply to all select items. This feature can increase user efficiency compared to the effort of repetitively performing the same inline action across multiple table items. When batch mode is active, single action icons and overflow menus on the row should be disabled.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"To exit the batch action mode, the user can select the cancel button on the far right of the bar or deselect all items.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:32:08.648Z\",\"updatedAt\":\"2026-04-20T11:33:00.133Z\",\"alt\":\"Data table multi select\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-batch-action-1.png\",\"filename\":\"datatable-batch-action-1.png\",\"mimeType\":\"image/png\",\"filesize\":69625,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-batch-action-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":18760,\"filename\":\"datatable-batch-action-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-batch-action-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":52151,\"filename\":\"datatable-batch-action-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-batch-action-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":18760,\"filename\":\"datatable-batch-action-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-batch-action-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":58298,\"filename\":\"datatable-batch-action-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-batch-action-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":107868,\"filename\":\"datatable-batch-action-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-batch-action-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":146107,\"filename\":\"datatable-batch-action-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-batch-action-1-288x162.png\",\"checksum\":\"bbb76d9c9393e9f0423ca4b5bea0b42a6b2c5a09389c1d3929ed92b983dadc19\",\"id\":\"69c8b9588314e7f2345510c1\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8b94d34e1302ea776033a\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b94a34e1302ea7760339\"}],\"subsections\":[],\"id\":\"69c8b93334e1302ea7760338\"},{\"isPrivate\":false,\"heading\":\"Inline actions\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Inline actions are functions that might be performed on a specific table row. Each row is accompanied by an \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"overflow menu\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"relationTo\":\"components-core\",\"value\":{\"name\":\"Menu buttons\",\"pageHeader\":{\"releaseStatus\":\"stable\",\"resources\":{\"githubUrl\":\"https://github.com/carbon-design-system/carbon/tree/main/packages/react/src/components/MenuButton\",\"storybookUrl\":\"https://react.carbondesignsystem.com/?path=/docs/components-menubutton--overview\"}},\"slug\":\"menu-buttons\",\"meta\":{\"image\":{\"createdAt\":\"2026-06-24T12:29:09.883Z\",\"updatedAt\":\"2026-06-24T12:29:10.055Z\",\"alt\":\"Menu buttons\",\"visibility\":\"public\",\"checksum\":\"dff7bea88459d92a7ee95b87d59eeffcd9a7936a3db50797d38f2a7cd1333690\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/Menu%20buttons.svg\",\"filename\":\"Menu buttons.svg\",\"mimeType\":\"image/svg+xml\",\"filesize\":3812,\"width\":320,\"height\":320,\"sizes\":{\"thumbnail\":{\"url\":null},\"square\":{\"url\":null},\"small\":{\"url\":null},\"medium\":{\"url\":null},\"large\":{\"url\":null},\"og\":{\"url\":null}},\"thumbnailURL\":null,\"id\":\"6a3bcd952f7728b62f54de5c\"},\"description\":\"Menu buttons, including menu buttons, combo buttons, and overflow menus, open a menu with a list of interactive options.\"},\"tabs\":[{\"slug\":\"guidelines\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"531b41b9406ccf4f8ef88274\"},{\"slug\":\"specifications\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"04e57b87dc3cd15cce4bc5fd\"},{\"slug\":\"code\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"032bb4b3d8bd95cafe973927\"},{\"slug\":\"accessibility\",\"a11y\":{\"showStatusTable\":true,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"60b024ee579e6af5484dd60b\"}],\"breadcrumbs\":[{\"url\":\"/menu-buttons\",\"id\":\"6a3a2895813b9a003da5ca8d\"}],\"id\":\"692f5430637db19284b0bf04\"}},\"tab\":\"guidelines\",\"linkType\":\"internal\",\"fragment\":\"overflow-menu\"},\"id\":\"69c8b9647a36c1dc510b285c\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" that contains actions that are related specifically to that row.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"When the overflow menu contains fewer than three options, keep the actions inline as icon buttons instead. This approach reduces a click and makes available actions visible at a glance.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:33:46.472Z\",\"updatedAt\":\"2026-04-20T11:33:00.156Z\",\"alt\":\"Data table inline actions\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-inline-actions-1.png\",\"filename\":\"datatable-inline-actions-1.png\",\"mimeType\":\"image/png\",\"filesize\":30478,\"width\":1216,\"height\":1216,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-inline-actions-1-288x288.png\",\"width\":288,\"height\":288,\"mimeType\":\"image/png\",\"filesize\":24894,\"filename\":\"datatable-inline-actions-1-288x288.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-inline-actions-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":45789,\"filename\":\"datatable-inline-actions-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-inline-actions-1-288x288.png\",\"width\":288,\"height\":288,\"mimeType\":\"image/png\",\"filesize\":24894,\"filename\":\"datatable-inline-actions-1-288x288.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-inline-actions-1-608x608.png\",\"width\":608,\"height\":608,\"mimeType\":\"image/png\",\"filesize\":66432,\"filename\":\"datatable-inline-actions-1-608x608.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-inline-actions-1-928x928.png\",\"width\":928,\"height\":928,\"mimeType\":\"image/png\",\"filesize\":136376,\"filename\":\"datatable-inline-actions-1-928x928.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-inline-actions-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":111904,\"filename\":\"datatable-inline-actions-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-inline-actions-1-288x288.png\",\"checksum\":\"1cbff214f47f5351caeed7d845f3620245f2e8d851afc073656f4927187dbdff\",\"id\":\"69c8b9ba8314e7f2345510f2\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8b9acb1e746ce1e947fb1\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b97334e1302ea776033c\"}],\"subsections\":[],\"id\":\"69c8b95b34e1302ea776033b\"},{\"isPrivate\":false,\"heading\":\"Overflow menu\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"By default, the overflow menu icons are persistent on each row. Having the overflow menus always visible signals to the user actions can be taken on the table rows. Alternatively, a product team may use the \",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"overflowMenuOnHover\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" prop to only show the overflow menu on hover and focus to reduce the visual clutter of an overflow menu on every row.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"For mobile and touch devices the data table will detect if the user agent supports hover-over and persist the overflow menus even if the \",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"overflowMenuOnHover\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" prop is enabled.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:34:41.990Z\",\"updatedAt\":\"2026-04-20T11:33:00.130Z\",\"alt\":\"Persistent overflow (left), on hover (right).\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-persistent-hover-1.png\",\"filename\":\"datatable-persistent-hover-1.png\",\"mimeType\":\"image/png\",\"filesize\":11660,\"width\":1216,\"height\":608,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-persistent-hover-1-288x144.png\",\"width\":288,\"height\":144,\"mimeType\":\"image/png\",\"filesize\":7642,\"filename\":\"datatable-persistent-hover-1-288x144.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-persistent-hover-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":35277,\"filename\":\"datatable-persistent-hover-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-persistent-hover-1-288x144.png\",\"width\":288,\"height\":144,\"mimeType\":\"image/png\",\"filesize\":7642,\"filename\":\"datatable-persistent-hover-1-288x144.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-persistent-hover-1-608x304.png\",\"width\":608,\"height\":304,\"mimeType\":\"image/png\",\"filesize\":21130,\"filename\":\"datatable-persistent-hover-1-608x304.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-persistent-hover-1-928x464.png\",\"width\":928,\"height\":464,\"mimeType\":\"image/png\",\"filesize\":43652,\"filename\":\"datatable-persistent-hover-1-928x464.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-persistent-hover-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":58402,\"filename\":\"datatable-persistent-hover-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-persistent-hover-1-288x144.png\",\"checksum\":\"d9e04ee464428e1851035373f55b2b871926dc5751ac7bb631d1644336315c7c\",\"id\":\"69c8b9f1dff79175467a307e\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Persistent overflow (left), on hover (right).\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69c8b9e4b1e746ce1e947fb4\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b9e1b1e746ce1e947fb3\"}],\"subsections\":[],\"id\":\"69c8b9cdb1e746ce1e947fb2\"},{\"isPrivate\":false,\"heading\":\"Loading\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"If extra load time is expected to display information, use skeleton states instead of spinners.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:35:24.510Z\",\"updatedAt\":\"2026-06-12T15:51:36.426Z\",\"alt\":\"Data table skeleton\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-skeleton-1.png\",\"filename\":\"datatable-skeleton-1.png\",\"mimeType\":\"image/png\",\"filesize\":27040,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-skeleton-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":4882,\"filename\":\"datatable-skeleton-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-skeleton-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":21901,\"filename\":\"datatable-skeleton-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-skeleton-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":4882,\"filename\":\"datatable-skeleton-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-skeleton-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":19650,\"filename\":\"datatable-skeleton-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-skeleton-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":47548,\"filename\":\"datatable-skeleton-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-skeleton-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":89671,\"filename\":\"datatable-skeleton-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-skeleton-1-288x162.png\",\"checksum\":\"53e1eefcaa2a77752d7d854cdf9f98e4477c1b0249fc57c40d287cdcd2b7da39\",\"id\":\"69c8ba1ccab2a5d5b397a054\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Expanding all rows with skeleton states\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69c8ba10b1e746ce1e947fb7\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8ba0bb1e746ce1e947fb6\"}],\"subsections\":[],\"id\":\"69c8b9f6b1e746ce1e947fb5\"}],\"id\":\"69c8b66861e5f877775fadfc\",\"blockName\":\"Universal behaviors\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Modifiers\",\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"Alternating row color\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The data table can use a zebra stripes modifier to style the table rows with alternating colors to make scanning horizontal information easier for the user.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:36:56.688Z\",\"updatedAt\":\"2026-04-20T11:33:00.135Z\",\"alt\":\"Data table with zebra stripes\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-zebra-1.png\",\"filename\":\"datatable-zebra-1.png\",\"mimeType\":\"image/png\",\"filesize\":13059,\"width\":1216,\"height\":684,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-zebra-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":16042,\"filename\":\"datatable-zebra-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-zebra-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":35372,\"filename\":\"datatable-zebra-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-zebra-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":16042,\"filename\":\"datatable-zebra-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-zebra-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":41522,\"filename\":\"datatable-zebra-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-zebra-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":78555,\"filename\":\"datatable-zebra-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-zebra-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":106866,\"filename\":\"datatable-zebra-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-zebra-1-288x162.png\",\"checksum\":\"8045ee2ed90ffbf669e7f2c9197fd161b693224a8b706f71c9b7a5c2a5e266bc\",\"id\":\"69c8ba78cab2a5d5b397a088\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8ba6db1e746ce1e947fbb\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8ba69b1e746ce1e947fba\"}],\"subsections\":[],\"id\":\"69c8ba55b1e746ce1e947fb9\"}],\"id\":\"69c8ba3bb1e746ce1e947fb8\",\"blockName\":\"Modifiers\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"AI presence\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Data table has a modification that takes on the AI visual styling when AI is present in the table. The AI variants of a data table function the same as the normal variants except for the addition of the AI label, which is both a visual indicator and the trigger for the explainability popover. Where the AI label goes inside of a data table depends on which parts of the data are AI generated.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"For more information on designing for AI, see the \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Carbon for AI\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Carbon for AI\",\"relationTo\":\"foundations\",\"value\":{\"meta\":{\"description\":\"Carbon for AI extends the Carbon Design System with a distinct visual and behavioral identity for AI experiences in IBM products.\"},\"name\":\"Carbon for AI\",\"slug\":\"carbon-for-ai\",\"id\":\"6a19d06183e83858ce4ceaf9\"}},\"tab\":\"tab-1\",\"linkType\":\"internal\"},\"id\":\"69c8ba961a9f95383e32e7bf\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" guidelines.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"Entire table\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"When the entire data table is styled for AI, it indicates to the user that AI is present in all aspects of the data table.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:38:06.196Z\",\"updatedAt\":\"2026-04-20T11:33:00.226Z\",\"alt\":\"Example of a data table generated by AI\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-datatable-1.png\",\"filename\":\"usage-ai-presence-datatable-1.png\",\"mimeType\":\"image/png\",\"filesize\":50947,\"width\":1728,\"height\":864,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-datatable-1-288x144.png\",\"width\":288,\"height\":144,\"mimeType\":\"image/png\",\"filesize\":14289,\"filename\":\"usage-ai-presence-datatable-1-288x144.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-datatable-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":46742,\"filename\":\"usage-ai-presence-datatable-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-datatable-1-288x144.png\",\"width\":288,\"height\":144,\"mimeType\":\"image/png\",\"filesize\":14289,\"filename\":\"usage-ai-presence-datatable-1-288x144.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-datatable-1-608x304.png\",\"width\":608,\"height\":304,\"mimeType\":\"image/png\",\"filesize\":43984,\"filename\":\"usage-ai-presence-datatable-1-608x304.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-datatable-1-928x464.png\",\"width\":928,\"height\":464,\"mimeType\":\"image/png\",\"filesize\":90497,\"filename\":\"usage-ai-presence-datatable-1-928x464.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-datatable-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":162018,\"filename\":\"usage-ai-presence-datatable-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-datatable-1-288x144.png\",\"checksum\":\"1615aef60f96b74f45ce62f668bef72f7e032728ab1b88a707da1dd91e8d3544\",\"id\":\"69c8babecab2a5d5b397a0d3\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Example of a data table generated by AI.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69c8bab3b1e746ce1e947fbf\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8baafb1e746ce1e947fbe\"}],\"subsections\":[],\"id\":\"69c8ba9cb1e746ce1e947fbd\"},{\"isPrivate\":false,\"heading\":\"Individual cells\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"If only some data table cells have content generated by AI, then those cells have an in-line AI label next to them. These cells do not get any AI layering.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:39:04.060Z\",\"updatedAt\":\"2026-04-20T11:33:00.244Z\",\"alt\":\"Example of a data table cell generated by AI represented by the in-line AI label\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/usage-ai-presence-inline-datatable-2.png\",\"filename\":\"usage-ai-presence-inline-datatable-2.png\",\"mimeType\":\"image/png\",\"filesize\":25337,\"width\":1728,\"height\":864,\"focalX\":50,\"focalY