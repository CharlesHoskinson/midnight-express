om/?path=/docs/components-datatable-withailabel--overview\"},\"id\":\"6a2c1f21466fe67ecf440f99\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" is now stable. This addition changes the visual appearance of the component and introduces an AI explainability feature when AI is present in the component. See the \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"AI presence\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"url\":\"https://\",\"linkType\":\"fragment\",\"fragment\":\"ai-presence\"},\"id\":\"6a2c1fea5a6d054d1e6678ae\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" section for more details.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"kind\":\"info\",\"id\":\"6a2c1f0b73a1ac2b24c3577b\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Live Demo\",\"blocks\":[],\"contentFlow\":[{\"blockType\":\"liveDemo\",\"isPrivate\":false,\"tall\":false,\"wide\":true,\"themeSelector\":true,\"lazy\":false,\"variants\":[{\"label\":\"Basic\",\"variant\":\"components-datatable-basic--default\",\"id\":\"69c9448ced880a001714edec\"},{\"label\":\"Basic actions\",\"variant\":\"components-datatable-batch-actions--default\",\"id\":\"69c9448ced880a001714eded\"},{\"label\":\"Dynamic\",\"variant\":\"components-datatable-dynamic--default\",\"id\":\"69c9448ced880a001714edee\"},{\"label\":\"Expansion\",\"variant\":\"components-datatable-expansion--default\",\"id\":\"69c9448ced880a001714edef\"},{\"label\":\"Batch expansion\",\"variant\":\"components-datatable-expansion--batch-expansion\",\"id\":\"69c9448ced880a001714edf0\"},{\"label\":\"Filtering\",\"variant\":\"components-datatable-filtering--default\",\"id\":\"69c9448ced880a001714edf1\"},{\"label\":\"Selection\",\"variant\":\"components-datatable-selection--default\",\"id\":\"69c9448ced880a001714edf2\"},{\"label\":\"With radio selection\",\"variant\":\"components-datatable-selection--with-radio-selection\",\"id\":\"69c9448ced880a001714edf3\"},{\"label\":\"With selection and sorting\",\"variant\":\"components-datatable-selection--with-selection-and-sorting\",\"id\":\"69c9448ced880a001714edf4\"},{\"label\":\"Sorting\",\"variant\":\"components-datatable-sorting--default\",\"id\":\"69c9448ced880a001714edf5\"},{\"label\":\"Toolbar\",\"variant\":\"components-datatable-toolbar--default\",\"id\":\"69c9448ced880a001714edf6\"},{\"label\":\"Persistant toolbar\",\"variant\":\"components-datatable-toolbar--persistent-toolbar\",\"id\":\"69c9448ced880a001714edf7\"},{\"label\":\"Small persistant toolbar\",\"variant\":\"components-datatable-toolbar--small-persistent-toolbar\",\"id\":\"69c9448ced880a001714edf8\"},{\"label\":\"With overflow menu\",\"variant\":\"components-datatable-toolbar--with-overflow-menu\",\"id\":\"69c9448ced880a001714edf9\"},{\"label\":\"AI label with expansion\",\"variant\":\"components-datatable-withailabel--ai-label-with-expansion\",\"id\":\"69c9448ced880a001714edfa\"},{\"label\":\"AI label with radio selection\",\"variant\":\"components-datatable-withailabel--ai-label-with-radio-selection\",\"id\":\"69c9448ced880a001714edfb\"},{\"label\":\"AI label with selection\",\"variant\":\"components-datatable-withailabel--ai-label-with-selection\",\"id\":\"69c9448ced880a001714edfc\"},{\"label\":\"AI label with selection and expansion\",\"variant\":\"components-datatable-withailabel--ai-label-with-selection-and-expansion\",\"id\":\"69c9448ced880a001714edfd\"},{\"label\":\"Column AI label sort\",\"variant\":\"components-datatable-withailabel--column-ai-label-sort\",\"id\":\"69c9448ced880a001714edfe\"},{\"label\":\"Column AI label with selection and expansion\",\"variant\":\"components-datatable-withailabel--column-ai-label-with-selection-and-expansion\",\"id\":\"69c9448ced880a001714edff\"}],\"id\":\"69c944a63b8259698d3bcbcb\"}],\"sections\":[],\"id\":\"69c944a13b8259698d3bcbca\",\"blockName\":\"Live Demo\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Overview\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The data table’s features are ideal for organizing and displaying data in a UI. The column headers can sort data in ascending or descending order, rows can be expanded to progressively disclose information, and single or batch actions can be taken on rows.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The data table toolbar gives a location for primary buttons, search, filtering, table display settings, and other utilities.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"When to use\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"To organize and display data.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"If your user must navigate to a specific piece of data to complete a task.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Displaying all of a user’s resources.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[],\"id\":\"69c8b141f19d3390de619aac\"},{\"isPrivate\":false,\"heading\":\"When not to use\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"When a more complex display of the data or interactions are required.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"As a replacement for a spreadsheet application.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[],\"id\":\"69c8b14ff19d3390de619aad\"},{\"isPrivate\":false,\"heading\":\"Variants\",\"blocks\":[],\"contentFlow\":[{\"blockType\":\"contentRichText\",\"isPrivate\":false,\"content\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Variant\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":1,\"rowSpan\":1},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Purpose\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":1,\"rowSpan\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablerow\",\"version\":1},{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":2,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Default\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":2,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The basic data table has only the header and table element rows. It is available in five row sizes.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablerow\",\"version\":1},{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":2,\"mode\":\"normal\",\"style\":\"\",\"text\":\"With selection\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":2,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The selection variant enables users to select individual rows in a data table. Selection options include a single-select radio button option and a multi-select checkbox option. Users can perform a single action or batch actions against selected items.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablerow\",\"version\":1},{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":2,\"mode\":\"normal\",\"style\":\"\",\"text\":\"With expansion\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":2,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The expandable variant helps present large amounts of data in a small space. Users can expand and collapse row panels to reveal and hide additional information.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"