me\":\"datatable-target-1-288x216.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-target-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":35528,\"filename\":\"datatable-target-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-target-1-288x216.png\",\"width\":288,\"height\":216,\"mimeType\":\"image/png\",\"filesize\":13490,\"filename\":\"datatable-target-1-288x216.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-target-1-608x456.png\",\"width\":608,\"height\":456,\"mimeType\":\"image/png\",\"filesize\":43611,\"filename\":\"datatable-target-1-608x456.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-target-1-928x696.png\",\"width\":928,\"height\":696,\"mimeType\":\"image/png\",\"filesize\":98876,\"filename\":\"datatable-target-1-928x696.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-target-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":91408,\"filename\":\"datatable-target-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-target-1-288x216.png\",\"checksum\":\"0cf0b702c5ec3a21957d09a6ccce34030c7318c5689582868f2e3124eb4fccc9\",\"id\":\"69c8b6c6630abed3708bd918\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Highlighted target areas for data table mouse interactions\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69c8b74e61e5f877775fae04\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b74861e5f877775fae03\"}],\"id\":\"69c8b70c61e5f877775fae02\"},{\"isPrivate\":false,\"heading\":\"Hover\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The data table’s row hover state should always be enabled as it can help the user visually scan the columns of data in a row even if the row is not interactive.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:24:46.033Z\",\"updatedAt\":\"2026-04-20T11:32:59.935Z\",\"alt\":\"Data table row hover\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-hover-1.png\",\"filename\":\"datatable-hover-1.png\",\"mimeType\":\"image/png\",\"filesize\":14888,\"width\":1216,\"height\":684,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-hover-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":13717,\"filename\":\"datatable-hover-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-hover-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":38678,\"filename\":\"datatable-hover-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-hover-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":13717,\"filename\":\"datatable-hover-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-hover-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":39809,\"filename\":\"datatable-hover-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-hover-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":80447,\"filename\":\"datatable-hover-1-928x522.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-hover-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":108727,\"filename\":\"datatable-hover-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-hover-1-288x162.png\",\"checksum\":\"f5d3e56b7c287701fae6dfff38e593286ba3220ab6679bedcda42b5e096328c4\",\"id\":\"69c8b79ecab2a5d5b3979ef9\"},\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"69c8b78561e5f877775fae07\"}],\"itemsPerRow\":\"1\",\"colLg\":\"12\",\"colLgPair\":\"4\",\"id\":\"69c8b77e61e5f877775fae06\"}],\"id\":\"69c8b76b61e5f877775fae05\"}],\"id\":\"69c8b67161e5f877775fadfd\"},{\"isPrivate\":false,\"heading\":\"Pagination\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Pagination divides a data table into separate pages. Simple pagination indicates the current page in view and offers controls to go to the previous or next page. Advanced pagination is accompanied by an option that enables the user to change the number of items per page and to jump to a specific page number. The pagination component is always placed at the bottom of the data table. For more information, see the \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"pagination\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Pagination\",\"relationTo\":\"components-core\",\"value\":{\"pageHeader\":{\"releaseStatus\":\"stable\",\"resources\":{\"githubUrl\":\"https://github.com/carbon-design-system/carbon/tree/main/packages/react/src/components/Pagination\",\"storybookUrl\":\"https://react.carbondesignsystem.com/?path=/docs/components-pagination--overview\"}},\"name\":\"Pagination\",\"slug\":\"pagination\",\"meta\":{\"image\":{\"createdAt\":\"2026-06-24T12:31:50.734Z\",\"updatedAt\":\"2026-06-24T12:31:51.289Z\",\"alt\":\"Pagination\",\"visibility\":\"public\",\"checksum\":\"f96168edb36b39c51173b1226d721728f1780d6fef8186d8486bb5ae2b93a577\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/Pagination.svg\",\"filename\":\"Pagination.svg\",\"mimeType\":\"image/svg+xml\",\"filesize\":2914,\"width\":320,\"height\":320,\"sizes\":{\"thumbnail\":{\"url\":null},\"square\":{\"url\":null},\"small\":{\"url\":null},\"medium\":{\"url\":null},\"large\":{\"url\":null},\"og\":{\"url\":null}},\"thumbnailURL\":null,\"id\":\"6a3bce3684d7dda97db0203d\"},\"description\":\"Pagination splits content or data into several pages, with a control for navigating to the next or previous page.\"},\"tabs\":[{\"slug\":\"guidelines\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"9036efd1e4f244896cfc2cd1\"},{\"slug\":\"specifications\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"f0047e415668fc98998d8079\"},{\"slug\":\"code\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"807fcc47093a3b9a7bd5c1df\"},{\"slug\":\"accessibility\",\"a11y\":{\"showStatusTable\":true,\"selectedTables\":[\"Pagination\"]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"f8454419d87d14cdf6b9aaf0\"}],\"breadcrumbs\":[{\"url\":\"/pagination\",\"id\":\"6a4d1a6a1974e7003cd37ee7\"}],\"id\":\"69b2adcbec396b3eb7c9140f\"}},\"tab\":\"guidelines\",\"linkType\":\"internal\"},\"id\":\"69c8b7bfdac39f9b36311e9e\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" component.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-29T05:25:54.477Z\",\"updatedAt\":\"2026-06-12T15:34:14.374Z\",\"alt\":\"Data table pagination\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-pagination-1.png\",\"filename\":\"datatable-pagination-1.png\",\"mimeType\":\"image/png\",\"filesize\":35957,\"width\":1728,\"height\":972,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-pagination-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":11464,\"filename\":\"datatable-pagination-1-288x162.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-pagination-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":24991,\"filename\":\"datatable-pagination-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-pagination-1-288x162.png\",\"width\":288,\"height\":162,\"mimeType\":\"image/png\",\"filesize\":11464,\"filename\":\"datatable-pagination-1-288x162.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-pagination-1-608x342.png\",\"width\":608,\"height\":342,\"mimeType\":\"image/png\",\"filesize\":34243,\"filename\":\"datatable-pagination-1-608x342.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-pagination-1-928x522.png\",\"width\":928,\"height\":522,\"mimeType\":\"image/png\",\"filesize\":60325,\"filename\":\"datatable-pagination-1-928x522.png\"},\"og\":{\