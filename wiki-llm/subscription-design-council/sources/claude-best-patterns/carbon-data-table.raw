dium, large, and extra large\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"6a70475e575b72003c60ff98\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"6a70475d31bc080db4c98b86\"},{\"blockType\":\"contentRichText\",\"isPrivate\":false,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The column header row \",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\".cds--data-table thead\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" should always match the row size of the table. Extra large row heights are only recommended if your data is expected to have 2 lines of content in a single row.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"colLg\":\"8\",\"id\":\"6a70478b31bc080db4c98b87\"},{\"blockType\":\"doDont\",\"isPrivate\":false,\"examples\":[{\"type\":\"do\",\"media\":{\"createdAt\":\"2026-03-29T05:04:11.622Z\",\"updatedAt\":\"2026-04-20T11:32:59.751Z\",\"alt\":\"Do: Do use the same row height for the table and header rows.\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-header-size-do-1.png\",\"filename\":\"datatable-header-size-do-1.png\",\"mimeType\":\"image/png\",\"filesize\":5703,\"width\":576,\"height\":576,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/datatable-header-size-do-1-288x288.png\",\"width\":288,\"height\":288,\"mimeType\":\"imag