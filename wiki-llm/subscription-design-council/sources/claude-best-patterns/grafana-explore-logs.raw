vability-benefits-for-business/","plcmt":"learn-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/42efe38999/icon-nav-benefits-of-observability.svg"},{"text":"Success Stories","href":"/success/","plcmt":"learn-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/9a1805f0cf/icon-nav-success-stories.svg"}]}]},{"groups":[{"header":"HOW-TO","description":"","plcmt":"learn-nav","items":[{"text":"Documentation","href":"/docs/","plcmt":"learn-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/485866931d/icon-nav-how-to-docs.svg","target":"_blank"},{"text":"Webinars & Videos","href":"/videos/","plcmt":"learn-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/c14210d699/icon-nav-webinars-videos.svg"},{"text":"Tutorials","href":"/tutorials/","plcmt":"learn-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/1fe3485643/icon-nav-tutorials.svg"},{"text":"Workshops","href":"/workshops/","plcmt":"learn-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/ce6955c2f6/icon-nav-workshop.svg"},{"text":"Grafana Learn","href":"/docs/learning-hub/","plcmt":"learn-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/020c706da2/icon-nav-learning-journeys.svg","target":"_blank"},{"text":"Professional Services","href":"/professional-services/","plcmt":"learn-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/f766349529/icon-nav-professional-services.svg"}]}]},{"groups":[{"header":"FEATURED WEBINAR","description":"","plcmt":"learn-nav","items":[{"text":"Get started with Grafana Assistant","href":"/go/webinar/getting-started-with-grafana-assistant/","plcmt":"learn-nav","description":"<p>Learn how to get started with Grafana Cloud&#039;s AI Assistant for faster insights.</p>","image":{"src":"https://a-us.storyblok.com/f/1022730/1386x780/b92a0db445/grafanaassistantgeneralmetaimage.png/m/filters:format(webp):quality(75)/","alt":"Get started with Grafana Assistant"}}]}]}]},{"type":"link","text":"Docs","href":"/docs/","plcmt":"nav"},{"type":"dropdown","text":" Company","href":"","plcmt":"company-nav","columns":[{"items":[{"text":"About Grafana Labs","href":"/about/grafana-labs","plcmt":"company-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/3a62f7f3e2/icon-nav-grafana.svg"},{"text":"Newsroom","href":"/press/","plcmt":"company-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/06dc558ac7/icon-nav-newsroom.svg"},{"text":"Success stories","href":"/success/","plcmt":"company-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/9a1805f0cf/icon-nav-success-stories.svg"},{"text":"Partnerships","href":"/partnerships/","plcmt":"company-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/0fa4edd4c6/icon-nav-partnership.svg"},{"text":"Careers","href":"/careers/","plcmt":"company-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/301345e926/icon-nav-careers.svg"},{"text":"Leadership","href":"/about/grafana-labs#meet-our-founders","plcmt":"company-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/ac9118bcd9/icon-nav-leadership.svg"},{"text":"Hey AI","href":"/ai-info/","plcmt":"company-nav","icon":"https://a-us.storyblok.com/f/1022730/24x24/0680514922/icon-nav-hey-ai.svg"}]}]}],"button_group":[{"text":"AI/Search","icon":"https://a-us.storyblok.com/f/567658451994139/16x16/d2d9bfecdd/icon-grafana-ai-search-btn.svg","variant":"link","action":"openSearchModal","url":null},{"type":"link","text":"Sign in","href":"/auth/sign-in/","plcmt":"nav"},{"type":"button","text":"Sign up","href":"/auth/sign-up/create-user","plcmt":"nav","variant":"primary"}]},"search_modal":{"placeholder":"What do you want to know?","buttons":[{"text":"Site Search","icon":"https://a-us.storyblok.com/f/567658451994139/14x14/26edb0b9d8/icon-grafana-search.svg","variant":"outline","action":"siteSearch","url":null},{"text":"Ask AI","icon":"https://a-us.storyblok.com/f/567658451994139/14x14/71b3167fed/ai-icon.svg","variant":"primary","action":"askAI","url":null}],"askAiUrl":"/grot/","siteSearchUrl":"/search"},"plcmt":"nav"},"locale":"en","available