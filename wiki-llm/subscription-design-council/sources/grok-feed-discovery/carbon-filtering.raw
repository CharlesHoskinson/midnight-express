e,\"heading\":\"Multiselect\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Use a multiselect filter when the user has the option to pick more than one attribute to modify the data results. Under the hood, multiselects behave like \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"checkboxes\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Checkbox\",\"relationTo\":\"components-core\",\"value\":{\"name\":\"Checkbox\",\"pageHeader\":{\"releaseStatus\":\"stable\",\"resources\":{\"githubUrl\":\"https://github.com/carbon-design-system/carbon/tree/main/packages/react/src/components/Checkbox\",\"storybookUrl\":\"https://react.carbondesignsystem.com/?path=/docs/components-checkbox--overview\"}},\"slug\":\"checkbox\",\"meta\":{\"image\":{\"createdAt\":\"2026-06-22T15:21:21.606Z\",\"updatedAt\":\"2026-06-22T15:21:21.742Z\",\"alt\":\"Checkbox\",\"visibility\":\"public\",\"checksum\":\"7a5c1f02296dd2ac1c2fb26e1cba317f31b6da091deeb56d7296dc84cd2799dd\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/Checkbox.svg\",\"filename\":\"Checkbox.svg\",\"mimeType\":\"image/svg+xml\",\"filesize\":2652,\"width\":320,\"height\":320,\"sizes\":{\"thumbnail\":{\"url\":null},\"square\":{\"url\":null},\"small\":{\"url\":null},\"medium\":{\"url\":null},\"large\":{\"url\":null},\"og\":{\"url\":null}},\"thumbnailURL\":null,\"id\":\"6a3952f1cd98e71403023b20\"},\"description\":\"Checkboxes are used when there are multiple items to select in a list. Users can select zero, one, or any number of items.\"},\"tabs\":[{\"slug\":\"guidelines\",\"a11y\":{\"showStatusTable\":false,\"selectedTables\":[]},\"a11yStatus\":{\"showStatusTable\":true},\"id\":\"c00b3714237993a72ead9829\"},{\"slug\":\"specifications\",\"a11y\":{\"showStatusTable\":false,\"s