-928x456.png\",\"width\":928,\"height\":456,\"mimeType\":\"image/png\",\"filesize\":47258,\"filename\":\"filter-2-928x456.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-2-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":77715,\"filename\":\"filter-2-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/filter-2-288x142.png\",\"checksum\":\"25edb0a6c2a288afcf24ef14c965b8ccc0f3579f714aa6c05f073c908b75af96\",\"id\":\"69dbc9d1a7e304ff901b3ca1\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Example of a multiselect filter in a checkbox set\",\"version\":1}]}]}},\"id\":\"69dbc9d9a20c2596ff010f4e\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbc9d9a20c2596ff010f4d\"}],\"subsections\":[],\"id\":\"69dbc9d9a20c2596ff010f4f\"},{\"isPrivate\":false,\"heading\":\"Selecting multiple categories\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"A category is a set of filter items within the same topic. For example, \\\"size\\\" is a category and \",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"small\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\", \",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"medium\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\", \",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"large\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\", and \",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":16,\"mode\":\"normal\",\"style\":\"\",\"text\":\"extra large\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" are its filter choices. Multiple filter categories may be applied to the same data set. For example, the user can filter by size, color, and price range.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Multiple category selection is usually placed vertically on the left side of the page or horizontally at the top of the data set. Multiple categories should never be put within a menu or dropdown.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T16:35:30.564Z\",\"updatedAt\":\"2026-04-20T11:33:37.001Z\",\"alt\":\"Example of multiple filter categories\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-3.png\",\"filename\":\"filter-3.png\",\"mimeType\":\"image/png\",\"filesize\":16143,\"width\":1472,\"height\":1122,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-3-288x220.png\",\"width\":288,\"height\":220,\"mimeType\":\"image/png\",\"filesize\":16774,\"filename\":\"filter-3-288x220.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-3-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":23835,\"filename\":\"filter-3-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-3-288x220.png\",\"width\":288,\"height\":220,\"mimeType\":\"image/png\",\"filesize\":16774,\"filename\":\"filter-3-288x220.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-3-608x463.png\",\"width\":608,\"height\":463,\"mimeType\":\"image/png\",\"filesize\":39541,\"filename\":\"filter-3-608x463.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-3-928x707.png\",\"width\":928,\"height\":707,\"mimeType\":\"image/png\",\"filesize\":69679,\"filename\":\"filter-3-928x707.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-3-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":64391,\"filename\":\"filter-3-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/filter-3-288x220.png\",\"checksum\":\"3d4beda530fc0aa51827e9438145323f75b2d7b35755a303ac011fd57396c199\",\"id\":\"69dbc9d2a7e304ff901b3ca8\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Example of multiple filter categories\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69dbc9d9a20c2596ff010f51\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbc9d9a20c2596ff010f50\"}],\"subsections\":[],\"id\":\"69dbc9d9a20c2596ff010f52\"},{\"isPrivate\":false,\"heading\":\"Multiple filters with batch updates\",\"intro\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Use a batch filter when all filters are applied together at the end of the selection process. The data set only refreshes once at user action. The trigger is most commonly an \\\"Apply filters\\\" button.\",\"version\":1}]},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The batch filter works best when the user is making several filtering selections across different categories that may take a longer time to mentally process. Batch filtering is also a good solution for slow data-return speeds. This can prevent the user from having to wait for the data to load after every selection.\",\"version\":1}]}]}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T16:35:31.853Z\",\"updatedAt\":\"2026-04-20T11:33:36.997Z\",\"alt\":\"Example of batch filtering\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-4.png\",\"filename\":\"filter-4.png\",\"mimeType\":\"image/png\",\"filesize\":8742,\"width\":1216,\"height\":912,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-4-288x216.png\",\"width\":288,\"height\":216,\"mimeType\":\"image/png\",\"filesize\":9223,\"filename\":\"filter-4-288x216.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-4-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":23077,\"filename\":\"filter-4-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-4-288x216.png\",\"width\":288,\"height\":216,\"mimeType\":\"image/png\",\"filesize\":9223,\"filename\":\"filter-4-288x216.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-4-608x456.png\",\"width\":608,\"height\":456,\"mimeType\":\"image/png\",\"filesize\":23346,\"filename\":\"filter-4-608x456.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-4-928x696.png\",\"width\":928,\"height\":696,\"mimeType\":\"image/png\",\"filesize\":44801,\"filename\":\"filter-4-928x696.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-4-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":61228,\"filename\":\"filter-4-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/filter-4-288x216.png\",\"checksum\":\"93773e38e6350db8c22817c16b0c7196a5b0bcca70482a45480d471634cf8d34\",\"id\":\"69dbc9d3a7e304ff901b3caf\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Example of batch filtering\",\"version\":1}]}]}},\"id\":\"69dbc9d9a20c2596ff010f54\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbc9d9a20c2596ff010f53\"}],\"subsections\":[],\"id\":\"69dbc9d9a20c2596ff010f55\"},{\"isPrivate\":false,\"heading\":\"Multiple filters with instant updates\",\"intro\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"This method returns results after each individual selection is made. The trigger is the individual selection and the filter manipulates the data in real time. This is a good solution for when the user is only selecting from one category or the user is expected to only make one filter selection.\",\"version\":1}]}]}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[],\"id\":\"69dbc9d9a20c2596ff010f56\"}],\"id\":\"69dbc9d9a20c2596ff010f32\",\"blockName\":\"Selection methods\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Filter states\",\"intro\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Filters within each category should start either as \",\"version\":1},{\"type\":\"text\",\"detail\":0,\"format\":2,\"mode\":\"normal\",\"style\":\"\",\"text\":\"all unselected\",\"version\":1},{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" or \",\"version\":1},{\"type\":\"text\",\"detail\":0,\"format\":2,\"mode\":\"normal\",\"style\":\"\",\"text\":\"all selected\",\"version\":1},{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\". When using multiple categories, the start state can vary from category to category. If the user typically wants only one or a few criteria to be excluded from the results, then all filters should be selected at the start. If the user typically wants to see only results related to one particular criteria, then all filters should start as unselected.\",\"version\":1}]}]}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T16:35:33.401Z\",\"updatedAt\":\"2026-04-20T11:33:36.999Z\",\"alt\":\"Example of filter without selections\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-5.png\",\"filename\":\"filter-5.png\",\"mimeType\":\"image/png\",\"filesize\":5310,\"width\":1216,\"height\":912,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-5-288x216.png\",\"width\":288,\"height\":216,\"mimeType\":\"image/png\",\"filesize\":4570,\"filename\":\"filter-5-288x216.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-5-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":11728,\"filename\":\"filter-5-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-5-288x216.png\",\"width\":288,\"height\":216,\"mimeType\":\"image/png\",\"filesize\":4570,\"filename\":\"filter-5-288x216.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-5-608x456.png\",\"width\":608,\"height\":456,\"mimeType\":\"image/png\",\"filesize\":11681,\"filename\":\"filter-5-608x456.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-5-928x696.png\",\"width\":928,\"height\":696,\"mimeType\":\"image/png\",\"filesize\":22125,\"filename\":\"filter-5-928x696.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-5-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":30373,\"filename\":\"filter-5-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/filter-5-288x216.png\",\"checksum\":\"cb8b50f6e3af12bb25baf2c04ae95a16d2361e408d6a80a7245440986c131c62\",\"id\":\"69dbc9d5a7e304ff901b3cb6\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Example of filter without selections\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"id\":\"69dbc9d9a20c2596ff010f59\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbc9d9a20c2596ff010f58\"},{\"blockType\":\"contentRichText\",\"isPrivate\":false,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"If the filter(s) can be hidden in either a drawer, dropdown, or menu, then there should be an indicator visible on the closed filter state that informs the user that filters have been applied. At a minimum, the indicator should include the number of filters applied and have the option to clear filters without re-opening the filter container.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"colLg\":\"8\",\"id\":\"69dbc9d9a20c2596ff010f5a\"},{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T16:35:34.986Z\",\"updatedAt\":\"2026-04-20T11:33:36.975Z\",\"alt\":\"Example of filter with selections\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-6.png\",\"filename\":\"filter-6.png\",\"mimeType\":\"image/png\",\"filesize\":6318,\"width\":1216,\"height\":912,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-6-288x216.png\",\"width\":288,\"height\":216,\"mimeType\":\"image/png\",\"filesize\":6144,\"filename\":\"filter-6-288x216.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-6-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":15306,\"filename\":\"filter-6-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-6-288x216.png\",\"width\":288,\"height\":216,\"mimeType\":\"image/png\",\"filesize\":6144,\"filename\":\"filter-6-288x216.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-6-608x456.png\",\"width\":608,\"height\":456,\"mimeType\":\"image/png\",\"filesize\":14960,\"filename\":\"filter-6-608x456.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-6-928x696.png\",\"width\":928,\"height\":696,\"mimeType\":\"image/png\",\"filesize\":28607,\"filename\":\"filter-6-928x696.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-6-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":38904,\"filename\":\"filter-6-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/filter-6-288x216.png\",\"checksum\":\"ef1074392937a1a885f095325865a70a760f0c6b7d7fd18062934bc64bddaa7c\",\"id\":\"69dbc9d6a7e304ff901b3cbd\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Example of filter with selections\",\"version\":1}]}]}},\"id\":\"69dbc9d9a20c2596ff010f5c\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbc9d9a20c2596ff010f5b\"}],\"sections\":[],\"id\":\"69dbc9d9a20c2596ff010f57\",\"blockName\":\"Filter states\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Resetting filters\",\"intro\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Each category should have a way to clear all applied filters at once without having to interact with each individual item. Clearing filters returns the filters to their original default starting state.\",\"version\":1}]},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"If multiple categories have been applied to the same data set then there should also be a way to dismiss all filters across all categories at once.\",\"version\":1}]}]}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T16:35:36.254Z\",\"updatedAt\":\"2026-04-20T11:33:36.982Z\",\"alt\":\"Filter reset example\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-7.png\",\"filename\":\"filter-7.png\",\"mimeType\":\"image/png\",\"filesize\":6593,\"width\":1472,\"height\":462,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-7-288x90.png\",\"width\":288,\"height\":90,\"mimeType\":\"image/png\",\"filesize\":7787,\"filename\":\"filter-7-288x90.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-7-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":12332,\"filename\":\"filter-7-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-7-288x90.png\",\"width\":288,\"height\":90,\"mimeType\":\"image/png\",\"filesize\":7787,\"filename\":\"filter-7-288x90.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-7-608x191.png\",\"width\":608,\"height\":191,\"mimeType\":\"image/png\",\"filesize\":18566,\"filename\":\"filter-7-608x191.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-7-928x291.png\",\"width\":928,\"height\":291,\"mimeType\":\"image/png\",\"filesize\":31444,\"filename\":\"filter-7-928x291.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/filter-7-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":58228,\"filename\":\"filter-7-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/filter-7-288x90.png\",\"checksum\":\"efb1b2e724bd2039aa4d010c51d122cb01828d5f556d738fc08f1b95815e7e3e\",\"id\":\"69dbc9d8a7e304ff901b3cc4\"},\"iconColor\":\"light\",\"hideCaption\":true,\"captionText\":null,\"id\":\"69dbc9d9a20c2596ff010f5f\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbc9d9a20c2596ff010f5e\"}],\"sections\":[],\"id\":\"69dbc9d9a20c2596ff010f5d\",\"blockName\":\"Resetting filters\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Related\",\"intro\":null,\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"Components\",\"intro\":null,\"blocks\":[],\"contentFlow\":[{\"blockType\":\"contentRichText\",\"isPrivate\":false,\"content\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Radio button\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fie