:"text","value":". For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/managing-subscriptions-for-activity-on-github/managing-your-subscriptions"},"children":[{"type":"text","value":"Managing your subscriptions"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"default-subscriptions","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#default-subscriptions"},"children":[{"type":"text","value":"Default subscriptions"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"In general, you are automatically subscribed to conversations by default when you have:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Not disabled automatic watching for repositories or teams you've joined in your notification settings. This setting is enabled by default."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Been assigned to an issue or pull request."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Opened a pull request or issue."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Commented on a thread."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Subscribed to a thread manually by clicking "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Watch"}]},{"type":"text","value":" or "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Subscribe"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Had your username @mentioned."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Changed the state of a thread, such as by closing an issue or merging a pull request."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Had a team you're a member of @mentioned."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"By default, you also automatically watch all repositories that you create and are owned by your personal account."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To unsubscribe from conversations you're automatically subscribed to, you can change your notification settings or directly unsubscribe or unwatch activity on GitHub. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/managing-subscriptions-for-activity-on-github/managing-your-subscriptions"},"children":[{"type":"text","value":"Managing your subscriptions"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"customizing-notifications-and-subscriptions","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#customizing-notifications-and-subscriptions"},"children":[{"type":"text","value":"Customizing notifications and subscriptions"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can choose to view your notifications through the notifications inbox at "},{"type":"element","tagName":"a","properties":{"href":"https://github.com/notifications"},"children":[{"type":"text","value":"https://github.com/notifications"}]},{"type":"text","value":" and in the GitHub Mobile app, through your email, or some combination of these options."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To customize the types of updates you'd like to receive and where to send those updates, configure your notification settings. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/get-started/configuring-notifications"},"children":[{"type":"text","value":"Configuring notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To keep your subscriptions manageable, review your subscriptions and watched repositories and unsubscribe as needed. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/managing-subscriptions-for-activity-on-github"},"children":[{"type":"text","value":"Managing subscriptions for activity on GitHub"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To customize how you'd like to receive updates for specific pull requests or issues, you can configure your preferences within the issue or pull request. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/viewing-and-triaging-notifications/triaging-a-single-notification#customizing-when-to-receive-future-updates-for-an-issue-or-pull-request"},"children":[{"type":"text","value":"Triaging a single notification"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Each email notification that GitHub sends contains header information that you can use to filter notifications in your email client. For information about the headers included, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/reference/email-notification-headers"},"children":[{"type":"text","value":"Email notification headers"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can customize and schedule push notifications in the GitHub Mobile app. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/get-started/configuring-notifications#managing-your-notification-settings-with-github-mobile"},"children":[{"type":"text","value":"Configuring notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"reasons-for-receiving-notifications","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#reasons-for-receiving-notifications"},"children":[{"type":"text","value":"Reasons for receiving notifications"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Your inbox is configured with default filters, which represent the most common reasons that people need to follow-up on their notifications. For more information about inbox filters, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/viewing-and-triaging-notifications/managing-notifications-from-your-inbox#default-notification-filters"},"children":[{"type":"text","value":"Managing notifications from your inbox"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Your inbox shows the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"reason"}]},{"type":"text","value":" you're receiving a notification as a label, such as, "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"mention"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"subscribed"}]},{"type":"text","value":", or "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"review requested"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can filter your inbox by the reason you're subscribed to notifications. For example, to only see pull requests where someone requested your review, you can use the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"reason:review-requested"}]},{"type":"text","value":" query filter."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"If you've configured notifications to be sent by email and believe you're receiving notifications that don't belong to you, consider troubleshooting with email headers, which show the intended recipient. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/reference/email-notification-headers"},"children":[{"type":"text","value":"Email notification headers"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"triaging-notifications-from-your-inbox","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#triaging-notifications-from-your-inbox"},"children":[{"type":"text","value":"Triaging notifications from your inbox"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To effectively manage your notifications, you can triage your inbox with options to:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Remove a notification from the inbox with "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Done"}]},{"type":"text","value":". You can review "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Done"}]},{"type":"text","value":" notifications all in one place by clicking "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Done"}]},{"type":"text","value":" in the sidebar or by using the query "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"is:done"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Mark a notification as read or unread."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Save"}]},{"type":"text","value":" a notification for later review. "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Saved"}]},{"type":"text","value":" notifications are flagged in your inbox. You can review "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Saved"}]},{"type":"text","value":" notifications all in one place in the sidebar by clicking "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Saved"}]},{"type":"text","value":" or by using the query "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"is:saved"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Automatically unsubscribe from this notification and future updates from this conversation. Unsubscribing also removes the notification from your inbox. If you unsubscribe from a conversation and someone mentions your username or a team you're on that you're receiving updates for, then you will start to receive notifications from this conversation again."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"From your inbox you can also triage multiple notifications at once. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/viewing-and-triaging-notifications/managing-notifications-from-your-inbox#triaging-multiple-notifications-at-the-same-time"},"children":[{"type":"text","value":"Managing notifications from your inbox"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"customizing-your-notifications-inbox","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#customizing-your-notifications-inbox"},"children":[{"type":"text","value":"Customizing your notifications inbox"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To focus on a group of notifications in your inbox, you can create custom filters. For example, you can create a custom filter for an open source project you contribute to and only see notifications for that repository in which you are mentioned. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/how-tos/viewing-and-triaging-notifications/managing-notifications-from-your-inbox"},"children":[{"type":"text","value":"Managing notifications from your inbox"}]},{"type":"text","value":". For more examples of how to customize your triaging workflow, see "},{"type":"element","tagName":"a","properties":{"href":"/en/subscriptions-and-notifications/tutorials/customizing-a-workflow-for-triaging-your-notifications"},"children":[{"type":"text","value":"Customizing a workflow for triaging your notifications"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"notification-retention-policy","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#notification-retention-policy"},"children":[{"type":"text","value":"Notification retention policy"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Notifications that are not marked as "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Saved"}]},{"type":"text","value":" are kept for 3 months. Notifications marked as "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Saved"}]},{"type":"text","value":" are kept indefinitely. If your saved notification is older than 3 months and you unsave it, the notification will disappear from your inbox within a day."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"feedback-and-support","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#feedback-and-support"},"children":[{"type":"text","value":"Feedback and support"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"If you have feedback or feature requests for notifications, use a "},{"type":"element","tagName":"a","properties":{"href":"https://github.com/orgs/community/discussions/categories/general"},"children":[{"type":"text","value":"GitHub Community discussion"}]},{"type":"text","value":"."}]}],"data":{"quirksMode":false}},"miniTocItems":[{"contents":{"href":"#notifications-and-subscriptions","title":"Notifications and subscriptions"}},{"contents":{"href":"#customizing-notifications-and-subscriptions","title":"Customizing notifications and subscriptions"}},{"contents":{"href":"#reasons-for-receiving-notifications","title":"Reasons for receiving notifications"}},{"contents":{"href":"#triaging-notifications-from-your-inbox","title":"Triaging notifications from your inbox"}},{"contents":{"href":"#customizing-your-notifications-inbox","title":"Customizing your notifications inbox"}},{"contents":{"href":"#notification-retention-policy","title":"Notification retention policy"}},{"contents":{"href":"#feedback-and-support","title":"Feedback and support"}}],"permissions":"","includesPlatformSpecificContent":false,"includesToolSpecificContent":false,"defaultPlatform":"","defaultTool":"","product":"","currentJourneyTrack":null,"detectedPlatforms":[],"detectedTools":[],"allTools":{"vscode":"Visual Studio Code