":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notifications should be related to the user’s goals and presented in the context of what they are doing\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablerow\",\"version\":1},{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Timely\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Ensure users are kept up to date with prompt notifications and see critical notifications immediately\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablerow\",\"version\":1},{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Informative\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Provide users with the context and next steps needed to understand and address the notification\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablecell\",\"version\":1,\"backgroundColor\":null,\"colSpan\":1,\"headerState\":0,\"rowSpan\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"tablerow\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"table\",\"version\":1,\"colWidths\":[92,92]},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Be considerate of your users when sending a notification. Notifications that are too frequent or disruptive create negative experiences and drive users from platforms.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notifications are comprised of status and type. Their status signifies the purpose of the information being conveyed. Notification types allow you to tailor the disruptiveness of the notification to the specific situation.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"colLg\":\"8\",\"id\":\"69dbd5eb61dc796180fbf753\"},{\"blockType\":\"twoColumnText\",\"isPrivate\":false,\"columns\":[{\"title\":\"Notification status\",\"content\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Informational\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Success\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Warning\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Error\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":4}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"format\":\"\",\"type\":\"root\",\"version\":1}},\"id\":\"6a3aed388286a8003cba57b7\"},{\"title\":\"Notification type\",\"content\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Inline\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Toast\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Actionable\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Callout\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":4},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Banner\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":5},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notification panel\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":6},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Modal\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":7}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"format\":\"\",\"type\":\"root\",\"version\":1}},\"id\":\"6a3aed388286a8003cba57b8\"}],\"id\":\"6a3aed378d86655f27d334b2\"}],\"sections\":[],\"id\":\"69dbd5eb61dc796180fbf745\",\"blockName\":\"Overview\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Designing with notifications\",\"intro\":null,\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"When to use\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Use notifications to inform users of important status changes and updates. Transparency is a core element of building user trust and is the first of Jakob Nielsen’s \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"10 usability heuristics\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"linkType\":\"custom\",\"newTab\":false,\"url\":\"https://www.nngroup.com/articles/ten-usability-heuristics/\"},\"id\":\"6a3aed8359221b8025965913\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\". They should be relevant to the user and as minimally disruptive as possible. There are two major use cases for notifications: task-generated and system-generated.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[{\"isPrivate\":false,\"heading\":\"Task-generated notifications\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Task-generated notifications are initiated in response to user action during a specific task. They give users direct, immediate feedback. They should be placed in the region of the page the user is working in and be related to the user’s action.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"contentRichText\",\"isPrivate\":false,\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"You might send a task-generated notification when:\",\"version\":1}]},{\"type\":\"list\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\",\"children\":[{\"type\":\"listitem\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"value\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"A form is successfully submitted\",\"version\":1}]}]},{\"type\":\"listitem\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"value\":2,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"There is a problem uploading a file\",\"version\":1}]}]},{\"type\":\"listitem\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"value\":3,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Credentials can't be found\",\"version\":1}]}]}]}]}},\"colLg\":\"8\",\"id\":\"69dbd5eb61dc796180fbf756\"}],\"id\":\"69dbd5eb61dc796180fbf757\"},{\"isPrivate\":false,\"heading\":\"System-generated notifications\",\"intro\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"These notifications are initiated by the application or system, independent of user action. They provide updates on background system status or out-of-context events that have finished.\",\"version\":1}]}]}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"contentRichText\",\"isPrivate\":false,\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"You might send a system-generated notification when:\",\"version\":1}]},{\"type\":\"list\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\",\"children\":[{\"type\":\"listitem\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"value\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"A user loses network connection\",\"version\":1}]}]},{\"type\":\"listitem\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"value\":2,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Planned system maintenance is coming soon\",\"version\":1}]}]},{\"type\":\"listitem\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"value\":3,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"A new report is ready\",\"version\":1}]}]},{\"type\":\"listitem\",\"version\":1,\"format\":\"\",\"indent\":0,\"direction\":null,\"value\":4,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The user's login session is about to expire\",\"version\":1}]}]}]}]}},\"colLg\":\"8\",\"id\":\"69dbd5eb61dc796180fbf758\"}],\"id\":\"69dbd5eb61dc796180fbf759\"}],\"id\":\"69dbd5eb61dc796180fbf75a\"},{\"isPrivate\":false,\"heading\":\"When not to use\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Only send notifications where necessary. Confine each notification to the portion of the interface and workflow it is relevant to. Being interrupted creates a frustrating and discouraging experience for users, so this should be limited as much as possible. Additionally, frequent distractions \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"lower productivity\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"linkType\":\"custom\",\"newTab\":false,\"url\":\"https://link.springer.com/chapter/10.1007/978-1-4842-4221-6_9#Sec22\"},\"id\":\"6a3aef5d59221b8025965914\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" and can lead to \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"alert fatigue\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"linkType\":\"custom\",\"newTab\":false,\"url\":\"https://psnet.ahrq.gov/primer/alert-fatigue\"},\"id\":\"6a3aef5d59221b8025965915\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\".\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf75b\"}],\"id\":\"69dbd5eb61dc796180fbf754\",\"blockName\":\"Designing with notifications\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Notification status\",\"intro\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notification statuses are designed to convey the emotional tone of the information being communicated. Each status is associated with a specific color and icon, ensuring a consistent and universal user experience.\",\"version\":1}]}]}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-03-14T14:33:23.050Z\",\"updatedAt\":\"2026-04-20T11:32:51.737Z\",\"alt\":\"Example of notification status\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/1_notification_status_1120.png\",\"filename\":\"1_notification_status_1120.png\",\"mimeType\":\"image/png\",\"filesize\":17386,\"width\":1728,\"height\":791,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/1_notification_status_1120-288x132.png\",\"width\":288,\"height\":132,\"mimeType\":\"image/png\",\"filesize\":7869,\"filename\":\"1_notification_status_1120-288x132.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/1_notification_status_1120-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":20946,\"filename\":\"1_notification_st