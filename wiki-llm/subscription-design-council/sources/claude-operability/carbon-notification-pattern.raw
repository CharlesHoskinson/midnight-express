nText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Low-contrast inline notification\",\"version\":1}]}]}},\"id\":\"69dbd5eb61dc796180fbf79f\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbd5eb61dc796180fbf79e\"}],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7a0\"},{\"isPrivate\":false,\"heading\":\"Toast\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Toasts\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Notification\",\"relationTo\":\"components-core\",\"value\":\"$6:0:props:layout:3:sections:0:intro:root:children:0:children:0:fields:doc:value\"},\"tab\":\"guidelines\",\"linkType\":\"internal\"},\"id\":\"6a3af28959221b8025965919\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" are notifications that slide in and out, typically in the top right of the page. They are more disruptive than inline notifications and are best used with system-generated messages that do not correspond to a specific section of the UI.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Carbon toasts can be either low-contrast or high-contrast. Their color should correspond with the message intent and they can also use an icon to convey the message intent.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T17:26:45.371Z\",\"updatedAt\":\"2026-04-20T11:33:38.440Z\",\"alt\":\"Example of a toast notification without actions (left) and actionable toast notification (right)\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/4_toast_static_736.png\",\"filename\":\"4_toast_static_736.png\",\"mimeType\":\"image/png\",\"filesize\":42316,\"width\":2240,\"height\":1440,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/4_toast_static_736-288x185.png\",\"width\":288,\"height\":185,\"mimeType\":\"image/png\",\"filesize\":16861,\"filename\":\"4_toast_static_736-288x185.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/4_toast_static_736-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":33490,\"filename\":\"4_toast_static_736-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/4_toast_static_736-288x185.png\",\"width\":288,\"height\":185,\"mimeType\":\"image/png\",\"filesize\":16861,\"filename\":\"4_toast_static_736-288x185.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/4_toast_static_736-608x391.png\",\"width\":608,\"height\":391,\"mimeType\":\"image/png\",\"filesize\":47087,\"filename\":\"4_toast_static_736-608x391.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/4_toast_static_736-928x597.png\",\"width\":928,\"height\":597,\"mimeType\":\"image/png\",\"filesize\":86862,\"filename\":\"4_toast_static_736-928x597.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/4_toast_static_736-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":125014,\"filename\":\"4_toast_static_736-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/4_toast_static_736-288x185.png\",\"checksum\":\"46fca90edb2bc1486ee80b712edec74e314c1b129b982f2caefeb81935c51f0b\",\"id\":\"69dbd5d5c4621ec2329f5834\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Example of a toast notification without actions (left) and actionable toast notification (right)\",\"version\":1}]}]}},\"id\":\"69dbd5eb61dc796180fbf7a3\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbd5eb61dc796180fbf7a2\"},{\"blockType\":\"contentRichText\",\"isPrivate\":false,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Long messages\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Removing the timestamp provides space for a third line of content for longer toast messages. Toasts are intended to be at-a-glance messages confined to a small region of the screen so their messages should not exceed three lines.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Best practices:\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Multiple toasts stack vertically, with the newest appearing at the top of the list.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Keep messages clear and concise.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The timestamp is optional and can be removed.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Toast notifications have a fixed width and should not be expanded to fit the content area.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":4}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"colLg\":\"8\",\"id\":\"6a3af2b28d86655f27d334b7\"},{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"gif\",\"media\":{\"createdAt\":\"2026-03-14T16:47:11.734Z\",\"updatedAt\":\"2026-04-20T11:32:51.779Z\",\"alt\":\"Example of toast notification placement\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notification.gif\",\"filename\":\"notification.gif\",\"mimeType\":\"image/gif\",\"filesize\":1265036,\"width\":736,\"height\":552,\"sizes\":{\"thumbnail\":{\"url\":null},\"square\":{\"url\":null},\"small\":{\"url\":null},\"medium\":{\"url\":null},\"large\":{\"url\":null},\"og\":{\"url\":null}},\"thumbnailURL\":null,\"checksum\":\"2eff382dd22a67a293e6128485bba2e01955dbe1444fb7370ee94d70c499b053\",\"id\":\"69b5910f03c1756a5658b788\"},\"poster\":\"$6:0:props:layout:3:sections:1:contentFlow:0:items:0:media\",\"iconColor\":\"light\",\"hideCaption\":false,\"id\":\"6a3af2dd813b9a003da5ce45\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"6a3af2dc8d86655f27d334b8\"}],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7a5\"},{\"isPrivate\":false,\"heading\":\"Actionable\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Actionable\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Notification\",\"relationTo\":\"components-core\",\"value\":\"$6:0:props:layout:3:sections:0:intro:root:children:0:children:0:fields:doc:value\"},\"tab\":\"guidelines\",\"linkType\":\"internal\"},\"id\":\"6a3af3ac59221b802596591b\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" notifications allow for interactive elements within a notification styled like an inline or toast notification. Actionable notifications, since they require user interaction, take focus when triggered and can be highly disruptive to screen readers and keyboard users.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Actionable notifications styled as inline notifications contain only one ghost button. A small “x” in the top right corner is used to dismiss inline notifications. Including the close button is optional and should not be included if it is critical for a user to read or interact with the notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Actionable notifications styled as toast notifications can only contain one tertiary button. If the toast includes an action button, then the notification should remain on screen until the user dismisses it. With the notification remaining open, the user has enough time to interact with the button without the toast closing too soon.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Best practices:\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"An actionable notification should persist until user dismisses it, allowing users time to interact with the notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Only one action per notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Limit action labels to two words or less.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T17:26:57.679Z\",\"updatedAt\":\"2026-04-20T11:33:38.528Z\",\"alt\":\"Actionable notification styled as a toast notification\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/8_actionable_toast.png\",\"filename\":\"8_actionable_toast.png\",\"mimeType\":\"image/png\",\"filesize\":11390,\"width\":1216,\"height\":808,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/8_actionable_toast-288x191.png\",\"width\":288,\"height\":191,\"mimeType\":\"image/png\",\"filesize\":10585,\"filename\":\"8_actionable_toast-288x191.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/8_actionable_toast-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":30316,\"filename\":\"8_actionable_toast-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/8_actionable_toast-288x191.png\",\"width\":288,\"height\":191,\"mimeType\":\"image/png\",\"filesize\":10585,\"filename\":\"8_actionable_toast-288x191.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/8_actionable_toast-608x404.png\",\"width\":608,\"height\":404,\"mimeType\":\"image/png\",\"filesize\":28243,\"filename\":\"8_actionable_toast-608x404.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/8_actionable_toast-928x617.png\",\"width\":928,\"height\":617,\"mimeType\":\"image/png\",\"filesize\":54558,\"filename\":\"8_actionable_toast-928x617.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/8_actionable_toast-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":69758,\"filename\":\"8_actionable_toast-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/8_actionable_toast-288x191.png\",\"checksum\":\"2209571285fc933f23fca8409b6c41a56a6dfb7ac0db19a18b0e196662e2db90\",\"id\":\"69dbd5e1c4621ec2329f5849\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Actionable notification styled as a toast notification\",\"version\":1}]}]}},\"id\":\"69dbd5eb61dc796180fbf7a8\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbd5eb61dc796180fbf7a7\"}],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7a9\"},{\"isPrivate\":false,\"heading\":\"Callout\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Callouts are used to highlight important information contextually within the contents of the page, and cannot be dismissed. Unlike other notification components they are not triggered by the user or system, rather they load with the contents of the page. They do not act as a feedback mechanism, they are persistent, and always present on the screen to provide necessary information to the user. Further, since Callouts are intended to offer guidance before users begin a task or take action, they do not include success or error statuses.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Best practices:\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Use to highlight information to help users make good decisions or avoid bad experience.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Place the callout contextually near an action button, input field or other data to provide information that can influence how they complete the task.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Avoid overloading a single page with multiple callouts.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Use sparingly to emphasize information that must not be overlooked.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":4},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Omit the title when it is redundant and might break the flow while reading through the information.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":5}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T17:26:59.748Z\",\"updatedAt\":\"2026-04-20T11:33:38.526Z\",\"alt\":\"Example of callout influencing a user journey\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notification-pattern-callout.png\",\"filename\":\"notification-pattern-callout.png\",\"mimeType\":\"image/png\",\"filesize\":21822,\"width\":1216,\"height\":810,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notification-pattern-callout-288x192.png\",\"width\":288,\"height\":192,\"mimeType\":\"image/png\",\"filesize\":17759,\"filename\":\"notification-pattern-callout-288x192.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notification-pattern-callout-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":47185,\"filename\":\"notification-pattern-callout-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notification-pattern-callout-288x192.png\",\"width\":288,\"height\":192,\"mimeType\":\"image/png\",\"filesize\":17759,\"filename\":\"notification-pattern-callout-288x192.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notification-pattern-callout-608x405.png\",\"width\":608,\"height\":405,\"mimeType\":\"image/png\",\"filesize\":52015,\"filename\":\"notification-pattern-callout-608x405.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notification-pattern-callout-928x618.png\",\"width\":928,\"height\":618,\"mimeType\":\"image/png\",\"filesize\":99155,\"filename\":\"notification-pattern-callout-928x618.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notification-pattern-callout-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":138761,\"filename\":\"notification-pattern-callout-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/notification-pattern-callout-288x192.png\",\"checksum\":\"80c2e33e57e589eb1c663ceaa15ddc8283750496f923134c106bc5829d9a78e2\",\"id\":\"69dbd5e3c4621ec2329f5850\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Example of callout influencing a user journey\",\"version\":1}]}]}},\"id\":\"69dbd5eb61dc796180fbf7ab\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbd5eb61dc796180fbf7aa\"}],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7ac\"},{\"isPrivate\":false,\"heading\":\"Banner\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Banners take over the top of an interface to show general notifications for the product or system, not a specific task. They persist until they are dismissed by the user. Depending on the message, the user resolving a product or system issue (for example, updating necessary account information), may dismiss the banner. Banners may also persist across multiple sessions.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Best practices:\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Banners should be placed at the top of the content area they relate to.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Do not cover other content with a banner notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Place system-wide messages directly below the main header or navigation bar.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Banners are not sticky and should scroll with the other content on the page.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":4},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Only show one banner at a time.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":5}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"More design iteration and user testing is needed before Carbon solidifies our guidance for banners and creates a banner component. Keep an eye out for refined usage examples in the future. If your team has developed a banner component, consider contributing it to Carbon so that it can be made available to others.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T17:27:01.858Z\",\"updatedAt\":\"2026-04-20T11:33:38.542Z\",\"alt\":\"Low-contrast banner notification\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/5_Banner_736.png\",\"filename\":\"5_Banner_736.png\",\"mimeType\":\"image/png\",\"filesize\":38868,\"width\":2240,\"height\":1440,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/5_Banner_736-288x185.png\",\"width\":288,\"height\":185,\"mimeType\":\"image/png\",\"filesize\":13395,\"filename\":\"5_Banner_736-288x185.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/5_Banner_736-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":29629,\"filename\":\"5_Banner_736-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/5_Banner_736-288x185.png\",\"width\":288,\"height\":185,\"mimeType\":\"image/png\",\"filesize\":13395,\"filename\":\"5_Banner_736-288x185.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/5_Banner_736-608x391.png\",\"width\":608,\"height\":391,\"mimeType\":\"image/png\",\"filesize\":42712,\"filename\":\"5_Banner_736-608x391.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/5_Banner_736-928x597.png\",\"width\":928,\"height\":597,\"mimeType\":\"image/png\",\"filesize\":77139,\"filename\":\"5_Banner_736-928x597.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/5_Banner_736-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":103730,\"filename\":\"5_Banner_736-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/5_Banner_736-288x185.png\",\"checksum\":\"911064b460622183f0b5edab23c339ddc0e2eeb63037b4d2cfb5d593e816aeb4\",\"id\":\"69dbd5e5c4621ec2329f5857\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Low-contrast banner notification\",\"version\":1}]}]}},\"id\":\"69dbd5eb61dc796180fbf7ae\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbd5eb61dc796180fbf7ad\"}],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7af\"},{\"isPrivate\":false,\"heading\":\"Notification panel\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notification panels are helpful for users who receive a large number of system-generated notifications or may need to reference their notifications later. They are used in conjunction with toasts to alert users of notifications as they come in.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notification panels ensure that users can access and read all notifications without cluttering the screen with many persistent notifications. They also provide a consistent experience to users who need more time to read notifications, use a screen reader, or prefer to limit the notifications they receive.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"More design iteration and user testing is needed before Carbon solidifies our guidance for notification panel and creates a notification panel component. Keep an eye out for refined usage examples in the future. If your team has developed a notification panel component, consider contributing it to Carbon so that it can be made available to others.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Best practices:\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Give users the ability to manage notification preferences.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Don’t send the same notification multiple times if users don’t interact with it.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"List notifications in chronological order.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notifications can be grouped by source or urgency.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":4}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T17:27:03.846Z\",\"updatedAt\":\"2026-04-20T11:33:38.534Z\",\"alt\":\"Notification panel with the Gray 100 theme\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/6_Panel_736.png\",\"filename\":\"6_Panel_736.png\",\"mimeType\":\"image/png\",\"filesize\":44403,\"width\":1472,\"height\":950,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/6_Panel_736-288x186.png\",\"width\":288,\"height\":186,\"mimeType\":\"image/png\",\"filesize\":28547,\"filename\":\"6_Panel_736-288x186.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/6_Panel_736-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":86137,\"filename\":\"6_Panel_736-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/6_Panel_736-288x186.png\",\"width\":288,\"height\":186,\"mimeType\":\"image/png\",\"filesize\":28547,\"filename\":\"6_Panel_736-288x186.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/6_Panel_736-608x392.png\",\"width\":608,\"height\":392,\"mimeType\":\"image/png\",\"filesize\":89567,\"filename\":\"6_Panel_736-608x392.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/6_Panel_736-928x599.png\",\"width\":928,\"height\":599,\"mimeType\":\"image/png\",\"filesize\":167140,\"filename\":\"6_Panel_736-928x599.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/6_Panel_736-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":237274,\"filename\":\"6_Panel_736-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/6_Panel_736-288x186.png\",\"checksum\":\"c722eae37fb5cdb24d142251728a43cfc93fb392d7c2099d7d42e76170b852fc\",\"id\":\"69dbd5e7c4621ec2329f585e\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notification panel with the Gray 100 theme\",\"version\":1}]}]}},\"id\":\"69dbd5eb61dc796180fbf7b1\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbd5eb61dc796180fbf7b0\"}],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7b2\"},{\"isPrivate\":false,\"heading\":\"Modal\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Modals interrupt the user and pause their current task. They are highly disruptive to users and should be used sparingly. Only use a modal when the message is critical and needs the user’s immediate attention or action. Modals persist until users engage with them and only disappear when dismissed by the user.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Best practices:\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Only display one modal notification at a time.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Use modals when you need to immediately interrupt a user’s task.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":2},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Give users clear steps to resolve and dismiss the notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"listitem\",\"version\":1,\"value\":3}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"list\",\"version\":1,\"listType\":\"bullet\",\"start\":1,\"tag\":\"ul\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"mediaBlock\",\"isPrivate\":false,\"items\":[{\"mediaType\":\"image\",\"media\":{\"createdAt\":\"2026-04-12T17:27:05.797Z\",\"updatedAt\":\"2026-04-20T11:33:38.531Z\",\"alt\":\"Danger modal notification\",\"visibility\":\"public\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/7_Modal_736.png\",\"filename\":\"7_Modal_736.png\",\"mimeType\":\"image/png\",\"filesize\":20207,\"width\":1472,\"height\":950,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/7_Modal_736-288x186.png\",\"width\":288,\"height\":186,\"mimeType\":\"image/png\",\"filesize\":15602,\"filename\":\"7_Modal_736-288x186.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/7_Modal_736-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":36670,\"filename\":\"7_Modal_736-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/7_Modal_736-288x186.png\",\"width\":288,\"height\":186,\"mimeType\":\"image/png\",\"filesize\":15602,\"filename\":\"7_Modal_736-288x186.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/7_Modal_736-608x392.png\",\"width\":608,\"height\":392,\"mimeType\":\"image/png\",\"filesize\":45189,\"filename\":\"7_Modal_736-608x392.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/7_Modal_736-928x599.png\",\"width\":928,\"height\":599,\"mimeType\":\"image/png\",\"filesize\":82054,\"filename\":\"7_Modal_736-928x599.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/7_Modal_736-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":115398,\"filename\":\"7_Modal_736-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/7_Modal_736-288x186.png\",\"checksum\":\"bbfdbb417b68761d5b4871e0317c6aa23681b71c181962cae22c705f6980293f\",\"id\":\"69dbd5e9c4621ec2329f5865\"},\"iconColor\":\"light\",\"hideCaption\":false,\"captionText\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"direction\":null,\"textFormat\":0,\"textStyle\":\"\",\"children\":[{\"type\":\"text\",\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Danger modal notification\",\"version\":1}]}]}},\"id\":\"69dbd5eb61dc796180fbf7b4\"}],\"itemsPerRow\":\"1\",\"colLg\":\"8\",\"colLgPair\":\"4\",\"id\":\"69dbd5eb61dc796180fbf7b3\"}],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7b5\"}],\"id\":\"69dbd5eb61dc796180fbf779\",\"blockName\":\"Notification types\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Considerations when designing\",\"intro\":null,\"blocks\":[],\"contentFlow\":[],\"sections\":[{\"isPrivate\":false,\"heading\":\"Notification priority\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Notifications range in their priority and therefore should vary in their disruptiveness to users. It is important to match the urgency and priority of the information being communicated to the visual style and behavior of the notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Carbon offers two visual styles for inline and toast notifications. The high-contrast style is more visually disruptive and should be used for notifications that are urgent or critical. The low-contrast style is better for supplemental messaging or other low priority use cases. Toast and inline notifications can use different styles, but you should never mix styles within the variations.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7b7\"},{\"isPrivate\":false,\"heading\":\"General user action\",\"intro\":{\"root\":{\"children\":[{\"children\":[],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"subsections\":[{\"isPrivate\":false,\"heading\":\"Optional action\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Actionable notifications can include a ghost or tertiary button that lets users interact with them. Taking action on these notifications should be optional and should not block the user from continuing with their current task. This action frequently takes users to a flow or page related to the message, where they can resolve the notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"id\":\"69dbd5eb61dc796180fbf7b8\"},{\"isPrivate\":false,\"heading\":\"Required action\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Some notification patterns must block users from dismissing the notification or continuing with their task until the message has been addressed. This is common in forms when there are errors or empty input fields. Notifications that prevent users from continuing should be relevant to the current task and provide the user with the steps needed to resolve them or continue with their current task.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Blocking users from continuing with a task is disruptive and hinders the overall experience, so these notifications should only be used when it is critical the user sees the notification or the user needs to take action right away.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"id\":\"69dbd5eb61dc796180fbf7b9\"}],\"id\":\"69dbd5eb61dc796180fbf7ba\"},{\"isPrivate\":false,\"heading\":\"Notification message\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"It’s important to consider the user’s context when writing notification messages. Use language that is accessible to the user and that will be easily understood. Use a tone that is appropriate for the situation and notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Because task-generated notifications are sent in response to user action, it isn’t necessary to give users extensive background information. Conversely, system-generated notifications are generally not relevant to the user’s current task so you should ensure the user has sufficient context to understand the notification.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[{\"blockType\":\"doDont\",\"isPrivate\":false,\"examples\":[{\"type\":\"do\",\"media\":{\"createdAt\":\"2026-06-24T14:25:22.606Z\",\"updatedAt\":\"2026-06-24T14:25:23.249Z\",\"alt\":\"Do use clear and consise language\",\"visibility\":\"public\",\"checksum\":\"c649bc1237de260204c6b9f3ff1d1e6a3ab73f17fd509b0c2054c97b6f901122\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-1.png\",\"filename\":\"notifications-usage-1.png\",\"mimeType\":\"image/png\",\"filesize\":48996,\"width\":996,\"height\":988,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-1-288x286.png\",\"width\":288,\"height\":286,\"mimeType\":\"image/png\",\"filesize\":7863,\"filename\":\"notifications-usage-1-288x286.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-1-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":14215,\"filename\":\"notifications-usage-1-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-1-288x286.png\",\"width\":288,\"height\":286,\"mimeType\":\"image/png\",\"filesize\":7863,\"filename\":\"notifications-usage-1-288x286.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-1-608x603.png\",\"width\":608,\"height\":603,\"mimeType\":\"image/png\",\"filesize\":21489,\"filename\":\"notifications-usage-1-608x603.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-1-928x921.png\",\"width\":928,\"height\":921,\"mimeType\":\"image/png\",\"filesize\":37544,\"filename\":\"notifications-usage-1-928x921.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-1-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":45698,\"filename\":\"notifications-usage-1-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-1-288x286.png\",\"id\":\"6a3be8d2eb0fd531659ff53e\"},\"color\":\"light\",\"aspectRatio\":\"1:1\",\"captionText\":\"Do use clear and concise language.\",\"id\":\"6a3be744b088c3a467346e45\"},{\"type\":\"dont\",\"media\":{\"createdAt\":\"2026-06-24T14:27:51.674Z\",\"updatedAt\":\"2026-06-24T14:27:52.264Z\",\"alt\":\"Do not use technical jargon or language unfamiliar to the user\",\"visibility\":\"public\",\"checksum\":\"91b3bf9fbd1ce13c67df9ba914a522444f071cfa0b6143e48be49cf0e581f10f\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-2.png\",\"filename\":\"notifications-usage-2.png\",\"mimeType\":\"image/png\",\"filesize\":41641,\"width\":1016,\"height\":1012,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-2-288x287.png\",\"width\":288,\"height\":287,\"mimeType\":\"image/png\",\"filesize\":5566,\"filename\":\"notifications-usage-2-288x287.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-2-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":9516,\"filename\":\"notifications-usage-2-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-2-288x287.png\",\"width\":288,\"height\":287,\"mimeType\":\"image/png\",\"filesize\":5566,\"filename\":\"notifications-usage-2-288x287.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-2-608x606.png\",\"width\":608,\"height\":606,\"mimeType\":\"image/png\",\"filesize\":14148,\"filename\":\"notifications-usage-2-608x606.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-2-928x924.png\",\"width\":928,\"height\":924,\"mimeType\":\"image/png\",\"filesize\":25008,\"filename\":\"notifications-usage-2-928x924.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-2-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":29248,\"filename\":\"notifications-usage-2-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-2-288x287.png\",\"id\":\"6a3be967eb0fd531659ff5f6\"},\"color\":\"light\",\"aspectRatio\":\"1:1\",\"captionText\":\"Do not use technical jargon or language unfamiliar to the user.\",\"id\":\"6a3be8e5b088c3a467346e46\"}],\"colMd\":\"4\",\"colLg\":\"4\",\"id\":\"6a3be73db088c3a467346e44\"},{\"blockType\":\"doDont\",\"isPrivate\":false,\"examples\":[{\"type\":\"do\",\"media\":{\"createdAt\":\"2026-06-24T14:34:44.772Z\",\"updatedAt\":\"2026-06-24T14:34:45.112Z\",\"alt\":\"Do ensure users know how to take action if it is necessary\",\"visibility\":\"public\",\"checksum\":\"fe22e435aca966035c3db592ffd7b903f1b55784ebdd7f65794924bd840d1da3\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-3.png\",\"filename\":\"notifications-usage-3.png\",\"mimeType\":\"image/png\",\"filesize\":73072,\"width\":1350,\"height\":1336,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-3-288x285.png\",\"width\":288,\"height\":285,\"mimeType\":\"image/png\",\"filesize\":8612,\"filename\":\"notifications-usage-3-288x285.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-3-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":15254,\"filename\":\"notifications-usage-3-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-3-288x285.png\",\"width\":288,\"height\":285,\"mimeType\":\"image/png\",\"filesize\":8612,\"filename\":\"notifications-usage-3-288x285.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-3-608x602.png\",\"width\":608,\"height\":602,\"mimeType\":\"image/png\",\"filesize\":22231,\"filename\":\"notifications-usage-3-608x602.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-3-928x918.png\",\"width\":928,\"height\":918,\"mimeType\":\"image/png\",\"filesize\":39299,\"filename\":\"notifications-usage-3-928x918.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-3-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":50507,\"filename\":\"notifications-usage-3-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-3-288x285.png\",\"id\":\"6a3beb042f7728b62f54f37a\"},\"color\":\"light\",\"aspectRatio\":\"1:1\",\"captionText\":\"Do ensure users know how to take action if it is necessary.\",\"id\":\"6a3beb72b088c3a467346e4a\"},{\"type\":\"dont\",\"media\":{\"createdAt\":\"2026-06-24T14:35:49.316Z\",\"updatedAt\":\"2026-06-24T14:35:49.730Z\",\"alt\":\"Do not leave users without next steps.\",\"visibility\":\"public\",\"checksum\":\"9d53ff0fdab2e52aea2539d4fc5820fdf5a2ac7bea5306a024e291059ce41bab\",\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-4.png\",\"filename\":\"notifications-usage-4.png\",\"mimeType\":\"image/png\",\"filesize\":44195,\"width\":994,\"height\":988,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-4-288x286.png\",\"width\":288,\"height\":286,\"mimeType\":\"image/png\",\"filesize\":8086,\"filename\":\"notifications-usage-4-288x286.png\"},\"square\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-4-448x448.png\",\"width\":448,\"height\":448,\"mimeType\":\"image/png\",\"filesize\":14615,\"filename\":\"notifications-usage-4-448x448.png\"},\"small\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-4-288x286.png\",\"width\":288,\"height\":286,\"mimeType\":\"image/png\",\"filesize\":8086,\"filename\":\"notifications-usage-4-288x286.png\"},\"medium\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-4-608x604.png\",\"width\":608,\"height\":604,\"mimeType\":\"image/png\",\"filesize\":21458,\"filename\":\"notifications-usage-4-608x604.png\"},\"large\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-4-928x922.png\",\"width\":928,\"height\":922,\"mimeType\":\"image/png\",\"filesize\":37364,\"filename\":\"notifications-usage-4-928x922.png\"},\"og\":{\"url\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-4-1200x630.png\",\"width\":1200,\"height\":630,\"mimeType\":\"image/png\",\"filesize\":42099,\"filename\":\"notifications-usage-4-1200x630.png\"}},\"thumbnailURL\":\"https://origin.carbondesignsystem.com/api/media/file/notifications-usage-4-288x286.png\",\"id\":\"6a3beb45eb0fd531659ff6a9\"},\"color\":\"light\",\"aspectRatio\":\"1:1\",\"captionText\":\"Do not leave users without next steps.\",\"id\":\"6a3beb84b088c3a467346e4b\"}],\"colMd\":\"4\",\"colLg\":\"4\",\"id\":\"6a3beb6fb088c3a467346e49\"}],\"subsections\":[],\"id\":\"69dbd5eb61dc796180fbf7bb\"}],\"id\":\"69dbd5eb61dc796180fbf7b6\",\"blockName\":\"Considerations when designing\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Accessibility\",\"intro\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Don’t use notifications that dismiss on a timer for critical or emergency messages.\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" Some users with disabilities need more time to read or interact with messages and timed actionable toasts may not provide sufficient time. \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"WCAG 2.1 success criterion 2.2.4 (AAA)\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"linkType\":\"custom\",\"newTab\":false,\"url\":\"https://www.w3.org/WAI/WCAG21/Understanding/no-timing.html\"},\"id\":\"6a3af62959221b8025965921\"}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":1,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Users should be able to manage or limit noncritical notifications.\",\"type\":\"text\",\"version\":1},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\" This gives users the control to reduce the number of distractions or disruptions they receive, which is particularly helpful for users with cognitive limitations. \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"WCAG 2.1 success criterion 2.2.3 (AAA)\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"linkType\":\"custom\",\"newTab\":false,\"url\":\"https://www.w3.org/WAI/WCAG21/Understanding/interruptions.html\"},\"id\":\"6a3af62959221b8025965922\"}],\"direction\":null,\"format\":\"start\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":1,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"blocks\":[],\"contentFlow\":[],\"sections\":[],\"id\":\"69dbd5eb61dc796180fbf7bc\",\"blockName\":\"Accessibility\"},{\"blockType\":\"contentGeneric\",\"isPrivate\":false,\"heading\":\"Related components and patterns\",\"intro\":null,\"blocks\":[],\"contentFlow\":[{\"blockType\":\"twoColumnText\",\"isPrivate\":false,\"columns\":[{\"title\":\"Components\",\"content\":{\"root\":{\"children\":[{\"children\":[{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Modal\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"relationTo\":\"components-core\",\"value\":{\"name\":\"Modal\",\"slug\":\"modal\",\"pageHeader\":{\"releaseStatus\":\"stable\",\"resources\":{\"githubUrl\":\"https://github.com/carbon-design-system/carbon/tree/main/packages/react/src/components/Modal\",\"storybookUrl\":\"https://react.carbondesignsystem.com/?path=/docs/components-modal--overview\"}},\"meta\":{\"image\":{\"createdAt\":\"2026-06-24T12:30:07.318Z\",\"updatedAt\":\"2026-06-24T12:30:07.510Z\",\"alt\":\"Modal\",\"