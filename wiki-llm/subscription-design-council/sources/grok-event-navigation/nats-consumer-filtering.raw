)"><span class="token plain">    AckPolicy </span><span class="token operator" style="color:hsl(221, 87%, 60%)">=</span><span class="token plain"> ConsumerConfigAckPolicy</span><span class="token punctuation" style="color:hsl(119, 34%, 47%)">.</span><span class="token plain">Explicit</span><span class="token punctuation" style="color:hsl(119, 34%, 47%)">,</span><span class="token plain"></span><br/></div><div class=token-line style="color:hsl(230, 8%, 24%)"><span class="token plain">    FilterSubject </span><span class="token operator" style="color:hsl(221, 87%, 60%)">=</span><span class="token plain"> </span><span class="token string" style="color:hsl(119, 34%, 47%)">"orders.shiped"</span><span class="token punctuation" style="color:hsl(119, 34%, 47%)">,</span><span class="token plain"></span><br/></div><div class=token-line style="color:hsl(230, 8%, 24%)"><span class="token plain"></span><span class="token punctuation" style="color:hsl(119, 34%, 47%)">}</span><span class="token punctuation" style="color:hsl(119, 34%, 47%)">)</span><span class="token punctuation" style="color:hsl(119, 34%, 47%)">;</span><span class="token plain"></span><br/></div><div class=token-line style="color:hsl(230, 8%, 24%)"><span class="token plain" style=display:inline-block></span><br/></div><div class=token-line style="color:hsl(230, 8%, 24%)"><span class="token plain"></span><span class="token comment" style="color:hsl(230, 4%, 64%)">// The fetch waits out its expiry and returns nothing, with no error</span><span class="token plain"></span><br/></div><div class=token-line style="color:hsl(230, 8%, 24%)"><span class="token plain"></span><span class="token keyword" style="color:hsl(301, 63%, 40%)">await</span><span class="token plain"> </span><span class="token keyword" style="color:hsl(301, 63%, 40%)">foreach</span><span class="token plain"> </span><span class="token punctuation" style="color:hsl(119, 34%, 47%)">(</span><span class="token class-name keyword" style="color:hsl(301, 63%, 4