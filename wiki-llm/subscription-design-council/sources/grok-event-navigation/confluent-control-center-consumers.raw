<script>
  function toggleTheme() {
    var html = document.documentElement;
    var current = html.getAttribute('data-theme');
    var newTheme =
      current === 'dark'
        ? 'light'
        : current === 'light'
          ? 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'light'
            : 'dark';
    html.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
    window.docsAIAssistant && window.docsAIAssistant.setTheme(newTheme);
  }

  function handleAIAssistant() {
    window.docsAIAssistant && window.docsAIAssistant.toggle();
  }

  function openSearchDialog() {
    var el = document.getElementById('cf-search-dialog');
    if (el) el.open();
  }

  function toggleMobileMenu() {
    var drawer = document.getElementById('cf-drawer');
    var overlay = document.getElementById('cf-drawer-overlay');
    if (!drawer || !overlay) return;
    var open = drawer.classList.toggle('cf-drawer--open');
    overlay.classList.toggle('cf-drawer-overlay--open', open);
    document.body.classList.toggle('cf-drawer-body-lock', open);
  }

  // The drawer markup is included at the end of <body> (mobile-drawer.html), so it
  // does not exist yet while this script runs. Bind once the document is parsed.
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.cf-drawer-nav-item').forEach(function (item) {
      item.addEventListener('click', toggleMobileMenu);
    });
  });
</script>

        
