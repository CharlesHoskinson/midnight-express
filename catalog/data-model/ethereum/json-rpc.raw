<span class="line"><span style="--shiki-light:#B07D48;--shiki-dark:#BD976A">curl</span><span style="--shiki-light:#AB5959;--shiki-dark:#CB7676"> -</span><span style="--shiki-light:#B07D48;--shiki-dark:#BD976A">X</span><span style="--shiki-light:#B07D48;--shiki-dark:#BD976A"> POST</span><span style="--shiki-light:#AB5959;--shiki-dark:#CB7676"> --</span><span style="--shiki-light:#B07D48;--shiki-dark:#BD976A">data</span><span style="--shiki-light:#B5695977;--shiki-dark:#C98A7D77"> '</span><span style="--shiki-light:#B56959;--shiki-dark:#C98A7D">{"jsonrpc":"2.0","method":"web3_sha3","params":["0x68656c6c6f20776f726c64"],"id":64}</span><span style="--shiki-light:#B5695977;--shiki-dark:#C98A7D77">'</span></span>
