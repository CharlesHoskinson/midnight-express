/chunks/3sk6w_fx1th0e.js\",\"/_next/static/chunks/0bc1_ikcbdbrr.js\",\"/_next/static/chunks/1260248q634w3.js\",\"/_next/static/chunks/3vckvubg9t0ou.js\",\"/_next/static/chunks/1s_1-ndsb0xui.js\",\"/_next/static/chunks/0u77ysm-8l43g.js\",\"/_next/static/chunks/1rzpngzfmuhc2.js\",\"/_next/static/chunks/1h0rs07h4cv23.js\"],\"ButtonLink\"]\n9a:[\"$\",\"p\",null,{\"children\":[\"This page deals mainly with the JSON-RPC API used by Ethereum execution clients. However, consensus clients also have an RPC API that allows users to query information about the node, request Beacon blocks, Beacon state, and other consensus-related information directly from a node. This API is documented on the \",[\"$\",\"$L98\",null,{\"href\":\"https://ethereum.github.io/beacon-APIs/#/\",\"children\":\"Beacon API webpage\"}],\".\"]}]\n9b:[\"$\",\"p\",null,{\"children\":[\"An internal API is also used for inter-client communication within a node - that is, it enables the consensus client and execution client to swap data. This is called the 'Engine API' and the specs are available on \",[\"$\",\"$L98\",null,{\"href\":\"https://github.com/ethereum/execution-apis/blob/main/src/engine/common.md\",\"children\":\"GitHub\"}],\".\"]}]\n9c:[\"$\",\"h2\",null,{\"id\":\"spec\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"spec permalink\",\"href\":\"#spec\",\"children\":[\"$\",\"$L99\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$92:6:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Execution client spec\"]}]\n9d:[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L98\",null,{\"href\":\"https://github.com/ethereum/execution-apis\",\"children\":\"Read the full JSON-RPC API spec on GitHub\"}],\". This API is documented on the \",[\"$\",\"$L98\",null,{\"href\":\"https://ethereum.github.io/execution-apis/\",\"children\":\"Execution API webpage\"}],\" and includes an Inspector to try out all the available methods.\"]}]\n9e:[\"$\",\"h2\",null,{\"id\":\"conventions\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"conventions permalink\",\"href\":\"#conventions\",\"children\":[\"$\",\"$L99\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$92:6:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Conventions\"]}]\n9f:[\"$\",\"h3\",null,{\"id\":\"hex-encoding\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"hex encoding permalink\",\"href\":\"#hex-encoding\",\"children\":[\"$\",\"$L99\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$92:6:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Hex value encoding\"]}]\na0:[\"$\",\"p\",null,{\"children\":\"Two key data types get passed over JSON: unformatted byte arrays and quantities. Both are passed with a hex encoding but with different requirements for formatting.\"}]\na1:[\"$\",\"h4\",null,{\"id\":\"quantities-encoding\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label"])</script><script>self.__next_f.push([1,"\":\"quantities encoding permalink\",\"href\":\"#quantities-encoding\",\"children\":[\"$\",\"$L99\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$92:6:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Quantities\"]}]\na2:[\"$\",\"p\",null,{\"children\":\"When encoding quantities (integers, numbers): encode as hex, prefix with \\\"0x\\\", the most compact representation (slight exception: zero should be represented as \\\"0x0\\\").\"}]\na3:[\"$\",\"p\",null,{\"children\":\"Here are some examples:\"}]\na4:[\"$\",\"ul\",null,{\"ref\":\"$undefined\",\"className\":\"ms-6 mb-6\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"0x41 (65 in decimal)\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"0x400 (1024 in decimal)\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"WRONG: 0x (should always have at least one digit - zero is \\\"0x0\\\")\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"WRONG: 0x0400 (no leading zeroes allowed)\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"WRONG: ff (must be prefixed 0x)\"}],\"\\n\"]}]\na5:[\"$\",\"h3\",null,{\"id\":\"unformatted-data-encoding\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"unformatted data encoding permalink\",\"href\":\"#unformatted-data-encoding\",\"children\":[\"$\",\"$L99\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$92:6:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Unformatted data\"]}]\na6:[\"$\",\"p\",null,{\"children\":\"When encoding unformatted data (byte arrays, account addresses, hashes, bytecode arrays): encode as hex, prefix with \\\"0x\\\", two hex digits per byte.\"}]\na7:[\"$\",\"p\",null,{\"children\":\"Here are some examples:\"}]\na8:[\"$\",\"ul\",null,{\"ref\":\"$undefined\",\"className\":\"ms-6 mb-6\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"0x41 (size 1, \\\"A\\\")\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"0x004200 (size 3, \\\"0B0\\\")\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"0x (size 0, \\\"\\\")\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"WRONG: 0xf0f0f (must be even number of digits)\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"WRONG: 004200 (must be prefixed 0x)\"}],\"\\n\"]}]\na9:[\"$\",\"h3\",null,{\"id\":\"block-parameter\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"block parameter permalink\",\"href\":\"#block-parameter\",\"children\":[\"$\",\"$L99\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$92:6:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"The block parameter\"]}]\naa:[\"$\",\"p\",null,{\"children\":\"The following methods have a block parameter:\"}]\nab:[\"$\",\"ul\",null,{\"ref\":\"$undefined\",\"className\":\"ms-6 mb-6\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L98\",null,{\"href\":\"#eth-getbalance\",\"children\":\"eth_getBalance\"}]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L98\",null,{\"href\":\"#eth-getcode\",\"children\":\"eth_getCode\"}]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L98\",null,{\"href\":\"#eth-gettransactioncount\",\"children\":\"eth_getTransactionCount\"}]}],\"\\n\",[\"$\""])</script><script>self.__next_f.push([1,",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L98\",null,{\"href\":\"#eth-getstorageat\",\"children\":\"eth_getStorageAt\"}]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L98\",null,{\"href\":\"#eth-call\",\"children\":\"eth_call\"}]}],\"\\n\"]}]\nac:[\"$\",\"p\",null,{\"children\":\"When requests are made that query the state of Ethereum, the provided block parameter determines the height of the block.\"}]\nad:[\"$\",\"p\",null,{\"children\":\"The following options are possible for the block parameter:\"}]\nae:[\"$\",\"ul\",null,{\"ref\":\"$undefined\",\"className\":\"ms-6 mb-6\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"code\",null,{\"children\":\"HEX String\"}],\" - an integer block number\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"code\",null,{\"children\":\"String \\\"earliest\\\"\"}],\" for the earliest/genesis block\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"code\",null,{\"children\":\"String \\\"latest\\\"\"}],\" - for the latest proposed block\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"code\",null,{\"children\":\"String \\\"safe\\\"\"}],\" - for the latest safe head block\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"code\",null,{\"children\":\"String \\\"finalized\\\"\"}],\" - for the latest finalized block\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"code\",null,{\"children\":\"String \\\"pending\\\"\"}],\" - for the pending state/transactions\"]}],\"\\n\"]}]\naf:[\"$\",\"h2\",null,{\"id\":\"examples\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"examples permalink\",\"href\":\"#examples\",\"children\":[\"$\",\"$L99\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$92:6:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Examples\"]}]\nb0:[\"$\",\"p\",null,{\"children\":[\"On this page we provide examples of how to use individual JSON_RPC API endpoints using the command line tool, \",[\"$\",\"$L98\",null,{\"href\":\"https://curl.se\",\"children\":\"curl\"}],\". These individual endpoint examples are found below in the \",[\"$\",\"$L98\",null,{\"href\":\"#curl-examples\",\"children\":\"Curl examples\"}],\" section. Further down the page, we also provide an \",[\"$\",\"$L98\",null,{\"href\":\"#usage-example\",\"children\":\"end-to-end example\"}],\" for compiling and deploying a smart contract using a Geth node, the JSON_RPC API and curl.\