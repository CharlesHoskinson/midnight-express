s07h4cv23.js\"],\"default\"]\nc5:I[296437,[\"/_next/static/chunks/3xiw_uf_wiiln.js\",\"/_next/static/chunks/1powma5x7o3vb.js\",\"/_next/static/chunks/01uud5mi6lbi5.js\",\"/_next/static/chunks/35k0yks7omgvq.js\",\"/_next/static/chunks/2yq-4fzgulj5e.js\",\"/_next/static/chunks/1l16jbdu364lv.js\",\"/_next/static/chunks/2ng9h0mydeg_4.js\",\"/_next/static/chunks/3kb04pw4l2ky4.js\",\"/_next/static/chunks/1vn138oc0i_ys.js\",\"/_next/static/chunks/1-atlk17xg9rv.js\",\"/_next/static/chunks/1l5p9f0m67out.js\",\"/_next/static/chunks/0m2w1vygouo46.js\",\"/_next/static/chunks/03s8w6p7_dtix.js\",\"/_next/static/chunks/1vtc81oz576vx.js\",\"/_next/static/chunks/3sk6w_fx1th0e.js\",\"/_next/static/chunks/0bc1_ikcbdbrr.js\",\"/_next/static/chunks/1260248q634w3.js\",\"/_next/static/chunks/3vckvubg9t0ou.js\",\"/_next/static/chunks/1s_1-ndsb0xui.js\",\"/_next/static/chunks/0u77ysm-8l43g.js\",\"/_next/static/chunks/1rzpngzfmuhc2.js\",\"/_next/static/chunks/1h0rs07h4cv23.js\"],\"default\"]\n98:[\"$\",\"h2\",null,{\"id\":\"validators\",\""])</script><script>self.__next_f.push([1,"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"validators permalink\",\"href\":\"#validators\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Validators\"]}]\n99:[\"$\",\"p\",null,{\"children\":\"To participate as a validator, a user must deposit 32 ETH into the deposit contract and run three separate pieces of software: an execution client, a consensus client, and a validator client. On depositing their ETH, the user joins an activation queue that limits the rate of new validators joining the network. Once activated, validators receive new blocks from peers on the Ethereum network. The transactions delivered in the block are re-executed to check that the proposed changes to Ethereum's state are valid, and the block signature is checked. The validator then sends a vote (called an attestation) in favor of that block across the network.\"}]\n9a:[\"$\",\"p\",null,{\"children\":\"Whereas under proof-of-work, the timing of blocks is determined by the mining difficulty, in proof-of-stake, the tempo is fixed. Time in proof-of-stake Ethereum is divided into slots (12 seconds) and epochs (32 slots). One validator is randomly selected to be a block proposer in every slot. This validator is responsible for creating a new block and sending it out to other nodes on the network. Also in every slot, a committee of validators is randomly chosen, whose votes are used to determine the validity of the block being proposed. Dividing the validator set up into committees is important for keeping the network load manageable. Committees divide up the validator set so that every active validator attests in every epoch, but not in every slot.\"}]\n9b:[\"$\",\"h2\",null,{\"id\":\"transaction-execution-ethereum-pos\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"transaction execution ethereum pos permalink\",\"href\":\"#transaction-execution-ethereum-pos\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"How a Transaction Gets Executed in Ethereum PoS\"]}]\n9c:[\"$\",\"p\",null,{\"children\":\"The following provides an end-to-end explanation of how a transaction gets executed in Ethereum proof-of-stake.\"}]\n"])</script><script>self.__next_f.push([1,"9d:[\"$\",\"ol\",null,{\"ref\":null,\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"A user creates and signs a \",[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/transactions/\",\"children\":\"transaction\"}],\" with their private key. This is usually handled by a wallet or a library such as \",[\"$\",\"$L96\",null,{\"href\":\"https://docs.ethers.org/v6/\",\"children\":\"ethers.js\"}],\", \",[\"$\",\"$L96\",null,{\"href\":\"https://docs.web3js.org/\",\"children\":\"web3js\"}],\", \",[\"$\",\"$L96\",null,{\"href\":\"https://web3py.readthedocs.io/en/v5/\",\"children\":\"web3py\"}],\" etc but under the hood the user is making a request to a node using the Ethereum \",[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/apis/json-rpc/\",\"children\":\"JSON-RPC API\"}],\". The user defines the amount of gas that they are prepared to pay as a tip to a validator to encourage them to include the transaction in a block. The \",[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/gas/#priority-fee\",\"children\":\"tips\"}],\" get paid to the validator while the \",[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/gas/#base-fee\",\"children\":\"base fee\"}],\" gets burned.\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"The transaction is submitted to an Ethereum \",[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/nodes-and-clients/#execution-client\",\"children\":\"execution client\"}],\" which verifies its validity. This means ensuring that the sender has enough ETH to fulfill the transaction and they have signed it with the correct key.\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"If the transaction is valid, the execution client adds it to its local mempool (list of pending transactions) and also broadcasts it to other nodes over the execution layer gossip network. When other nodes hear about the transaction they add it to their local mempool too. Advanced users might refrain from broadcasting their transaction and instead forward it to specialized block builders such as \",[\"$\",\"$L96\",null,{\"href\":\"https://docs.flashbots.net/flashbots-auction/overview\",\"children\":\"Flashbots Auction\"}],\". This allows them to organize the transactions in upcoming blocks for maximum profit (\",[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/mev/#mev-extraction\",\"children\":\"MEV\"}],\").\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"One of the validator nodes on the network is the block proposer for the current slot, having previously been selected pseudo-randomly using RANDAO. This node is responsible for building and broadcasting the next block to be added to the Ethereum blockchain and updating the global state. The node is made up of three parts: an execution client, a consensus client and a validator client. The execution client bundles transactions from the local mempool into an \\\"execution payload\\\" and executes them locally to generate a state change. This information is passed to the consensus client where the execution payload is wrapped as part of a \\\"beacon block\\\" that also contains information about rewards, penalties, slashings, attestations etc. that enable the network to agree on the sequence of blocks at the head of the chain. The communication between the execution and consensus clients is described in more detail in \",[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/networking-layer/#connecting-clients\",\"children\":\"Connecting the Consensus and Execution Clients\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"Other nodes receive the new beacon block on the consensus layer gossip network. They pass it to their execution client where the transactions are re-executed locally to ensure the proposed state change is valid. The validator client then attests that the block is valid and is the logical next block in their view of the chain (meaning it builds on the chain with the greatest weight of attestations as defined in the \",\"$Lbb\",\"). The block is added to the local database in each node that attests to it.\"]}],\"\\n\",\"$Lbc\",\"\\n\"],\"className\":\"ms-6 mb-6\"}]\n"])</script><script>self.__next_f.push([1,"9e:[\"$\",\"p\",null,{\"children\":\"More detail on finality can be found below.\"}]\n9f:[\"$\",\"h2\",null,{\"id\":\"finality\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"finality permalink\",\"href\":\"#finality\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Finality\"]}]\na0:[\"$\",\"p\",null,{\"children\":[\"A transaction has \\\"finality\\\" in distributed networks when it is part of a block that can't change without a large amount of ETH getting burned. On proof-of-stake Ethereum, this is managed using \\\"checkpoint\\\" blocks. The first block in each epoch is a checkpoint. Validators vote for pairs of checkpoints that it considers to be valid. If a pair of checkpoints attracts votes representing at least two-thirds of the total staked ETH, the checkpoints are upgraded. The more recent of the two (target) becomes \\\"justified\\\". The earlier of the two is already justified because it was the \\\"target\\\" in the previous epoch. Now it is upgraded to \\\"finalized\\\". This process of upgrading the checkpoints is handled by \",[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L96\",null,{\"href\":\"https://arxiv.org/pdf/1710.09437\",\"children\":\"Casper the Friendly Finality Gadget (Casper-FFG)\"}]}],\". Casper-FFG is a block finality tool for consensus. Once a block is finalized, it cannot be reverted or changed without a majority slashing of stakers, making it economically inviable.\"]}]\na1:[\"$\",\"p\",null,{\"children\":[\"To revert a finalized block, an attacker would commit to losing at least one-third of the total supply of staked ETH. The exact reason for this is explained in this \",[\"$\",\"$L96\",null,{\"href\":\"https://blog.ethereum.org/2016/05/09/on-settlement-finality\",\"children\":\"Ethereum Foundation blog post\"}],\". Since finality requires a two-thirds majority, an attacker could prevent the network from reaching finality by voting with one-third of the total stake. There is a mechanism to defend against this: the \",[\"$\",\"$L96\",null,{\"href\":\"https://eth2book.info/bellatrix/part2/incentives/inactivity\",\"children\":\"inactivity leak\"}],\". This activates whenever the chain fails to finalize for more than four epochs. The inactivity leak bleeds away the staked ETH from validators voting against the majority, allowing the majority to regain a two-thirds majority and finalize the chain.\"]}]\na2:[\"$\",\"h2\",null,{\"id\":\"crypto-economic-security\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"crypto economic security permalink\",\"href\":\"#crypto-economic-security\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Crypto-economic security\"]}]\na3:[\"$\",\"p\",null,{\"children\":\"Running a validator is a commitment. The validator is expected to maintain sufficient hardware and connectivity to participate in block validation and proposal. In return, the validator is paid in ETH (their staked balance increases). On the other hand, participating as a validator also opens new avenues for users to attack the network for personal gain or sabotage. To prevent this, validators miss out on ETH rewards if they fail to participate when called upon, and their existing stake can be destroyed if they behave dishonestly. Two primary behaviors can be considered dishonest: proposing multiple blocks in a single slot (equivocating) and submitting contradictory attestations.\"}]\na4:[\"$\",\"p\",null,{\"children\":[\"The amount of ETH slashed depends on how many validators are also being slashed at "])</script><script>self.__next_f.push([1,"around the same time. This is known as the \",[\"$\",\"$L96\",null,{\"href\":\"https://eth2book.info/latest/part2/incentives/slashing#the-correlation-penalty\",\"children\":\"\\\"correlation penalty\\\"\"}],\", and it can be minor (less than 0.1% stake for a single validator slashed on their own) or can result in 100% of the validator's stake getting destroyed (mass slashing event). It is imposed halfway through a forced exit period that begins with an immediate penalty (1/4096 of the validator's effective balance, up to 0.5 ETH) on Day 1, the correlation penalty on Day 18, and finally, ejection from the network on Day 36. They receive minor attestation penalties every day because they are present on the network but not submitting votes. This all means a coordinated attack would be very costly for the attacker.\"]}]\na5:[\"$\",\"h2\",null,{\"id\":\"fork-choice\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"fork choice permalink\",\"href\":\"#fork-choice\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Fork choice\"]}]\na6:[\"$\",\"p\",null,{\"children\":[\"When the network performs optimally and honestly, there is only ever one new block at the head of the chain, and all validators attest to it. However, it is possible for validators to have different views of the head of the chain due to network latency or because a block proposer has equivocated. Therefore, consensus clients require an algorithm to decide which one to favor. The algorithm used in proof-of-stake Ethereum is called \",[\"$\",\"$L96\",null,{\"href\":\"https://arxiv.org/pdf/2003.03052.pdf\",\"children\":\"LMD-GHOST\"}],\", and it works by identifying the fork that has the greatest weight of attestations in its history.\"]}]\na7:[\"$\",\"h2\",null,{\"id\":\"pos-and-security\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"pos and security permalink\",\"href\":\"#pos-and-security\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Proof-of-stake and security\"]}]\na8:[\"$\",\"p\",null,{\"children\":[\"The threat of a \",[\"$\",\"$L96\",null,{\"href\":\"https://www.investopedia.com/terms/1/51-attack.asp\",\"children\":\"51% attack\"}],\" still exists on proof-of-stake as it does on proof-of-work, but it's even riskier for the attackers. An attacker would need 51% of the staked ETH. They could then use their own attestations to ensure their preferred fork was the one with the most accumulated attestations. The 'weight' of accumulated attestations is what consensus clients use to determine the correct chain, so this attacker would be able to make their fork the canonical one. However, a strength of proof-of-stake over proof-of-work is that the community has flexibility in mounting a counter-attack. For example, the honest validators could decide to keep building on the minority chain and ignore the attacker's fork while encouraging apps, exchanges, and pools to do the same. They could also decide to forcibly remove the attacker from the network and destroy their staked ETH. These are strong economic defenses against a 51% attack.\"]}]\na9:[\"$\",\"p\",null,{\"children\":\"Beyond 51% attacks, bad actors might also attempt other types of malicious activities, such as:\"}]\naa:[\"$\",\"ul\",null,{\"ref\":\"$undefined\",\"className\":\"ms-6 mb-6\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"long-range attacks (although the finality gadget neutralizes this attack vector)\"}],"])</script><script>self.__next_f.push([1,"\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"short range 'reorgs' (although proposer boosting and attestation deadlines mitigate this)\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"bouncing and balancing attacks (also mitigated by proposer boosting, and these attacks have anyway only been demonstrated under idealized network conditions)\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"avalanche attacks (neutralized by the fork choice algorithms rule of only considering the latest message)\"}],\"\\n\"]}]\nab:[\"$\",\"p\",null,{\"children\":\"Overall, proof-of-stake, as it is implemented on Ethereum, has been demonstrated to be more economically secure than proof-of-work.\"}]\nac:[\"$\",\"h2\",null,{\"id\":\"pros-and-cons\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"pros and cons permalink\",\"href\":\"#pros-and-cons\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Pros and cons\"]}]\n"])</script><script>self.__next_f.push([1,"ad:[\"$\",\"$Lbd\",null,{\"children\":[[\"$\",\"$Lbe\",null,{\"children\":[\"$\",\"$Lbf\",null,{\"children\":[[\"$\",\"$Lc0\",null,{\"align\":\"$undefined\",\"children\":\"Pros\"}],[\"$\",\"$Lc0\",null,{\"align\":\"$undefined\",\"children\":\"Cons\"}]]}]}],[\"$\",\"$Lc1\",null,{\"children\":[[\"$\",\"$Lbf\",null,{\"children\":[[\"$\",\"$Lc2\",null,{\"align\":\"$undefined\",\"children\":\"Staking makes it easier for individuals to participate in securing the network, promoting decentralization. validator node can be run on a normal laptop. Staking pools allow users to stake without having 32 ETH.\"}],[\"$\",\"$Lc2\",null,{\"align\":\"$undefined\",\"children\":\"Proof-of-stake is younger and less battle-tested compared to proof-of-work\"}]]}],[\"$\",\"$Lbf\",null,{\"children\":[[\"$\",\"$Lc2\",null,{\"align\":\"$undefined\",\"children\":\"Staking is more decentralized. Economies of scale do not apply in the same way that they do for PoW mining.\"}],[\"$\",\"$Lc2\",null,{\"align\":\"$undefined\",\"children\":\"Proof-of-stake is more complex to implement than proof-of-work\"}]]}],[\"$\",\"$Lbf\",null,{\"children\":[[\"$\",\"$Lc2\",null,{\"align\":\"$undefined\",\"children\":\"Proof-of-stake offers greater crypto-economic security than proof-of-work\"}],[\"$\",\"$Lc2\",null,{\"align\":\"$undefined\",\"children\":\"Users need to run three pieces of software to participate in Ethereum's proof-of-stake.\"}]]}],[\"$\",\"$Lbf\",null,{\"children\":[[\"$\",\"$Lc2\",null,{\"align\":\"$undefined\",\"children\":\"Less issuance of new ETH is required to incentivize network participants\"}],[\"$\",\"$Lc2\",null,{\"align\":\"$undefined\"}]]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"ae:[\"$\",\"h3\",null,{\"id\":\"comparison-to-proof-of-work\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"comparison to proof of work permalink\",\"href\":\"#comparison-to-proof-of-work\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Comparison to proof-of-work\"]}]\naf:[\"$\",\"p\",null,{\"children\":\"Ethereum originally used proof-of-work but switched to proof-of-stake in September 2022. PoS offers several advantages over PoW, such as:\"}]\n"])</script><script>self.__next_f.push([1,"b0:[\"$\",\"ul\",null,{\"ref\":\"$undefined\",\"className\":\"ms-6 mb-6\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"better energy efficiency – there is no need to use lots of energy on proof-of-work computations\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"lower barriers to entry, reduced hardware requirements – there is no need for elite hardware to stand a chance of creating new blocks\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"reduced centralization risk – proof-of-stake should lead to more nodes securing the network\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"because of the low energy requirement less ETH issuance is required to incentivize participation\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"economic penalties for misbehavior make 51% style attacks more costly for an attacker compared to proof-of-work\"}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"the community can resort to social recovery of an honest chain if a 51% attack were to overcome the crypto-economic defenses.\"}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"b1:[\"$\",\"h2\",null,{\"id\":\"further-reading\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"further reading permalink\",\"href\":\"#further-reading\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Further reading\"]}]\n"])</script><script>self.__next_f.push([1,"b2:[\"$\",\"ul\",null,{\"ref\":\"$undefined\",\"className\":\"ms-6 mb-6\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"$L96\",null,{\"href\":\"https://vitalik.eth.limo/general/2017/12/31/pos_faq.html\",\"children\":\"Proof of Stake FAQ\"}],\" \",[\"$\",\"em\",null,{\"children\":\"Vitalik Buterin\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"$L96\",null,{\"href\":\"https://consensys.net/blog/blockchain-explained/what-is-proof-of-stake/\",\"children\":\"What is Proof of Stake\"}],\" \",[\"$\",\"em\",null,{\"children\":\"ConsenSys\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"$L96\",null,{\"href\":\"https://bitcoinmagazine.com/culture/what-proof-of-stake-is-and-why-it-matters-1377531463\",\"children\":\"What Proof of Stake Is And Why It Matters\"}],\" \",[\"$\",\"em\",null,{\"children\":\"Vitalik Buterin\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"$L96\",null,{\"href\":\"https://vitalik.eth.limo/general/2020/11/06/pos2020.html\",\"children\":\"Why Proof of Stake (Nov 2020)\"}],\" \",[\"$\",\"em\",null,{\"children\":\"Vitalik Buterin\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"$L96\",null,{\"href\":\"https://blog.ethereum.org/2014/11/25/proof-stake-learned-love-weak-subjectivity\",\"children\":\"Proof of Stake: How I Learned to Love Weak Subjectivity\"}],\" \",[\"$\",\"em\",null,{\"children\":\"Vitalik Buterin\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L96\",null,{\"href\":\"https://mirror.xyz/jmcook.eth/YqHargbVWVNRQqQpVpzrqEQ8IqwNUJDIpwRP7SS5FXs\",\"children\":\"Proof-of-stake Ethereum attack and defense\"}]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[[\"$\",\"$L96\",null,{\"href\":\"https://medium.com/@VitalikButerin/a-proof-of-stake-design-philosophy-506585978d51\",\"children\":\"A Proof of Stake Design Philosophy\"}],\" \",[\"$\",\"em\",null,{\"children\":\"Vitalik Buterin\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L96\",null,{\"href\":\"https://www.youtube.com/watch?v=3yrqBG-7EVE\",\"children\":\"Video: Vitalik Buterin explains proof-of-stake to Lex Fridman\"}]}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"b3:[\"$\",\"h2\",null,{\"id\":\"related-topics\",\"className\":\"group relative\",\"data-group\":true,\"children\":[[\"$\",\"$L1e\",null,{\"className\":\"absolute end-full flex h-full items-center opacity-0 transition-opacity duration-100 ease-in-out group-hover:opacity-100 focus:opacity-100\",\"aria-label\":\"related topics permalink\",\"href\":\"#related-topics\",\"children\":[\"$\",\"$L97\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$91:props:children:2:props:children:1:props:children:0:props:children:3:2:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-link me-1 size-3\"}]}],\"Related topics\"]}]\nb4:[\"$\",\"ul\",null,{\"ref\":\"$undefined\",\"className\":\"ms-6 mb-6\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/consensus-mechanisms/pow/\",\"children\":\"Proof-of-work\"}]}],\"\\n\",[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/consensus-mechanisms/poa/\",\"children\":\"Proof-of-authority\"}]}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"b6:[\"$\",\"$Lc3\",null,{\"className\":\"my-10 border-t\",\"contributors\":[{\"login\":\"jorgesumle\",\"avatar_url\":\"https://avatars.githubusercontent.com/jorgesumle\",\"html_url\":\"https://github.com/jorgesumle\",\"date\":\"2025-09-01T11:30:52Z\"},{\"login\":\"PAVANTEJ-05\",\"avatar_url\":\"https://avatars.githubusercontent.com/PAVANTEJ-05\",\"html_url\":\"https://github.com/PAVANTEJ-05\",\"date\":\"2025-04-01T10:34:16Z\"},{\"login\":\"corwintines\",\"avatar_url\":\"https://avatars.githubusercontent.com/corwintines\",\"html_url\":\"https://github.com/corwintines\",\"date\":\"2024-09-03T21:01:44Z\"},{\"login\":\"abraj\",\"avatar_url\":\"https://avatars.githubusercontent.com/abraj\",\"html_url\":\"https://github.com/abraj\",\"date\":\"2024-09-02T16:58:28Z\"},{\"login\":\"mcmoodoo\",\"avatar_url\":\"https://avatars.githubusercontent.com/mcmoodoo\",\"html_url\":\"https://github.com/mcmoodoo\",\"date\":\"2024-06-10T11:48:20Z\"},{\"login\":\"CodeMongerrr\",\"avatar_url\":\"https://avatars.githubusercontent.com/CodeMongerrr\",\"html_url\":\"https://github.com/CodeMongerrr\",\"date\":\"2024-05-16T13:40:08Z\"},{\"login\":\"nhsz\",\"avatar_url\":\"https://avatars.githubusercontent.com/nhsz\",\"html_url\":\"https://github.com/nhsz\",\"date\":\"2023-08-15T14:19:33Z\"},{\"login\":\"mlibre\",\"avatar_url\":\"https://avatars.githubusercontent.com/mlibre\",\"html_url\":\"https://github.com/mlibre\",\"date\":\"2023-07-09T07:14:34Z\"},{\"login\":\"bskrksyp9\",\"avatar_url\":\"https://avatars.githubusercontent.com/bskrksyp9\",\"html_url\":\"https://github.com/bskrksyp9\",\"date\":\"2023-05-12T12:56:02Z\"},{\"login\":\"LucaPennella\",\"avatar_url\":\"https://avatars.githubusercontent.com/LucaPennella\",\"html_url\":\"https://github.com/LucaPennella\",\"date\":\"2023-03-01T17:48:47Z\"},{\"login\":\"jmcook1186\",\"avatar_url\":\"https://avatars.githubusercontent.com/jmcook1186\",\"html_url\":\"https://github.com/jmcook1186\",\"date\":\"2023-01-12T21:47:49Z\"},{\"login\":\"danceratopz\",\"avatar_url\":\"https://avatars.githubusercontent.com/danceratopz\",\"html_url\":\"https://github.com/danceratopz\",\"date\":\"2022-12-06T09:30:32Z\"},{\"login\":\"117503445\",\"avatar_url\":\"https://avatars.githubusercontent.com/117503445\",\"html_url\":\"https://github.com/117503445\",\"date\":\"2022-10-22T05:58:38Z\"},{\"login\":\"emmanuel-awosika\",\"avatar_url\":\"https://avatars.githubusercontent.com/emmanuel-awosika\",\"html_url\":\"https://github.com/emmanuel-awosika\",\"date\":\"2022-10-22T05:12:41Z\"},{\"login\":\"EmperorRP\",\"avatar_url\":\"https://avatars.githubusercontent.com/EmperorRP\",\"html_url\":\"https://github.com/EmperorRP\",\"date\":\"2022-10-10T13:50:15Z\"},{\"login\":\"ethosdev\",\"avatar_url\":\"https://avatars.githubusercontent.com/ethosdev\",\"html_url\":\"https://github.com/ethosdev\",\"date\":\"2022-10-04T03:34:54Z\"},{\"login\":\"yashxcode\",\"avatar_url\":\"https://avatars.githubusercontent.com/yashxcode\",\"html_url\":\"https://github.com/yashxcode\",\"date\":\"2022-09-16T17:04:51Z\"},{\"login\":\"setgree\",\"avatar_url\":\"https://avatars.githubusercontent.com/setgree\",\"html_url\":\"https://github.com/setgree\",\"date\":\"2022-06-13T09:59:43Z\"},{\"login\":\"taxmeifyoucan\",\"avatar_url\":\"https://avatars.githubusercontent.com/taxmeifyoucan\",\"html_url\":\"https://github.com/taxmeifyoucan\",\"date\":\"2022-06-03T11:41:51Z\"},{\"login\":\"wackerow\",\"avatar_url\":\"https://avatars.githubusercontent.com/wackerow\",\"html_url\":\"https://github.com/wackerow\",\"date\":\"2026-08-31T18:09:07Z\"},{\"login\":\"mnelsonBT\",\"avatar_url\":\"https://avatars.githubusercontent.com/mnelsonBT\",\"html_url\":\"https://github.com/mnelsonBT\",\"date\":\"2026-02-25T17:06:22Z\"},{\"login\":\"pettinarip\",\"avatar_url\":\"https://avatars.githubusercontent.com/pettinarip\",\"html_url\":\"https://github.com/pettinarip\",\"date\":\"2026-02-16T17:48:36Z\"},{\"login\":\"minimalsm\",\"avatar_url\":\"https://avatars.githubusercontent.com/minimalsm\",\"html_url\":\"https://github.com/minimalsm\",\"date\":\"2026-02-16T10:53:00Z\"}],\"lastEditLocaleTimestamp\":\"August 31, 2026\"}]\n"])</script><script>self.__next_f.push([1,"b7:[\"$\",\"$Lc4\",null,{\"contentNotTranslated\":false}]\nb8:[\"$\",\"$Lc5\",null,{\"isArticle\":true}]\nb9:[\"$\",\"$L95\",null,{\"className\":\"pt-12\",\"items\":\"$91:props:children:2:props:children:1:props:children:0:props:children:2:props:items\",\"maxDepth\":\"$undefined\"}]\n"])</script><script>self.__next_f.push([1,"bb:[\"$\",\"$L96\",null,{\"href\":\"/developers/docs/consensus-mechanisms/pos/#fork-choice\",\"children\":\"fork choice rules\"}]\nbc:[\"$\",\"li\",null,{\"ref\":\"$undefined\",\"className\":\"mb-3 last:mb-0 [\u0026_ol]:mt-3 [\u0026_ul]:mt-3\",\"children\":\"The transaction can be considered \\\"finalized\\\" if it has become part of a chain with a \\\"supermajority link\\\" between two checkpoints. Checkpoints occur at the start of each epoch and they exist to account for the fact that only a subset of active validators attest in each slot, but all active validators attest across each epoch. Therefore, it is only between epochs that a 'supermajority link' can be demonstrated (this is where 66% of the total staked ETH on the network agrees on two checkpoints).\"}]\n"])</script><script>self.__next_f.push([1,"b5:[\"$\",\"$L90\",null,{\"locale\":\"en\",\"messages\":{\"learn-quizzes\":{\"test-your-knowledge\":\"Test your Ethereum knowledge\",\"explanation\":\"Explanation\",\"question-number\":\"Question number {number}:\",\"submit-answer\":\"Check answer\",\"next-question\":\"Next question\",\"see-results\":\"See results\",\"try-again\":\"Try again\",\"share-results\":\"Share results\",\"next-quiz\":\"Next quiz\",\"passed\":\"You passed the quiz!\",\"your-results\":\"Your results\",\"score\":\"Score\",\"correct\":\"Correct\",\"questions\":\"Questions\",\"page-proof-of-stake\":\"Proof-of-stake\",\"proof-of-stake-1-prompt\":\"A validator tries to defraud the network by proposing conflicting blocks. What does the protocol do?\",\"proof-of-stake-1-a-label\":\"Destroys some or all of the ETH they staked\",\"proof-of-stake-1-a-explanation\":\"Validators stake ETH into a smart contract, and that capital can be destroyed if they act dishonestly. That is what makes fraud expensive.\",\"proof-of-stake-1-b-label\":\"Wastes the electricity they spent competing for the block\",\"proof-of-stake-1-b-explanation\":\"That is the proof-of-work model, where the cost of misbehaving is spent energy. Under proof-of-stake the cost is staked capital that the protocol can destroy.\",\"proof-of-stake-1-c-label\":\"Issues a fine from the Ethereum Foundation\",\"proof-of-stake-1-c-explanation\":\"No company or foundation issues or collects penalties. The rules are enforced by the protocol itself, which destroys staked ETH.\",\"proof-of-stake-1-d-label\":\"Nothing, because miners check every block before it is added\",\"proof-of-stake-1-d-explanation\":\"There are no miners on Ethereum. Other validators check each proposed block, and a dishonest proposer loses stake.\",\"proof-of-stake-2-prompt\":\"On Ethereum, blocks are produced by whoever solves an energy-intensive computational puzzle first.\",\"proof-of-stake-2-a-label\":\"True\",\"proof-of-stake-2-a-explanation\":\"There is no puzzle to race. Time runs in fixed 12-second slots, and each slot's proposer is drawn at random from the validators who have staked ETH. The rest then check that block and attest to it, which is how the network agrees.\",\"proof-of-stake-2-b-label\":\"False\",\"proof-of-stake-2-b-explanation\":\"There is no puzzle to race. Time runs in fixed 12-second slots, and each slot's proposer is drawn at random from the validators who have staked ETH. The rest then check that block and attest to it, which is how the network agrees.\",\"proof-of-stake-3-prompt\":\"Once a block on Ethereum is finalized, what would it cost an attacker to reverse it?\",\"proof-of-stake-3-a-label\":\"Enough electricity to out-compute the rest of the network\",\"proof-of-stake-3-a-explanation\":\"That describes attacking a proof-of-work chain. Finality on Ethereum is defended by capital at risk, not by computing power.\",\"proof-of-stake-3-b-label\":\"Nothing, as long as enough users agree the block should be undone\",\"proof-of-stake-3-b-explanation\":\"Finalized blocks cannot be undone by popular request. Reversing one means an attacker gives up an enormous amount of staked ETH.\",\"proof-of-stake-3-c-label\":\"At least one third of all the ETH staked on the network\",\"proof-of-stake-3-c-explanation\":\"Finality requires a two thirds majority of staked ETH, so reverting a finalized block commits the attacker to losing at least a third of the total stake, worth billions of dollars. That makes it economically inviable.\",\"proof-of-stake-3-d-label\":\"Only the cost of persuading the largest staking pools and exchanges to agree\",\"proof-of-stake-3-d-explanation\":\"No group of companies can vote to undo a finalized block. The penalty is enforced by the protocol and paid in destroyed stake.\",\"proof-of-stake-4-prompt\":\"When a validator is slashed, what determines how much of their stake is destroyed?\",\"proof-of-stake-4-a-label\":\"It is always their full stake\",\"proof-of-stake-4-a-explanation\":\"A validator slashed on their own loses less than 0.1% of their stake. The penalty scales up only when many are slashed together, which is the pattern a true attack would produce.\",\"proof-of-stake-4-b-label\":\"It is always the same fixed amount\",\"proof-of-stake-4-b-explanation\":\"There is an immediate penalty when the process starts, but the total depends on how many validators are slashed at the same time, so a widespread failure costs far more than a lone one.\",\"proof-of-stake-4-c-label\":\"How long the validator has been active on the network\",\"proof-of-stake-4-c-explanation\":\"Time served does not change the penalty. What matters is how many others are slashed at the same time, since simultaneous slashings signal a threat to the network rather than an isolated mistake.\",\"proof-of-stake-4-d-label\":\"How many other validators are slashed at around the same time\",\"proof-of-stake-4-d-explanation\":\"This is the correlation penalty. A validator slashed alone loses less than 0.1% of their stake, while a mass slashing event can destroy all of it. The more validators that fail together, the greater the threat to the network, and the harder the protocol punishes it.\",\"proof-of-stake-5-prompt\":\"What would someone need to control to force their preferred version of the Ethereum chain?\",\"proof-of-stake-5-a-label\":\"51% of the world's mining hardware\",\"proof-of-stake-5-a-explanation\":\"Ethereum has no miners. Clients follow the fork carrying the greatest weight of validator attestations, and that weight comes from staked ETH.\",\"proof-of-stake-5-b-label\":\"51% of the staked ETH\",\"proof-of-stake-5-b-explanation\":\"An attacker holding a majority of the stake could use their own attestations to give their fork the most weight. It is possible, but honest validators can respond by ignoring that fork and destroying the attacker's stake.\",\"proof-of-stake-5-c-label\":\"51% of the ETH held by the Ethereum Foundation\",\"proof-of-stake-5-c-explanation\":\"The Ethereum Foundation does not control consensus, and stakes well under 0.5% of all staked ETH. Only staked ETH carries weight, and it is spread across hundreds of thousands of validators.\",\"proof-of-stake-5-d-label\":\"51% of the exchanges that list ETH\",\"proof-of-stake-5-d-explanation\":\"Exchanges do not choose the canonical chain. Validator attestations do, weighted by staked ETH.\",\"proof-of-stake-6-prompt\":\"Which statement about proof-of-stake compared with proof-of-work is accurate?\",\"proof-of-stake-6-a-label\":\"It needs purpose-built hardware to stand a chance of producing blocks\",\"proof-of-stake-6-a-explanation\":\"That was true of proof-of-work. Proof-of-stake significantly lowers the hardware bar, and a validator node can run on a normal laptop.\",\"proof-of-stake-6-b-label\":\"It requires more new ETH to be issued to keep participants involved\",\"proof-of-stake-6-b-explanation\":\"The opposite. Because the energy cost is low, less new ETH is needed to incentivize participation.\",\"proof-of-stake-6-c-label\":\"It uses far less energy, but is younger and less battle-tested\",\"proof-of-stake-6-c-explanation\":\"Proof-of-stake removes the energy-hungry computations mining depended on. Its trade-offs are that it is newer than proof-of-work and more complex to implement.\",\"proof-of-stake-6-d-label\":\"It removes the need for participants to run any software\",\"proof-of-stake-6-d-explanation\":\"Participants still run software. A validator runs three pieces: an execution client, a consensus client, and a validator client.\"},\"common\":{}},\"children\":\"$Lc6\"}]\n"])</script><script>self.__next_f.push([1,"c7:I[675083,[\"/_next/static/chunks/3xiw_uf_wiiln.js\",\"/_next/static/chunks/1powma5x7o3vb.js\",\"/_next/static/chunks/01uud5mi6lbi5.js\",\"/_next/static/chunks/35k0yks7omgvq.js\",\"/_next/static/chunks/2yq-4fzgulj5e.js\",\"/_next/static/chunks/1l16jbdu364lv.js\",\"/_next/static/chunks/2ng9h0mydeg_4.js\",\"/_next/static/chunks/3kb04pw4l2ky4.js\",\"/_next/static/chunks/1vn138oc0i_ys.js\",\"/_next/static/chunks/1-atlk17xg9rv.js\",\"/_next/static/chunks/1l5p9f0m67out.js\",\"/_next/static/chunks/0m2w1vygouo46.js\",\"/_next/static/chunks/03s8w6p7_dtix.js\",\"/_next/static/chunks/1vtc81oz576vx.js\",\"/_next/static/chunks/3sk6w_fx1th0e.js\",\"/_next/static/chunks/0bc1_ikcbdbrr.js\",\"/_next/static/chunks/1260248q634w3.js\",\"/_next/static/chunks/3vckvubg9t0ou.js\",\"/_next/static/chunks/1s_1-ndsb0xui.js\",\"/_next/static/chunks/0u77ysm-8l43g.js\",\"/_next/static/chunks/1rzpngzfmuhc2.js\",\"/_next/static/chunks/1h0rs07h4cv23.js\"],\"StandaloneQuizClient\"]\nc6:[\"$\",\"$Lc7\",null,{\"quizKey\":\"proof-of-stake\"}]\n"])</script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"b0ac75650ef241c6b9d979fc00a5cc45","spa":2}' crossorigin="anonymous"></script>
