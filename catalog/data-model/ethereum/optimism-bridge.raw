velopers\"},{\"title\":\"App developer quickstart\",\"description\":\"Get testnet ETH, deploy your first contract to OP Sepolia, and bridge assets - your first steps on the Superchain.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/quickstarts/get-started\"},{\"title\":\"Integrating DeFi with Actions SDK\",\"description\":\"Perform DeFi actions with lightweight, composable, and type-safe modules.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/quickstarts/actions\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"Building apps on OP Stack chains\",\"description\":\"Learn the basics of building apps on OP Stack chains.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/building-apps\"},{\"title\":\"Testing apps for OP Stack chains\",\"description\":\"Learn best practices for testing apps on OP Stack chains.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/testing-apps\"},{\"title\":\"Configuring Actions SDK\",\"description\":\"Learn how to configure Actions SDK for your application.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/configuring-actions\"},{\"title\":\"Connecting a wallet to Actions SDK\",\"description\":\"Connect an embedded provider wallet to Actions SDK so it can perform DeFi actions like Lend, Borrow, Swap, and Pay.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/connect-wallet-to-actions\"},{\"group\":\"Bridging\",\"pages\":[{\"title\":\"Bridging basics\",\"description\":\"Learn about the fundamentals of sending data and tokens between Ethereum and OP Mainnet.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/bridging/basics\"},{\"title\":\"Custom bridges\",\"description\":\"Important considerations when building custom bridges for OP Mainnet.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/bridging/custom-bridge\"},{\"title\":\"Sending data between L1 and L2\",\"description\":\"Understand how bridging between L1 and L2 works, the messenger contracts that carry messages, what messages cost, and why the challenge period exists.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/bridging/messaging\"},{\"title\":\"Using the Standard Bridge\",\"description\":\"Learn how the Standard Bridge moves ETH and ERC-20 tokens between Layer 1 and Layer 2.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/bridging/standard-bridge\"},{\"title\":\"Verifying bridged token addresses\",\"description\":\"Use the Superchain Token List to find and verify the correct bridged representation of a token before using the Standard Bridge.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/bridging/verify-bridged-tokens\"}]},{\"group\":\"Interoperability\",\"pages\":[{\"title\":\"Build interoperable apps on OP Stack devnet\",\"description\":\"Learn about deploying contracts, cross-chain messaging, and tutorials to help you build applications on OP Stack chains.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/interoperability/get-started\"},{\"title\":\"Interop message passing overview\",\"description\":\"Understand how interop message passing works, from the initiating message on the source chain to the executing message on the destination chain.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/interoperability/message-passing\"},{\"title\":\"Reading Logs with OP Stack Interop\",\"description\":\"Understand how contracts use CrossL2Inbox to validate logs from other interop chains, and how this pull model differs from sending messages.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/interoperability/reading-logs\"},{\"title\":\"Message expiration\",\"description\":\"What message expiration is, why it exists, and how to reemit a previously sent message if it has expired and was never relayed.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/interoperability/message-expiration\"}]},{\"group\":\"Transactions\",\"pages\":[{\"title\":\"Estimating transaction fees on OP Mainnet\",\"description\":\"Learn how to properly estimate the total cost of a transaction on OP Mainnet.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/transactions/estimates\"},{\"title\":\"Integrate Subblocks in your app\",\"description\":\"Query pre-confirmed Subblocks state from your app using standard JSON-RPC methods with the pending tag, or through viem and ethers.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/transactions/integrating-subblocks\"},{\"title\":\"Setting transaction gas parameters on OP Mainnet\",\"description\":\"Learn how to set gas parameters for transactions on OP Mainnet.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/transactions/parameters\"},{\"title\":\"Transaction statuses on OP Mainnet\",\"description\":\"Reference for the statuses a transaction can have on OP Mainnet.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/guides/transactions/statuses\"},{\"title\":\"Subblocks and gas usage on OP Stack\",\"description\":\"Explains how Subblocks affect block gas usage, transaction inclusion, and why large transactions can be rejected or stay pending.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/transactions/subblocks-and-gas-usage\"},{\"title\":\"Troubleshooting transactions\",\"description\":\"Learn how to troubleshoot common problems with transactions.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/guides/transactions/troubleshooting\"}]}]},{\"group\":\"Tutorials\",\"pages\":[{\"title\":\"Deploy a contract to OP Sepolia\",\"description\":\"Deploy your first smart contract to an OP Stack chain and interact with it using Foundry.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/deploy-a-contract\"},{\"group\":\"Bridging\",\"pages\":[{\"title\":\"Create an L2 token for the Standard Bridge\",\"description\":\"Learn how to create a standard or custom L2 representation of an L1 ERC-20 token that works with the Standard Bridge on an OP Stack chain.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/bridging/standard-bridge-standard-token\"},{\"title\":\"Bridging ERC-20 tokens to OP Mainnet\",\"description\":\"Learn how to use @eth-optimism/viem and viem packages to transfer ERC-20 tokens between Layer 1 (Ethereum or Sepolia) and Layer 2 (OP Mainnet or OP Sepolia).\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/bridging/cross-dom-bridge-erc20\"},{\"title\":\"Communicating between OP Stack and Ethereum in Solidity\",\"description\":\"Learn how to write Solidity contracts on OP Stack and Ethereum that can talk to each other.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/bridging/cross-dom-solidity\"},{\"title\":\"Submitting Transactions from L1\",\"description\":\"Learn how to process deposit transactions and withdrawals with Viem.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/bridging/cross-dom-bridge-eth\"},{\"title\":\"Transferring ETH\",\"description\":\"Learn how to transfer ETH across the OP Stack interop cluster\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/bridging/bridge-crosschain-eth\"},{\"title\":\"Deposit transactions\",\"description\":\"Learn about using deposit transactions with `supersim`.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/bridging/deposit-transactions\"},{\"title\":\"Replaying a failed deposit\",\"description\":\"Learn how deposit replays work by deliberately failing a deposit against a test contract on OP Sepolia and then replaying it with more gas, end to end.\",\"href\":\"/app-developers/tutorials/bridging/replay-failed-deposit\"}]},{\"group\":\"Interoperability\",\"pages\":[{\"title\":\"Making crosschain contract calls (ping pong)\",\"description\":\"Understand how the CrossChainPingPong example contract uses the L2ToL2CrossDomainMessenger to make crosschain contract calls, and the design choices behind it.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/tutorials/interoperability/contract-calls\"},{\"title\":\"Deploying crosschain event composability (contests)\",\"description\":\"Understand how the Contests example composes with cross-chain events, using the CrossL2Inbox to consume events emitted by contracts on any OP Stack chain.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/tutorials/interoperability/event-contests\"},{\"title\":\"Making cross-chain event reads (tic-tac-toe)\",\"description\":\"Understand how a horizontally scalable TicTacToe implementation uses CrossL2Inbox event reads to coordinate gameplay across interop chains.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/tutorials/interoperability/event-reads\"},{\"title\":\"Relay transactions manually\",\"description\":\"Learn to relay transactions directly by sending the correct transaction.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/interoperability/manual-relay\"},{\"title\":\"Interop message passing tutorial\",\"description\":\"Learn to implement cross-chain communication on OP Stack chains by building a message passing system using the L2ToL2CrossDomainMessenger contract.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/interoperability/message-passing\"}]},{\"group\":\"Supersim\",\"pages\":[{\"title\":\"First steps\",\"description\":\"Take your first steps with Supersim.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/development/supersim/first-steps\"},{\"title\":\"Install Supersim\",\"description\":\"Learn how to install Supersim and start it in vanilla mode.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/tutorials/development/supersim/installation\"}]},{\"group\":\"Transactions\",\"pages\":[{\"title\":\"Estimating transaction costs on OP Stack\",\"description\":\"Learn how to use viem to estimate the cost of a transaction on OP Stack.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/transactions/sdk-estimate-costs\"},{\"title\":\"Tracing deposits and withdrawals\",\"description\":\"Learn how to use the viem library to trace deposits and withdrawals between L1 and L2.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/transactions/sdk-trace-txns\"},{\"title\":\"Triggering OP Stack transactions from Ethereum\",\"description\":\"Learn how to force transaction inclusion without the OP Stack Sequencer using Viem.\",\"diataxis\":\"tutorial\",\"href\":\"/app-developers/tutorials/transactions/send-tx-from-eth\"}]}]},{\"group\":\"Tools \u0026 SDKs\",\"pages\":[{\"title\":\"Tools \u0026 SDKs Support Matrix\",\"description\":\"One page that differentiates the OP Stack SDK surfaces and developer tools — what each is for, who owns it, where its canonical docs live, and its support status.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/support-matrix\"},{\"title\":\"Tools \u0026 SDKs Listing Criteria\",\"description\":\"What a tool or SDK must meet to be listed on the support matrix, the removal rule, and the maintenance sweep that keeps listings accurate.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/listing-criteria\"},{\"group\":\"op-alloy\",\"pages\":[{\"title\":\"op-alloy\",\"diataxis\":\"explanation\",\"description\":null,\"href\":\"/app-developers/tools-sdks/op-alloy/intro\"},{\"title\":\"Add op-alloy to your project\",\"description\":\"Add the op-alloy crates to a Rust project with Cargo and pick the feature flags you need.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/tools-sdks/op-alloy/starting\"},{\"group\":\"Building\",\"pages\":[{\"title\":\"Building\",\"diataxis\":\"explanation\",\"description\":null,\"href\":\"/app-developers/tools-sdks/op-alloy/building/index\"},{\"title\":\"Consensus\",\"diataxis\":\"reference\",\"description\":null,\"href\":\"/app-developers/tools-sdks/op-alloy/building/consensus\"},{\"title\":\"RPC Engine Types\",\"diataxis\":\"explanation\",\"description\":null,\"href\":\"/app-developers/tools-sdks/op-alloy/building/engine\"}]}]},{\"title\":\"op-revm\",\"description\":\"op-revm is the Optimism variant of revm, implementing OP Stack modifications to the EVM.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/tools-sdks/op-revm\"},{\"title\":\"Testnet faucets\",\"description\":\"Learn how to get testnet ETH on test networks like Sepolia and OP Sepolia for development and testing purposes.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/faucets\"},{\"title\":\"Block explorers\",\"description\":\"Learn about different block explorers you can use to interact with contracts and view transaction history for OP Mainnet and OP Sepolia.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/block-explorers\"},{\"group\":\"Data\",\"pages\":[{\"title\":\"Data and Dashboards\",\"description\":\"Learn about various dashboards and terms to explore various OP Stack metrics.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/data/data-and-dashboards\"},{\"title\":\"Data Glossary\",\"description\":\"This glossary explains various data terms.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/data/data-glossary\"},{\"title\":\"Analytics tools\",\"description\":\"Learn about platforms you can use to gather analytics and set up customizations about OP Mainnet.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/data/analytics-tools\"},{\"title\":\"Oracles\",\"description\":\"Learn about different oracles and how you can use them to access offchain data onchain as well as random number generation.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/data/oracles\"}]},{\"title\":\"Supersim Multichain Development Environment\",\"description\":\"Learn how to use the Supersim local dev environment tool designed to simulate the OP Stack multi-chain environment.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/tools-sdks/supersim\"},{\"title\":\"Account abstraction\",\"description\":\"This guide explains how to use account abstraction to remove friction from your app experience\",\"diataxis\":\"reference\",\"href\":\"/app-developers/tools-sdks/account-abstraction\"}]},{\"group\":\"Reference\",\"pages\":[{\"title\":\"OP Stack RPC directory\",\"description\":\"Find public RPC endpoints and production RPC providers across all OP Stack networks.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/rpc-providers\"},{\"group\":\"Actions SDK\",\"pages\":[{\"title\":\"Integrating wallets\",\"description\":\"Understand the wallet options Actions SDK supports, embedded wallet providers, gas sponsorship, and smart wallets.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/reference/actions/integrating-wallets\"},{\"title\":\"Wallet Documentation\",\"description\":\"API reference for Actions SDK wallet classes, functions, and parameters.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/actions/wallet-definitions\"},{\"title\":\"Lend Documentation\",\"description\":\"API reference for Actions SDK lending operations, functions, and parameters.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/actions/lend-documentation\"},{\"title\":\"Swap Documentation\",\"description\":\"API reference for Actions SDK swap operations, functions, and parameters.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/actions/swap-documentation\"}]},{\"group\":\"Contracts\",\"pages\":[{\"title\":\"Interoperability predeploys\",\"description\":\"Learn how interoperability predeploys work.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/contracts/interop/predeploy\"}]},{\"group\":\"Tokens\",\"pages\":[{\"title\":\"Bridged token addresses\",\"description\":\"This reference guide lists the correct bridged token addresses for each token.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/tokens/tokenlist\"}]},{\"group\":\"Supersim\",\"pages\":[{\"title\":\"OPChainA (chainID 901)\",\"description\":\"Learn network details and contract addresses for OPChainA (chainID 901).\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/tools/supersim/chain-a\"},{\"title\":\"OPChainB (chainID 902)\",\"description\":\"Learn network details and contract addresses for OPChainB (chainID 902).\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/tools/supersim/chain-b\"},{\"title\":\"Fork mode\",\"description\":\"Learn how to fork Supersim.\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/reference/tools/supersim/fork\"},{\"title\":\"Included contracts\",\"description\":\"Learn about the Supersim included contracts.\",\"diataxis\":\"reference\",\"href\":\"/app-developers/reference/tools/supersim/included-contracts\"},{\"title\":\"Vanilla mode\",\"description\":\"Learn how to use Supersim in vanilla mode (non-forked).\",\"diataxis\":\"how-to\",\"href\":\"/app-developers/reference/tools/supersim/vanilla\"}]}]}]},{\"tab\":\"Protocol\",\"pages\":[{\"title\":\"Protocol\",\"href\":\"/op-stack/introduction/op-stack\"}]},{\"tab\":\"OP Mainnet\",\"pages\":[{\"title\":\"OP Mainnet\",\"href\":\"/op-mainnet\"}]},{\"tab\":\"Governance\",\"pages\":[{\"title\":\"Governance\",\"href\":\"/governance/protocol-upgrades\"}]},{\"tab\":\"Notices\",\"pages\":[{\"title\":\"Notices\",\"href\":\"/notices\"}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L4a\"}]\n"])</script><script>self.__next_f.push([1,"4b:I[763509,[\"/mintlify-assets/_next/static/chunks/607c8643ad3fc16c.js?dpl=dpl_GVtXmXHpaP6SrfeCHtJggY5XmUiC\",\"/mintlify-assets/_next/static/chunks/1e7a188add93a653.js?dpl=dpl_GVtXmXHpaP6SrfeCHtJggY5XmUiC\",\"/mintlify-assets/_next/static/chunks/343f3c7f568a2e5d.js?dpl=dpl_GVtXmXHpaP6SrfeCHtJggY5XmUiC\",\"/mintlify-assets/_next/static/chunks/c50d793b8f34b10b.js?dpl=dpl_GVtXmXHpaP6SrfeCHtJggY5XmUiC\",\"/mintlify-assets/_next/static/chunks/ccee8d9b3189ccd9.js?dpl=dpl_GVtXmXHpaP6SrfeCHtJggY5XmUiC\",\"/mintlify-assets/_next/static/chunks/2b24f11e21272c