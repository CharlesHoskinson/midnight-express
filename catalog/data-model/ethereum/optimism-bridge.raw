=\"dark\"] .card-list-item__number {\n  background: #334155;\n  color: #cbd5e1;\n}\n\n.card-list-item__content {\n  flex: 1;\n}\n\n.card-list-item__header {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin-bottom: 0.5rem;\n}\n\n.card-list-item__title {\n  font-family: var(--font-riforma) !important;\n  margin: 0;\n  font-size: 1rem;\n  font-weight: 400;\n  color: #0f172a;\n  transition: color 0.2s ease;\n  letter-spacing: -0.01em;\n}\n\nhtml[class*=\"dark\"] .card-list-item__title {\n  color: #f1f5f9;\n}\n\n.card-list-item__description {\n  font-family: var(--font-riforma) !important;\n  margin: 0;\n  font-size: 0.875rem;\n  color: #64748b;\n  line-height: 1.5;\n  transition: color 0.2s ease;\n}\n\nhtml[class*=\"dark\"] .card-list-item__description {\n  color: #94a3b8;\n}\n\n.card-list-item__badge {\n  padding: 0.25rem 0.75rem;\n  border-radius: 16px;\n  font-size: 0.75rem;\n  font-weight: 600;\n  text-transform: capitalize;\n}\n\n.card-list-item__badge--easy {\n  background: #dcfce7;\n  color: #166534;\n}\n\n.card-list-item__badge--medium {\n  background: #fef3c7;\n  color: #92400e;\n}\n\n.card-list-item__badge--hard {\n  background: #fee2e2;\n  color: #991b1b;\n}\n\nhtml[class*=\"dark\"] .card-list-item__badge--easy {\n  background: #14532d;\n  color: #bbf7d0;\n}\n\nhtml[class*=\"dark\"] .card-list-item__badge--medium {\n  background: #92400e;\n  color: #fef3c7;\n}\n\nhtml[class*=\"dark\"] .card-list-item__badge--hard {\n  background: #991b1b;\n  color: #fecaca;\n}\n\n.card-list-item__arrow {\n  color: #cbd5e1;\n  font-size: 1.25rem;\n  transition: all 0.2s ease;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-top: 0.25rem;\n}\n\n.card-list-item:hover .card-list-item__arrow {\n  transform: translateX(4px);\n  color: #ef4444;\n}\n\nhtml[class*=\"dark\"] .card-list-item__arrow {\n  color: #64748b;\n}\n\nhtml[class*=\"dark\"] .card-list-item:hover .card-list-item__arrow {\n  color: #ef4444;\n}\n\n/* Container for regular Mintlify sections (not homepage) */\n.nx-prose:not([data-page-id=\"index\"] .nx-prose) {\n  max-width: 1400px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  padding-left: 2rem !important;\n  padding-right: 2rem !important;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .hero-section {\n    padding: 4rem 2rem;\n    flex-direction: column;\n    text-align: center;\n    min-height: auto;\n  }\n\n  .hero-content {\n    margin-bottom: 2rem;\n    max-width: none;\n  }\n\n  .home-cards {\n    grid-template-columns: 1fr !important;\n    padding: 0 2rem;\n  }\n\n  .nx-prose {\n    padding-left: 2rem !important;\n    padding-right: 2rem !important;\n  }\n\n  .card-list-item__header {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 0.5rem;\n  }\n}\n\n.nx-card img,\n[class*=\"card\"] img[src*=\"/public/img/\"] {\n  background: transparent !important;\n}"])</script><script>self.__next_f.push([1,"53:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"styles/homepage.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$58\"}}]]\n5a:T1d7c,"])</script><script>self.__next_f.push([1,"// Enhanced Mixpanel Analytics for Optimism Docs\n// This extends the default Mintlify + Mixpanel integration\n\n(function() {\n  // Wait for Mixpanel to be loaded by Mintlify\n  function waitForMixpanel(callback) {\n    if (typeof mixpanel !== 'undefined') {\n      callback();\n    } else {\n      setTimeout(() =\u003e waitForMixpanel(callback), 100);\n    }\n  }\n\n  waitForMixpanel(() =\u003e {\n    // Enhanced User Properties\n    mixpanel.register({\n      'docs_version': 'mintlify_v2',\n      'platform': 'optimism_docs',\n      'user_agent': navigator.userAgent,\n      'screen_resolution': `${screen.width}x${screen.height}`,\n      'timezone': Intl.DateTimeFormat().resolvedOptions().timeZone\n    });\n\n    // Track Developer Persona Based on Navigation\n    function trackDeveloperPersona() {\n      const currentTab = document.querySelector('[data-tab].active')?.textContent || 'unknown';\n      const personaMap = {\n        'App Devs': 'app_developer',\n        'Operators': 'chain_operator', \n        'OP Stack': 'protocol_developer',\n        'Interoperability': 'interop_developer',\n        'Superchain': 'ecosystem_developer'\n      };\n\n      const persona = personaMap[currentTab] || 'general_user';\n      mixpanel.register({ 'developer_persona': persona });\n      \n      mixpanel.track('Persona Identified', {\n        'persona': persona,\n        'tab': currentTab,\n        'timestamp': new Date().toISOString()\n      });\n    }\n\n    // Track Tutorial Progress\n    function trackTutorialProgress() {\n      const tutorialSteps = document.querySelectorAll('[data-step], .steps \u003e div');\n      if (tutorialSteps.length \u003e 0) {\n        const currentPage = window.location.pathname;\n        \n        tutorialSteps.forEach((step, index) =\u003e {\n          const observer = new IntersectionObserver((entries) =\u003e {\n            entries.forEach(entry =\u003e {\n              if (entry.isIntersecting) {\n                mixpanel.track('Tutorial Step Viewed', {\n                  'tutorial_page': currentPage,\n                  'step_number': index + 1,\n                  'total_steps': tutorialSteps.length,\n                  'progress_percentage': Math.round(((index + 1) / tutorialSteps.length) * 100)\n                });\n              }\n            });\n          }, { threshold: 0.5 });\n          \n          observer.observe(step);\n        });\n      }\n    }\n\n    // Track Code Snippet Interactions\n    function trackCodeSnippets() {\n      // Track copy button clicks\n      document.addEventListener('click', (e) =\u003e {\n        if (e.target.matches('[data-copy], .copy-button, [aria-label*=\"Copy\"]')) {\n          const codeBlock = e.target.closest('pre, .code-block');\n          const language = codeBlock?.querySelector('code')?.className?.match(/language-(\\w+)/)?.[1] || 'unknown';\n          \n          mixpanel.track('Code Copied', {\n            'language': language,\n            'page': window.location.pathname,\n            'code_length': codeBlock?.textContent?.length || 0\n          });\n        }\n      });\n    }\n\n    // Track AI Feature Usage\n    function trackAIFeatures() {\n      // Track contextual actions (copy to ChatGPT, Claude, etc.)\n      document.addEventListener('click', (e) =\u003e {\n        const button = e.target.closest('[data-action]');\n        if (button) {\n          const action = button.getAttribute('data-action') || button.textContent.toLowerCase();\n          \n          if (action.includes('chatgpt') || action.includes('claude') || action.includes('copy')) {\n            mixpanel.track('AI Feature Used', {\n              'feature_type': action,\n              'page': window.location.pathname,\n              'content_type': determineContentType()\n            });\n          }\n        }\n      });\n    }\n\n    // Track Search Behavior\n    function trackSearchBehavior() {\n      const searchInput = document.querySelector('[data-search], input[type=\"search\"]');\n      if (searchInput) {\n        let searchTimeout;\n        \n        searchInput.addEventListener('input', (e) =\u003e {\n          clearTimeout(searchTimeout);\n          searchTimeout = setTimeout(() =\u003e {\n            if (e.target.value.length \u003e 2) {\n              mixpanel.track('Search Query', {\n                'query': e.target.value,\n                'query_length': e.target.value.length,\n                'page_context': window.location.pathname\n              });\n            }\n          }, 1000);\n        });\n      }\n    }\n\n    // Track Feedback Interactions\n    function trackFeedback() {\n      document.addEventListener('click', (e) =\u003e {\n        // Thumbs rating\n        if (e.target.matches('[data-rating], .thumbs-up, .thumbs-down')) {\n          const rating = e.target.classList.contains('thumbs-up') || \n                        e.target.getAttribute('data-rating') === 'positive' ? 'positive' : 'negative';\n          \n          mixpanel.track('Page Feedback', {\n            'rating': rating,\n            'page': window.location.pathname,\n            'content_type': determineContentType()\n          });\n        }\n\n        // Suggest edit / Raise issue\n        if (e.target.matches('[data-suggest-edit], [data-raise-issue]')) {\n          const actionType = e.target.getAttribute('data-suggest-edit') !== null ? 'suggest_edit' : 'raise_issue';\n          \n          mixpanel.track('Content Improvement Action', {\n            'action_type': actionType,\n            'page': window.location.pathname,\n            'content_type': determineContentType()\n          });\n        }\n      });\n    }\n\n    // Helper function to determine content type\n    function determineContentType() {\n      const path = window.location.pathname;\n      if (path.includes('/tutorials/')) return 'tutorial';\n      if (path.includes('/tools/')) return 'tool_documentation';\n      if (path.includes('/configuration/')) return 'configuration_guide';\n      if (path.includes('/api/')) return 'api_reference';\n      return 'general_documentation';\n    }\n\n    // Track Time on Page\n    let pageStartTime = Date.now();\n    let isPageVisible = true;\n\n    document.addEventListener('visibilitychange', () =\u003e {\n      isPageVisible = !document.hidden;\n    });\n\n    window.addEventListener('beforeunload', () =\u003e {\n      if (isPageVisible) {\n        const timeOnPage = Math.round((Date.now() - pageStartTime) / 1000);\n        mixpanel.track('Page Session End', {\n          'time_on_page_seconds': timeOnPage,\n          'page': window.location.pathname,\n          'content_type': determineContentType()\n        });\n      }\n    });\n\n    // Initialize all tracking\n    function initializeTracking() {\n      trackDeveloperPersona();\n      trackTutorialProgress();\n      trackCodeSnippets();\n      trackAIFeatures();\n      trackSearchBehavior();\n      trackFeedback();\n      \n      // Track initial page view with enhanced properties\n      mixpanel.track('Enhanced Page View', {\n        'page': window.location.pathname,\n        'content_type': determineContentType(),\n        'referrer': document.referrer,\n        'timestamp': new Date().toISOString()\n      });\n    }\n\n    // Initialize when DOM is ready\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initializeTracking);\n    } else {\n      initializeTracking();\n    }\n\n    // Re-initialize on navigation (SPA behavior)\n    let currentPath = window.location.pathname;\n    setInterval(() =\u003e {\n      if (window.location.pathname !== currentPath) {\n        currentPath = window.location.pathname;\n        pageStartTime = Date.now();\n        setTimeout(initializeTracking, 500); // Small delay for DOM updates\n      }\n    }, 1000);\n  });\n})();\n"])</script><script>self.__next_f.push([1,"54:[\"$\",\"$L59\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"68e527abf5cdcba58d5a8a2b\",\"subdomain\":\"optimism-373f39ad\",\"filePath\":\"public/mixpanel-custom.js\",\"__v\":0,\"content\":\"$5a\"}]}]\n5d:T663c,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Heading,Info,Step,Steps}=_components;if(!Heading)_missingMdxReference(`Heading`,true);if(!Info)_missingMdxReference(`Info`,true);if(!Step)_missingMdxReference(`Step`,true);if(!Steps)_missingMdxReference(`Steps`,true);return _jsxs(_Fragment,{children:[_jsxs(_components.p,{children:[`The Standard Bridge is a basic token bridging system available on OP Mainnet and all other standard OP Stack chains.\nThe Standard Bridge allows you to easily move ETH and most ERC-20 tokens between Ethereum and OP Mainnet.\nTransfers from Ethereum to OP Mainnet via the Standard Bridge are usually completed within 1-3 minutes.\nTransfers from OP Mainnet to Ethereum are completed in 7 days as a result of the `,_jsx(_components.a,{href:`/app-developers/guides/bridging/messaging#understanding-the-challenge-period`,children:`withdrawal challenge period`}),`.`]}),`\n`,_jsx(_components.p,{children:`The Standard Bridge is fully permissionless and supports standard ERC-20 tokens.\nOther bridging systems also exist that provide different features and security properties.\nYou may wish to explore some of these options to find the bridge that works best for you and your application.`}),`\n`,_jsx(Info,{children:_jsxs(_components.p,{children:[`The Standard Bridge `,_jsx(_components.strong,{children:`does not`}),` support `,_jsx(_components.a,{href:`https://github.com/d-xo/weird-erc20#fee-on-transfer`,children:_jsx(_components.strong,{children:`fee on transfer tokens`})}),` or `,_jsx(_components.a,{href:`https://github.com/d-xo/weird-erc20#balance-modifications-outside-of-transfers-rebasingairdrops`,children:_jsx(_components.strong,{children:`rebasing tokens`})}),` because they can cause bridge accounting errors.`]})}),`\n`,_jsx(Heading,{level:`2`,id:`design`,children:`Design`}),`\n`,_jsx(_components.p,{children:`The Standard Bridge allows users to convert tokens that are native to one chain (like Ethereum) into a representation of those tokens on the other chain (like OP Mainnet).\nUsers can then convert these bridged representations back into their original native tokens at any time.`}),`\n`,_jsx(_components.p,{children:`This bridging mechanism functions identically in both directions — tokens native to OP Mainnet can be bridged to Ethereum, just like tokens native to Ethereum can be bridged to OP Mainnet.\nHere you’ll get to understand how the Standard Bridge works when moving tokens from Ethereum to OP Mainnet.\nSince the bridging mechanism is mirrored on both sides, this will also explain how the bridge works in the opposite direction.`}),`\n`,_jsx(Heading,{level:`3`,id:`architecture`,children:`Architecture`}),`\n`,_jsxs(_components.p,{children:[`The Standard Bridge is composed of two contracts, the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/L1/L1StandardBridge.sol`,children:_jsx(_components.code,{children:`L1StandardBridge`})}),` (on `,_jsx(_components.code,{children:`Ethereum`}),`) and the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/L2/L2StandardBridge.sol`,children:_jsx(_components.code,{children:`L2StandardBridge`})}),` (on `,_jsx(_components.code,{children:`OP Mainnet`}),`).\nThese two contracts interact with one another via the `,_jsx(_components.code,{children:`CrossDomainMessenger`}),` system for sending messages between Ethereum and OP Mainnet.\nYou can read more about the `,_jsx(_components.code,{children:`CrossDomainMessenger`}),` in the guide on `,_jsx(_components.a,{href:`/app-developers/guides/bridging/messaging`,children:`Sending Data Between L1 and L2`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`bridged-tokens`,children:`Bridged tokens`}),`\n`,_jsx(_components.p,{children:`The Standard Bridge utilizes bridged representations of tokens that are native to another blockchain.\nBefore a token native to one chain can be bridged to the other chain, a bridged representation of that token must be created on the receiving side.`}),`\n`,_jsxs(_components.p,{children:[`A bridged representation of a token is an ERC-20 token that implements the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/interfaces/universal/IOptimismMintableERC20.sol#L10-L18`,children:_jsx(_components.code,{children:`IOptimismMintableERC20`})}),` interface.\nThis interface includes a few functions that the `,_jsx(_components.code,{children:`StandardBridge`}),` contracts use to manage the bridging process.\nAll bridged versions of tokens `,_jsx(_components.strong,{children:`must`}),` implement this interface to be used with the `,_jsx(_components.code,{children:`StandardBridge`}),`.\nNative tokens do not need to implement this interface.`]}),`\n`,_jsx(_components.p,{children:`A native token may have more than one bridged representation at the same time.\nUsers must always specify which bridged token they wish to use when using the bridge.\nDifferent bridged representations of the same native token are considered entirely independent tokens.`}),`\n`,_jsx(Heading,{level:`3`,id:`bridging-native-tokens`,children:`Bridging native tokens`}),`\n`,_jsxs(_components.p,{children:[`The Standard Bridge uses a “lock-and-mint” mechanism to convert native tokens into their bridged representations.\nThis means that `,_jsx(_components.strong,{children:`native tokens are locked`}),` into the Standard Bridge on one side, after which `,_jsx(_components.strong,{children:`bridged tokens are minted`}),` on the other side.\nThe process for bridging a native token involves a few steps.`]}),`\n`,_jsxs(Steps,{children:[_jsx(Step,{title:`User gives the Standard Bridge an allowance`,children:_jsxs(_components.p,{children:[`The Standard Bridge must be able to pull tokens from the user to lock them into the bridge contract.\nTo do this, the user must first give the bridge an `,_jsx(_components.a,{href:`https://eips.ethereum.org/EIPS/eip-20#approve`,children:`allowance`}),` to transfer the number of tokens that the user wishes to convert into a bridged representation.`]})}),_jsxs(Step,{title:`User calls the bridging function`,children:[_jsxs(_components.p,{children:[`After providing a sufficient allowance, the user calls the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L217-L229`,children:_jsx(_components.code,{children:`bridgeERC20To`})}),` function on the `,_jsx(_components.code,{children:`StandardBridge`}),` contract on the chain where the native token lives (e.g., the `,_jsx(_components.code,{children:`L1StandardBridge`}),` contract if the token is native to Ethereum).`]}),_jsx(_components.p,{children:`The user must provide the following parameters to this function call:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`address _localToken`}),`: Address of the native token on the sending side.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`address _remoteToken`}),`: Address of the bridged representation on the receiving side.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`address _to`}),`: Address of the recipient of these tokens, usually the sender’s address.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`uint256 _amount`}),`: Number of tokens to transfer.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`uint32 _minGasLimit`}),`: Gas to use to complete the transfer on the receiving side.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`bytes calldata _extraData`}),`: Optional identity extra data.`]}),`\n`]}),_jsxs(Info,{children:[_jsxs(_components.p,{children:[`Users can also trigger the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L194-L206`,children:_jsx(_components.code,{children:`bridgeERC20`})}),` function instead of `,_jsx(_components.code,{children:`bridgeERC20To`}),` to avoid needing to specify the `,_jsx(_components.code,{children:`address _to`}),` parameter.\nDoing so will automatically set the `,_jsx(_components.code,{children:`address _to`}),` parameter to the `,_jsx(_components.code,{children:`msg.sender`}),`.`]}),_jsxs(_components.p,{children:[_jsxs(_components.strong,{children:[`The `,_jsx(_components.code,{children:`bridgeERC20`}),` function can be potentially dangerous for users with `,_jsx(_components.a,{href:`https://web.archive.org/web/20231012141406/https://blockworks.co/news/what-are-smart-contract-wallets`,children:`smart contract wallets`}),` as some smart contract wallets cannot be deployed at the same address on every blockchain.`]}),`\nTo help users avoid potentially losing access to tokens by accident, the `,_jsx(_components.code,{children:`bridgeERC20`}),` function will always revert when triggered from a smart contract.\nSmart contract wallet users and other smart contracts should therefore use the `,_jsx(_components.code,{children:`bridgeERC20To`}),` function instead.`]})]})]}),_jsxs(Step,{title:`The Standard Bridge locks the transferred tokens`,children:[_jsxs(_components.p,{children:[`When the user triggers the `,_jsx(_components.code,{children:`bridgeERC20To`}),` function while transferring a native token, the Standard Bridge will pull the `,_jsx(_components.code,{children:`_amount`}),` of `,_jsx(_components.code,{children:`_localToken`}),` tokens from the user’s address and lock them inside of the bridge contract.\nA record of all locked tokens is stored within a `,_jsxs(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L41`,children:[_jsx(_components.code,{children:`deposits`}),` mapping`]}),` that keeps track of the total number of tokens deposited for a given `,_jsx(_components.code,{children:`_localToken`}),` and `,_jsx(_components.code,{children:`_remoteToken`}),` pair.`]}),_jsxs(_components.p,{children:[`Since a native token may have more than one bridged representation, the `,_jsx(_components.code,{children:`deposits`}),` token must keep track of the deposit pools for each `,_jsx(_components.code,{children:`_localToken`}),`/`,_jsx(_components.code,{children:`_remoteToken`}),` pair independently.`]}),_jsxs(_components.p,{children:[`To illustrate, suppose that two users deposit 100 units of the same native token, `,_jsx(_components.code,{children:`Token A`}),`, but wish to receive two different bridged tokens, `,_jsx(_components.code,{children:`Token B`}),` and `,_jsx(_components.code,{children:`Token C`}),`.\nAlthough the Standard Bridge would now have a total balance of 200 units of `,_jsx(_components.code,{children:`Token A`}),`, the mapping would show that the `,_jsx(_components.code,{children:`Token A`}),`/`,_jsx(_components.code,{children:`Token B`}),` pool and the `,_jsx(_components.code,{children:`Token A`}),`/`,_jsx(_components.code,{children:`Token C`}),` pool both have only 100 units.`]})]}),_jsx(Step,{title:`The Standard Bridge sends a minting message`,children:_jsxs(_components.p,{children:[`After locking the native tokens, the Standard Bridge contract on the sending side will trigger a cross-chain message to the Standard Bridge contract on the receiving side via the `,_jsx(_components.a,{href:`/app-developers/guides/bridging/messaging`,children:_jsx(_components.code,{children:`CrossDomainMessenger`})}),` system.\nThis message tells the receiving side to `,_jsx(_components.strong,{children:`mint`}),` tokens according to the parameters specified by the user.\nSpecifically, this message is an encoded call to the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L272-L299`,children:_jsx(_components.code,{children:`finalizeBridgeERC20`})}),` function on the other Standard Bridge contract.\nAt this point, execution ends on the sending side.`]})}),_jsxs(Step,{title:`The minting message is executed`,children:[_jsxs(_components.p,{children:[`Once the minting message is sent, it must be relayed to the receiving side.\nMessage relaying is automatic when sending from Ethereum to OP Mainnet but requires additional user transactions when sending from OP Mainnet to Ethereum.\nRead more about the message relaying process in the guide to `,_jsx(_components.a,{href:`/app-developers/guides/bridging/messaging#communication-speed`,children:`Sending Data Between L1 and L2`}),`.`]}),_jsxs(_components.p,{children:[`When the message is relayed, the `,_jsx(_components.code,{children:`finalizeBridgeERC20`}),` function will be triggered on the receiving Standard Bridge contract.\nThis function will receive the `,_jsx(_components.code,{children:`_minGasLimit`}),` gas defined by the user to execute to completion.`]})]}),_jsxs(Step,{title:`The minting message is authenticated`,children:[_jsxs(_components.p,{children:[`Upon execution, `,_jsx(_components.code,{children:`finalizeBridgeERC20`}),` verifies a number of things about the incoming request:`]}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L281`,children:`The request must have originated from the Standard Bridge contract on the other blockchain`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L283`,children:`The Standard Bridge must not be in an emergency paused state`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsxs(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L284`,children:[`The bridged token must properly implement the `,_jsx(_components.code,{children:`IOptimismMintableERC20`}),` interface`]}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsxs(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L285-L288`,children:[`The bridged token must recognize the original native token as its `,_jsx(_components.code,{children:`remoteToken()`})]}),`.`]}),`\n`]})]}),_jsxs(Step,{title:`The bridged token is minted`,children:[_jsxs(_components.p,{children:[`If the minting message is fully verified, `,_jsx(_components.code,{children:`finalizeBridgeERC20`}),` will `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L290`,children:`mint tokens to the recipient`}),` equal to the number of tokens originally deposited on the other blockchain.\nFor this to work properly, the bridged representation of the native token must correctly implement a `,_jsx(_components.code,{children:`mint`}),` function that allows the Standard Bridge to mint tokens arbitrarily.\nThis is part of the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/interfaces/universal/IOptimismMintableERC20.sol`,children:_jsx(_components.code,{children:`IOptimismMintableERC20`})}),` interface.`]}),_jsx(_components.p,{children:`This completes the process of bridging native tokens.\nThis process is identical in both the Ethereum to OP Mainnet and OP Mainnet to Ethereum directions.`})]})]}),`\n`,_jsx(Heading,{level:`3`,id:`bridging-non-native-tokens`,children:`Bridging non-native tokens`}),`\n`,_jsxs(_components.p,{children:[`The Standard Bridge uses a “burn-and-unlock” mechanism to convert bridged representations of tokens back into their native tokens.\nThis means that `,_jsx(_components.strong,{children:`bridged tokens are burned`}),` on the Standard Bridge on one side, after which `,_jsx(_components.strong,{children:`native tokens are unlocked`}),` on the other side.\nThe process for bridging a non-native, bridged representation of a token involves a few steps.`]}),`\n`,_jsxs(Steps,{children:[_jsxs(Step,{title:`User calls the bridging function`,children:[_jsxs(_components.p,{children:[`Unlike when bridging native tokens, users do not need to provide an approval to trigger a transfer of a bridged token because the Standard Bridge should already have the ability to `,_jsx(_components.code,{children:`burn`}),` these tokens.\nHere, the user calls the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L217-L229`,children:_jsx(_components.code,{children:`bridgeERC20To`})}),` function on the `,_jsx(_components.code,{children:`StandardBridge`}),` contract on the chain where the bridged token lives (e.g., the `,_jsx(_components.code,{children:`L2StandardBridge`}),` contract if the token is bridged to OP Mainnet).`]}),_jsx(_components.p,{children:`The user must provide the following parameters to this function call:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`address _localToken`}),`: Address of the bridged token on the sending side.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`address _remoteToken`}),`: Address of the native token on the receiving side.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`address _to`}),`: Address of the recipient of these tokens, usually the sender’s address.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`uint256 _amount`}),`: Number of tokens to transfer.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`uint32 _minGasLimit`}),`: Gas to use to complete the transfer on the receiving side.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`bytes calldata _extraData`}),`: Optional identity extra data.`]}),`\n`]})]}),_jsx(Step,{title:`The Standard Bridge burns the transferred tokens`,children:_jsxs(_components.p,{children:[`When the user triggers the `,_jsx(_components.code,{children:`bridgeERC20To`}),` function while transferring a bridge token, `,_jsxs(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L359`,children:[`the Standard Bridge will burn the corresponding `,_jsx(_components.code,{children:`_amount`}),` of tokens from the sender’s address`]}),`.`]})}),_jsx(Step,{title:`The Standard Bridge sends an unlock message`,children:_jsxs(_components.p,{children:[`After burning the bridged tokens, the Standard Bridge contract on the sending side will trigger a cross-chain message to the Standard Bridge contract on the receiving side via the `,_jsx(_components.a,{href:`/app-developers/guides/bridging/messaging`,children:_jsx(_components.code,{children:`CrossDomainMessenger`})}),` system.\nThis message tells the receiving side to `,_jsx(_components.strong,{children:`unlock`}),` tokens according to the parameters specified by the user.\nSpecifically, this message is an encoded call to the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L272-L299`,children:_jsx(_components.code,{children:`finalizeBridgeERC20`})}),` function on the other Standard Bridge contract.\nAt this point, execution ends on the sending side.`]})}),_jsxs(Step,{title:`The unlock message is executed`,children:[_jsxs(_components.p,{children:[`Once the unlock message is sent, it must be relayed to the receiving side.\nMessage relaying is automatic when sending from Ethereum to OP Mainnet but requires additional user transactions when sending from OP Mainnet to Ethereum.\nRead more about the message relaying process in the guide to `,_jsx(_components.a,{href:`/app-developers/guides/bridging/messaging#communication-speed`,children:`Sending Data Between L1 and L2`}),`.`]}),_jsxs(_components.p,{children:[`When the message is relayed, the `,_jsx(_components.code,{children:`finalizeBridgeERC20`}),` function will be triggered on the receiving Standard Bridge contract.\nThis function will receive the `,_jsx(_components.code,{children:`_minGasLimit`}),` gas defined by the user to execute to completion.`]})]}),_jsxs(Step,{title:`The unlock message is authenticated`,children:[_jsxs(_components.p,{children:[`Upon execution, `,_jsx(_components.code,{children:`finalizeBridgeERC20`}),` verifies a number of things about the incoming request:`]}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L281`,children:`The request must have originated from the Standard Bridge contract on the other blockchain`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L283`,children:`The Standard Bridge must not be in an emergency paused state`}),`.`]}),`\n`]})]}),_jsxs(Step,{title:`The native token is unlocked`,children:[_jsxs(_components.p,{children:[`If the unlock message is fully verified, `,_jsx(_components.code,{children:`finalizeBridgeERC20`}),` will `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L292-L293`,children:`unlock and transfer tokens to the recipient`}),` equal to the number of tokens originally burned on the other blockchain.`]}),_jsx(_components.p,{children:`This completes the process of bridging native tokens.\nThis process is identical in both the Ethereum to OP Mainnet and OP Mainnet to Ethereum directions.`})]})]}),`\n`,_jsx(Heading,{level:`3`,id:`bridging-eth`,children:`Bridging ETH`}),`\n`,_jsxs(_components.p,{children:[`The Standard Bridge contracts can also be used to bridge ETH from Ethereum to OP Mainnet and vice versa.\nThe ETH bridging process is generally less complex than the ERC-20 bridging process.\nUsers simply need to trigger and send ETH to the `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L166-L168`,children:_jsx(_components.code,{children:`bridgeETH`})}),` or `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/universal/StandardBridge.sol#L182-L184`,children:_jsx(_components.code,{children:`bridgeETHTo`})}),` functions on either blockchain.`]}),`\n`,_jsx(Info,{children:_jsxs(_components.p,{children:[`Users can also deposit ETH from Ethereum to OP Mainnet by sending a basic ETH transfer from an EOA to the `,_jsx(_components.code,{children:`L1StandardBridgeProxy`}),`.\nThis works because the `,_jsx(_components.code,{children:`L1StandardBridgeProxy`}),` contains a `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/optimism/blob/develop/packages/contracts-bedrock/src/L1/L1StandardBridge.sol#L134-L136`,children:_jsx(_components.code,{children:`receive`})}),` function.\nYou can find the mainnet and testnet addresses on the `,_jsx(_components.a,{href:`/op-mainnet/network-information/op-addresses`,children:`Contract Addresses`}),` page.`]})}),`\n`,_jsx(Heading,{level:`2`,id:`tutorials`,children:`Tutorials`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`/app-developers/tutorials/bridging/cross-dom-bridge-erc20`,children:`Learn how to bridge ERC-20 tokens with viem`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`/app-developers/tutorials/bridging/standard-bridge-standard-token`,children:`Learn how to create a standard or custom bridged token`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`/app-developers/tutorials/bridging/cross-dom-bridge-eth`,children:`Learn how to submit transactions from L1`})}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`superchain-token-list`,children:`Superchain Token List`}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.a,{href:`/app-developers/reference/tokens/tokenlist`,children:`Superchain Token List`}),` exists to help users discover the right bridged token addresses for any given native token.\nBecause a native token may have more than one bridged representation, and different bridged representations are entirely independent tokens, using the wrong one can lock up your native tokens permanently.\nFollow the guide on `,_jsx(_components.a,{href:`/app-developers/guides/bridging/verify-bridged-tokens`,children:`verifying bridged token addresses`}),` to confirm that you’re using the correct bridged representation of a token before bridging.`]}),`\n`,_jsxs(_components.p,{children:[`Developers who are creating their own bridged tokens should consider `,_jsx(_components.a,{href:`https://github.com/ethereum-optimism/ethereum-optimism.github.io#adding-a-token-to-the-list`,children:`adding their token`}),` to the Superchain Token List.\nTokens on the Superchain Token List will automatically appear on certain tools like the `,_jsx(_components.a,{href:`https://app.optimism.io/bridge?utm_source=op-docs\u0026utm_medium=docs`,children:`Superchain Bridges UI`}),`.`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"55:[\"$\",\"$L5b\",null,{\"slug\":\"app-developers/guides/bridging/standard-bridge\",\"pageMetadata\":\"$4a:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5c\",null,{\"mdxSource\":{\"compiledSource\":\"$5d\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"Using the Standard Bridge\",\"description\":\"Learn how the Standard Bridge moves ETH and ERC-20 tokens between Layer 1 and Layer 2.\",\"diataxis\":\"explanation\",\"href\":\"/app-developers/guides/bridging/standard-bridge\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"docs.optimism.io\"}]}]\n"])</script></body></html>