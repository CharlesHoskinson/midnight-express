ma LL';\n  src: url('/fonts/RiformaLL-Medium.woff2') format('woff2');\n  font-weight: 500;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Riforma LL';\n  src: url('/fonts/RiformaLL-MediumItalic.woff2') format('woff2');\n  font-weight: 500;\n  font-style: italic;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Riforma LL';\n  src: url('/fonts/RiformaLL-Bold.woff2') format('woff2');\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Riforma LL';\n  src: url('/fonts/RiformaLL-BoldItalic.woff2') format('woff2');\n  font-weight: 700;\n  font-style: italic;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Riforma LL';\n  src: url('/fonts/RiformaLL-Heavy.woff2') format('woff2');\n  font-weight: 900;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Riforma LL';\n  src: url('/fonts/RiformaLL-HeavyItalic.woff2') format('woff2');\n  font-weight: 900;\n  font-style: italic;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Riforma LL';\n  src: url('/fonts/RiformaLL-Light.woff2') format('woff2');\n  font-weight: 300;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Riforma LL';\n  src: url('/fonts/RiformaLL-LightItalic.woff2') format('woff2');\n  font-weight: 300;\n  font-style: italic;\n  font-display: swap;\n}\n\n/* Apply Riforma LL globally */\nbody,\n.nx-prose,\n.nx-prose p,\n.nx-prose h1,\n.nx-prose h2,\n.nx-prose h3,\n.nx-prose h4,\n.nx-prose h5,\n.nx-prose h6 {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n}\n\n/* Homepage-specific styling (no frontmatter title/description) */\n/* Add proper container for h1 and p */\n[data-page-id=\"index\"] {\n  max-width: 1400px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  padding-left: 2rem !important;\n  padding-right: 2rem !important;\n}\n\n/* Style custom h1 and p tags */\n[data-page-id=\"index\"] h1 {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n  font-size: 3rem !important;\n  font-weight: 700 !important;\n  line-height: 1.1 !important;\n  margin-bottom: 1rem !important;\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n  color: #111827 !important;\n  letter-spacing: -0.02em !important;\n  max-width: 100% !important;\n}\n\nhtml[class*=\"dark\"] [data-page-id=\"index\"] h1 {\n  color: #f9fafb !important;\n}\n\n[data-page-id=\"index\"] \u003e p:first-of-type,\n[data-page-id=\"index\"] h1 + p {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n  font-size: 1.25rem !important;\n  line-height: 1.6 !important;\n  color: #6b7280 !important;\n  margin-bottom: 2rem !important;\n  margin-top: 0 !important;\n  max-width: 100% !important;\n}\n\nhtml[class*=\"dark\"] [data-page-id=\"index\"] \u003e p:first-of-type,\nhtml[class*=\"dark\"] [data-page-id=\"index\"] h1 + p {\n  color: #9ca3af !important;\n}\n\n/* Homepage content spacing */\n[data-page-id=\"index\"] .nx-prose {\n  padding-top: 0 !important;\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n  max-width: 100% !important;\n}\n\n/* Full width homepage styles */\n.nx-container {\n  max-width: none !important;\n  padding: 0 !important;\n  background: transparent !important;\n}\n\n/* Ensure page container has proper padding */\n[data-page-id=\"index\"] .nx-prose,\n[data-page-id=\"index\"] \u003e div \u003e div {\n  max-width: 100% !important;\n}\n\n/* Ensure clean link previews */\nbody {\n  background: #ffffff !important;\n}\n\nhtml[class*=\"dark\"] body {\n  background: #0f172a !important;\n}\n\n/* Remove any potential gradients from Mintlify */\n.nx-bg-gradient-to-r,\n.nx-bg-gradient-to-l,\n.nx-bg-gradient-to-t,\n.nx-bg-gradient-to-b,\n.nx-bg-gradient-to-br,\n.nx-bg-gradient-to-bl,\n.nx-bg-gradient-to-tr,\n.nx-bg-gradient-to-tl {\n  background: transparent !important;\n}\n\n/* Hero section styles */\n.hero-section {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: auto;\n  padding: 0;\n  margin-bottom: 2.5rem;\n  max-width: 100%;\n  margin-left: 0;\n  margin-right: 0;\n  background: transparent;\n}\n\n.hero-content {\n  flex: 1;\n  max-width: 505px;\n}\n\n.hero-content h1 {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  font-size: 2.5rem;\n  font-weight: 600;\n  line-height: 1.2;\n  margin-bottom: 0.75rem;\n  color: #111827;\n  letter-spacing: -0.025em;\n}\n\nhtml[class*=\"dark\"] .hero-content h1 {\n  color: #f9fafb;\n}\n\n.hero-content p {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  font-size: 1.125rem;\n  font-weight: 400;\n  line-height: 1.6;\n  margin-bottom: 1rem;\n  color: #6b7280;\n}\n\nhtml[class*=\"dark\"] .hero-content p {\n  color: #9ca3af;\n}\n\n.hero-visual {\n  flex: 1;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.hero-visual img {\n  max-width: 100%;\n  height: auto;\n}\n\n.hero-buttons {\n  display: flex;\n  gap: 1rem;\n}\n\n.btn-primary {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  background-color: #ef4444;\n  color: white;\n  padding: 0.75rem 1.5rem;\n  border: none;\n  border-radius: 6px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 0.2s;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n}\n\n.btn-primary:hover {\n  background-color: #dc2626;\n  color: white;\n  text-decoration: none;\n}\n\n.btn-secondary {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  background-color: transparent;\n  color: #1f2937;\n  padding: 0.75rem 1.5rem;\n  border: 1px solid #d1d5db;\n  border-radius: 6px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n}\n\n.btn-secondary:hover {\n  background-color: #f9fafb;\n  border-color: #9ca3af;\n  color: #1f2937;\n  text-decoration: none;\n}\n\nhtml[class*=\"dark\"] .btn-secondary {\n  color: #f9fafb;\n  border-color: #4b5563;\n}\n\nhtml[class*=\"dark\"] .btn-secondary:hover {\n  background-color: #374151;\n  border-color: #6b7280;\n  color: #f9fafb;\n}\n\n@media (max-width: 768px) {\n  .hero-section {\n    flex-direction: column;\n    text-align: center;\n    min-height: auto;\n    padding: 2rem 0;\n  }\n\n  .hero-content {\n    padding-right: 0;\n    margin-bottom: 2rem;\n  }\n\n  .hero-content h1 {\n    font-size: 1.75rem;\n  }\n\n  .hero-buttons {\n    justify-content: center;\n  }\n}\n\n/* Home Cards Component Styles */\n.home-cards {\n  width: 100%;\n  margin-bottom: 2.5rem;\n  margin-top: 0;\n  max-width: 100%;\n  margin-left: 0;\n  margin-right: 0;\n  padding: 0;\n}\n\n.home-card {\n  display: flex;\n  flex-direction: column;\n  padding: 1.75rem;\n  background: transparent;\n  border: 1px solid #e2e8f0;\n  border-radius: 12px;\n  transition: all 0.2s ease;\n}\n\nhtml[class*=\"dark\"] .home-card {\n  background: #1e293b;\n  border-color: #334155;\n}\n\n/* Card Content */\n.home-card .home-card__title {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n  font-size: 1.5rem !important;\n  font-weight: 600 !important;\n  margin: 0 0 1.5rem 0;\n  color: #0f172a;\n  letter-spacing: -0.01em;\n}\n\nhtml[class*=\"dark\"] .home-card .home-card__title {\n  color: #f1f5f9;\n}\n\n.home-card__footer {\n  margin-top: auto;\n  padding-top: 1.5rem;\n}\n\n.home-card__footer-link {\n  color: #64748b;\n  text-decoration: none;\n  font-size: 0.875rem;\n  font-weight: 500;\n  transition: color 0.2s ease;\n}\n\n.home-card__footer-link:hover {\n  color: #475569;\n  text-decoration: none;\n}\n\nhtml[class*=\"dark\"] .home-card__footer-link {\n  color: #94a3b8;\n}\n\nhtml[class*=\"dark\"] .home-card__footer-link:hover {\n  color: #cbd5e1;\n}\n\n/* Card List Components */\n.card-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n\n.card-list-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 1rem;\n  padding: 0.875rem 0;\n  border-radius: 6px;\n  text-decoration: none;\n  color: inherit;\n  transition: all 0.2s ease;\n  border-bottom: 1px solid #f1f5f9;\n}\n\n.card-list-item:last-child {\n  border-bottom: none;\n}\n\nhtml[class*=\"dark\"] .card-list-item {\n  border-bottom-color: #334155;\n}\n\n.card-list-item:hover .card-list-item__title {\n  color: #ef4444;\n}\n\n.card-list-item:hover .card-list-item__description {\n  color: #475569;\n}\n\nhtml[class*=\"dark\"] .card-list-item:hover .card-list-item__description {\n  color: #cbd5e1;\n}\n\n.card-list-item__number {\n  width: 2rem;\n  height: 2rem;\n  border-radius: 50%;\n  background: #f1f5f9;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 0.875rem;\n  flex-shrink: 0;\n  color: #475569;\n}\n\nhtml[class*=\"dark\"] .card-list-item__number {\n  background: #334155;\n  color: #cbd5e1;\n}\n\n.card-list-item__content {\n  flex: 1;\n}\n\n.card-list-item__header {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin-bottom: 0.5rem;\n}\n\n.card-list-item__title {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  margin: 0;\n  font-size: 1rem;\n  font-weight: 600;\n  color: #0f172a;\n  transition: color 0.2s ease;\n  letter-spacing: -0.01em;\n}\n\nhtml[class*=\"dark\"] .card-list-item__title {\n  color: #f1f5f9;\n}\n\n.card-list-item__description {\n  font-family: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  margin: 0;\n  font-size: 0.875rem;\n  color: #64748b;\n  line-height: 1.5;\n  transition: color 0.2s ease;\n}\n\nhtml[class*=\"dark\"] .card-list-item__description {\n  color: #94a3b8;\n}\n\n.card-list-item__badge {\n  padding: 0.25rem 0.75rem;\n  border-radius: 16px;\n  font-size: 0.75rem;\n  font-weight: 600;\n  text-transform: capitalize;\n}\n\n.card-list-item__badge--easy {\n  background: #dcfce7;\n  color: #166534;\n}\n\n.card-list-item__badge--medium {\n  background: #fef3c7;\n  color: #92400e;\n}\n\n.card-list-item__badge--hard {\n  background: #fee2e2;\n  color: #991b1b;\n}\n\nhtml[class*=\"dark\"] .card-list-item__badge--easy {\n  background: #14532d;\n  color: #bbf7d0;\n}\n\nhtml[class*=\"dark\"] .card-list-item__badge--medium {\n  background: #92400e;\n  color: #fef3c7;\n}\n\nhtml[class*=\"dark\"] .card-list-item__badge--hard {\n  background: #991b1b;\n  color: #fecaca;\n}\n\n.card-list-item__arrow {\n  color: #cbd5e1;\n  font-size: 1.25rem;\n  transition: all 0.2s ease;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-top: 0.25rem;\n}\n\n.card-list-item:hover .card-list-item__arrow {\n  transform: translateX(4px);\n  color: #ef4444;\n}\n\nhtml[class*=\"dark\"] .card-list-item__arrow {\n  color: #64748b;\n}\n\nhtml[class*=\"dark\"] .card-list-item:hover .card-list-item__arrow {\n  color: #ef4444;\n}\n\n/* Container for regular Mintlify sections (not homepage) */\n.nx-prose:not([data-page-id=\"index\"] .nx-prose) {\n  max-width: 1400px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  padding-left: 2rem !important;\n  padding-right: 2rem !important;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .hero-section {\n    padding: 4rem 2rem;\n    flex-direction: column;\n    text-align: center;\n    min-height: auto;\n  }\n\n  .hero-content {\n    margin-bottom: 2rem;\n    max-width: none;\n  }\n\n  .home-cards {\n    grid-template-columns: 1fr !important;\n    padding: 0 2rem;\n  }\n\n  .nx-prose {\n    padding-left: 2rem !important;