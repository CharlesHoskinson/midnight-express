-weight: 300;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Riforma LL';\n  src: url('/fonts/RiformaLL-LightItalic.woff2') format('woff2');\n  font-weight: 300;\n  font-style: italic;\n  font-display: swap;\n}\n\n/* Logo Size Control */\nimg[alt*=\"logo\"],\n.nx-logo img,\nnav img,\nheader img[src*=\"logo\"],\na[href=\"/\"] img {\n  max-height: 13px !important;\n  width: auto !important;\n  height: 13px !important;\n}\n\n/* Apply Riforma LL to regular text and Roboto Mono to code */\n:root {\n  --font-riforma: 'Riforma LL', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  --font-mono: 'Roboto Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n}\n\n/* Default font for regular text */\nbody {\n  font-family: var(--font-riforma) !important;\n}\n\n/* Apply Riforma LL to text content with high specificity */\nhtml,\nbody,\n.nx-prose,\n.nx-prose p,\n.nx-prose h1,\n.nx-prose h2,\n.nx-prose h3,\n.nx-prose h4,\n.nx-prose h5,\n.nx-prose h6,\n.nx-prose li,\n.nx-prose td,\n.nx-prose th,\n.nx-prose blockquote,\ndiv:not([class*=\"language-\"]):not(pre):not(code),\nspan:not([class*=\"language-\"]):not([class*=\"token\"]),\na:not(pre a):not(code a),\nbutton {\n  font-family: var(--font-riforma) !important;\n}\n\n/* Code blocks and inline code - MUST come after Riforma rules to override */\npre,\ncode,\n.nx-font-mono,\n.nx-bg-primary-700\\/5,\n.language-javascript,\n.language-typescript,\n.language-python,\n.language-json,\n.language-bash,\n.language-shell,\n.language-solidity,\n.language-yml,\n.language-yaml,\n.language-sh,\n[class*=\"language-\"],\n.nx-code-block,\ndiv[data-language],\ndiv[data-theme*=\"dark\"],\ndiv[data-theme*=\"light\"],\nspan[class*=\"token\"],\n.token,\n.comment,\n.prolog,\n.doctype,\n.cdata,\n.punctuation,\n.property,\n.tag,\n.boolean,\n.number,\n.constant,\n.symbol,\n.deleted,\n.function,\n.class-name,\n.regex,\n.important,\n.variable,\n.operator,\n.keyword {\n  font-family: var(--font-mono) !important;\n  font-feature-settings: normal !important;\n}\n\n/* Ensure all nested elements in code blocks use monospace */\npre *,\ncode *,\n.nx-code-block *,\ndiv[data-language] *,\n[class*=\"language-\"] *,\npre span,\ncode span,\n.nx-code-block span,\ndiv[data-language] span,\n[class*=\"language-\"] span {\n  font-family: var(--font-mono) !important;\n  font-feature-settings: normal !important;\n}\n\n/* Brand requirement: h1, h2 should use Riforma LL with font-weight 400 */\n.nx-prose h1,\nh1 {\n  font-family: var(--font-riforma) !important;\n  font-weight: 400 !important;\n}\n\n.nx-prose h2,\nh2 {\n  font-family: var(--font-riforma) !important;\n  font-weight: 400 !important;\n}\n\n.nx-prose h3,\nh3 {\n  font-family: var(--font-riforma) !important;\n  font-weight: 400 !important;\n}\n\n/* Homepage-specific styling (no frontmatter title/description) */\n/* Add proper container for h1 and p */\n[data-page-id=\"index\"] {\n  max-width: 1400px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  padding-left: 2rem !important;\n  padding-right: 2rem !important;\n}\n\n/* Style custom h1 and p tags */\n[data-page-id=\"index\"] h1 {\n  font-family: var(--font-riforma) !important;\n  font-size: 3rem !important;\n  font-weight: 400 !important;\n  line-height: 1.1 !important;\n  margin-bottom: 1rem !important;\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n  color: #111827 !important;\n  letter-spacing: -0.02em !important;\n  max-width: 100% !important;\n}\n\nhtml[class*=\"dark\"] [data-page-id=\"index\"] h1 {\n  color: #f9fafb !important;\n}\n\n[data-page-id=\"index\"] \u003e p:first-of-type,\n[data-page-id=\"index\"] h1 + p {\n  font-family: var(--font-riforma) !important;\n  font-size: 1.25rem !important;\n  line-height: 1.6 !important;\n  color: #6b7280 !important;\n  margin-bottom: 2rem !important;\n  margin-top: 0 !important;\n  max-width: 100% !important;\n}\n\nhtml[class*=\"dark\"] [data-page-id=\"index\"] \u003e p:first-of-type,\nhtml[class*=\"dark\"] [data-page-id=\"index\"] h1 + p {\n  color: #9ca3af !important;\n}\n\n/* Homepage content spacing */\n[data-page-id=\"index\"] .nx-prose {\n  padding-top: 0 !important;\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n  max-width: 100% !important;\n}\n\n/* Full width homepage styles */\n.nx-container {\n  max-width: none !important;\n  padding: 0 !important;\n  background: transparent !important;\n}\n\n/* Ensure page container has proper padding */\n[data-page-id=\"index\"] .nx-prose,\n[data-page-id=\"index\"] \u003e div \u003e div {\n  max-width: 100% !important;\n}\n\n/* Ensure clean link previews */\nbody {\n  background: #ffffff !important;\n}\n\nhtml[class*=\"dark\"] body {\n  background: #0f172a !important;\n}\n\n/* Remove any potential gradients from Mintlify */\n.nx-bg-gradient-to-r,\n.nx-bg-gradient-to-l,\n.nx-bg-gradient-to-t,\n.nx-bg-gradient-to-b,\n.nx-bg-gradient-to-br,\n.nx-bg-gradient-to-bl,\n.nx-bg-gradient-to-tr,\n.nx-bg-gradient-to-tl {\n  background: transparent !important;\n}\n\n/* Hero section styles */\n.hero-section {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: auto;\n  padding: 0;\n  margin-bottom: 2.5rem;\n  max-width: 100%;\n  margin-left: 0;\n  margin-right: 0;\n  background: transparent;\n}\n\n.hero-content {\n  flex: 1;\n  max-width: 505px;\n}\n\n.hero-content h1 {\n  font-family: var(--font-riforma) !important;\n  font-size: 2.5rem;\n  font-weight: 600;\n  line-height: 1.2;\n  margin-bottom: 0.75rem;\n  color: #111827;\n  letter-spacing: -0.025em;\n}\n\nhtml[class*=\"dark\"] .hero-content h1 {\n  color: #f9fafb;\n}\n\n.hero-content p {\n  font-family: var(--font-riforma) !important;\n  font-size: 1.125rem;\n  font-weight: 400;\n  line-height: 1.6;\n  margin-bottom: 1rem;\n  color: #6b7280;\n}\n\nhtml[class*=\"dark\"] .hero-content p {\n  color: #9ca3af;\n}\n\n.hero-visual {\n  flex: 1;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.hero-visual img {\n  max-width: 100%;\n  height: auto;\n}\n\n.hero-buttons {\n  display: flex;\n  gap: 1rem;\n}\n\n.btn-primary {\n  font-family: var(--font-riforma) !important;\n  background-color: #FF0420;\n  color: white;\n  padding: 0.75rem 1.5rem;\n  border: none;\n  border-radius: 0.75rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 0.2s;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n}\n\n.btn-primary:hover {\n  background-color: #e00320;\n  color: white;\n  text-decoration: none;\n}\n\n.btn-secondary {\n  font-family: var(--font-riforma) !important;\n  background-color: transparent;\n  color: #1f2937;\n  padding: 0.75rem 1.5rem;\n  border: 1px solid #d1d5db;\n  border-radius: 0.75rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n}\n\n.btn-secondary:hover {\n  background-color: #f9fafb;\n  border-color: #9ca3af;\n  color: #1f2937;\n  text-decoration: none;\n}\n\nhtml[class*=\"dark\"] .btn-secondary {\n  color: #f9fafb;\n  border-color: #4b5563;\n}\n\nhtml[class*=\"dark\"] .btn-secondary:hover {\n  background-color: #374151;\n  border-color: #6b7280;\n  color: #f9fafb;\n}\n\n@media (max-width: 768px) {\n  .hero-section {\n    flex-direction: column;\n    text-align: center;\n    min-height: auto;\n    padding: 2rem 0;\n  }\n\n  .hero-content {\n    padding-right: 0;\n    margin-bottom: 2rem;\n  }\n\n  .hero-content h1 {\n    font-size: 1.75rem;\n  }\n\n  .hero-buttons {\n    justify-content: center;\n  }\n}\n\n/* Home Cards Component Styles */\n.home-cards {\n  width: 100%;\n  margin-bottom: 2.5rem;\n  margin-top: 0;\n  max-width: 100%;\n  margin-left: 0;\n  margin-right: 0;\n  padding: 0;\n}\n\n.home-card {\n  display: flex;\n  flex-direction: column;\n  padding: 1.75rem;\