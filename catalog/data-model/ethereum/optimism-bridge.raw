      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var parentRect = parent.getBoundingClientRect();
    var itemRect = item.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://docs.optimism.io/#organization","name":"Optimism Documentation","url":"https://docs.optimism.io","logo":{"@type":"ImageObject","url":"https://mintcdn.com/optimism-373f39ad/Vw5vY8zA-CRjBsUF/public/logos/Lockup_docs_dark.svg?fit=max&auto=format&n=Vw5vY8zA-CRjBsUF&q=85&s=a1ab18aecbec09fe5ad40222ce76f00c"}},{"@type":"WebSite","@id":"https://docs.optimism.io#website","name":"Optimism Documentation","url":"https://docs.optimism.io","publisher":{"@id":"https://docs.optimism.io/#organization"}},{"@type":"WebPage","@id":"https://docs.optimism.io//app-developers/guides/bridging/standard-bridge#webpage","url":"https://docs.optimism.io//app-developers/guides/bridging/standard-bridge","name":"Using the Standard Bridge","description":"Learn how the Standard Bridge moves ETH and ERC-20 tokens between Layer 1 and Layer 2.","dateModified":"2026-08-01T19:09:22.360Z","isPartOf":{"@id":"https://docs.optimism.io#website"},"breadcrumb":{"@id":"https://docs.optimism.io//app-developers/guides/bridging/standard-bridge#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://docs.optimism.io//app-developers/guides/bridging/standard-bridge#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Guides","item":"https://docs.optimism.io/app-developers/guides/building-apps"},{"@type":"ListItem","position":2,"name":"Bridging","item":"https://docs.optimism.io/app-developers/guides/bridging/basics"},{"@type":"ListItem","position":3,"name":"Using the Standard Bridge","item":"https://docs.optimism.io//app-developers/guides/bridging/standard-bridge"}]},{"@type":["Article","TechArticle"],"@id":"https://docs.optimism.io//app-developers/guides/bridging/standard-bridge#article","headline":"Using the Standard Bridge","name":"Using the Standard Bridge","description":"Learn