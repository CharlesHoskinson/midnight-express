"h2\",null,{\"children\":\"Documentation Index\"}],[\"$\",\"p\",null,{\"children\":[\"Fetch the complete documentation index at:\",\" \",[\"$\",\"a\",null,{\"href\":\"/docs/llms.txt\",\"tabIndex\":-1,\"children\":\"/docs/llms.txt\"}]]}],[\"$\",\"p\",null,{\"children\":\"Use this file to discover all available pages before exploring further.\"}]]}],false,null,null,[\"$\",\"script\",null,{\"id\":\"_mintlify-banner-script\",\"dangerouslySetInnerHTML\":{\"__html\":\"(function i(a,b,c,d,e){try{let f,g,h=[];try{h=window.location.pathname.split(\\\"/\\\").filter(a=\u003e\\\"\\\"!==a\u0026\u0026\\\"global\\\"!==a).slice(0,2)}catch{h=[]}let i=h.find(a=\u003ec.includes(a)),j=[];for(let c of(i?j.push(i):j.push(b),j.push(\\\"global\\\"),j)){if(!c)continue;let b=a[c];if(b?.content){f=b.content,g=c;break}}if(!f)return void document.documentElement.setAttribute(d,\\\"hidden\\\");let k=!0,l=0;for(;l\u003clocalStorage.length;){let a=localStorage.key(l);if(l++,!a?.endsWith(e))continue;let b=localStorage.getItem(a);if(b\u0026\u0026b===f){k=!1;break}g\u0026\u0026(a.startsWith(`lang:${g}_`)||!a.startsWith(\\\"lang:\\\"))\u0026\u0026(localStorage.removeItem(a),l--)}document.documentElement.setAttribute(d,k?\\\"visible\\\":\\\"hidden\\\")}catch(a){console.error(a),document.documentElement.setAttribute(d,\\\"hidden\\\")}})(\\n  {\\\"global\\\":{\\\"content\\\":\\\"Manage your API keys, billing, and usage on the [**Developer Platform**](https://developers.jup.ag/portal). Questions? Reach us via [**Support**](/docs/resources/support).\\\"}},\\n  \\\"en\\\",\\n  [],\\n  \\\"data-banner-state\\\",\\n  \\\"bannerDismissed\\\",\\n)\"},\"suppressHydrationWarning\":true}],[\"$\",\"$L2b\",null,{\"appId\":\"$undefined\",\"autoBoot\":true,\"children\":[\"$\",\"$L2c\",null,{\"value\":{\"auth\":\"$undefined\",\"userAuth\":\"$undefined\"},\"children\":[\"$\",\"$L2d\",null,{\"value\":{\"subdomain\":\"jupiter\",\"hasAudioNarration\":false,\"actualSubdomain\":\"jupiter\",\"customDomains\":[\"developers.jup.ag\"],\"gitSource\":{\"type\":\"github\",\"owner\":\"jup-ag\",\"repo\":\"docs\",\"deployBranch\":\"main\",\"contentDirectory\":\"\",\"isPrivate\":false,\"mountPath\":\"\",\"label\":\"\"},\"chroma\":{\"liveDeploymentHistoryId\":\"6abf5f5e087bdc039c450ef3\",\"collectionId\":\"fadec661-bf6d-419d-b843-681b74cf2258\",\"schemaVersion\":\"v3\",\"latestBuiltDeploymentHistoryId\":\"6abf5f5e087bdc039c450ef3\"},\"feedback\":{\"thumbs\":true},\"entitlements\":{\"AI_CHAT\":{\"status\":\"ENABLED\"},\"REMOVE_BRANDING\":{\"status\":\"DISABLED\"},\"CONTEXTUAL_FEEDBACK\":{\"status\":\"DISABLED\"},\"CODE_SNIPPET_FEEDBACK\":{\"status\":\"DISABLED\"},\"WEB_MCP\":{\"status\":\"ENABLED\"},\"NARRATION\":{\"status\":\"ENABLED\"}},\"buildId\":\"6abfa8b6541723b30379d700\",\"clientVersion\":\"0.0.3774\",\"preview\":\"$undefined\",\"searchFilterCounts\":[{\"language\":\"default\",\"tag\":\"Docs\",\"count\":197},{\"language\":\"default\",\"tag\":\"API Reference\",\"count\":80},{\"language\":\"default\",\"tag\":\"Lend\",\"count\":64},{\"language\":\"default\",\"tag\":\"Prediction\",\"count\":44},{\"language\":\"default\",\"tag\":\"LO \u0026 DCA\",\"count\":30},{\"language\":\"default\",\"tag\":\"More\",\"count\":28},{\"language\":\"default\",\"tag\":\"Swap\",\"count\":26},{\"language\":\"default\",\"tag\":\"Get Started\",\"count\":25},{\"language\":\"default\",\"tag\":\"Resources\",\"count\":21},{\"language\":\"default\",\"tag\":\"Earn\",\"count\":18}],\"searchSettings\":\"$undefined\",\"disableKonamiCode\":\"$undefined\"},\"children\":[\"$\",\"$L2e\",null,{\"value\":{\"docsConfig\":{\"theme\":\"mint\",\"$schema\":\"https://mintlify.com/docs.json\",\"name\":\"Jupiter Developers\",\"colors\":{\"primary\":\"#00BEF0\",\"light\":\"#C7F284\",\"dark\":\"#000000\"},\"logo\":{\"light\":\"https://mintcdn.com/jupiter/mrenEfoqnubhOTHf/logo/logo.png?fit=max\u0026auto=format\u0026n=mrenEfoqnubhOTHf\u0026q=85\u0026s=e745e60a4186bc382d3d5d9bdff9273a\",\"dark\":\"https://mintcdn.com/jupiter/mrenEfoqnubhOTHf/logo/logo.png?fit=max\u0026auto=format\u0026n=mrenEfoqnubhOTHf\u0026q=85\u0026s=e745e60a4186bc382d3d5d9bdff9273a\",\"href\":\"https://developers.jup.ag/\"},\"favicon\":\"https://mintcdn.com/jupiter/mrenEfoqnubhOTHf/favicon.png?fit=max\u0026auto=format\u0026n=mrenEfoqnubhOTHf\u0026q=85\u0026s=453e41111d621d16c4f196f9e772ce58\",\"api\":{\"playground\":{\"display\":\"interactive\"}},\"appearance\":\"$19:2:props:children:1:props:appearance\",\"navbar\":{\"primary\":{\"type\":\"button\",\"label\":\"Dashboard\",\"href\":\"https://developers.jup.ag/portal\"}},\"footer\":{\"socials\":{\"x\":\"https://x.com/JupiterExchange\",\"discord\":\"https://discord.gg/jup\",\"telegram\":\"https://t.me/jup_dev\",\"github\":\"https://github.com/jup-ag\",\"youtube\":\"https://www.youtube.com/@JupiterOnchain\"},\"links\":[{\"items\":[{\"label\":\"Support\",\"href\":\"/docs/resources/support\"},{\"label\":\"Guidelines\",\"href\":\"/docs/legal\"},{\"label\":\"Legal\",\"href\":\"/docs/legal/sdk-api-license-agreement\"},{\"label\":\"Brand Kit\",\"href\":\"/docs/resources/brand-kit\"},{\"label\":\"Status\",\"href\":\"https://status.jup.ag\"}]}]},\"seo\":{\"metatags\":{\"og:image\":\"/logo/og.png\",\"og:type\":\"website\",\"og:site_name\":\"Jupiter Developers\",\"twitter:card\":\"summary_large_image\",\"twitter:site\":\"@JupiterExchange\",\"twitter:image\":\"/logo/og.png\",\"keywords\":\"Jupiter, Jupiter Developer Platform, Jupiter API, Jupiter SDK, Solana API, Solana swap API, Solana price API, Solana token API, prediction market API, Solana DeFi API, crypto API, Jupiter Swap, Jupiter Ultra, Jupiter Lend, Jupiter Perps, Jupiter Studio, Jupiter Plugin, Jupiter Wallet Kit, Jupiter Referral Program\"}},\"banner\":{\"content\":\"Manage your API keys, billing, and usage on the [**Developer Platform**](https://developers.jup.ag/portal). Questions? Reach us via [**Support**](/docs/resources/support).\"},\"contextual\":{\"options\":[\"copy\",\"view\",\"chatgpt\",\"claude\",\"cursor\",\"vscode\"],\"display\":\"header\"},\"styling\":{\"latex\":true,\"codeblocks\":\"system\"},\"navigation\":{\"pages\":[]}},\"docsNavWithMetadata\":\"$undefined\",\"anonymizedNav\":\"$undefined\",\"hasFullNav\":false},\"children\":\"$L2f\"}]}]}]}]]}]]}]]\n"])</script><script>self.__next_f.push([1,"31:T4ad,"])</script><script>self.__next_f.push([1,"How to use the Jupiter Developer Platform firewall to control traffic to API keys used in browser, mobile, or other client-side apps. Firewall rules are evaluated per team at the api.jup.ag gateway before requests reach the API, with up to 50 rules per team (enabled or disabled, deleted rules excluded). When several rules match a request, one decision rule wins by: (1) action precedence Bypass \u003e Deny \u003e Rate limit \u003e Log, (2) specificity (count of distinct condition types in the matched group, e.g. path + country = 2 beats path alone = 1), (3) age (older rule wins). Each rule combines conditions (Path starts-with prefix, API keys is-any-of, Method, Country, Header, IP/CIDR) with AND/OR groups and one of four actions: Log (record only), Deny (returns 403 'Request blocked by firewall'), Rate limit (N requests per second/minute scoped per IP, per API key, or per team; returns 429 when exceeded), or Bypass (skips firewall checks for matching trusted traffic, must have at least one condition). Each rule shows a human-readable IF...THEN Expression Overview. Firewall decisions and matched rules appear in request logs and Firewall analytics, and rule changes are recorded in the audit log."])</script><script>self.__next_f.push([1,"32:T489,"])</script><script>self.__next_f.push([1,"How to integrate an AMM (automated market maker, also called a DEX) into Jupiter's Metis routing engine, which powers both /order and /build endpoints. Covers the self-serve integration workflow: implement the Amm trait from the jupiter-amm-interface Rust crate, verify that Amm::quote() matches on-chain execution with the jupiter-amm-test-kit parity harness in the same repository (it snapshots a live pool, executes the native swap in LiteSVM, and asserts the quoted amounts equal the on-chain token deltas exactly), then submit the SDK for review via the AMM integrators support form at support.jup.ag. Implementation mechanics (trait definition, test-suite pattern, fixtures) live in the jup-ag/jupiter-amm-interface repository READMEs; this page covers Jupiter-side requirements: integration prerequisites (security audit, code health, traction), the no-network-calls rule, SDK fork access, and the submission process. Also explains how proprietary AMMs (propAMMs) detect Jupiter frontend flow by verifying the dedicated signer sighWH8KaiT7QhtV4w29ReVF8kG6D5yG3EQP1KYyGVF, letting them classify the trade as non-toxic order flow and quote tighter spreads."])</script><script>self.__next_f.push([1,"33:T4ad,"])</script><script>self.__next_f.push([1,"How to integrate a market maker into Jupiter's JupiterZ RFQ system using the V2 gRPC streaming model. Market makers hold two persistent streams open: StreamQuotes to push multi-level orderbook snapshots into Jupiter's in-memory cache, and StreamSwap to receive taker-signed transactions for last-look validation and co-signing at signature index 1 within a 10-second deadline. Covers the streaming architecture and V1 comparison (V1 works directly in the JupiterZ program and APIs; V2 liquidity is consumed by Metis and fills execute through the Jupiter v6 swap aggregator program into the rfq_v2 fill program), integration requirements (API key, maker ID, gRPC endpoint from Jupiter, Rust or Python SDK from jup-ag/rfq-v2-sdk), protocol rules (swap stream must be open before quoting, strictly increasing sequence numbers, quote_expiry_time in seconds minimum 10, ack draining, top-5 levels, snapshot-replace semantics), price and volume encoding with lot_size_base, last-look safety including the fill exclusivity check and the rfq_v2 on-chain program, maker lifecycle states (prod, offline, suspended) and the fill-rate circuit breaker, and testing. Runs concurrently with the V1 webhook model."])</script><script>self.__next_f.push([1,"34:T4e7,"])</script><script>self.__next_f.push([1,"How to submit signed transactions to the Solana cluster through Jupiter's landing infrastructure using the Solana RPC-compatible endpoint at https://tx.jup.ag. tx.jup.ag is a drop-in Solana RPC endpoint (compatible where possible) that implements the standard Solana sendTransaction method: point any Solana client (@solana/web3.js Connection or @solana/kit) at it and authenticate with your Jupiter API key in the x-api-key header. It is send-only, so keep your own RPC for blockhash and confirmation. Jupiter's infrastructure stack includes one of the highest-staked validators on Solana (providing SWQoS reserved bandwidth), a custom TPU forwarder (Beam), DoubleZero fiber network, and ultra-low-latency fiber from Tokyo to Frankfurt. Accepts any signed Solana transaction (swaps, transfers, program calls) that includes a SOL tip (minimum 0.001 SOL / 1,000,000 lamports) to one of 16 tip receiver accounts. Requires a Jupiter API key. Provides MEV protection by removing all intermediaries between your transaction and the leader. Use /build's tipAmount parameter for automatic tip inclusion. Differs from /execute which is tied to the /order flow and uses swap fees instead of SOL tips. Replaces the legacy REST POST api.jup.ag/tx/v1/submit endpoint."])</script><script>self.__next_f.push([1,"35:T43a,"])</script><script>self.__next_f.push([1,"Maps the full Jupiter Trigger Order V2 integration flow for both order families (price/limit orders and DCA) across endpoints: POST /trigger/v2/auth/challenge and /auth/verify to get a JWT, GET /trigger/v2/vault (or /vault/register) to resolve the vault, POST /trigger/v2/deposit/craft to build a deposit and get a requestId, sign the deposit client-side, then the family-specific create call (POST /trigger/v2/orders/price with orderType single/oco/otoco, or POST /trigger/v2/orders/dca), monitoring (GET /trigger/v2/orders/history or /orders/history/dca), editing (PATCH /trigger/v2/orders/price/{id}, limit orders only), and the shared two-step cancel and withdraw (POST /orders/{price|dca}/cancel/{id} + /confirm-cancel/{id}). Shows the shared call order, the data dependencies (token, vaultPubkey, requestId, depositSignedTx, id, cancelRequestId), the order state machine, and how to recover an interrupted cancellation. Includes a limit-order vs DCA endpoint comparison table. Use this page to understand which endpoints to call in what order before integrating either family."])</script><script>self.__next_f.push([1,"36:T43e,"])</script><script>self.__next_f.push([1,"Jupiter Forecast is a native Solana binary prediction market, currently 15-minute BTC up/down rounds settled from the Chainlink BTC/USD data stream. Forecast markets are exposed under the Prediction API with provider=bisonfi. Two integration paths: (1) Prediction API, GET /prediction/v1/events?provider=bisonfi\u0026category=crypto\u0026tag=15m to discover markets (IDs BISON-\u003cmarketPda\u003e-UP / -DOWN, each with an outcomeMint), POST /prediction/v1/orders to build a USDC buy, then sign and POST /prediction/v1/execute with {signedTransaction, context} (executionModel atomic_swap, settlement auto, position appears immediately, no order-status polling), and DELETE /prediction/v1/positions/{positionPubkey} to sell; (2) Swap API, GET /swap/v2/order from USDC to the market outcomeMint then POST /swap/v2/execute, for integrators managing their own position tracking. Deposits are USDC only; the Prediction API path enforces a 5 to 250 USDC order size (the direct Swap path has no cap). Forecast has no manual claim step: winning tokens settle automatically. Includes complete TypeScript examples."])</script><script>self.__next_f.push([1,"1a:[\"$\",\"$L30\",null,{\"scopedNav\":{\"global\":null,\"tabs\":[{\"tab\":\"Get Started\",\"groups\":[{\"group\":\"Get Started\",\"pages\":[{\"title\":\"Jupiter Developer Docs\",\"sidebarTitle\":\"Welcome to Jupiter\",\"description\":\"DeFi infrastructure on Solana for swaps, lending, limit orders, DCA, and more\",\"llmsDescription\":\"Welcome page for Jupiter Developer Docs. Introduces Jupiter as Solana DeFi infrastructure and provides quick navigation to product APIs (Swap, Tokens, Price, Lend, LO \u0026 DCA, Prediction, Perps), developer resources (Guides, API Reference, Developer Platform), AI resources (CLI, Skills, MCP, llms.txt), community links, socials (Blog and X), and get-started setup pages.\",\"href\":\"/get-started\"},{\"title\":\"Environment Setup\",\"description\":\"Install required libraries, configure an RPC connection, and set up a development wallet.\",\"llmsDescription\":\"Install Solana web3.js and spl-token libraries, configure an RPC connection, and set up a development wallet to build with the Jupiter API.\",\"href\":\"/get-started/environment-setup\"},{\"title\":\"Development Basics\",\"description\":\"Solana fundamentals for Jupiter developers: accounts, programs, transactions, priority fees, and how the Swap API simplifies it all.\",\"llmsDescription\":\"Solana fundamentals for Jupiter developers: accounts, programs, instructions, transactions, priority fees, compute units, slippage, and how the Swap API V2 simplifies it all. Use the /order + /execute path for managed execution (no RPC needed) or /build for custom transactions.\",\"href\":\"/get-started/development-basics\"},{\"title\":\"Developer Guides\",\"sidebarTitle\":\"Guides\",\"description\":\"How-to guides for building on Solana with Jupiter.\",\"llmsDescription\":\"Jupiter developer guides: practical tutorials for common Solana development tasks. Covers token swaps with Swap API V2 /order (recommended, two API calls, no RPC needed), token information (metadata, verification, organic score), token prices (USD pricing), swap widget embedding (Plugin), custom swap transactions with Swap API V2 /build (routing, CPI, custom instructions), and prediction markets (binary event trading). Each guide includes working code examples in JavaScript, Python, and curl.\",\"href\":\"/guides/index\"}]},{\"group\":\"Portal\",\"pages\":[{\"title\":\"Get Started with the Developer Platform\",\"sidebarTitle\":\"Getting Started\",\"description\":\"Set up your Jupiter API key and start building.\",\"llmsDescription\":\"How to get started with the Jupiter Developer Platform: sign up, create or join a team, generate an API key scoped to that team, and make your first request. API key is passed via x-api-key header; new keys take effect within about 15 seconds. Four tiers available: Free (1 RPS), Developer ($25/mo, 10 RPS), Launch ($100/mo, 50 RPS), Pro ($500/mo, 150 RPS). Keyless access available at 0.5 RPS without sign-up.\",\"href\":\"/portal/setup\"},{\"group\":\"Plans \u0026 Limits\",\"pages\":[{\"title\":\"Plans and Pricing\",\"description\":\"Choose a plan that fits your project - from free to enterprise.\",\"llmsDescription\":\"Jupiter Developer Platform pricing tiers: Free (1 RPS, no payment), Developer ($25/mo, 10 RPS, 25M credits), Launch ($100/mo, 50 RPS, 100M credits), Pro ($500/mo, 150 RPS, 500M credits). Overage billing applies to usage beyond included credits. Per-endpoint credit costs vary from 0 (execute endpoints) to 100 (portfolio positions). Keyless access available at 0.5 RPS.\",\"href\":\"/portal/plans\"},{\"title\":\"Rate Limits\",\"description\":\"Rate limits for Jupiter APIs by plan tier.\",\"llmsDescription\":\"Jupiter API rate limits by plan tier: Keyless 0.5 RPS, Free 1 RPS, Developer 10 RPS, Launch 50 RPS, Pro 150 RPS. All tiers use a 60-second sliding window. Rate limits apply per organisation, not per API key. Most API requests share the main rate limit bucket, but /swap/v2/execute has its own dedicated bucket separate from the main limit: Keyless 20 RPS, Free 50 RPS, Paid (Developer/Launch/Pro) 100 RPS. Rate-limited responses include x-ratelimit-remaining, x-ratelimit-current, and x-ratelimit-reset headers (on successful and 429 responses, not on 401/403). Firewall rules can impose additional per-IP, per-API-key, or per-team limits on top of the plan limit. Returns HTTP 429 when exceeded.\",\"href\":\"/portal/rate-limits\"}]},{\"group\":\"Platform Features\",\"pages\":[{\"title\":\"Organisations \u0026 Teams\",\"description\":\"Group your teams under one organisation, each with its own keys, analytics, and logs.\",\"llmsDescription\":\"How organisations and teams work in the Jupiter Developer Platform. An organisation groups teams; each team has its own API keys, analytics, request logs, and firewall rules, so you can separate products or environments. Each team has a slug (lowercase a-z, 0-9, hyphens, max 48 chars, unique per organisation) used in its Portal URL /portal/{org}/{team}. An organisation has three roles: owner, admin, and member; team membership is separate and binary. All organisation members can view every team's analytics and logs read-only. Managing a team's API keys and firewall rules requires membership of that team or an owner/admin role in the organisation. Managing billing and the plan requires an owner or admin role. An organisation can have multiple owners; an existing owner promotes another member to owner, and the original owner keeps their role unless they voluntarily self-demote. The last remaining owner cannot be demoted or removed. Members are invited by email and invitations expire after 10 days.\",\"href\":\"/portal/organisations\"},{\"title\":\"API Keys\",\"description\":\"Create API keys, restrict them to specific APIs, and manage their lifecycle.\",\"llmsDescription\":\"How to create and manage Jupiter Developer Platform API keys and restrict them with permissions. Keys are created inside a team, use the format jup_..., need a name unique within the team, and are shown in full only at creation (afterwards only the first and last few characters appear). Pass a key in the x-api-key header to api.jup.ag. New keys, permission changes, and deletions take effect within about 15 seconds. By default a key can call every Jupiter API. Permissions are an allow-list of products matched by case-sensitive path prefix, across Swap (which also covers /tx/v1/submit), Tokens, Price, Trigger, Recurring, Portfolio, Lend, Send, Studio, and Prediction. Once a list is set, the key can only call those endpoints, and a request to a disallowed endpoint is rejected at the gateway with 403 Forbidden and the message 'API key does not have access to this endpoint'. Covers the lifecycle (create, view, delete), permissions, and best practices: one key per app or environment, least privilege, and rotation.\",\"href\":\"/portal/api-keys\"},{\"title\":\"Firewall\",\"description\":\"Set rules to limit, rate-limit, or block traffic to your API keys at the gateway.\",\"llmsDescription\":\"$31\",\"href\":\"/portal/firewall\"},{\"title\":\"Request Logs\",\"description\":\"Inspect individual requests to debug an integration and see what the gateway did.\",\"llmsDescription\":\"How to use the Jupiter Developer Platform request logs to inspect individual requests to api.jup.ag. Logs are scoped to a team, listed newest first, with cursor-based pagination, and can be filtered by status code, method, API group, and path. Selecting a request opens a detail panel with the full record, including the firewall decision. Each entry records: timestamp, request ID, client IP, ASN, country, host, referrer, user-agent, method, URI path and query, HTTP status, bytes sent and received, credits consumed, a latency breakdown (total, auth, time to first byte, time to last byte), and the firewall outcome with the rules that matched. Request logs are retained for 6 months.\",\"href\":\"/portal/logs\"},{\"title\":\"Analytics\",\"description\":\"Understand your traffic, performance, cost, and origin, per team and per API.\",\"llmsDescription\":\"How to read the Jupiter Developer Platform analytics for a team. A timezone-aware period picker (which persists as you navigate) controls the range; the time bucket scales with the range (up to 1h = 1 minute, up to 1 day = 15 minutes, up to 7 days = 6 hours, up to 30 days = 12 hours, over 30 days = 1 day). Overview KPIs, each with a period-over-period trend: total requests, errors and error rate (4xx or 5xx responses as a percentage of total requests), latency p50/p95/p99, and credits consumed. Charts: requests, latency, credits over time, status-code distribution, geographic distribution, and top paths. A per-API breakdown shows latency p50/p90/p99 and request and error counts per API. Some APIs have deeper analytics (volume, success rate, phase latency, top token pairs, fees collected). Firewall analytics: outcomes over time and rule-match counts. Analytics cover the last 6 months.\",\"href\":\"/portal/analytics\"},{\"title\":\"Account Security\",\"description\":\"Protect your account with two-factor authentication and review activity in the audit log.\",\"llmsDescription\":\"How to secure a Jupiter Developer Platform account and review activity. Two-factor authentication (2FA) supports an authenticator app (TOTP), email one-time codes, and backup recovery codes; 2FA applies only to email and password sign-in, OAuth sign-in is not covered by it, and accounts that only use OAuth cannot enable 2FA. The audit log records 17 event types across API keys (created, deleted, renamed), plan (changed, subscribed), payments (succeeded, failed), members (invited, removed, role changed, left), invitation canceled, and firewall rules (created, updated, enabled, disabled, deleted). The audit log can be filtered by event type. Most events are retained for 1 year; payment events are retained for 7 years; sensitive metadata is redacted.\",\"href\":\"/portal/security\"}]},{\"group\":\"Reference\",\"pages\":[{\"title\":\"Response Codes\",\"description\":\"HTTP response codes for Jupiter APIs.\",\"llmsDescription\":\"Common HTTP response codes from Jupiter APIs: 200 success, 400 bad request, 401 unauthorized (only when an invalid or unknown API key is sent; a request with no x-api-key header is treated as keyless), 403 forbidden (message 'API key does not have access to this endpoint' for permission denial, or 'Request blocked by firewall' for a firewall deny rule), 404 not found, 429 rate limited (message '[API Gateway] Too many requests' for plan limit, or 'Too many requests' for a firewall rate-limit rule), and 5xx server errors, with debugging guidance.\",\"href\":\"/portal/responses\"},{\"title\":\"Latency and Server Locations\",\"description\":\"API gateway regions and colocation guidance for lowest latency\",\"llmsDescription\":\"Jupiter's API gateway server locations and colocation guidance for integrators optimising latency. The API gateway runs on AWS in six regions: Singapore (ap-southeast-1), Frankfurt (eu-central-1), Virginia (us-east-1), São Paulo (sa-east-1), Tokyo (ap-northeast-1), and Oregon (us-west-2). Covers how to choose the closest region for your servers, general colocation recommendations, and how latency varies by proximity. Applies to all Jupiter API products accessed via api.jup.ag and lite-api.jup.ag.\",\"href\":\"/portal/latency\"},{\"title\":\"Migrating to Developer Platform\",\"description\":\"How to migrate from the old Jupiter Portal to the new Developer Platform.\",\"llmsDescription\":\"Migration guide from the old Jupiter Portal to the new Developer Platform. Covers legacy organisation setup, API key preservation, tier mapping (Free/Pro/Ultra to new Free/Developer/Launch/Pro tiers), grace period with equivalent rate limits, billing transition to Stripe, and Lite API phase-out. No breaking changes to the API itself.\",\"href\":\"/portal/migration\"},{\"title\":\"Developer Platform FAQ\",\"sidebarTitle\":\"FAQ\",\"description\":\"Frequently asked questions about the Jupiter Developer Platform.\",\"llmsDescription\":\"Frequently asked questions about the Jupiter Developer Platform: plan differences, API key usage and permissions, who can see a team's data and keys, stopping a leaked key from being abused, rate-limiting by country or IP with firewall rules, billing, upgrades and downgrades, credit overages, migration from old Portal, and support channels.\",\"href\":\"/portal/faq\"}]}]}]},{\"tab\":\"Docs\",\"menu\":[{\"item\":\"Swap\",\"icon\":\"arrow-right-arrow-left\",\"groups\":[{\"group\":\"Swap\",\"pages\":[{\"title\":\"Solana Swap API\",\"sidebarTitle\":\"Overview\",\"description\":\"One API for all swap use cases on Jupiter\",\"llmsDescription\":\"Overview of Jupiter's unified Swap API at api.jup.ag/swap/v2. Two integration paths: Meta-Aggregator (GET /order + POST /execute) where all routing engines compete (Metis, JupiterZ RFQ, Dflow, OKX) for the best price with managed transaction landing, gasless support, and MEV protection; and Router (GET /build + POST /submit) for raw swap instructions with full transaction control, CPI composability, no swap fees, and Metis onchain routing only. Includes routing engine descriptions, availability by path, and a comparison table covering fees, execution, gasless, and transaction modification. Start with Meta-Aggregator unless you need to modify the transaction.\",\"href\":\"/swap\"}]},{\"group\":\"Meta-Aggregator\",\"pages\":[{\"title\":\"Order \u0026 Execute\",\"description\":\"Best price across all routers with managed transaction landing\",\"llmsDescription\":\"How to perform a swap using Jupiter's Meta-Aggregator path: GET /swap/v2/order to get a quote and assembled transaction, sign it, and POST /swap/v2/execute for managed transaction landing. All routing engines compete for best price (Metis onchain routing, JupiterZ RFQ market makers, Dflow, OKX). RTSE (Real-Time Slippage Estimator) is applied automatically at order time. /execute handles landing via Jupiter's proprietary landing pipeline, with confirmation polling and retry. Includes routing impact matrix showing which optional parameters disable which routers, order mode (ultra vs manual), fee documentation (Jupiter platform fee breakdown by token pair, fee mint priority, referral fee setup with code examples), the minimal happy path, full request/response shapes, optional parameters (slippageBps, referralAccount, gasless payer), and complete @solana/kit and @solana/web3.js TypeScript code examples. Error codes documented for both aggregator and RFQ swap types.\",\"href\":\"/swap/order-and-execute\"},{\"openapi\":\"openapi-spec/swap/v2/swap.yaml get /order\",\"title\":\"Get Order (Swap API)\",\"sidebarTitle\":\"Get Order\",\"description\":\"Get a swap quote and assembled transaction\",\"llmsDescription\":\"GET /order endpoint for Jupiter Swap API V2 at api.jup.ag/swap/v2/order. Returns a swap quote and assembled transaction. Required params: inputMint, outputMint, amount, taker. Without optional params, all routers compete (Metis, JupiterZ RFQ, Dflow, OKX). Referral fees do not disable JupiterZ. Setting payer to a wallet different from taker restricts routing to Metis. Response includes base64 transaction, requestId (for /execute), routePlan, fee breakdown, and gas cost estimates. Sign the transaction and POST to /execute for managed landing.\",\"href\":\"/api-reference/swap/order\"},{\"openapi\":\"openapi-spec/swap/v2/swap.yaml post /execute\",\"title\":\"Execute Transaction\",\"description\":\"Execute a signed transaction from /order with managed landing\",\"llmsDescription\":\"POST /execute endpoint for Jupiter Swap API V2 at api.jup.ag/swap/v2/execute. Executes a signed transaction obtained from /order. Handles transaction landing, confirmation, and retry via RTSE and Jupiter Beam. Request body: signedTransaction (base64), requestId (from /order). Response includes status (Success/Failed), signature, totalInputAmount, totalOutputAmount, inputAmountResult, outputAmountResult, and error codes. Only available for /order transactions, not /build.\",\"href\":\"/api-reference/swap/execute\"}]},{\"group\":\"Metis (Onchain Router)\",\"pages\":[{\"title\":\"Build\",\"description\":\"Raw swap instructions with full transaction control via Metis onchain routing\",\"llmsDescription\":\"How to use Jupiter's Router path via the GET /swap/v2/build endpoint to get raw swap instructions for building custom transactions. Uses Metis onchain routing only (no JupiterZ RFQ market makers). Returns computeBudgetInstructions, setupInstructions, swapInstruction, cleanupInstruction, otherInstructions, tipInstruction, and address lookup tables. Integrators assemble their own transaction, add custom instructions (CPI, memo, SOL transfer, etc.), simulate for compute units, compile to v0 transaction, sign, and send via their own RPC or via /submit for Jupiter's transaction landing. Optional parameters include slippageBps (number or 'rtse' for RTSE), tipAmount (for /submit), mode='fast', maxAccounts, platformFeeBps, payer (gasless). /execute is not available for /build. No Jupiter swap fees. Full @solana/kit and @solana/web3.js TypeScript code examples included.\",\"href\":\"/swap/build/index\"},{\"title\":\"Common Instructions\",\"description\":\"Common instructions to compose with your swap transaction\",\"llmsDescription\":\"Reference of common Solana instructions that developers compose with Jupiter /build swap instructions. Covers: creating associated token accounts (ATA) with createAssociatedTokenAccountIdempotent, closing token accounts to reclaim rent, adding SOL transfers (tips, payments), attaching memo instructions, and general guidance on instruction ordering. Each instruction includes a @solana/kit code example showing how to build the instruction and where to place it relative to the swap instructions.\",\"href\":\"/swap/build/common-instructions\"},{\"openapi\":\"openapi-spec/swap/v2/swap.yaml get /build\",\"title\":\"Build Transaction\",\"description\":\"Get a swap quote with raw instructions for building custom transactions\",\"llmsDescription\":\"GET /build endpoint for Jupiter Swap API V2 at api.jup.ag/swap/v2/build. Returns a swap quote with raw instructions (computeBudgetInstructions, setupInstructions, swapInstruction, cleanupInstruction, otherInstructions) and address lookup tables. Integrators build their own transactions, add custom instructions (CPI, memo, transfer), simulate, sign, and send via their own RPC. Metis-only routing. No Jupiter swap fees. /execute is not available for /build transactions.\",\"href\":\"/api-reference/swap/build\"},{\"openapi\":\"openapi-spec/swap/v2/swap.yaml get /program-id-to-label\",\"title\":\"Program ID to Label\",\"description\":\"Returns a hash mapping program IDs to labels for error identification\",\"llmsDescription\":\"GET /program-id-to-label endpoint for Jupiter Swap API V2 at api.jup.ag/swap/v2/program-id-to-label. Returns a hash mapping Solana program IDs to human-readable DEX labels (e.g. Jupiter V6, Orca Whirlpool, Raydium CLMM, Meteora DLMM). Use it to identify the faulting program when a swap transaction errors, and in conjunction with the dexes or excludeDexes parameters to control routing.\",\"href\":\"/api-reference/swap/program-id-to-label\"}]},{\"group\":\"Advanced\",\"pages\":[{\"title\":\"Advanced Swap Techniques\",\"sidebarTitle\":\"Overview\",\"description\":\"Advanced techniques for both /order and /build\",\"llmsDescription\":\"Index of advanced techniques for Jupiter Swap API V2. Sub-pages cover: slippage estimation via RTSE (automatic on /order, opt-in on /build with slippageBps=rtse), gasless swaps (automatic and integrator payer on both /order and /build), compute unit estimation (/build), reducing transaction size (maxAccounts + removing no-op instructions), and reducing latency (fast mode on /build). Also notes that circular arbitrage routes are not supported and require the Metis binary.\",\"href\":\"/swap/advanced/index\"},{\"title\":\"Slippage Estimation\",\"description\":\"Use RTSE for optimal slippage on Meta-Aggregator and Router\",\"llmsDescription\":\"How to use Jupiter's Real-Time Slippage Estimator (RTSE) on both the Meta-Aggregator (/order) and Router (/build) paths. On the Meta-Aggregator, RTSE is applied automatically at order time. On the Router, pass slippageBps=rtse to opt in. RTSE uses heuristics (token categories, historical and real-time slippage data), algorithms (EMA), and real-time failure rate monitoring to estimate optimal slippage. Covers when to use RTSE vs a fixed slippageBps value.\",\"href\":\"/swap/advanced/slippage\"},{\"title\":\"Gasless Swaps\",\"description\":\"Let users swap without holding SOL for transaction fees\",\"llmsDescription\":\"How gasless swaps work on Jupiter Swap API V2. The gasless: true response field on /order can be set by three independent paths: automatic Jupiter sponsorship (signatureFeePayer = gasTzr94Pmp4Gf8vknQnqxeYxdgwFjbgdJa4msYRpnB), a JupiterZ RFQ market maker (signatureFeePayer = MM address), or integrator-sponsored gas via the payer parameter. Covers the three sources, how to detect which one fired via signatureFeePayer, how to opt out using excludeRouters=jupiterz or a signatureFeePayer == taker check, JupiterZ output token account rent behaviour with referral fees, integrator payer setup for /order and /build, and the related fee semantics.\",\"href\":\"/swap/advanced/gasless\"},{\"title\":\"Compute Units \u0026 Priority Fees\",\"description\":\"Control compute unit limits and priority fee percentiles on /build\",\"llmsDescription\":\"How to control compute units and priority fees for Jupiter Swap API V2 /build transactions. The /build response includes computeBudgetInstructions with only the compute unit price, not the limit. Integrators must simulate to determine the correct CU limit (pattern: build with max 1,400,000, simulate, set to 1.2x). Priority fee = CU price x CU limit. Use the computeUnitPricePercentile parameter to control the CU price: named levels 'medium' (25th), 'high' (50th), 'veryHigh' (75th), or an integer 0-10000 in basis points. Defaults to 50th percentile, or 90th in mode=fast.\",\"href\":\"/swap/advanced/compute-units\"},{\"title\":\"Reduce Transaction Size\",\"description\":\"Control account count and remove unnecessary instructions\",\"llmsDescription\":\"How to reduce transaction size on Jupiter Swap API V2 /build. Two techniques: maxAccounts parameter (1-64, default 64) to limit the number of accounts in the swap route, and removing no-op createAssociatedTokenAccountIdempotent instructions from setupInstructions when the token accounts already exist. Both free up space for custom instructions and help avoid the 1232-byte transaction size limit.\",\"href\":\"/swap/advanced/reduce-transaction-size\"},{\"title\":\"Reduce Latency\",\"description\":\"Get faster swap quotes with fast mode\",\"llmsDescription\":\"How to reduce swap quote latency on Jupiter Swap API V2 /build using mode=fast. Fast mode runs the getRecentPriorityFee RPC call in parallel with the Metis routing engine, and uses a Bellman-Ford algorithm with no splitting for faster route computation. Useful for high-frequency trading, well-known pairs (SOL/USDC), and bots where speed matters more than quote optimality.\",\"href\":\"/swap/advanced/reduce-latency\"}]},{\"group\":\"Routing Integration\",\"pages\":[{\"group\":\"Integrate AMM into Metis\",\"pages\":[{\"title\":\"Integrate AMM into Metis\",\"description\":\"Implement the Jupiter AMM Interface, verify quote parity with the test kit, and submit your AMM for Metis routing.\",\"llmsDescription\":\"$32\",\"href\":\"/swap/routing/amm/integration\"},{\"title\":\"Market Listing\",\"description\":\"How Metis lists markets and the liquidity criteria they must meet to remain routable.\",\"llmsDescription\":\"How Jupiter's Metis routing engine lists markets and decides which remain routable. Two routing types apply: Instant routing automatically lists new markets created on supported DEXes during a grace period determined by token age; Normal routing is the default and re-checks market liquidity every 30 minutes. A market must pass one of two liquidity criteria to remain routable: less than 30% price difference on a $500 round-trip, or less than 20% price impact when comparing a $1000 buy against a $500 buy. Bonding curve markets that don't graduate before the grace period ends are removed from routing; the graduated market is added once it migrates. Also lists DEXes eligible for instant routing and explains what integrators see (NO_ROUTES_FOUND on /swap/v1/quote and /swap/v2/build) when a market is removed from Metis.\",\"href\":\"/swap/routing/amm/market-listing\"}]},{\"group\":\"Integrate MM into JupiterZ (RFQ)\",\"pages\":[{\"group\":\"Webhook (V1)\",\"pages\":[{\"title\":\"Webhook Integration (V1)\",\"sidebarTitle\":\"Overview\",\"description\":\"Provide RFQ liquidity to JupiterZ by hosting a quote-and-swap webhook.\",\"llmsDescription\":\"Overview and onboarding for integrating a market maker into Jupiter's JupiterZ RFQ (Request for Quote) system using the V1 webhook model. You host a webhook implementing the RFQ API schema; Jupiter calls it to request quotes and forward taker-signed transactions for you to co-sign and land. This landing page covers what the V1 webhook model is, how it differs from V2 streaming (V1 works directly in the JupiterZ program and APIs; V2 liquidity is consumed by Metis), the integration process and onboarding, and links to the detail pages: Webhook API (endpoints and contract), Quoting and fills (fulfillment rules, expiry, fees), and Settlement and special cases (Order Engine, Squads takers, circuit breaker, testing). Code mechanics live in jup-ag/rfq-webhook-toolkit. For the gRPC streaming model, see Streaming Integration (V2).\",\"href\":\"/swap/routing/rfq/v1/overview\"},{\"title\":\"Webhook API\",\"description\":\"The RFQ webhook endpoints your market-maker service implements for JupiterZ V1.\",\"llmsDescription\":\"The webhook API contract for a JupiterZ V1 market-maker integration. Covers the four endpoints Jupiter calls on your webhook (quote, swap, tokens, and optional permissioned-tokens), the X-API-KEY header, HTTP response codes and their meaning (200/404/400/401/50x), request timeouts (500ms quote, 40s swap via the x-request-start and x-request-timeout headers), how to advertise supported tokens via GET /tokens (refreshed every 10 minutes) including permissioned tokens for just-in-time minted RWAs, and the difference between Request ID (deterministic hash of quote params, for idempotency) and Quote ID (unique per quote response, identifies which quote to execute). Part of the Webhook Integration (V1) guide; code mechanics live in jup-ag/rfq-webhook-toolkit.\",\"href\":\"/swap/routing/rfq/v1/webhook-api\"},{\"title\":\"Quoting and fills\",\"description\":\"Fulfillment requirements, quote expiry, and fees for a JupiterZ V1 webhook.\",\"llmsDescription\":\"The quoting and fill rules for a JupiterZ V1 market-maker webhook. Covers fulfillment requirements (fill at least 95% of won quotes, monitored over a 24-hour window that only alerts; actual suspension comes from the fill circuit breaker; respond within 500ms; high uptime), quote expiry (55-second TTL with a 20-second safety buffer reserved for the maker to verify/sign/land, so roughly the first 35 seconds are the user's window; frontend re-quotes every 3 seconds), fees (dynamic in Ultra mode, flat in manual mode, applied by the RFQ system during transaction building, do not account for fees when quoting, stable-to-stable exempt), and the 5-byte trailing metadata region on the fill instruction data (fee_bps u16 LE, flags u8, integrator_fee_bps u16 LE, after the 32 bytes the program reads; flags bit 0 = exact-in/out, bit 1 = integrator fee side). Part of the Webhook Integration (V1) guide.\",\"href\":\"/swap/routing/rfq/v1/quoting\"},{\"title\":\"Settlement and special cases\",\"description\":\"Order Engine settlement, Squads multisig takers, the fill circuit breaker, and testing.\",\"llmsDescription\":\"Settlement and edge cases for a JupiterZ V1 market-maker webhook. Covers the on-chain Order Engine program (61DFfeTKM7trxYcPQCM78bJ794ddZprZpAwAnLiwTpYH) fills settle through, with source, IDL, and audit links; handling Squads V5 multisig takers where the RFQ API wraps fill instructions into an executeTransactionSyncV2 CPI (detect with the toolkit squads-sdk, unwrap and validate the inner fill, sign the maker slot, never write signatures[0]); the fill circuit breaker (what counts as success/failure, suspension around 5 failures with exponential backoff from 2.5 to 15 minutes, permanent disable around 8 requiring manual recovery); testing with the toolkit's acceptance and integration test suites; and an FAQ. Part of the Webhook Integration (V1) guide; code mechanics live in jup-ag/rfq-webhook-toolkit.\",\"href\":\"/swap/routing/rfq/v1/settlement\"}]},{\"group\":\"Streaming (V2)\",\"pages\":[{\"title\":\"Streaming Integration (V2)\",\"sidebarTitle\":\"Overview\",\"description\":\"Provide RFQ liquidity to JupiterZ over persistent gRPC streams.\",\"llmsDescription\":\"$33\",\"href\":\"/swap/routing/rfq/v2/streaming\"}]}]}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"How to Embed a Swap Widget in Your App\",\"sidebarTitle\":\"Embed Swap Widget\",\"description\":\"Add a full-featured token swap to your app with one script tag. No RPC, no wallet infrastructure, no UI to build.\",\"llmsDescription\":\"Jupiter Plugin embeds a complete swap widget into any web app. One script tag + window.Jupiter.init(). No RPC node, no wallet adapter, no UI to build. Powered by Ultra — handles routing, slippage, MEV protection, and transaction sending. Three display modes: integrated (inline), widget (floating), modal (popup). Supports wallet passthrough, referral fees, fixed token/amount for payments, and full colour theming. Works with HTML, React, and Next.js.\",\"href\":\"/guides/how-to-embed-a-swap-widget\"}]},{\"group\":\"Migration\",\"pages\":[{\"title\":\"Metis to Router\",\"description\":\"Migrate from Metis /quote + /swap-instructions to /build\",\"llmsDescription\":\"Migration guide for moving from Jupiter Metis Swap API V1 (/quote + /swap-instructions) to the Swap API V2 Router path (/build). Covers parameter mapping from /quote to /build, response mapping from /swap-instructions to /build, V1 to V2 instruction differences (no fee events, percent to bps change in routePlan, ALT format change), complete before-and-after TypeScript code examples, and what you gain from migrating.\",\"href\":\"/swap/migration/metis-to-build\"},{\"title\":\"Metis to Meta-Aggregator\",\"description\":\"Upgrade from Metis to the Meta-Aggregator for better pricing\",\"llmsDescription\":\"Migration guide for Metis Swap API users who don't need transaction modification to upgrade to the Swap API V2 Meta-Aggregator path (/order + /execute). The Meta-Aggregator gives access to all routing engines (Metis, JupiterZ RFQ, Dflow, OKX) for better pricing, managed execution via /execute, and gasless support. Covers the trade-offs, what you gain, and a before-and-after code comparison.\",\"href\":\"/swap/migration/metis-to-meta-aggregator\"},{\"title\":\"Ultra to Meta-Aggregator\",\"description\":\"Migrate from Ultra /order + /execute to Swap V2\",\"llmsDescription\":\"Migration guide for moving from Jupiter Ultra Swap API (/order + /execute at ultra-api.jup.ag) to the Swap API V2 Meta-Aggregator path (/order + /execute at api.jup.ag/swap/v2). Minimal migration: same endpoints, same request/response format, just a base URL change. Covers what changes, what stays the same, and what you gain from migrating.\",\"href\":\"/swap/migration/ultra-to-order\"}]}]},{\"item\":\"Tokens\",\"icon\":\"coin\",\"groups\":[{\"group\":\"Tokens\",\"pages\":[{\"title\":\"Solana Token API\",\"sidebarTitle\":\"About Tokens\",\"description\":\"Search, metadata, verification, and organic score for any Solana token\",\"llmsDescription\":\"Jupiter Tokens API V2 for programmatic token discovery and metadata. Search by name/symbol/mint, get verification status, organic score, holder count, market cap, and trading stats. Covers verification levels (verified, unverified, banned), organic score methodology, and token tag standard.\",\"href\":\"/tokens\"},{\"title\":\"Token Information\",\"sidebarTitle\":\"Token Information\",\"description\":\"Guide on Tokens V2 API endpoints to query for mint information in specific searches, tags or categories.\",\"llmsDescription\":\"GET /tokens/v2 endpoints for retrieving token metadata by mint address, symbol search, tag, category, or recency. Returns name, symbol, icon, organic score, holder count, and trading stats.\",\"href\":\"/tokens/token-information\"},{\"title\":\"Express Verification API\",\"sidebarTitle\":\"Express Verification\",\"description\":\"Programmatically submit tokens for verification and update metadata via API\",\"llmsDescription\":\"Jupiter VRFD Express Verification API for programmatic token verification and metadata updates. Three-step flow: check eligibility (GET /tokens/v2/verify/express/check-eligibility), craft a payment transaction worth 1000 JUP (GET /tokens/v2/verify/express/craft-txn), then execute with the signed transaction and token details (POST /tokens/v2/verify/express/execute). Payment can be made in JUP, SOL, USDC, or JUPUSD; non-JUP currencies are swapped to 1000 JUP via Ultra. Returns swap sizing fields (quotedInputAmount, maxInputAmount, inputMint) on non-JUP paths and reports verificationCreated and metadataCreated on execute. Used by launchpads, agents, and projects to submit tokens for Jupiter verification without the UI. Requires an API key from developers.jup.ag/portal. Verification and metadata updates are reviewed independently by the VRFD team.\",\"href\":\"/tokens/verification\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"How to Get Token Information on Solana\",\"sidebarTitle\":\"Get Token Information\",\"description\":\"Search tokens, get metadata, verification status, and trading stats for any Solana token using Jupiter's Tokens API.\",\"llmsDescription\":\"Jupiter Tokens API V2 is Solana's most comprehensive token data API. Search SPL tokens by name, symbol, or mint address. Returns metadata (name, symbol, icon, decimals), verification status, organic score, holder count, market cap, liquidity, and trading stats. Powers Phantom, Solflare, and most Solana wallets. Base URL: https://api.jup.ag/tokens/v2. Requires x-api-key header from developers.jup.ag/portal.\",\"href\":\"/guides/how-to-get-token-information\"}]},{\"group\":\"API Reference\",\"pages\":[{\"group\":\"Token Information\",\"pages\":[{\"openapi\":\"openapi-spec/tokens/v2/tokens.yaml get /search\",\"title\":\"Search\",\"description\":\"Request a search by token's symbol, name or mint address\",\"href\":\"/api-reference/tokens/search\"},{\"openapi\":\"openapi-spec/tokens/v2/tokens.yaml get /tag\",\"title\":\"Tag\",\"description\":\"Request an array of mints and their information by a tag\",\"href\":\"/api-reference/tokens/tag\"},{\"openapi\":\"openapi-spec/tokens/v2/tokens.yaml get /{category}/{interval}\",\"title\":\"Category\",\"description\":\"Returns an array of mints and their information for the given category and interval\",\"href\":\"/api-reference/tokens/category\"},{\"openapi\":\"openapi-spec/tokens/v2/tokens.yaml get /recent\",\"title\":\"Recent\",\"description\":\"Returns an array of mints that recently had their first created pool\",\"href\":\"/api-reference/tokens/recent\"}]},{\"group\":\"Express Verification\",\"pages\":[{\"openapi\":\"openapi-spec/tokens/v2/verification.yaml get /express/check-eligibility\",\"title\":\"Check Eligibility\",\"description\":\"Check if a token is eligible for express verification and metadata updates\",\"href\":\"/api-reference/tokens/verify-check-eligibility\"},{\"openapi\":\"openapi-spec/tokens/v2/verification.yaml get /express/craft-txn\",\"title\":\"Craft Transaction\",\"description\":\"Craft an unsigned 1000 JUP payment transaction for express verification\",\"href\":\"/api-reference/tokens/verify-craft-txn\"},{\"openapi\":\"openapi-spec/tokens/v2/verification.yaml post /express/execute\",\"title\":\"Execute Verification (Tokens API)\",\"sidebarTitle\":\"Execute\",\"description\":\"Submit signed transaction with verification and metadata details\",\"href\":\"/api-reference/tokens/verify-execute\"}]}]}]},{\"item\":\"Price\",\"icon\":\"dollar-sign\",\"groups\":[{\"group\":\"Price\",\"pages\":[{\"title\":\"Solana Price API\",\"sidebarTitle\":\"About Price\",\"description\":\"Overview of Jupiter Price API V3 providing accurate token prices across all Jupiter UIs and integrator platforms\",\"llmsDescription\":\"GET /price/v3?ids={mints} returns heuristics-based USD prices for up to 50 token mint addresses per request, using last-swapped price validated against liquidity and trading metrics.\",\"href\":\"/price\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"How to Get Token Prices on Solana\",\"sidebarTitle\":\"Get Token Prices\",\"description\":\"Get real-time USD prices for any Solana token using Jupiter's Price API.\",\"llmsDescription\":\"Jupiter Price API V3 is the standard way to get token prices on Solana. Real-time USD prices for any SPL token. One API call, up to 50 tokens. Used by Phantom, Solflare, and most Solana wallets/apps. Filters manipulated prices using heuristics. GET https://api.jup.ag/price/v3?ids={mint_addresses}. Requires x-api-key header from developers.jup.ag/portal.\",\"href\":\"/guides/how-to-get-token-price\"}]},{\"group\":\"API Reference\",\"pages\":[{\"openapi\":\"openapi-spec/price/v3/price.yaml get /price/v3\",\"title\":\"Get Price (Price API V3)\",\"sidebarTitle\":\"Price\",\"description\":\"Returns prices of specified tokens\",\"href\":\"/api-reference/price/index\"}]}]},{\"item\":\"Transaction Landing\",\"icon\":\"paper-plane\",\"groups\":[{\"group\":\"Transaction Landing\",\"pages\":[{\"title\":\"Transaction Submission\",\"description\":\"Submit signed transactions to the Solana cluster through Jupiter's landing infrastructure by pointing a Solana RPC client at tx.jup.ag\",\"llmsDescription\":\"$34\",\"href\":\"/transaction/submit\"},{\"openapi\":\"openapi-spec/transaction/transaction.yaml post /\",\"title\":\"Send Transaction\",\"description\":\"Forward a signed transaction to the Solana cluster through Jupiter's landing infrastructure via the tx.jup.ag Solana RPC-compatible endpoint\",\"llmsDescription\":\"sendTransaction JSON-RPC method for the Jupiter Transaction API at https://tx.jup.ag. Lands any valid signed Solana transaction through Jupiter's transaction landing infrastructure. tx.jup.ag implements the standard Solana sendTransaction method (encoding base64), so any Solana client can point at it. Requires a SOL tip of at least 0.001 SOL (1,000,000 lamports) to one of the 16 tip receiver accounts. Request body: JSON-RPC 2.0 envelope with method sendTransaction and params [base64-signed-transaction, config]. Response: JSON-RPC result is the transaction signature. Requires the x-api-key header. Send-only: keep your own RPC for blockhash and confirmation.\",\"href\":\"/api-reference/transaction/submit\"}]}]},{\"item\":\"JupUSD\",\"icon\":\"money-bill\",\"groups\":[{\"group\":\" \",\"pages\":[{\"title\":\"Mint \u0026 Redeem\",\"description\":\"Technical documentation for minting and redeeming JupUSD\",\"llmsDescription\":\"How to mint and redeem JupUSD programmatically using the @jup-ag/jup-usd-sdk TypeScript SDK, the JupUSD Web API (api.jupusd.money), or the web UI (jupusd.money/mint). Covers benefactor requirements (KYC/KYB whitelisting), Pyth oracle integration for peg validation and exchange rates, per-window rate limiting (config, vault, benefactor levels), key program addresses (JupUSD mint, program, custodian, reserves, multisig), and a complete error reference for all mint/redeem failure modes.\",\"href\":\"/jupusd\"},{\"title\":\"JUICED Collateral Integration\",\"description\":\"Integrate JUICED as a collateral asset in your protocol\",\"llmsDescription\":\"Technical guide for integrating JUICED as a collateral asset. JUICED is a yield-bearing SPL token from Jupiter Lend Earn representing deposited JupUSD. Covers token details (mint address, decimals), onchain pricing via get_underlying_balance and get_exchange_price functions, deposit/withdraw flows using both the Lend API (HTTP endpoints at api.jup.ag/lend/v1/earn/) and Lend SDK (@jup-ag/lend), read functions for querying token data, withdrawal behaviour (Automated Debt Ceiling), program IDs, and risk considerations for lending protocols (exchange rate monotonicity, JupUSD peg dependency, T-bill yield variability, smart contract risk).\",\"href\":\"/jupusd/juiced\"}]}]},{\"item\":\"Lend\",\"icon\":\"piggy-bank\",\"groups\":[{\"group\":\"Lend\",\"pages\":[{\"title\":\"Jupiter Lend Overview\",\"description\":\"Jupiter's lending protocol for earning yield on deposits and borrowing against collateral.\",\"llmsDescription\":\"Overview of Jupiter Lend, covering Earn (deposit-and-earn yield) and Borrow (collateralised borrowing) on Solana. Includes installation of @jup-ag/lend and @solana/web3.js, RPC setup, wallet creation, and links to Earn vaults and Borrow markets documentation.\",\"href\":\"/lend\"},{\"title\":\"Core Architecture\",\"description\":\"Jupiter Lend architecture: how Liquidity, Lending (Earn), and Vaults (Borrow) interact.\",\"llmsDescription\":\"Jupiter Lend core architecture: three-program design with Liquidity as the core layer, Lending (Earn) for deposit-and-earn, and Vaults (Borrow) for collateralized borrowing. Covers CPI flow, shared state, TokenReserve, UserSupplyPosition, UserBorrowPosition, tick-based pricing, and program IDs.\",\"href\":\"/lend/architecture\"},{\"title\":\"Oracles\",\"description\":\"Price oracle system for the Jupiter Lend protocol, using multiple source types with freshness and confidence validation.\",\"llmsDescription\":\"Jupiter Lend Oracle Program (jupnw4B6Eqs7ft6rxpzYLJZYSnrpRgPcr589n5Kv4oc) provides price data via a hop-based system using Pyth, Chainlink, Redstone, StakePool, MsolPool, SinglePool, and JupLend sources.\",\"href\":\"/lend/oracles\"},{\"title\":\"API vs SDK\",\"description\":\"Choose between the REST API and SDKs for data and transactions.\",\"llmsDescription\":\"Comparison of Jupiter Lend integration options: REST API for language-agnostic HTTP access to Earn endpoints, @jup-ag/lend-read Read SDK for on-chain Earn and Borrow data, and @jup-ag/lend Lend SDK for instruction building. Includes capability matrix, code examples, and recommended usage table.\",\"href\":\"/lend/api-vs-sdk\"}]},{\"group\":\"Earn\",\"pages\":[{\"title\":\"Earn Overview\",\"description\":\"Jupiter Earn vault mechanics, data structures, and integration overview.\",\"llmsDescription\":\"Technical overview of Jupiter Earn vaults. Covers the unified liquidity layer, lending account structure (mint, fTokenMint, exchange prices, rewards rate model), key data structures in Rust/TypeScript/JSON, and links to deposit/withdraw operations and user position reading.\",\"href\":\"/lend/earn/index\"},{\"title\":\"Earn API (Beta)\",\"description\":\"Deposit and withdraw assets to earn yield through the Jupiter Lend protocol.\",\"llmsDescription\":\"Jupiter Lend Earn API for depositing and withdrawing assets. Supports deposit/withdraw by amount and mint/redeem by share count, with both transaction and instruction endpoints.\",\"href\":\"/lend/earn/api\"},{\"group\":\"Earn SDK\",\"pages\":[{\"title\":\"Deposit to Earn\",\"description\":\"Deposit assets into Jupiter Earn vaults to start earning yield.\",\"llmsDescription\":\"Deposit assets into Jupiter Earn vaults using the @jup-ag/lend SDK. Covers getDepositIxs for building deposit instructions, getMintIxs for depositing by vault shares, complete transaction flow with signing and sending, and full TypeScript code example.\",\"href\":\"/lend/earn/deposit\"},{\"title\":\"Withdraw from Earn\",\"description\":\"Withdraw assets from Jupiter Earn vaults.\",\"llmsDescription\":\"Withdraw assets from Jupiter Earn vaults using the @jup-ag/lend SDK. Covers getWithdrawIxs for withdrawing by underlying amount, getRedeemIxs for withdrawing by vault shares, max withdraw/redeem patterns, complete transaction flow, and full TypeScript code example.\",\"href\":\"/lend/earn/withdraw\"},{\"title\":\"Read Earn Data\",\"description\":\"Read Earn (supply) balances, positions, and pool metrics using the Jupiter Lend Read SDK.\",\"llmsDescription\":\"Read Earn (supply) balances, positions, and pool metrics using the @jup-ag/lend-read Read SDK. Covers Client setup, getAllJlTokens, getJlTokenDetails (supply rate, rewards rate, conversion rates), getUserPosition, getUserPositions, getPreviews, getExchangePrice, and getJlTokenRewards. Includes SDK type definitions for UserPosition and TokenDetails.\",\"href\":\"/lend/earn/read-data\"}]},{\"title\":\"Earn CPI Integration\",\"description\":\"Cross-Program Invocation integration for Jupiter Lend Earn deposit and withdraw.\",\"llmsDescription\":\"How to integrate Jupiter Lend Earn via Cross-Program Invocation (CPI) from an on-chain Solana program. Covers deposit and withdraw function discriminators (sha256 global:deposit and global:withdraw), complete Rust DepositParams and WithdrawParams structs with all account fields and mutability, account explanation tables, PDA derivation patterns (LENDING_SEED, F_TOKEN_MINT_SEED, LENDING_ADMIN_SEED), error codes (FTokenMinAmountOut, FTokenMaxAmount, etc.), and TypeScript context helpers (getDepositContext, getWithdrawContext) from @jup-ag/lend/earn for resolving CPI accounts from the frontend. Programs: Lending jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9, Liquidity jupeiUmn818Jg1ekPURTpr4mFo29p46vygyykFJ3wZC.\",\"href\":\"/lend/earn/cpi\"},{\"title\":\"JUICED Collateral Integration\",\"description\":\"Integrate JUICED as a collateral asset in your protocol\",\"llmsDescription\":\"Technical guide for integrating JUICED as a collateral asset. JUICED is a yield-bearing SPL token from Jupiter Lend Earn representing deposited JupUSD. Covers token details (mint address, decimals), onchain pricing via get_underlying_balance and get_exchange_price functions, deposit/withdraw flows using both the Lend API (HTTP endpoints at api.jup.ag/lend/v1/earn/) and Lend SDK (@jup-ag/lend), read functions for querying token data, withdrawal behaviour (Automated Debt Ceiling), program IDs, and risk considerations for lending protocols (exchange rate monotonicity, JupUSD peg dependency, T-bill yield variability, smart contract risk).\",\"href\":\"/jupusd/juiced\"}]},{\"group\":\"Borrow\",\"pages\":[{\"title\":\"Borrow Overview\",\"description\":\"Introduction to Jupiter Borrow and the Read SDK.\",\"llmsDescription\":\"Introduction to Jupiter Borrow, the collateralised borrowing side of Jupiter Lend. Covers the vault and position model (NFT-based positions, tick-based pricing), key TypeScript data structures (VaultConfig, UserPosition, NftPosition), and links to borrow operations and vault data reading via the Read SDK.\",\"href\":\"/lend/borrow/index\"},{\"title\":\"Borrow API (Beta)\",\"description\":\"Read borrow vaults and positions, and build collateralised borrow transactions via the Jupiter Lend API.\",\"llmsDescription\":\"Jupiter Lend Borrow REST API. Read endpoints GET /lend/v1/borrow/vaults and GET /lend/v1/borrow/positions, and the universal POST /lend/v1/borrow/operate (and /operate-instructions) endpoint that creates a position, deposits collateral, borrows, repays, and withdraws using signed colAmount and debtAmount. Covers the OperatePayload, positionId 0 to create a new position NFT, the nftId returned in responses, address lookup tables in the instructions response, the MIN_I128 repay-all and withdraw-all sentinel, and that WSOL-collateral vaults require pre-wrapped SOL. Includes runnable TypeScript examples.\",\"href\":\"/lend/borrow/api\"},{\"group\":\"Borrow SDK\",\"pages\":[{\"title\":\"Create Position\",\"description\":\"Create a new borrow position (position NFT).\",\"llmsDescription\":\"Create a new borrow position (NFT) in a Jupiter Lend vault using getInitPositionIx from @jup-ag/lend/borrow. Required before depositing collateral or borrowing. Covers legacy transaction building, position ID usage, and option to batch create + deposit in one transaction.\",\"href\":\"/lend/borrow/create-position\"},{\"title\":\"Deposit Collateral\",\"description\":\"Deposit assets as collateral into a Jupiter Lend borrow position.\",\"llmsDescription\":\"Deposit collateral into a Jupiter Lend borrow position using getOperateIx with positive colAmount and zero debtAmount. Covers versioned (v0) transaction building with address lookup tables, positionId 0 for batch create + deposit, operate parameters table, and full TypeScript code example.\",\"href\":\"/lend/borrow/deposit\"},{\"title\":\"Borrow Assets\",\"description\":\"Borrow assets against your collateral\",\"llmsDescription\":\"Borrow assets from a Jupiter Lend vault against deposited collateral using getOperateIx with zero colAmount and positive debtAmount. Covers versioned (v0) transaction building, operate parameters, LTV and interest mechanics, and full TypeScript code example.\",\"href\":\"/lend/borrow/borrow\"},{\"title\":\"Repay\",\"description\":\"Repay borrowed debt\",\"llmsDescription\":\"Repay borrowed debt on a Jupiter Lend borrow position using getOperateIx with zero colAmount and negative debtAmount. Covers partial and full repay, MAX_REPAY_AMOUNT sentinel for full debt repayment, versioned (v0) transaction building, and full TypeScript code example.\",\"href\":\"/lend/borrow/repay\"},{\"title\":\"Withdraw Collateral\",\"description\":\"Withdraw collateral from a Jupiter Lend borrow position.\",\"llmsDescription\":\"Withdraw collateral from a Jupiter Lend borrow position using getOperateIx with negative colAmount and zero debtAmount. Covers LTV constraints, MAX_WITHDRAW_AMOUNT sentinel for full withdrawal, versioned (v0) transaction building, and full TypeScript code example.\",\"href\":\"/lend/borrow/withdraw\"},{\"title\":\"Combined Operations\",\"description\":\"Run create, deposit, borrow, repay, and withdraw in a single transaction using getOperateIx.\",\"llmsDescription\":\"Combine multiple Jupiter Lend borrow operations (create position, deposit, borrow, repay, withdraw) into a single transaction using multiple getOperateIx calls. Covers positionId 0 for auto-creation, instruction merging, address lookup table deduplication, and full TypeScript code example.\",\"href\":\"/lend/borrow/combined\"},{\"title\":\"Liquidate\",\"description\":\"Liquidate an underwater borrow position\",\"llmsDescription\":\"Liquidate underwater borrow positions in Jupiter Lend using getLiquidateIx from @jup-ag/lend/borrow. Covers liquidation threshold mechanics, optional parameters (to, absorb, colPerUnitDebt), versioned (v0) transaction building with address lookup tables, and full TypeScript code example.\",\"href\":\"/lend/borrow/liquidation\"},{\"title\":\"Read Vault Data\",\"description\":\"Read vault config, state, and user positions (Borrow) using the Jupiter Lend Read SDK.\",\"llmsDescription\":\"Read vault configuration, state, and user positions for Jupiter Lend Borrow using the @jup-ag/lend-read Read SDK. Covers Client setup, getAllVaults, getVaultByVaultId, getVaultConfig, getVaultState, getAllUserPositions, getPositionByVaultId, getUserPosition, getCurrentPositionState, getFinalPosition, getAllPositionIdsForVault, getAllPositionsWithRiskRatio, getNftOwner. getAllUserPositions and getPositionByVaultId return NftPosition \u0026 { vault: VaultEntireData } — each position includes full vault data. Includes SDK type definitions for NftPosition, UserPosition, VaultConfig, VaultState.\",\"href\":\"/lend/borrow/read-vault-data\"}]},{\"title\":\"Borrow CPI Integration\",\"description\":\"Cross-Program Invocation integration for Jupiter Lend Borrow vault operations.\",\"llmsDescription\":\"How to integrate Jupiter Lend Borrow vaults via Cross-Program Invocation (CPI) from an on-chain Solana program. Covers init_position and operate function discriminators (sha256 global:init_position and global:operate), complete Rust InitPositionParams and OperateParams structs with all account fields and mutability, account explanation tables for core vault, position management, and liquidity integration accounts, remaining_accounts structure (oracle sources, branches, tick debt arrays), signed-amount convention (positive = deposit/borrow, negative = withdraw/payback, i128::MIN = max), transfer types (Normal vs Claim), operation patterns (deposit, borrow, payback, withdraw, max variants), error codes, return values (nft_id, new_col_final, new_debt_final), and TypeScript CPI integration using getOperateIx from @jup-ag/lend/borrow with setup instructions pattern. Programs: Vaults jupr81YtYssSyPt8jbnGuiWon5f6x9TcDEFxYe3Bdzi (mainnet), Ho32sUQ4NzuAQgkPkHuNDG3G18rgHmYtXFA8EBmqQrAu (devnet).\",\"href\":\"/lend/borrow/cpi\"}]},{\"group\":\"Lend AMM\",\"pages\":[{\"title\":\"AMM Overview\",\"description\":\"Route swaps directly through the Lend AMM, Jupiter Lend's concentrated-liquidity AMM on the Liquidity Layer.\",\"llmsDescription\":\"Overview of integrating swaps against the Jupiter Lend AMM on Solana, a concentrated-liquidity AMM built on the Jupiter Lend Liquidity Layer. Covers pool shapes (collateral pool, debt pool, collateral + debt), the swap_in (exact-in) and swap_out (exact-out) instructions, slippage guards enforced on-chain, token0/token1 pubkey ordering, native-unit amounts, pool-favouring rounding, dex_id pool addressing, program addresses (Lend AMM jupZ4m2GqUCJ5iueMfzQf8khFfH31d4XAQt3RzCT9Vd, Liquidity Layer jupeiUmn818Jg1ekPURTpr4mFo29p46vygyykFJ3wZC, Oracle jupnw4B6Eqs7ft6rxpzYLJZYSnrpRgPcr589n5Kv4oc), PDA seeds, and how pools sit on the Liquidity Layer (shares, interest accrual, re-entrancy, pausing). Entry point for routers, aggregators, and on-chain programs that want to route swaps through Jupiter Lend as a DEX via the TypeScript SDKs or Rust CPI.\",\"href\":\"/lend/dex/index\"},{\"title\":\"AMM SDK\",\"description\":\"Quote and execute Lend AMM swaps with the @jup-ag/lend-read and @jup-ag/lend TypeScript SDKs.\",\"llmsDescription\":\"How to swap against the Jupiter Lend AMM using the TypeScript SDKs: quote off-chain with Dex.estimateSwapIn / estimateSwapOut from @jup-ag/lend-read, derive on-chain slippage guards (amountOutMin / amountInMax), then build and send the swap instruction with getSwapInIx / getSwapOutIx from @jup-ag/lend/dex. Covers the SwapResult quote fields, the builder return shape (ixs, accounts, remainingAccounts, addressLookupTableAccounts), versioned transactions with the pool's address lookup table, compute budget sizing, sending output to a different recipient, exact on-chain quoting via simulation with the ADDRESS_DEAD sentinel, and mapping AnchorError codes like DexNotEnoughAmountOut (6024) and DexExceedsAmountInMax (6051).\",\"href\":\"/lend/dex/typescript\"},{\"title\":\"AMM APIs\",\"sidebarTitle\":\"AMM APIs (Coming soon)\",\"description\":\"REST endpoints for quoting and building Lend AMM swaps. Coming soon.\",\"llmsDescription\":\"Placeholder for the upcoming Jupiter Lend AMM REST API. REST endpoints for quoting and building swaps against the Lend AMM over HTTP are not yet available. Until they launch, integrate with the TypeScript SDKs (@jup-ag/lend-read for quoting, @jup-ag/lend/dex for building swap instructions) or via Rust CPI from an on-chain program.\",\"href\":\"/lend/dex/api\"},{\"title\":\"AMM CPI Integration\",\"description\":\"Call swap_in and swap_out on the Lend AMM from your own Solana program via CPI.\",\"llmsDescription\":\"How to swap against the Jupiter Lend AMM from an on-chain Solana program via cross-program invocation (CPI). Covers generating the CPI client from the published IDL with Anchor's declare_program! macro, the full 25-account DexOperation context in exact order, why all four supply/borrow position accounts are mandatory for swaps, reading the u64 return value with .get(), signing as a PDA with new_with_signer, passing external center-price oracle accounts as remaining accounts, Token-2022 handling, compute budget sizing, and a raw instruction recipe (discriminators and Borsh argument layout) for non-Anchor programs. AMM program id jupZ4m2GqUCJ5iueMfzQf8khFfH31d4XAQt3RzCT9Vd.\",\"href\":\"/lend/dex/cpi\"},{\"title\":\"AMM Errors\",\"description\":\"Error codes on the Lend AMM swap path, what triggers them, and how to handle them.\",\"llmsDescription\":\"Reference table of Jupiter Lend AMM program errors on the swap path. Covers slippage errors (DexNotEnoughAmountOut 6024, DexExceedsAmountInMax 6051), size and dust limits (DexSwapInLimitingAmounts 6052, DexSwapOutLimitingAmounts 6053, DexLimitingAmountsSwapAndNonPerfect 6060, DexOracleUpdateHugeSwapDiff 6048), reserve and utilization errors (6022, 6057, 6058, 6059, 6025, 6023), pool state errors (DexSwapAndArbitragePaused 6050, DexAlreadyEntered 6017, 6021, 6019, 6020), external center-price errors (6067, 6068, 6056), CPI account errors (DexValidateInvalidLiquidityPosition 6077, 6078, 6066, 6079), the intentional simulation sentinels (DexSwapInResult 6081, DexSwapOutResult 6082), and how to read the custom error code from a failed transaction in TypeScript or CPI.\",\"href\":\"/lend/dex/errors\"}]},{\"group\":\"Flashloan\",\"pages\":[{\"title\":\"Flashloans\",\"description\":\"Borrow assets with no collateral and no fees using Jupiter Lend Flashloans.\",\"llmsDescription\":\"Overview of Jupiter Lend Flashloans: borrow any supported asset with no collateral and no fees, as long as the borrowed amount is returned within the same transaction. Covers use cases (arbitrage, liquidations, collateral swapping), how the atomic borrow-execute-payback flow works on Solana, and links to the execute guide for SDK integration with getFlashloanIx, getFlashBorrowIx, and getFlashPaybackIx from @jup-ag/lend/flashloan.\",\"href\":\"/lend/flashloan/index\"},{\"title\":\"Execute a Flashloan\",\"description\":\"Build and send a flashloan transaction using the Jupiter Lend SDK.\",\"llmsDescription\":\"How to execute a flashloan using the Jupiter Lend SDK (@jup-ag/lend/flashloan). Covers the getFlashloanIx helper that returns borrowIx and paybackIx, the getFlashBorrowIx and getFlashPaybackIx individual helpers, required parameters (connection, signer, asset, amount), transaction assembly order (borrow → custom logic → payback), VersionedTransaction construction, and a complete TypeScript code example. Flashloans have no fees and no collateral requirements.\",\"href\":\"/lend/flashloan/execute\"}]},{\"group\":\"Liquidity\",\"pages\":[{\"title\":\"Unifying Liquidity\",\"description\":\"The Liquidity layer as the foundation of Jupiter Lend, unifying liquidity across Earn and Borrow protocols.\",\"llmsDescription\":\"Jupiter Lend Liquidity layer: single shared layer that consolidates liquidity across Earn and Borrow. Key features: capital efficiency, automated ceilings, advanced liquidation, highest LTVs.\",\"href\":\"/lend/liquidity/index\"},{\"title\":\"Liquidity Data \u0026 Analytics\",\"description\":\"Query market state, interest rates, and utilisation for Jupiter Lend liquidity layer.\",\"llmsDescription\":\"How to use the @jup-ag/lend-read SDK Liquidity module for data and analytics: dashboards, APY aggregators, and protocol state queries. Covers listedTokens() for market discovery, getOverallTokenData() for supply/borrow rates and utilisation, getExchangePricesAndConfig() and calculateExchangePrice() for real-time price computation, getUserSupplyData() and getUserBorrowData() for individual positions, getUserMultipleBorrowSupplyData() for batched portfolio fetching, and getAllUserPositions() for global protocol state indexing. Distinct from Dune or other third-party analytics, this is the canonical SDK for Jupiter Lend liquidity layer data.\",\"href\":\"/lend/liquidity/analytics\"}]},{\"group\":\"Advanced\",\"pages\":[{\"title\":\"Advanced Guides\",\"description\":\"Advanced recipes combining flashloans, swaps, and vault operations.\",\"llmsDescription\":\"Index of advanced Jupiter Lend recipes that compose multiple primitives (flashloans, Jupiter Swap via Lite API, and vault operations) into single atomic transactions. Includes Multiply (leverage), Unwind (deleverage), Repay and Withdraw with Collateral, Vault Swap (move between vaults), Utilisation After Deposit (read-only calculation), and Native Staked Vaults (use staked SOL as collateral).\",\"href\":\"/lend/advanced/index\"},{\"title\":\"Multiply (Leverage)\",\"description\":\"Build leveraged positions by combining flashloans, Jupiter Swap, and vault operations.\",\"llmsDescription\":\"How to build a leveraged (multiply/looping) position on Jupiter Lend using a single atomic Solana transaction. Combines getFlashBorrowIx/getFlashPaybackIx from @jup-ag/lend/flashloan, Jupiter Lite API swap-instructions endpoint for swaps, and getOperateIx from @jup-ag/lend/borrow for vault deposit+borrow. Covers the full flow: flashloan debt asset → swap to collateral → deposit collateral and borrow debt → payback flashloan. Includes complete TypeScript code example with VersionedTransaction, address lookup tables, and helper functions.\",\"href\":\"/lend/advanced/multiply\"},{\"title\":\"Unwind (Deleverage)\",\"description\":\"Close or reduce leveraged positions by combining flashloans, Jupiter Swap, and vault operations.\",\"llmsDescription\":\"How to close or reduce a leveraged position on Jupiter Lend using a single atomic transaction. Combines getFlashBorrowIx/getFlashPaybackIx for flashloaning the collateral asset, Jupiter Lite API for swapping collateral to debt, and getOperateIx with MAX_REPAY_AMOUNT/MAX_WITHDRAW_AMOUNT for full unwind or negative signed amounts for partial unwind. Covers full and partial deleverage flows with complete TypeScript code example.\",\"href\":\"/lend/advanced/unwind\"},{\"title\":\"Repay with Collateral and Max Withdraw\",\"description\":\"Close a position when you hold only the collateral token.\",\"llmsDescription\":\"How to close a Jupiter Lend borrow position when you only hold the collateral token (e.g. SOL, not USDC). Uses a flashloan to borrow the debt asset, repay full debt and withdraw full collateral with getOperateIx using MAX_REPAY_AMOUNT and MAX_WITHDRAW_AMOUNT, swap collateral to debt via Jupiter Lite API, then payback the flashloan. All in a single atomic Solana transaction. Includes complete TypeScript code example.\",\"href\":\"/lend/advanced/repay-with-collateral-max-withdraw\"},{\"title\":\"Vault Swap\",\"description\":\"Move a position from one vault to another atomically.\",\"llmsDescription\":\"How to atomically swap a Jupiter Lend borrow position from one vault to another (e.g. SOL/USDC to SOL/USDT) in a single Solana transaction. Combines flashloan (borrow debt of vault 1), getOperateIx with MAX_REPAY_AMOUNT/MAX_WITHDRAW_AMOUNT to close vault 1, getOperateIx with positionId 0 to open vault 2, Jupiter Lite API swap to convert new debt token to original debt token, and flashloan payback. Covers borrow buffer for slippage, Solana 1232-byte transaction size limit, and complete TypeScript code example.\",\"href\":\"/lend/advanced/vault-swap\"},{\"title\":\"Utilisation After Deposit\",\"description\":\"Calculate the final utilisation on the Liquidity Layer after a hypothetical deposit.\",\"llmsDescription\":\"How to calculate the projected utilisation on the Jupiter Lend Liquidity Layer after a hypothetical deposit using the @jup-ag/lend-read SDK Liquidity module. Read-only guide covering getOverallTokenData() for current totalSupply and totalBorrow, utilisation formula (totalBorrow / totalSupply), and computing the new utilisation after adding a deposit. Includes complete TypeScript code example with BN arithmetic.\",\"href\":\"/lend/advanced/utilization-after-deposit\"},{\"group\":\"Native Staked Vaults\",\"pages\":[{\"title\":\"Native Staked Vaults\",\"description\":\"Use staked SOL as collateral via Single Pool tokens.\",\"llmsDescription\":\"Overview of Jupiter Lend Native Staked Vaults, which allow using staked SOL as collateral. Deposit validator stake accounts into the Single Pool program (SVSPxpvHdN29nkVg9rPapPNDddN5DipNLRUFhyjFThE) to receive pool tokens (e.g. nsHELIUS, nsJUPITER, nsNANSEN, nsEMERALD, nsSHIFT, nsKILN), then deposit those tokens into the corresponding Jupiter Lend vault to borrow against them while continuing to earn staking rewards. Lists all supported pools with vote accounts and pool mints.\",\"href\":\"/lend/advanced/native-staked-vault/index\"},{\"title\":\"Deposit Staked SOL\",\"description\":\"Deposit stake into Single Pool, receive pool tokens, then deposit them into a vault as collateral.\",\"llmsDescription\":\"How to deposit staked SOL into a Jupiter Lend Native Staked Vault. Covers the three-step flow: split stake via StakeProgram.split, deposit into Single Pool via SinglePoolProgram.deposit from @solana/spl-single-pool-classic to receive pool tokens, then deposit pool tokens into the corresponding vault via getOperateIx from @jup-ag/lend/borrow. Includes vault discovery using client.vault.getAllVaults() and matching supplyToken to pool mint. Complete TypeScript code example with VersionedTransaction.\",\"href\":\"/lend/advanced/native-staked-vault/deposit\"},{\"title\":\"Withdraw Staked SOL\",\"description\":\"Withdraw pool tokens from vault, then burn them via Single Pool to receive stake back.\",\"llmsDescription\":\"How to withdraw staked SOL from a Jupiter Lend Native Staked Vault. Covers the two-step flow: withdraw pool tokens from vault via getOperateIx with MAX_WITHDRAW_AMOUNT from @jup-ag/lend/borrow, then burn pool tokens via SinglePoolProgram.withdraw from @solana/spl-single-pool-classic to receive a new stake account. Complete TypeScript code example with VersionedTransaction.\",\"href\":\"/lend/advanced/native-staked-vault/withdraw\"}]}]},{\"group\":\"Wallet Integrations\",\"pages\":[{\"title\":\"Earn with Privy\",\"description\":\"Deposit and withdraw assets from Jupiter Earn vaults using Privy embedded wallets.\",\"llmsDescription\":\"How to deposit and withdraw from Jupiter Earn vaults using Privy embedded wallets. Covers PrivyClient setup, getDepositIxs and getWithdrawIxs from @jup-ag/lend/earn, building VersionedTransaction for Privy signing, signing via privy.wallets().solana().signTransaction, optional getUserPosition from @jup-ag/lend-read for max withdraw, and sending transactions. Complete flow for keyless Earn deposits and withdrawals.\",\"href\":\"/lend/wallets/privy-earn\"},{\"title\":\"Borrow with Privy\",\"description\":\"Create a position, deposit collateral, and borrow assets using Privy embedded wallets.\",\"llmsDescription\":\"How to create a borrow position, deposit collateral, and borrow assets from Jupiter Lend vaults using Privy embedded wallets. Covers PrivyClient setup, getOperateIx from @jup-ag/lend/borrow with positionId 0 for batched create-and-deposit, versioned transactions with address lookup tables, Privy signing via privy.wallets().solana().signTransaction, and the full create-deposit-borrow flow. Complete guide for keyless borrowing.\",\"href\":\"/lend/wallets/privy-borrow\"}]},{\"group\":\"Resources\",\"pages\":[{\"title\":\"Program addresses\",\"description\":\"Official program addresses for Jupiter Lend protocols.\",\"llmsDescription\":\"Official on-chain program addresses for all Jupiter Lend programs: Earn (jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9), Liquidity (jupeiUmn818Jg1ekPURTpr4mFo29p46vygyykFJ3wZC), Lending Rewards Rate Model (jup7TthsMgcR9Y3L277b8Eo9uboVSmu1utkuXHNUKar), Oracle (jupnw4B6Eqs7ft6rxpzYLJZYSnrpRgPcr589n5Kv4oc), Vaults/Borrow (jupr81YtYssSyPt8jbnGuiWon5f6x9TcDEFxYe3Bdzi), Flashloan (jupgfSgfuAXv4B6R2Uxu85Z1qdzgju79s6MfZekN6XS), and AMM (jupZ4m2GqUCJ5iueMfzQf8khFfH31d4XAQt3RzCT9Vd).\",\"href\":\"/lend/program-addresses\"},{\"title\":\"IDL and types\",\"description\":\"Anchor IDL and TypeScript types for Jupiter Lend programs.\",\"llmsDescription\":\"Anchor IDL JSON files and TypeScript type definitions for Jupiter Lend on-chain programs. Located in the jup-ag/jupiter-lend GitHub repository under the target directory. Use for CPI integrations, custom clients, and low-level program interactions.\",\"href\":\"/lend/idl-and-types\"},{\"title\":\"Dune Analytics\",\"description\":\"Community and protocol dashboards for Jupiter Lend.\",\"llmsDescription\":\"Links to Dune Analytics dashboards for Jupiter Lend protocol data, including TVL, utilisation, supply/borrow metrics, and community-built analytics.\",\"href\":\"/lend/dune\"}]},{\"group\":\"API Reference\",\"pages\":[{\"group\":\"Earn\",\"tag\":\"BETA\",\"pages\":[{\"openapi\":\"openapi-spec/lend/lend.yaml post /earn/deposit\",\"title\":\"Deposit\",\"description\":\"Request for a base64-encoded unsigned earn deposit transaction to deposit assets\",\"href\":\"/api-reference/lend/earn/deposit\"},{\"openapi\":\"openapi-spec/lend/lend.yaml post /earn/withdraw\",\"title\":\"Withdraw\",\"description\":\"Request for a base64-encoded unsigned earn withdraw transaction to withdraw assets\",\"href\":\"/api-reference/lend/earn/withdraw\"},{\"openapi\":\"openapi-spec/lend/lend.yaml post /earn/mint\",\"title\":\"Mint\",\"description\":\"Request for a base64-encoded unsigned earn mint transaction to mint shares\",\"href\":\"/api-reference/lend/earn/mint\"},{\"openapi\":\"openapi-spec/lend/lend.yaml post /earn/redeem\",\"title\":\"Redeem\",\"description\":\"Request for a base64-encoded unsigned earn redeem transaction to redeem shares\",\"href\":\"/api-reference/lend/earn/redeem\"},{\"openapi\":\"openapi-spec/lend/lend.yaml post /earn/deposit-instructions\",\"title\":\"Deposit Instructions\",\"description\":\"Request for the instruction of an earn deposit transaction to deposit assets\",\"href\":\"/api-reference/lend/earn/deposit-instructions\"},{\"openapi\":\"openapi-spec/lend/lend.yaml post /earn/withdraw-instructions\",\"title\":\"Withdraw Instructions\",\"description\":\"Request for the instruction of an earn withdraw transaction to withdraw assets\",\"href\":\"/api-reference/lend/earn/withdraw-instructions\"},{\"openapi\":\"openapi-spec/lend/lend.yaml post /earn/mint-instructions\",\"title\":\"Mint Instructions\",\"description\":\"Request for the instruction of an earn mint transaction to mint shares\",\"href\":\"/api-reference/lend/earn/mint-instructions\"},{\"openapi\":\"openapi-spec/lend/lend.yaml post /earn/redeem-instructions\",\"title\":\"Redeem Instructions\",\"description\":\"Request for the instruction of an earn redeem transaction to redeem shares\",\"href\":\"/api-reference/lend/earn/redeem-instructions\"},{\"openapi\":\"openapi-spec/lend/lend.yaml get /earn/tokens\",\"title\":\"Tokens\",\"description\":\"Request for the tokens available to be deposited and their information\",\"href\":\"/api-reference/lend/earn/tokens\"},{\"openapi\":\"openapi-spec/lend/lend.yaml get /earn/positions\",\"title\":\"Earn Positions\",\"sidebarTitle\":\"Positions\",\"description\":\"Request for the position data of one or multiple users\",\"href\":\"/api-reference/lend/earn/positions\"},{\"openapi\":\"openapi-spec/lend/lend.yaml get /earn/earnings\",\"title\":\"Earnings\",\"description\":\"Request for the earnings of one or multiple positions of a user\",\"href\":\"/api-reference/lend/earn/earnings\"}]},{\"group\":\"Borrow\",\"tag\":\"BETA\",\"pages\":[{\"openapi\":\"openapi-spec/lend/borrow.yaml get /borrow/vaults\",\"title\":\"Vaults\",\"description\":\"Request all borrow vaults with their configuration, rates, and liquidity\",\"href\":\"/api-reference/lend/borrow/vaults\"},{\"openapi\":\"openapi-spec/lend/borrow.yaml get /borrow/positions\",\"title\":\"Borrow Positions\",\"sidebarTitle\":\"Positions\",\"description\":\"Request the borrow positions of one or multiple users\",\"href\":\"/api-reference/lend/borrow/positions\"},{\"openapi\":\"openapi-spec/lend/borrow.yaml post /borrow/operate\",\"title\":\"Operate\",\"description\":\"Request a base64-encoded unsigned borrow operate transaction (deposit, borrow, repay, withdraw)\",\"href\":\"/api-reference/lend/borrow/operate\"},{\"openapi\":\"openapi-spec/lend/borrow.yaml post /borrow/operate-instructions\",\"title\":\"Operate Instructions\",\"description\":\"Request the instructions and address lookup tables for a borrow operate transaction\",\"href\":\"/api-reference/lend/borrow/operate-instructions\"}]}]}]},{\"item\":\"LO \u0026 DCA\",\"icon\":\"crosshairs\",\"groups\":[{\"group\":\"Get Started\",\"pages\":[{\"title\":\"Trigger Order API Overview\",\"sidebarTitle\":\"Overview\",\"description\":\"Create advanced trigger orders on Solana with vault-based execution: limit orders, take-profit/stop-loss (OCO), conditional chains (OTOCO), and recurring DCA.\",\"llmsDescription\":\"Jupiter Trigger Order API V2 enables vault-based automated orders on Solana. Two order families: price orders (single limit, OCO for TP/SL, OTOCO conditional chains) and DCA (dollar-cost averaging, recurring time- or price-conditional swaps). Requires JWT authentication via challenge-response flow. Deposits go into Privy-managed vault accounts shared across all your orders.\",\"href\":\"/trigger\"},{\"title\":\"Authentication\",\"description\":\"Authenticate with the Trigger Order API using a challenge-response JWT flow with refresh tokens.\",\"llmsDescription\":\"How to authenticate with the Jupiter Trigger Order API V2. POST /trigger/v2/auth/challenge requests a challenge (message or transaction); POST /trigger/v2/auth/verify submits the signed challenge. Send authMode: access_refresh to receive a 15-minute accessToken plus a rotating refreshToken (expiresAt, tokenType); the legacy access_only mode returns a single 24h token and is deprecated. Covers POST /trigger/v2/auth/refresh (rotate the refresh token), POST /trigger/v2/auth/logout (revoke one session) and POST /trigger/v2/auth/logout-all (revoke every session), the 401-then-refresh retry pattern, and migration from access_only. Use the accessToken in the Authorization: Bearer header for all authenticated endpoints.\",\"href\":\"/trigger/authentication\"},{\"title\":\"Vault \u0026 Deposit\",\"sidebarTitle\":\"Vault \u0026 Deposit\",\"description\":\"Resolve your vault and craft the deposit transaction that funds every trigger order.\",\"llmsDescription\":\"Canonical vault and deposit reference for the Jupiter Trigger V2 API, shared by both limit orders and DCA. Covers resolving your vault with GET /trigger/v2/vault (or /vault/register, 409 if already registered), crafting the funding transaction with POST /trigger/v2/deposit/craft (inputMint, outputMint, userAddress, amount, orderType price or dca, and orderSubType single/oco/otoco for price orders), the response fields (transaction, requestId, receiverAddress, mint, amount, tokenDecimals, inputTokenAccount, plus outputTokenAccount for otoco), and signing the deposit client-side to produce depositSignedTx. The vault is resolved from your JWT and the single-use requestId is consumed by the create call as depositRequestId.\",\"href\":\"/trigger/deposit\"},{\"title\":\"Integration Flow\",\"sidebarTitle\":\"Integration Flow\",\"description\":\"The end-to-end sequence of Trigger API calls for both limit orders and DCA, the data that flows between them, and where the two families diverge.\",\"llmsDescription\":\"$35\",\"href\":\"/trigger/lifecycle\"}]},{\"group\":\"Limit Orders\",\"pages\":[{\"title\":\"Create Order (Trigger)\",\"sidebarTitle\":\"Create\",\"description\":\"Create price-triggered limit orders: single, OCO (take-profit/stop-loss), and OTOCO (conditional chains).\",\"llmsDescription\":\"How to create Trigger V2 price orders with POST /trigger/v2/orders/price. Includes a complete runnable TypeScript example (authenticate, get vault, craft and sign deposit, submit the order). Covers the single, OCO (one-cancels-other TP/SL), and OTOCO (one-triggers-OCO) order types, the common and per-type parameters (triggerMint, triggerCondition, triggerPriceUsd, tpPriceUsd, slPriceUsd, slippageBps, expiresAt), default slippage by order side, validation rules (10 USD minimum, distinct mints, required future expiry), and the response ({ id, txSignature, depositConfirmed }). The shared vault and deposit reference lives on the Vault \u0026 Deposit page.\",\"href\":\"/trigger/create-order\"},{\"title\":\"Order History (Trigger)\",\"sidebarTitle\":\"Track\",\"description\":\"Query order history, filter by state, and understand the order lifecycle.\",\"llmsDescription\":\"GET /trigger/v2/orders/history returns paginated order history with state, events, and fill details. Filter by state (active/past), mint, and sort by updated_at/created_at/expires_at.\",\"href\":\"/trigger/order-history\"},{\"title\":\"Manage Orders\",\"sidebarTitle\":\"Manage\",\"description\":\"Update order parameters, cancel orders with two-step withdrawal, and withdraw funds from your vault.\",\"llmsDescription\":\"PATCH /trigger/v2/orders/price/{orderId} updates order parameters. POST /trigger/v2/orders/price/cancel/{orderId} initiates cancellation and returns a withdrawal transaction. POST /trigger/v2/orders/price/confirm-cancel/{orderId} confirms with the signed withdrawal transaction.\",\"href\":\"/trigger/manage-orders\"}]},{\"group\":\"DCA\",\"pages\":[{\"title\":\"Dollar-Cost Averaging (DCA)\",\"sidebarTitle\":\"Create\",\"description\":\"Split a single deposit into recurring swaps on a schedule, with optional price conditions.\",\"llmsDescription\":\"How to create a Trigger V2 DCA (dollar-cost averaging) order: POST /trigger/v2/deposit/craft (orderType: dca) then POST /trigger/v2/orders/dca. Covers the shared vault + JWT deposit flow, the time_based and price_conditional order types, all create parameters (orderCount min 2 with no fixed max, intervalSeconds 60s-1yr, minPriceUsd, maxPriceUsd, triggerMint, beginFillAt), and Earn While You Wait (jlEnabled/jlMint: idle stablecoin earns Jupiter Lend yield between rounds, time_based and supported stablecoins USDC/USDT/JupUSD only). Covers validation (min 10 USD per round, max 10 active orders, beginFillAt at most 30 days out) and create-time errors. Includes a complete runnable TypeScript example. See Track a DCA Order for monitoring and Cancel a DCA Order for withdrawal.\",\"href\":\"/trigger/dca\"},{\"title\":\"Track a DCA Order\",\"sidebarTitle\":\"Track\",\"description\":\"Monitor a DCA order's progress, fills, and state through the history endpoints.\",\"llmsDescription\":\"How to track a Trigger V2 DCA order: GET /trigger/v2/orders/history/dca (list) and GET /trigger/v2/orders/history/dca/{id} (single order), with query params (state active/past, mint, limit 1-100 default 20, offset, sort updated_at/created_at/next_fill_at, dir asc/desc). Documents the response fields (inputAmountInitial/inputAmountRemaining, amountPerRound, outputAmountTotal, inputAmountUsed, numberOfRounds/roundsFilled/fillPercent, nextFillAt/lastFillAt, state/displayState, jlEnabled/jlYieldUsd for Earn While You Wait orders, events), the full state-to-displayState mapping, how the keeper fills each round and delivers the output straight to the wallet, and how fees and slippage work (keeper-set, no slippage parameter).\",\"href\":\"/trigger/dca-history\"},{\"title\":\"Cancel a DCA Order\",\"sidebarTitle\":\"Cancel\",\"description\":\"Withdraw the unfilled remainder of a DCA order through the two-step cancel flow.\",\"llmsDescription\":\"How to cancel a Trigger V2 DCA order and withdraw the unfilled remainder: two-step flow, POST /trigger/v2/orders/dca/cancel/{id} (returns an unsigned withdrawal transaction plus refundAmount and roundsRemaining) then POST /trigger/v2/orders/dca/confirm-cancel/{id} (submit the signed transaction). Covers that re-calling cancel while withdrawing is idempotent, that a failed confirm-cancel leaves the order in withdrawing (it does not roll back to active), and that DCA orders cannot be edited (no PATCH route). Rounds that have already filled are not reversed.\",\"href\":\"/trigger/dca-cancel\"}]},{\"group\":\"Resources\",\"pages\":[{\"title\":\"Trigger Best Practices\",\"sidebarTitle\":\"Best Practices\",\"description\":\"Guidelines for error handling, token compatibility, and integration patterns across price orders and DCA in the Trigger Order V2 API.\",\"llmsDescription\":\"Best practices for Trigger Order V2 integrations across both order families. Price orders require an expiresAt and take a slippage setting (RTSE auto or fixed bps); DCA orders have no expiry (duration is orderCount times intervalSeconds, optional beginFillAt) and no slippage parameter (keeper-set per round). Covers error handling (400 details, 401 re-auth), the 10 USD minimum (per price order, or per DCA round), Token-2022 restrictions, and per-family order states.\",\"href\":\"/trigger/best-practices\"},{\"title\":\"Error Reference\",\"description\":\"HTTP status codes returned by each Trigger Order API endpoint and what causes them.\",\"llmsDescription\":\"Per-endpoint error reference for the Jupiter Trigger Order V2 API. Documents the JSON error envelope and the status codes returned by each endpoint: POST /trigger/v2/auth/challenge and /auth/verify, GET /trigger/v2/vault and /vault/register, POST /trigger/v2/deposit/craft, POST /trigger/v2/orders/price, PATCH /trigger/v2/orders/price/{id}, POST /trigger/v2/orders/price/cancel/{id} and /confirm-cancel/{id}, and GET /trigger/v2/orders/history. Explains common causes: 400 validation and state errors, 401 missing/expired JWT, 403 wallet mismatch, 404 order or vault not found, and 409 vault already registered. Covers price-order and shared endpoints only; DCA endpoint errors (/orders/dca, /orders/history/dca, /orders/dca/cancel, /confirm-cancel) are documented on the DCA pages.\",\"href\":\"/trigger/errors\"}]},{\"group\":\"API Reference\",\"pages\":[{\"group\":\"Authenticate \u0026 Vault\",\"pages\":[{\"title\":\"Request Challenge\",\"description\":\"Request a sign-in challenge for wallet authentication\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /auth/challenge\",\"href\":\"/api-reference/trigger/challenge\"},{\"title\":\"Verify Challenge\",\"description\":\"Submit the signed challenge to receive a JWT token\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /auth/verify\",\"href\":\"/api-reference/trigger/verify\"},{\"title\":\"Refresh Token\",\"description\":\"Rotate the refresh token and get a new access token\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /auth/refresh\",\"href\":\"/api-reference/trigger/refresh\"},{\"title\":\"Log Out\",\"description\":\"Revoke the refresh token for one session\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /auth/logout\",\"href\":\"/api-reference/trigger/logout\"},{\"title\":\"Log Out All\",\"description\":\"Revoke every session for the wallet\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /auth/logout-all\",\"href\":\"/api-reference/trigger/logout-all\"},{\"title\":\"Get Vault\",\"description\":\"Get vault information and balance for an account\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml get /vault\",\"href\":\"/api-reference/trigger/vault\"},{\"title\":\"Register Vault\",\"description\":\"Register a new trigger vault for the account\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml get /vault/register\",\"href\":\"/api-reference/trigger/vault-register\"},{\"title\":\"Craft Deposit\",\"description\":\"Craft a deposit transaction for the trigger vault\",\"llmsDescription\":\"API reference for POST /trigger/v2/deposit/craft, which builds an unsigned deposit transaction for Trigger V2 vault-based orders. Covers required request fields including inputMint, outputMint, userAddress, amount, orderType, and orderSubType for price orders, plus response fields such as transaction, requestId, receiverAddress, inputTokenAccount, and outputTokenAccount.\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /deposit/craft\",\"href\":\"/api-reference/trigger/deposit-craft\"}]},{\"group\":\"Limit Order\",\"pages\":[{\"title\":\"Create Order (Trigger API)\",\"sidebarTitle\":\"Create Order\",\"description\":\"Create a new trigger order\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /orders/price\",\"href\":\"/api-reference/trigger/create-order\"},{\"title\":\"Update Order\",\"description\":\"Update parameters of an existing trigger order\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml patch /orders/price/{orderId}\",\"href\":\"/api-reference/trigger/update-order\"},{\"title\":\"Cancel Order (Trigger API)\",\"sidebarTitle\":\"Cancel Order\",\"description\":\"Cancel a pending trigger order\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /orders/price/cancel/{orderId}\",\"href\":\"/api-reference/trigger/cancel-order\"},{\"title\":\"Confirm Cancel\",\"description\":\"Confirm and execute a pending order cancellation\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /orders/price/confirm-cancel/{orderId}\",\"href\":\"/api-reference/trigger/confirm-cancel\"}]},{\"group\":\"DCA\",\"pages\":[{\"title\":\"Create DCA Order\",\"description\":\"Create a recurring dollar-cost averaging order\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /orders/dca\",\"href\":\"/api-reference/trigger/create-dca\"},{\"title\":\"Cancel DCA Order\",\"description\":\"Initiate cancellation of a DCA order and craft the withdrawal transaction\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /orders/dca/cancel/{id}\",\"href\":\"/api-reference/trigger/cancel-dca\"},{\"title\":\"Confirm Cancel DCA Order\",\"description\":\"Submit the signed withdrawal transaction to finalize a DCA cancellation\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml post /orders/dca/confirm-cancel/{id}\",\"href\":\"/api-reference/trigger/confirm-cancel-dca\"},{\"title\":\"List DCA Orders\",\"description\":\"List your DCA orders with full event history\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml get /orders/history/dca\",\"href\":\"/api-reference/trigger/dca-history\"},{\"title\":\"Get DCA Order\",\"description\":\"Get a single DCA order by ID, including fills and events\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml get /orders/history/dca/{id}\",\"href\":\"/api-reference/trigger/dca-order\"}]},{\"group\":\"History\",\"pages\":[{\"title\":\"Order History (Trigger API)\",\"sidebarTitle\":\"Order History\",\"description\":\"Get historical trigger orders for an account\",\"openapi\":\"openapi-spec/trigger/v2/trigger.yaml get /orders/history\",\"href\":\"/api-reference/trigger/order-history\"}]}]}]},{\"item\":\"Prediction\",\"icon\":\"check-to-slot\",\"groups\":[{\"group\":\"Prediction\",\"tag\":\"BETA\",\"pages\":[{\"title\":\"Prediction Market API\",\"sidebarTitle\":\"About Prediction\",\"description\":\"Overview of Jupiter Prediction Market\",\"href\":\"/prediction\"},{\"title\":\"Jupiter Forecast\",\"sidebarTitle\":\"Forecast\",\"description\":\"Jupiter Forecast is a native prediction market on Solana. Trade 15-minute BTC up/down markets through the Prediction API or Swap API.\",\"llmsDescription\":\"$36\",\"href\":\"/prediction/forecast\"},{\"title\":\"Trading Lifecycle\",\"description\":\"The end-to-end sequence of Prediction API calls for a trade, and how data flows between them.\",\"llmsDescription\":\"Maps the full Jupiter Prediction Market trading flow across endpoints: GET /events or /events/search to discover events, read marketId from event.markets[], GET /markets/{marketId} for pricing, GET /orderbook/{marketId} for depth, GET /trading-status to confirm the exchange is open, POST /orders to place and sign the order, GET /orders/status/{orderPubkey} and GET /positions to track the fill, and POST /positions/{positionPubkey}/claim to settle. Shows call order and the data dependencies between calls. Use this page to understand which endpoints to call in what order before integrating.\",\"href\":\"/prediction/trading-lifecycle\"},{\"title\":\"Events \u0026 Markets\",\"description\":\"Discover prediction market events, search by keywords, and get market details with pricing information.\",\"llmsDescription\":\"GET /events lists events with filters. GET /events/search searches by keyword. GET /markets/{marketId} returns market details with pricing in micro USD. GET /orderbook/{marketId} provides bid/ask depth.\",\"href\":\"/prediction/events-and-markets\"},{\"title\":\"Open Positions\",\"description\":\"Create buy orders to open YES or NO positions in Jupiter Prediction Markets.\",\"llmsDescription\":\"POST /orders creates buy orders for YES/NO contracts. Required parameters: ownerPubkey, marketId, isYes, isBuy. Returns base64 transaction to sign and submit to Solana.\",\"href\":\"/prediction/open-positions\"},{\"title\":\"Manage Positions\",\"description\":\"View your prediction market positions and sell contracts to close positions.\",\"llmsDescription\":\"GET /positions lists holdings with P\u0026L. GET /orders lists your orders. DELETE /positions/{positionPubkey} closes a single position. DELETE /positions closes all open positions and requires minSellPriceSlippageBps.\",\"href\":\"/prediction/manage-positions\"},{\"title\":\"Claim Payouts\",\"description\":\"Claim your winnings after prediction markets resolve. Each winning contract pays out $1.\",\"llmsDescription\":\"POST /positions/{positionPubkey}/claim creates payout transaction for winning positions. Check position.claimable=true to verify eligibility. No claim fees - winning contracts pay $1 each.\",\"href\":\"/prediction/claim-payouts\"}]},{\"group\":\"Data \u0026 Analytics\",\"tag\":\"BETA\",\"pages\":[{\"title\":\"Position Data \u0026 History\",\"description\":\"Query positions, orders, and transaction history to track your prediction market activity and P\u0026L.\",\"llmsDescription\":\"GET /positions returns holdings with P\u0026L. GET /orders lists orders with fill status. GET /history provides transaction history with event types: order_created, order_filled, order_failed, position_updated, position_lost, payout_claimed.\",\"href\":\"/prediction/position-data\"},{\"title\":\"Social Features\",\"description\":\"Access user profiles, view leaderboards, and track the global trade feed on Jupiter Prediction Market.\",\"llmsDescription\":\"GET /profiles/{pubkey} returns user stats. GET /profiles/{pubkey}/pnl-history returns time-series P\u0026L. GET /leaderboards returns rankings by pnl/volume/win_rate. GET /trades provides the global trade feed.\",\"href\":\"/prediction/social-features\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"How to Build a Prediction Market App on Solana\",\"sidebarTitle\":\"Prediction Markets\",\"description\":\"Build prediction market features into your Solana app using Jupiter's Prediction API.\",\"llmsDescription\":\"Jupiter Prediction API brings prediction markets to Solana. Binary YES/NO trading on real-world events (sports, crypto, politics, elections). Aggregates liquidity from Polymarket and Kalshi. Full API for order creation, position management, P\u0026L tracking, and payout claims. Base URL: https://api.jup.ag/prediction/v1. Requires x-api-key header from developers.jup.ag/portal.\",\"href\":\"/guides/how-to-build-a-prediction-market-app-on-solana\"}]},{\"group\":\"API Reference\",\"tag\":\"BETA\",\"pages\":[{\"group\":\"Events\",\"pages\":[{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /events\",\"title\":\"Get Events\",\"description\":\"Get a list of all available prediction events with optional filtering and pagination\",\"href\":\"/api-reference/prediction/get-events\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /events/search\",\"title\":\"Search Events\",\"description\":\"Search for events by title or keyword\",\"href\":\"/api-reference/prediction/search-events\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /events/{eventId}\",\"title\":\"Get Event\",\"description\":\"Get detailed information about a specific event\",\"href\":\"/api-reference/prediction/get-event\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /events/suggested/{pubkey}\",\"title\":\"Get Suggested Events\",\"description\":\"Get personalized event suggestions based on user activity\",\"href\":\"/api-reference/prediction/get-suggested-events\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /events/scores\",\"title\":\"Get Live Scores\",\"description\":\"Get the latest live scores for a set of events\",\"href\":\"/api-reference/prediction/get-event-scores\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /events/{eventId}/score\",\"title\":\"Get Event Score\",\"description\":\"Get the latest live score for a single event\",\"href\":\"/api-reference/prediction/get-event-score\"}]},{\"group\":\"Markets\",\"pages\":[{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /events/{eventId}/markets\",\"title\":\"Get Event Markets\",\"description\":\"Get all markets for a specific event\",\"href\":\"/api-reference/prediction/get-event-markets\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /events/{eventId}/markets/{marketId}\",\"title\":\"Get Event Market\",\"description\":\"Get detailed market information for a specific market within an event\",\"href\":\"/api-reference/prediction/get-event-market\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /markets/{marketId}\",\"title\":\"Get Market\",\"description\":\"Get detailed market information by market ID\",\"href\":\"/api-reference/prediction/get-market\"}]},{\"group\":\"Orders\",\"pages\":[{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /orders\",\"title\":\"Get Orders\",\"description\":\"Get a list of orders with optional filtering by owner or market\",\"href\":\"/api-reference/prediction/get-orders\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /orders/{orderPubkey}\",\"title\":\"Get Order (Prediction API)\",\"sidebarTitle\":\"Get Order\",\"description\":\"Get detailed information about a specific order\",\"href\":\"/api-reference/prediction/get-order\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /orders/status/{orderPubkey}\",\"title\":\"Get Order Status\",\"description\":\"Get the latest status and history for an order\",\"href\":\"/api-reference/prediction/get-order-status\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml post /orders\",\"title\":\"Create Order (Prediction API)\",\"sidebarTitle\":\"Create Order\",\"description\":\"Request an unsigned transaction to create a new order\",\"href\":\"/api-reference/prediction/create-order\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml post /execute\",\"title\":\"Execute Order (Prediction API)\",\"sidebarTitle\":\"Execute Order\",\"description\":\"Submit a signed order transaction, including Jupiter Forecast orders\",\"href\":\"/api-reference/prediction/execute\"}]},{\"group\":\"Positions\",\"pages\":[{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /positions\",\"title\":\"Get Positions (Prediction API)\",\"sidebarTitle\":\"Get Positions\",\"description\":\"Get a list of positions with optional filtering\",\"href\":\"/api-reference/prediction/get-positions\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /positions/{positionPubkey}\",\"title\":\"Get Position\",\"description\":\"Get detailed information about a specific position\",\"href\":\"/api-reference/prediction/get-position\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml delete /positions/{positionPubkey}\",\"title\":\"Close Position\",\"description\":\"Request an unsigned transaction to sell all contracts in a position\",\"href\":\"/api-reference/prediction/close-position\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml delete /positions\",\"title\":\"Close All Positions\",\"description\":\"Request unsigned transactions to close all open positions\",\"href\":\"/api-reference/prediction/close-all-positions\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml post /positions/{positionPubkey}/claim\",\"title\":\"Claim Position\",\"description\":\"Request an unsigned transaction to claim payout from a winning position\",\"href\":\"/api-reference/prediction/claim-position\"}]},{\"group\":\"History \u0026 Data\",\"pages\":[{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /history\",\"title\":\"Get History\",\"description\":\"Get trading history and event records for an account\",\"href\":\"/api-reference/prediction/get-history\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /orderbook/{marketId}\",\"title\":\"Get Orderbook\",\"description\":\"Get orderbook data for a specific market\",\"href\":\"/api-reference/prediction/get-orderbook\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /trading-status\",\"title\":\"Get Trading Status\",\"description\":\"Get current trading status of the prediction market\",\"href\":\"/api-reference/prediction/get-trading-status\"}]},{\"group\":\"Profile \u0026 Social\",\"pages\":[{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /profiles/{ownerPubkey}\",\"title\":\"Get Profile\",\"description\":\"Get profile statistics for a user\",\"href\":\"/api-reference/prediction/get-profile\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /profiles/{ownerPubkey}/pnl-history\",\"title\":\"Get PnL History\",\"description\":\"Get historical PnL data for charting\",\"href\":\"/api-reference/prediction/get-pnl-history\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /trades\",\"title\":\"Get Trades\",\"description\":\"Get recent filled trades across all markets\",\"href\":\"/api-reference/prediction/get-trades\"},{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /leaderboards\",\"title\":\"Get Leaderboards\",\"description\":\"Get leaderboard rankings by various metrics\",\"href\":\"/api-reference/prediction/get-leaderboards\"}]},{\"group\":\"Vault\",\"pages\":[{\"openapi\":\"openapi-spec/prediction/prediction.yaml get /vault-info\",\"title\":\"Get Vault Info\",\"description\":\"Get vault account information and balance\",\"href\":\"/api-reference/prediction/get-vault-info\"}]}]}]},{\"item\":\"More\",\"icon\":\"ellipsis\",\"groups\":[{\"group\":\"Portfolio\",\"tag\":\"BETA\",\"pages\":[{\"title\":\"Jupiter Portfolio API Overview\",\"sidebarTitle\":\"About Portfolio\",\"description\":\"Overview of Jupiter Portfolio API for comprehensive portfolio tracking across the Solana ecosystem\",\"llmsDescription\":\"BETA: GET /portfolio/v1/positions?wallet={address} returns all DeFi positions across protocols on Solana including lending, staking, and LP positions.\",\"href\":\"/portfolio\"},{\"title\":\"Jupiter Positions\",\"description\":\"Query Jupiter positions, platform information, and staking data using the Portfolio API.\",\"llmsDescription\":\"Query Jupiter-specific positions including wallet balances, staked JUP, limit orders, DCA, liquidity pools, and leveraged trades via GET /portfolio/v1/positions/{address}.\",\"href\":\"/portfolio/jupiter-positions\"}]},{\"group\":\"Send\",\"tag\":\"BETA\",\"pages\":[{\"title\":\"Jupiter Send API Overview\",\"sidebarTitle\":\"About Send API\",\"description\":\"Overview of Jupiter Send API for gifting, paying, or onboarding users even without a wallet\",\"llmsDescription\":\"Send tokens to any user without requiring a connected wallet on the receiving end. Recipients claim tokens via Jupiter Mobile.\",\"href\":\"/send/index\"},{\"title\":\"Invite Code (Beta)\",\"description\":\"Generate invite codes and derive deterministic keypairs for the Send API.\",\"llmsDescription\":\"Client-side utilities for generating 12-character base58 invite codes and deriving deterministic Solana keypairs for the Send API.\",\"href\":\"/send/invite-code\"},{\"title\":\"Craft Send (Beta)\",\"description\":\"Build a Send transaction that transfers tokens to a recipient via an invite code.\",\"llmsDescription\":\"Use the POST /send/v1/craft-send endpoint to build a Send transaction that transfers tokens to a recipient via an invite code.\",\"href\":\"/send/craft-send\"},{\"title\":\"Craft Clawback (Beta)\",\"description\":\"Reclaim tokens from an unclaimed Send invite before it expires.\",\"llmsDescription\":\"Use the POST /send/v1/craft-clawback endpoint to reclaim tokens from an unclaimed Send invite before it expires.\",\"href\":\"/send/craft-clawback\"},{\"title\":\"Manage Invites (Beta)\",\"description\":\"Query pending and historical Send invites for a wallet address.\",\"llmsDescription\":\"Query pending and historical Send invites using the /send/v1/pending-invites and /send/v1/invite-history endpoints.\",\"href\":\"/send/manage-invites\"}]},{\"group\":\"Studio\",\"tag\":\"BETA\",\"pages\":[{\"title\":\"Jupiter Studio Overview\",\"sidebarTitle\":\"About Studio\",\"description\":\"Jupiter Studio provides APIs for token creation with flexible bonding curves, LP fee management, vesting schedules, and dedicated token pages on jup.ag.\",\"href\":\"/studio/index\"},{\"title\":\"Create Token (Beta)\",\"description\":\"Launch a token with configurable bonding curves, metadata, and images through the Studio API.\",\"llmsDescription\":\"Use the Studio API create-tx and submit endpoints to launch a token with configurable bonding curves, upload metadata and images, and submit the signed transaction.\",\"href\":\"/studio/create-token\"},{\"title\":\"Claim Fee (Beta)\",\"description\":\"Check and claim unclaimed LP fees from Dynamic Bonding Curve pools.\",\"llmsDescription\":\"Retrieve pool addresses, check unclaimed LP fees, and claim fees from Dynamic Bonding Curve pools using the Studio API fee endpoints.\",\"href\":\"/studio/claim-fee\"}]},{\"group\":\"Lock\",\"pages\":[{\"title\":\"Jupiter Lock Overview\",\"sidebarTitle\":\"About Lock\",\"description\":\"Jupiter Lock is an open-sourced, audited, and free ecosystem tool to lock and distribute tokens over-time.\",\"llmsDescription\":\"Jupiter Lock (Program ID: LocpQgucEQHbqNABEYvBvwoxCPsSbG91A1QaQhQQqjn) is an open-source, audited, and free tool for locking and vesting tokens over time on Solana.\",\"href\":\"/lock/index\"}]},{\"group\":\"Perps\",\"pages\":[{\"title\":\"Jupiter Perpetuals Overview\",\"sidebarTitle\":\"About Perps API\",\"description\":\"Overview of Jupiter Perps API for leverage trading on Solana\",\"llmsDescription\":\"Jupiter Perpetuals program for leveraged trading on Solana. Work-in-progress documentation covering account structures and the Anchor IDL.\",\"href\":\"/perps/index\"},{\"title\":\"Position Account\",\"description\":\"Overview of the Position account used in the Jupiter Perpetuals Program, representing trade position data for a given token\",\"llmsDescription\":\"The Position account stores trade position data including owner, side (long/short), entry price, size, collateral, PNL, and borrow fee snapshot. Derived from the trader's wallet, custody, and collateral custody.\",\"href\":\"/perps/position-account\"},{\"title\":\"PositionRequest Account\",\"description\":\"Overview of the PositionRequest account used in the Jupiter Perpetuals Program, representing a request to open or close a position\",\"llmsDescription\":\"The PositionRequest account represents a pending request to open, close, or modify a position, including TP/SL triggers. It is a PDA derived from the Position account with a unique random seed.\",\"href\":\"/perps/position-request-account\"},{\"title\":\"Pool Account\",\"description\":\"Overview of the Pool account used in the Jupiter Perpetuals Program, representing data for the JLP pool including AUM and Custody data\",\"llmsDescription\":\"The Pool account stores JLP pool configuration including AUM (aumUsd), custody public keys, position limits, fee schedules (open/close/swap), and APR calculation data. Only one Pool account exists.\",\"href\":\"/perps/pool-account\"},{\"title\":\"Custody Account\",\"description\":\"Overview of the Custody account used in the Jupiter Perpetuals Program, representing tokens managed by the JLP pool\",\"llmsDescription\":\"The Custody account stores parameters and state for each token (SOL, ETH, BTC, USDC, USDT, JupUSD) managed by the JLP pool, including oracle data, pricing params, asset balances, and funding rate state.\",\"href\":\"/perps/custody-account\"}]},{\"group\":\"API Reference\",\"pages\":[{\"group\":\"Portfolio\",\"pages\":[{\"openapi\":\"openapi-spec/portfolio/portfolio.yaml get /positions/{address}\",\"title\":\"Get Positions (Portfolio API)\",\"sidebarTitle\":\"Get Positions\",\"description\":\"Request for Jupiter positions of an address\",\"href\":\"/api-reference/portfolio/get-positions\"},{\"openapi\":\"openapi-spec/portfolio/portfolio.yaml get /staked-jup/{address}\",\"title\":\"Get Staked JUP\",\"description\":\"Request for staked JUP information of an address\",\"href\":\"/api-reference/portfolio/get-staked-jup\"},{\"openapi\":\"openapi-spec/portfolio/portfolio.yaml get /platforms\",\"title\":\"Get Platforms\",\"description\":\"Request for platform information\",\"href\":\"/api-reference/portfolio/get-platforms\"}]},{\"group\":\"Send\",\"pages\":[{\"openapi\":\"openapi-spec/send/send.yaml post /craft-send\",\"title\":\"Craft Send\",\"description\":\"Request for a base64-encoded unsigned Send transaction\",\"href\":\"/api-reference/send/craft-send\"},{\"openapi\":\"openapi-spec/send/send.yaml post /craft-clawback\",\"title\":\"Craft Clawback\",\"description\":\"Request for a base64-encoded unsigned Send transaction\",\"href\":\"/api-reference/send/craft-clawback\"},{\"openapi\":\"openapi-spec/send/send.yaml get /pending-invites\",\"title\":\"Pending Invites\",\"description\":\"Request for the pending invites of an address\",\"href\":\"/api-reference/send/pending-invites\"},{\"openapi\":\"openapi-spec/send/send.yaml get /invite-history\",\"title\":\"Invite History\",\"description\":\"Request for the invite history of an address\",\"href\":\"/api-reference/send/invite-history\"}]},{\"group\":\"Studio\",\"pages\":[{\"openapi\":\"openapi-spec/studio/studio.yaml post /dbc-pool/create-tx\",\"title\":\"DBC Pool Create TX\",\"description\":\"Request for a base64-encoded unsigned transaction to create a Dynamic Bonding Curve pool with token metadata\",\"href\":\"/api-reference/studio/dbc-pool-create-tx\"},{\"openapi\":\"openapi-spec/studio/studio.yaml post /dbc-pool/submit\",\"title\":\"DBC Pool Submit\",\"description\":\"Execute the signed transaction, and optionally upload content and header image\",\"href\":\"/api-reference/studio/dbc-pool-submit\"},{\"openapi\":\"openapi-spec/studio/studio.yaml get /dbc-pool/addresses/{mint}\",\"title\":\"DBC Pool Addresses by Mint\",\"description\":\"Request for pool addresses for a given token mint\",\"href\":\"/api-reference/studio/dbc-pool-addresses-by-mint\"},{\"openapi\":\"openapi-spec/studio/studio.yaml post /dbc/fee\",\"title\":\"DBC Fee\",\"description\":\"Request for unclaimed creator trading fees of a Dynamic Bonding Curve pool\",\"href\":\"/api-reference/studio/dbc-fee\"},{\"openapi\":\"openapi-spec/studio/studio.yaml post /dbc/fee/create-tx\",\"title\":\"DBC Fee Create TX\",\"description\":\"Request for a base64-encoded unsigned transaction to claim creator trading fees of a Dynamic Bonding Curve pool\",\"href\":\"/api-reference/studio/dbc-fee-create-tx\"}]}]}]}]},{\"tab\":\"AI\",\"groups\":[{\"group\":\" \",\"pages\":[{\"title\":\"Jupiter for AI Agents\",\"sidebarTitle\":\"Overview\",\"description\":\"Connect your AI agent to Jupiter's APIs and docs\",\"llmsDescription\":\"Overview of Jupiter's AI surface area. Covers how agents connect to Jupiter based on their environment: local agents (Claude Code, Cursor, Codex) use CLI + Skills, hosted agents (ChatGPT, Claude.ai) use MCP. Tools split into two categories: reading docs (llms.txt, Skills, Docs MCP) and executing operations (CLI, Jupiter MCP). All Jupiter APIs are AI-native: no RPC required, clean JSON responses, simple REST interfaces.\",\"href\":\"/ai\"},{\"title\":\"llms.txt\",\"description\":\"Structured documentation index optimised for LLM and AI agent consumption.\",\"llmsDescription\":\"Jupiter provides two LLM-optimised documentation files: llms.txt (structured Markdown index of all APIs, guides, and resources with titles and descriptions, the perfect entrypoint for LLMs and AI agents) and llms-full.txt (the complete documentation site content including all code examples). Both follow the llmstxt.org standard. Additionally, any documentation page can be accessed as raw Markdown by appending .md to the URL or using the Accept: text/markdown header.\",\"href\":\"/ai/llms-txt\"},{\"title\":\"Skills\",\"description\":\"Pre-built agent skills for integrating Jupiter APIs into AI coding agents.\",\"llmsDescription\":\"Jupiter provides two agent skills in the jup-ag/agent-skills repository that AI coding agents can use as context when building with Jupiter. (1) integrating-jupiter: comprehensive integration guidance covering all Jupiter APIs (Swap, Lend, Perps, Trigger, Recurring, Tokens, Price, Portfolio, Prediction Markets, Send, Studio, Lock, Routing) with intent routing, API playbooks, error handling, and production hardening. (2) jupiter-lend: deep-dive into Jupiter Lend protocol (powered by Fluid) covering liquidity pools, lending markets (jlTokens), vaults, and flashloans with read (@jup-ag/lend-read) and write (@jup-ag/lend) SDKs. Skills are installed via npx skills add and provide SKILL.md files that AI agents consume as context.\",\"href\":\"/ai/skills\"},{\"title\":\"Documentation MCP\",\"description\":\"Search and query Jupiter docs and APIs from your AI editor via Model Context Protocol.\",\"llmsDescription\":\"Jupiter supports the Model Context Protocol (MCP) through Mintlify's native MCP server at https://developers.jup.ag/docs/mcp. This enables AI tools like Claude Code, Cursor, Windsurf, and other MCP-compatible editors to search and query Jupiter documentation and OpenAPI specifications in-context. The MCP server allows AI assistants to look up API endpoints, read documentation pages, and understand API schemas without leaving the editor. It is a read-only documentation server, not a tool for executing API calls.\",\"href\":\"/ai/mcp\"},{\"title\":\"Jupiter Trading MCP\",\"sidebarTitle\":\"Trading MCP\",\"description\":\"Execute Jupiter trades and DeFi operations from any MCP client.\",\"llmsDescription\":\"Jupiter's hosted Trading MCP server at https://mcp.jup.ag gives AI agents access to Jupiter's trading infrastructure through the Model Context Protocol. It exposes 75 tools across 11 domains: Swap (quote, execute), Tokens (search, discovery, verification), Price, Trigger (limit orders, v2 vault flow), Recurring (DCA on the Trigger v2 flow), Lend (earn yield), Prediction (prediction markets), Portfolio (positions, staked JUP), Send (invite-based transfers), Studio (token launch pools), and Transaction (land signed transactions). An API key is optional: requests without one work at a lower rate limit, and passing your Jupiter API key from the Developer Platform as a Bearer token raises the limit. Transport is HTTP (Streamable HTTP). Covers setup for Claude Desktop, Claude Code, Cursor, and Windsurf, plus example prompts. This is the read-write operations server, distinct from the read-only Documentation MCP.\",\"href\":\"/ai/trading-mcp\"},{\"title\":\"Jupiter CLI\",\"description\":\"Trade on Jupiter from your terminal, Telegram, or through AI agents.\",\"llmsDescription\":\"The Jupiter CLI (jup) is a command-line tool for interacting with Jupiter's products on Solana: Spot trading, Perpetual futures, and Lending. It is non-interactive and LLM-friendly by design, with JSON output mode for structured responses. Install via npm (npm i -g @jup-ag/cli). For full command references, key management, configuration, and JSON response schemas, see the CLI documentation at https://github.com/jup-ag/cli/tree/main/docs. Three usage paths: direct terminal, Telegram via OpenClaw/miniclaw, and AI agent integration.\",\"href\":\"/ai/cli\"}]}]},{\"tab\":\"Tool Kits\",\"groups\":[{\"group\":\"Tool Kits\",\"pages\":[{\"title\":\"Jupiter Tool Kits\",\"sidebarTitle\":\"About Tool Kits\",\"description\":\"Powerful developer tools and SDKs that help you integrate Jupiter products into your applications with minimal effort.\",\"llmsDescription\":\"Three developer tool kits: Jupiter Plugin (drop-in Ultra Swap widget), Wallet Kit (unified wallet adapter for all Solana wallets), and Referral Program (earn fees on user trades).\",\"href\":\"/tool-kits\"}]},{\"group\":\"Jupiter Plugin\",\"pages\":[{\"title\":\"Integrate Jupiter Plugin\",\"sidebarTitle\":\"Introduction\",\"description\":\"Seamlessly integrate end-to-end Ultra Swap functionality into any application with just a few lines of code.\",\"llmsDescription\":\"Drop-in Ultra Swap widget for any web app. Supports 3 display modes (integrated, widget, modal), RPC-less operation, wallet passthrough, and customizable theming.\",\"href\":\"/tool-kits/plugin/index\"},{\"group\":\"Walkthrough\",\"pages\":[{\"title\":\"Next.js App Example\",\"description\":\"Step-by-step guide to integrate Jupiter Plugin into a Next.js application.\",\"llmsDescription\":\"Step-by-step guide to integrate Jupiter Plugin into a Next.js application using either the window object or the @jup-ag/plugin npm package.\",\"href\":\"/tool-kits/plugin/nextjs-app-example\"},{\"title\":\"React App Example\",\"description\":\"Step-by-step guide to integrate Jupiter Plugin into a React application.\",\"llmsDescription\":\"Step-by-step guide to integrate Jupiter Plugin into a React application using either the window object or the @jup-ag/plugin npm package.\",\"href\":\"/tool-kits/plugin/react-app-example\"},{\"title\":\"HTML App Example\",\"description\":\"Step-by-step guide to integrate Jupiter Plugin into a plain HTML application.\",\"llmsDescription\":\"Step-by-step guide to integrate Jupiter Plugin into a plain HTML application using the plugin script tag and window.Jupiter.init().\",\"href\":\"/tool-kits/plugin/html-app-example\"}]},{\"title\":\"Customizing Plugin\",\"description\":\"Learn how to customize Jupiter Plugin's appearance and behavior.\",\"llmsDescription\":\"Configure Jupiter Plugin display modes, form props (swap mode, fixed amounts, referral fees), wallet passthrough, event handlers, branding, and color themes.\",\"href\":\"/tool-kits/plugin/customization\"},{\"title\":\"Jupiter Plugin FAQ\",\"sidebarTitle\":\"FAQ\",\"description\":\"Frequently asked questions about Jupiter Plugin\",\"llmsDescription\":\"Frequently asked questions about Jupiter Plugin: feature requests, adding referral fees, fixing integrated mode layout issues, and best practices for customization.\",\"href\":\"/tool-kits/plugin/faq\"}]},{\"group\":\"Jupiter Wallet Kit\",\"pages\":[{\"title\":\"Integrate Wallet Kit\",\"sidebarTitle\":\"Introduction\",\"description\":\"Integrate Jupiter Wallet Kit into your application to simplify wallet connectivity across all Solana wallets, all in a unified wallet interface\",\"llmsDescription\":\"Open-source unified wallet adapter supporting 20+ Solana wallets, Wallet Standard, Jupiter Wallet Extension, Mobile Adapter QR login, and i18n in 7 languages.\",\"href\":\"/tool-kits/wallet-kit/index\"},{\"title\":\"Jupiter Wallet Extension\",\"description\":\"Step-by-step guide to integrate Jupiter Wallet Extension into a Next.js application.\",\"llmsDescription\":\"Step-by-step guide to integrate Jupiter Wallet Extension into a Next.js app using @jup-ag/wallet-adapter with UnifiedWalletProvider and notification handling.\",\"href\":\"/tool-kits/wallet-kit/jupiter-wallet-extension\"},{\"title\":\"Jupiter Mobile Adapter\",\"description\":\"Integrate Jupiter Mobile QR code login into your app with WalletConnect support.\",\"llmsDescription\":\"Integrate Jupiter Mobile QR code login into your app using the @jup-ag/jup-mobile-adapter package with Reown's AppKit for WalletConnect support.\",\"href\":\"/tool-kits/wallet-kit/jupiter-mobile-adapter\"}]},{\"group\":\"Jupiter Referral Program\",\"pages\":[{\"title\":\"Referral Program\",\"sidebarTitle\":\"Introduction\",\"description\":\"Earn on-chain fees from user trades through the open-source Jupiter Referral Program.\",\"llmsDescription\":\"The open-source Referral Program SDK enables developers to earn on-chain fees via Jupiter APIs (Swap, Trigger, Plugin) and can be integrated by any Solana program.\",\"href\":\"/tool-kits/referral-program\"}]}]},{\"tab\":\"Changelog\",\"href\":\"https://developers.jup.ag/changelog\"},{\"tab\":\"Resources\",\"groups\":[{\"group\":\"Resources\",\"pages\":[{\"title\":\"Support\",\"description\":\"Technical and customer support platforms for Jupiter\",\"href\":\"/resources/support\"},{\"title\":\"Brand Kit\",\"description\":\"Logos, labelling guidelines, and brand assets for Jupiter integrations.\",\"href\":\"/resources/brand-kit\"},{\"title\":\"Stats\",\"description\":\"Jupiter product metrics, revenue, and usage statistics on Dune.\",\"href\":\"/resources/stats\"},{\"title\":\"Audits\",\"description\":\"Formal audit reports for Jupiter programs\",\"llmsDescription\":\"Formal third-party audit reports for Jupiter's onchain programs, organised by product: Jupiter Swap, Perpetuals, Lend, Limit Order, Lock, and DAO. Each entry links to the full PDF report from firms including Offside Labs, OtterSec, Sec3, Certora, Code4rena, Mixbytes, and Zenith. To report a new vulnerability, use the bug bounty program on the Security page instead.\",\"href\":\"/resources/audits\"},{\"title\":\"Security\",\"description\":\"Report security vulnerabilities to Jupiter by email\",\"llmsDescription\":\"How to report security vulnerabilities in Jupiter's onchain programs, APIs, and web infrastructure. Report vulnerabilities by emailing security@jup.ag, covering separate Web3 and Web2 scopes, for issues that threaten user funds, protocol solvency, governance integrity, or user data. Links to the formal audit reports for Jupiter programs.\",\"href\":\"/resources/security\"},{\"title\":\"References\",\"description\":\"Links and references to Jupiter's GitHub repositories.\",\"href\":\"/resources/references\"}]},{\"group\":\"Legal\",\"pages\":[{\"title\":\"Guidelines\",\"description\":\"Important legal documentation and guidelines that governs the use of our services and platform. Please review these documents carefully.\",\"href\":\"/legal/index\"},{\"title\":\"SDK \u0026 API License Agreement\",\"description\":\"Jupiter API \u0026 SDK License Agreement\",\"href\":\"/legal/sdk-api-license-agreement\"},{\"title\":\"Terms of Use\",\"description\":\"Jupiter Terms of Use\",\"href\":\"/legal/terms-of-use\"},{\"title\":\"Privacy Policy\",\"description\":\"Privacy Policy for Jupiter\",\"href\":\"/legal/privacy-policy\"}]}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L37\"}]\n"])</script><script>self.__next_f.push([1,"38:I[604804,[\"/docs/_next/static/chunks/607c8643ad3fc16c.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/1e7a188add93a653.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/343f3c7f568a2e5d.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/c50d793b8f34b10b.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/ccee8d9b3189ccd9.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/9b51ed6445f8c728.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/3b847e5370bd724e.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/4fa3ca58dfaaeff8.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/8d0901e40ed4b058.js?dpl=dpl_G2V2ecyQiE2VPjSZgHNz4JvwMtzJ\",\"/docs/_next/static/chunks/468295ca52ed5c09.js?dpl=dpl_G2V