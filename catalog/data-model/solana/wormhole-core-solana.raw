          });</script> </div> <div class="llms"> <div> <span class="footer-title">AI Resources</span> <button class="ai-file-actions-btn ai-file-actions-copy" data-action="copy-llms-full" data-url="https://wormhole.com/docs/ai/llms-full.jsonl"> <svg viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12z"></path></svg> llms-full.jsonl </button> </div> </div> <div class="md-social"> <a class="md-social__link" href="https://x.com/wormhole" rel="noopener" target="_blank" title="Twitter"> <svg viewbox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><!-- Font Awesome Free 7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2025 Fonticons, Inc.--><path d="M357.2 48h70.6L273.6 224.2 455 464H313L201.7 318.6 74.5 464H3.8l164.9-188.5L-5.2 48h145.6l100.5 132.9zm-24.8 373.8h39.1L119.1 88h-42z"></path></svg> </a> <a class="md-social__link" href="https://t.me/wormholecrypto" rel="noopener" target="_blank" title="Telegram"> <?xml version="1.0" encoding="UTF-8" standalone="no"?> <svg fill="none" height="16.04286" id="svg499" version="1.1" width="19.249975" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg"> <defs id="defs503"></defs> <path d="m 17.609233,0.1413996 c 0,0 1.78,-0.694 1.632,0.993 -0.05,0.694 -0.494,3.124 -0.84,5.753 l -1.188,7.7870004 c 0,0 -0.099,1.14 -0.99,1.34 -0.89,0.198 -2.225,-0.695 -2.472,-0.894 -0.198,-0.149 -3.71,-2.38 -4.9470005,-3.472 -0.3459997,-0.297 -0.7419997,-0.892 0.05,-1.587 L 14.047233,5.1013996 c 0.594,-0.595 1.188,-1.983 -1.286,-0.297 l -6.9250002,4.712 c 0,0 -0.791,0.4960004 -2.275,0.05 l -3.21599998,-0.993 c 0,0 -1.18700001,-0.744 0.84099998,-1.488 4.947,-2.33 11.0310002,-4.711 16.4230002,-6.943 z" fill="#fff" id="path497" style="fill:#ffffff;fill-opacity:1"></path> </svg> </a> <a class="md-