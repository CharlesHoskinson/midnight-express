</script><link rel="icon" href="/docs/favicon.png"/><link rel="preload" href="/docs/_next/static/css/5a24bfca91fcd059.css" as="style"/><link rel="stylesheet" href="/docs/_next/static/css/5a24bfca91fcd059.css" data-n-g=""/><noscript data-n-css=""></noscript><script defer="" nomodule="" src="/docs/_next/static/chunks/polyfills-42372ed130431b0a.js"></script><script src="/docs/_next/static/chunks/webpack-c4ce12dbf23e3ec1.js" defer=""></script><script src="/docs/_next/static/chunks/framework-c26057c747147ce4.js" defer=""></script><script src="/docs/_next/static/chunks/main-87593f4979ffae61.js" defer=""></script><script src="/docs/_next/static/chunks/pages/_app-6d7a6c09afc0ac71.js" defer=""></script><script src="/docs/_next/static/chunks/0845d28f-d73486dde250b7ae.js" defer=""></script><script src="/docs/_next/static/chunks/d12bc315-26f5c6ed6e15025e.js" defer=""></script><script src="/docs/_next/static/chunks/78900-10e0414aecdec679.js" defer=""></script><script src="/docs/_next/static/chunks/55114-a3a104c6a70f42e4.js" defer=""></script><script src="/docs/_next/static/chunks/75629-d204a28d5b923c2e.js" defer=""></script><script src="/docs/_next/static/chunks/pages/en/smart-contracts/core-b7cc6b2a2731822b.js" defer=""></script><script src="/docs/_next/static/vWX6gSRjtYAq92ly2xfv1/_buildManifest.js" defer=""></script><script src="/docs/_next/static/vWX6gSRjtYAq92ly2xfv1/_ssgManifest.js" defer=""></script></head><body class="bg-background text-foreground"><div id="__next"><div class="min-h-screen bg-background"><header class="sticky top-0 z-50 border-b border-border bg-background shadow-foreground/5 transition duration-500 dark:shadow-none dark:bg-transparent"><div class="mx-auto flex max-w-[1800px] flex-wrap items-center justify-between px-4 py-5 sm:px-6 lg:px-8 xl:px-12"><div class="mr-6 flex nav:hidden"><button type="button" class="relative" aria-label="Open navigation"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" class="h-6