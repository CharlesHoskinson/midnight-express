e":"h3","attributes":{"id":"what-is-metaplex-core"},"children":["What is Metaplex Core?"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Metaplex Core is a next-generation NFT standard on Solana that uses a single-account design for lower costs, enforced royalties, and a flexible plugin system. It's the recommended standard for new NFT projects."]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"how-is-core-different-from-token-metadata"},"children":["How is Core different from Token Metadata?"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Core uses one account per asset (vs 3+ for Token Metadata), costs ~80% less to mint, has lower compute usage, and includes built-in royalty enforcement. Token Metadata is considered legacy for new projects. See ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/tm-differences"},"children":["Differences from Token Metadata"]}," for a detailed comparison."]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"can-i-migrate-from-token-metadata-to-core"},"children":["Can I migrate from Token Metadata to Core?"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Core Assets and Token Metadata NFTs are separate standards. There's no automatic migration. New projects should use Core; existing Token Metadata collections continue to work."]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"does-core-support-royalties"},"children":["Does Core support royalties?"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Yes. Core has a ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins/royalties"},"children":["Royalties plugin"]}," that enforces royalties by default. You can set basis points, creator splits, and allowlist/denylist rules for marketplaces."]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"what-are-plugins"},"children":["What are plugins?"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Plugins are modular extensions that add behavior to Core Assets or Collections. Examples include Freeze Delegate (allow freezing), Attributes (on-chain data), and Royalties (creator payments)."]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"how-much-does-it-cost-to-mint-a-core-asset"},"children":["How much does it cost to mint a Core Asset?"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Approximately 0.003 SOL per base asset, compared to ~0.022 SOL for Token Metadata. This makes Core ~80% cheaper for minting. See ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/tm-differences"},"children":["Differences from Token Metadata"]}," for more details."]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"which-rpc-providers-support-core"},"children":["Which RPC providers support Core?"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["All major RPC providers supporting DAS (Digital Asset Standard) index Core assets. See ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/solana/rpcs-and-das"},"children":["RPC Providers"]}," for a current list."]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"can-i-use-core-for-gaming-assets"},"children":["Can I use Core for gaming assets?"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Yes. Core's plugin system makes it ideal for gaming: use Attributes for on-chain stats, Freeze Delegate for locking items, and Transfer Delegate for marketplace integration."]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"glossary"},"children":["Glossary"]},{"$$mdtype":"Tag","name":"Table","attributes":{},"children":[{"$$mdtype":"Tag","name":"thead","attributes":{},"children":[{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Term"]},{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Definition"]}]}]},{"$$mdtype":"Tag","name":"tbody","attributes":{},"children":[{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Asset"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["A single Core on-chain account representing an NFT with ownership, metadata, and plugins"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Collection"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["A Core account that groups related Assets and can apply collection-wide plugins"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Plugin"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["A modular extension that adds behavior to Assets or Collections (royalties, freeze, attributes)"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["DAS"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["Digital Asset Standard - the API specification for querying indexed NFT data"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Basis Points"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["Royalty percentage in hundredths of a percent (500 = 5%)"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Delegate"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["An account authorized to perform specific actions on an Asset without owning it"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["CPI"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["Cross-Program Invocation - calling the Core program from another Solana program"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["URI"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["The off-chain metadata URL pointing to a JSON file with name, image, and attributes"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Asset Signer PDA"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["A separate address derived from an Asset that acts as the Asset's wallet"]}]}]}]}],"frontmatter":{"title":"Overview","metaTitle":"Metaplex Core | Next-Gen NFT Standard for Solana","description":"Metaplex Core is the next-generation NFT standard on Solana with single-account design, enforced royalties, and a flexible plugin system. Lower costs, lower compute, better performance.","updated":"09-03-2026","keywords":["Metaplex Core","Solana NFT","NFT standard","single-account NFT","enforced royalties","mpl-core"],"about":["NFT standards","Solana blockchain","Digital assets"],"proficiencyLevel":"Beginner","programmingLanguage":["JavaScript","TypeScript","Rust"],"faqs":[{"q":"What is Metaplex Core?","a":"Metaplex Core is a next-generation NFT standard on Solana that uses a single-account design for lower costs, enforced royalties, and a flexible plugin system. It's the recommended standard for new NFT projects."},{"q":"How is Core different from Token Metadata?","a":"Core uses one account per asset vs 3+ for Token Metadata, costs ~80% less to mint, has lower compute usage, and includes built-in royalty enforcement."},{"q":"Can I migrate from Token Metadata to Core?","a":"Core Assets and Token Metadata NFTs are separate standards. There's no automatic migration. New projects should use Core; existing Token Metadata collections continue to work."},{"q":"Does Core support royalties?","a":"Yes. Core has a Royalties plugin that enforces royalties by default. You can set basis points, creator splits, and allowlist/denylist rules for marketplaces."},{"q":"What are plugins?","a":"Plugins are modular extensions that add behavior to Core Assets or Collections. Examples include Freeze Delegate, Attributes, and Royalties."},{"q":"How much does it cost to mint a Core Asset?","a":"Approximately 0.003 SOL per base asset, compared to ~0.022 SOL for Token Metadata. This makes Core ~80% cheaper for minting."},{"q":"Which RPC providers support Core?","a":"All major RPC providers supporting DAS (Digital Asset Standard) index Core assets."},{"q":"Can I use Core for gaming assets?","a":"Yes. Core's plugin system makes it ideal for gaming with Attributes for on-chain stats, Freeze Delegate for locking items, and Transfer Delegate for marketplace integration."}]},"file":{"path":"/en/smart-contracts/core/index.md"}}},"__N_SSG":true},"page":"/en/smart-contracts/core","query":{},"buildId":"vWX6gSRjtYAq92ly2xfv1","assetPrefix":"/docs","isFallback":false,"gsp":true,"scriptLoader":[]}</script><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a451c4cc1e074d02',t:'MTc5MTA5MTU1NQ=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility