re (\"Core\") is the ",{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["next-generation NFT standard"]}," on Solana. It uses a ",{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["single-account design"]}," that reduces minting costs by 80%+ compared to alternatives, while providing ",{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["enforced royalties"]},", ",{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["collection-level operations"]},", and a ",{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["flexible plugin system"]}," for custom behaviors. "]},{"$$mdtype":"Tag","name":"Callout","attributes":{"title":"What You'll Learn","type":"note"},"children":[{"$$mdtype":"Tag","name":"p","attributes":{},"children":["This overview covers:"]},{"$$mdtype":"Tag","name":"ul","attributes":{},"children":[{"$$mdtype":"Tag","name":"li","attributes":{},"children":["What Metaplex Core is and why it exists"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Key advantages over Token Metadata and other standards"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Core concepts: Assets, Collections, and Plugins"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["How to get started building with Core"]}]}]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"summary"},"children":["Summary"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Metaplex Core"]}," is a Solana NFT standard that replaces Token Metadata for most new projects. It offers the lowest minting costs, enforced royalties, and a plugin architecture for custom functionality."]},{"$$mdtype":"Tag","name":"ul","attributes":{},"children":[{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Single-account design: ~0.003 SOL per mint (vs 0.022 SOL for Token Metadata)"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Enforced royalties by default with allowlist/denylist controls"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Plugin system for staking, attributes, delegates, and custom behaviors"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Collection-level operations: freeze, update royalties, or modify all assets at once"]}]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"out-of-scope"},"children":["Out of Scope"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["This overview does not cover: fungible tokens (use SPL Token), Token Metadata migration paths, or detailed plugin implementation. See specific pages for those topics."]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"quick-start"},"children":["Quick Start"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Jump to:"]}," ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"#next-steps"},"children":["Getting Started"]}," · ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"#introduction"},"children":["Key Advantages"]}," · ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"#faq"},"children":["FAQ"]}," · ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"#glossary"},"children":["Glossary"]}]},{"$$mdtype":"Tag","name":"ol","attributes":{},"children":[{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Install the SDK: ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["npm install @metaplex-foundation/mpl-core"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Create an Asset: ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/create-asset"},"children":["Creating Assets guide"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Add plugins: ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins"},"children":["Plugins overview"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Query with DAS: ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/fetch"},"children":["Fetching Assets"]}]}]},{"$$mdtype":"Tag","name":"QuickLinks","attributes":{},"children":[{"$$mdtype":"Tag","name":"QuickLink","attributes":{"title":"Getting Started","description":"Find the language or library of your choice and get started with digital assets on Solana.","icon":"InboxArrowDown","href":"/smart-contracts/core/sdk"},"children":[]},{"$$mdtype":"Tag","name":"QuickLink","attributes":{"title":"API Reference","description":"Looking for something specific? Check our API References.","icon":"CodeBracketSquare","href":"https://mpl-core.typedoc.metaplex.com/","target":"_blank"},"children":[]},{"$$mdtype":"Tag","name":"QuickLink","attributes":{"title":"Differences from Token Metadata","description":"Coming from Token Metadata? See what's changed and what's new.","icon":"AcademicCap","href":"/smart-contracts/core/tm-differences"},"children":[]},{"$$mdtype":"Tag","name":"QuickLink","attributes":{"title":"Try Core in a UI","description":"Mint a Core Asset yourself using our web interface.","icon":"Beaker","href":"https://core.metaplex.com/","target":"_blank"},"children":[]}]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"introduction"},"children":["Introduction"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Metaplex Core is the recommended NFT standard for new projects on Solana. Compared to Token Metadata and other standards, Core provides:"]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"cost-efficiency"},"children":["Cost Efficiency"]},{"$$mdtype":"Tag","name":"Table","attributes":{},"children":[{"$$mdtype":"Tag","name":"thead","attributes":{},"children":[{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Standard"]},{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Mint Cost"]},{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Compute Units"]}]}]},{"$$mdtype":"Tag","name":"tbody","attributes":{},"children":[{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Metaplex Core"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["~0.003 SOL"]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["~17,000 CU"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":["Token Metadata"]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["~0.022 SOL"]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["~205,000 CU"]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":["Token Extensions"]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["~0.0046 SOL"]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":["~85,000 CU"]}]}]}]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"key-advantages"},"children":["Key Advantages"]},{"$$mdtype":"Tag","name":"ul","attributes":{},"children":[{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Single Account Design"]},": Core uses one account per asset instead of multiple (mint + metadata + token account). This reduces costs and simplifies development."]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Enforced Royalties"]},": The ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins/royalties"},"children":["Royalties plugin"]}," enforces creator royalties by default with allowlist/denylist controls."]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Collection-Level Operations"]},": Update royalties, freeze assets, or modify metadata for an entire collection in a single transaction."]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Plugin Architecture"]},": Add custom behaviors to assets via plugins:",{"$$mdtype":"Tag","name":"ul","attributes":{},"children":[{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins/freeze-delegate"},"children":["Freeze Delegate"]}," - Allow others to freeze/unfreeze"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins/burn-delegate"},"children":["Burn Delegate"]}," - Allow others to burn"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins/attribute"},"children":["Attributes"]}," - On-chain key/value data (auto-indexed by DAS)"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins/transfer-delegate"},"children":["Transfer Delegate"]}," - Allow others to transfer"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["And many more in the ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins"},"children":["Plugins section"]}]}]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["DAS Indexing"]},": All major ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/solana/rpcs-and-das"},"children":["RPC providers supporting DAS"]}," already index Core assets."]}]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"core-concepts"},"children":["Core Concepts"]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"assets"},"children":["Assets"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["An ",{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Asset"]}," is a single on-chain account representing an NFT. Unlike Token Metadata (which uses 3+ accounts), Core Assets contain ownership, metadata URI, and plugin data in one account."," ","See: ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/what-is-an-asset"},"children":["What is an Asset?"]}]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"collections"},"children":["Collections"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["A ",{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Collection"]}," is a Core account that groups related Assets. Collections can have their own plugins that apply to all member Assets. Collection-level royalties, for example, apply to every Asset in the collection unless overridden."]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Groups"]}," (",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["GroupV1"]},") are a separate taxonomy layer that can organize collections, standalone assets, and nested groups. See ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/groups"},"children":["Core Groups"]}," for when to use groups vs collections."," ","See: ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/collections"},"children":["Collections"]}]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"plugins"},"children":["Plugins"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Plugins"]}," are modular extensions that add behavior to Assets or Collections. They hook into lifecycle events (create, transfer, burn) to enforce rules or store data."," ","See: ",{"$$mdtype":"Tag","name":"Link","attributes":{"href":"/smart-contracts/core/plugins"},"children":["Plugins Overview"]}]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"quick-reference"},"children":["Quick Reference"]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"program-ids"},"children":["Program IDs"]},{"$$mdtype":"Tag","name":"Table","attributes":{},"children":[{"$$mdtype":"Tag","name":"thead","attributes":{},"children":[{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Program"]},{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Address"]}]}]},{"$$mdtype":"Tag","name":"tbody","attributes":{},"children":[{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":["MPL Core"]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"code","attributes":{},"children":["CoREENxT6tW1HoK8ypY1SxRMZTcVPm7R94rH4PZNhX7d"]}]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":["MPL Core (Devnet)"]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"code","attributes":{},"children":["CoREENxT6tW1HoK8ypY1SxRMZTcVPm7R94rH4PZNhX7d"]}]}]}]}]},{"$$mdtype":"Tag","name":"h3","attributes":{"id":"sdk-packages"},"children":["SDK Packages"]},{"$$mdtype":"Tag","name":"Table","attributes":{},"children":[{"$$mdtype":"Tag","name":"thead","attributes":{},"children":[{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Language"]},{"$$mdtype":"Tag","name":"Th","attributes":{"scope":"col"},"children":["Package"]}]}]},{"$$mdtype":"Tag","name":"tbody","attributes":{},"children":[{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":["JavaScript/TypeScript"]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"code","attributes":{},"children":["@metaplex-foundation/mpl-core"]}]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"