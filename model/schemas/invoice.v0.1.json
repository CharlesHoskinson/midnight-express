{
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^event:[a-z0-9][a-z0-9._/-]{0,63}$",
      "maxLength": 80
    },
    "source": {
      "type": "string",
      "pattern": "^urn:mpe:source:[a-z0-9][a-z0-9-]{0,31}$"
    },
    "type": {
      "const": "mpe.invoice.payment-observed.v0.1"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "urn:mpe:model:invoice.v0.1"
    },
    "mpeprofile": {
      "const": "invoice.v0.1"
    },
    "mpecontract": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "data": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "type": "string",
          "pattern": "^invoice:[a-z0-9][a-z0-9._/-]{0,63}$",
          "maxLength": 80
        },
        "supplier": {
          "type": "string",
          "pattern": "^party:[a-z0-9][a-z0-9._/-]{0,63}$",
          "maxLength": 80
        },
        "customer": {
          "type": "string",
          "pattern": "^party:[a-z0-9][a-z0-9._/-]{0,63}$",
          "maxLength": 80
        },
        "documentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "currency": {
          "const": "iso4217:USD"
        },
        "payable": {
          "type": "object",
          "properties": {
            "coefficient": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,17}$"
            },
            "scale": {
              "const": 2
            }
          },
          "required": [
            "coefficient",
            "scale"
          ],
          "additionalProperties": false
        },
        "paymentId": {
          "type": "string",
          "pattern": "^payment:[a-z0-9][a-z0-9._/-]{0,63}$",
          "maxLength": 80
        },
        "amount": {
          "type": "object",
          "properties": {
            "coefficient": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,17}$"
            },
            "scale": {
              "const": 2
            }
          },
          "required": [
            "coefficient",
            "scale"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "Pending",
            "Final",
            "Reversed"
          ]
        },
        "observedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
        },
        "effectiveAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
        },
        "rail": {
          "const": "fixture-bank-v1"
        }
      },
      "required": [
        "invoiceId",
        "supplier",
        "customer",
        "documentDigest",
        "currency",
        "payable",
        "paymentId",
        "amount",
        "status",
        "observedAt",
        "effectiveAt",
        "rail"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "mpeprofile",
    "mpecontract",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpe:model:invoice.v0.1"
}
